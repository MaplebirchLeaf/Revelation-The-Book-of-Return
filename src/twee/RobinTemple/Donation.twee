:: Revelation Robin Temple Donation
<!-- ./src/twee/RobinTemple/Donation.twee -->
<<set $outside to 0>><<set $location to 'temple'>><<temple_effects>><<effects>><<npc Robin>><<person1>>
<<lanSwitch
  'An initiate carries the collection plate along the benches. Robin checks <<his>> pocket and looks at you. The temple also needs linen and food for the people it shelters.'
  '一名见习者捧着奉献盘走过长椅。罗宾摸了摸口袋，望向你。神殿还需要为收容的人准备布巾和食物。'
>>
<br><br>
<<if $RevelationRobinTemple.donation_day isnot Time.days>>
  <<if $money gte 100>>
    <<templeicon 'altar'>><<lanLink '捐出 £1' 'Revelation Robin Temple Donation Result'>><<set $RevelationRobinTemple.donation_day to Time.days>><<set $RevelationRobinTemple.donation_amount to 100>><<money -100>><</lanLink>><br>
  <</if>>
  <<if $money gte 500>>
    <<templeicon 'altar'>><<lanLink '捐出 £5' 'Revelation Robin Temple Donation Result'>><<set $RevelationRobinTemple.donation_day to Time.days>><<set $RevelationRobinTemple.donation_amount to 500>><<money -500>><</lanLink>><br>
  <</if>>
  <<if $money gte 2500>>
    <<templeicon 'altar'>><<lanLink '捐出 £25' 'Revelation Robin Temple Donation Result'>><<set $RevelationRobinTemple.donation_day to Time.days>><<set $RevelationRobinTemple.donation_amount to 2500>><<money -2500>><</lanLink>><br>
  <</if>>
<</if>>
<<getouticon>><<lanLink '收回手' 'Revelation Robin Temple Prayer'>><</lanLink>><br>

:: Revelation Robin Temple Donation Result
<<set $outside to 0>><<set $location to 'temple'>><<temple_effects>><<effects>><<npc Robin>><<person1>>
<<set _donationAmount to $RevelationRobinTemple.donation_amount>>
<<set $RevelationRobinTemple.donation_amount to 0>>
<<lanSwitch
  'You place your contribution on the plate. The initiate thanks you. Robin looks at the shelves by the door, already working out where the next delivery should go.'
  '你把钱放进奉献盘。见习者向你道谢。罗宾望向门边的架子，已经在想下一批物资该放在哪里。'
>>
<br><br>
<<if _donationAmount gte 2500 and !$soup_kitchen_known>>
  <<set $soup_kitchen_known to 1>>
  <<lanSwitch 'The initiate mentions the soup kitchen on Wolf Street. Its kitchen opens in the evening, and extra hands are welcome.' '见习者提起狼街的施粥所。厨房在晚间开放，很欢迎有人帮忙。'>>
  <br><br><span class='gold'><<lanSwitch 'You learned where to help at the soup kitchen.' '你得知了施粥所的位置。'>></span>
<</if>>
<<if _donationAmount gte 2500>>
  <<grace 3>><<ggrace>>
<<elseif _donationAmount gte 500>>
  <<grace 1>><<ggrace>>
<</if>>
<<if _donationAmount gt 0>><<npcincr Robin love 1>><br><br><<glove>><</if>>
<<templeicon 'altar'>><<lanLink '回到长椅' 'Revelation Robin Temple Prayer'>><</lanLink>><br>
