:: RobinTemple Worship Widgets [widget]
<<widget 'robin-temple-hospital-followup'>>
  <<if $stress lt $stressmax and $exposed lte 0
    and !$robinmissing and $robin.timer.hurt is 0
    and !(maplebirch.get('Robin') and $RobinExpansion?.asylum?.status is 'admitted')>>
    <<switch $RobinTemple.hospital_stage>>
      <<case 'waiting'>>
        <<socialiseicon 'ask'>><<lanLink '回到罗宾陪同的就诊' 'RobinTemple Hospital Arrival'>><</lanLink>><br>
      <<case 'discharged' 'therapy'>>
        <<getouticon>><<lanLink '与罗宾完成出院手续' 'RobinTemple Hospital Home'>><</lanLink>><br>
      <<case 'rescue'>>
        <<socialiseicon 'ask'>><<lanLink '继续与罗宾离开医院' 'RobinTemple Hospital Rescue'>><</lanLink>><br>
      <<case 'vanilla'>>
        <<socialiseicon 'ask'>><<lanLink '继续医院检查' 'RobinTemple Hospital Examination'>><</lanLink>><br>
    <</switch>>
  <</if>>
<</widget>>

<<widget 'robin-temple-hall-link'>>
  <<if _revelationTempleLinks is 'pray' and maplebirch.get('RobinTemple').member
    and $stress lt $stressmax and $exposed lte 0
    and Time.hour gte 11 and Time.hour lt 20
    and getRobinLocation() is 'temple' and !$robinmissing>>
    <<templeicon 'altar'>><<lanLink '和罗宾一起祈祷' 'RobinTemple Prayer'>><</lanLink>><br>
    <br>
  <</if>>
<</widget>>

:: RobinTemple Prayer
<<set $outside to 0>><<set $location to 'temple'>><<temple_effects>><<effects>><<npc Robin>><<person1>>
<<run maplebirch.get('RobinTemple').reviewFaith()>>
<<if $RobinTemple.prayer_event_day isnot Time.days>>
  <!-- 每天只抽取并保存一次偶遇事件，重访长椅不会重新抽取。 -->
  <<set $RobinTemple.prayer_event_day to Time.days>>
  <<set $RobinTemple.prayer_event to random(1, 4)>>
  <<set $RobinTemple.prayer_event_done to false>>
  <<set $RobinTemple.prayer_event_resolved to false>>
<</if>>
<<language>>
  <<option 'EN'>>
    Robin sits at the end of a bench with a closed schoolbook on <<his>> lap. <<He>> moves it aside when you sit down.
  <<option 'CN'>>
    罗宾坐在长椅尽头，膝上放着合起的课本。你坐下时，<<he>>把书挪到一旁。
<</language>>
<br><br>
<<if $RobinTemple.faith_transition isnot ''>>
  <<socialiseicon 'ask'>><<lanLink '听罗宾说说最近的想法' 'RobinTemple Faith Transition'>><</lanLink>><br><br>
<</if>>
<<if !$RobinTemple.prayer_event_done and $RobinTemple.prayer_event lte 4>>
  <<switch $RobinTemple.prayer_event>>
    <<case 1>><<language>>
        <<option 'EN'>>
          A visitor stands by the donation shelves, trying to read a note without disturbing the prayer.
        <<option 'CN'>>
          一名访客站在奉献架旁，正想看清便条上的字，又怕打扰别人祈祷。
      <</language>>
    <<case 2>><<language>>
        <<option 'EN'>>
          A younger initiate lingers in the aisle with a torn work list.
        <<option 'CN'>>
          一名年幼的见习教徒拿着撕破的工作表，在过道里迟迟不走。
      <</language>>
    <<case 3>><<language>>
        <<option 'EN'>>
          A tired visitor sits down at the far end of the bench and puts <<his>> head in <<his>> hands.
        <<option 'CN'>>
          一名疲惫的访客坐在长椅另一头，双手抱住了头。
      <</language>>
    <<case 4>><<language>>
        <<option 'EN'>>
          The side-room door closes. Robin catches the uneasy look on your face.
        <<option 'CN'>>
          侧室的门合上了。罗宾注意到你脸上的不安。
      <</language>>
  <</switch>>
  <br><br>
  <<socialiseicon 'ask'>><<lanLink '和罗宾看看发生了什么' 'RobinTemple Prayer Event'>><</lanLink>><br><br>
<</if>>
<<if $RobinTemple.prayer_day isnot Time.days>>
  <<language>>
    <<option 'EN'>>
      The last visitors are leaving. For once, you have enough quiet to hear your own thoughts.
    <<option 'CN'>>
      最后几名访客正要离开。难得安静下来，你终于听得见自己的念头。
  <</language>>
  <br><br>
  <<templeicon 'altar'>><<lanLink '为需要帮助的人祈祷 (1:00)' 'RobinTemple Prayer Others'>><<pass 60>><</lanLink>><<ggrace>><<ggconviction 'Robin'>><<lstress>><br>
  <<loveicon 'hug'>><<lanLink '和罗宾谈谈心里的疑虑 (0:30)' 'RobinTemple Prayer Doubt'>><<pass 30>><</lanLink>><<glove>><<lstress>><br>
  <<templeicon 'altar'>><<lanLink '留意神殿里的人群 (1:00)' 'RobinTemple Prayer Observe'>><</lanLink>><br>
  <<templeicon 'altar'>><<lanLink '不说出自己的祈祷，安静坐一会儿 (0:30)' 'RobinTemple Prayer Quiet'>><</lanLink>><<ggrace>><<lstress>><br>
  <<if $daily.templePray isnot 1 and ['penis_small', 'penis_big', 'breasts_small', 'breasts_big', 'pregnancy'].some(insecurityExists)>>
    <<socialiseicon 'ask'>><<lanLink '谈谈别人对你身体的嘲笑' 'RobinTemple Prayer Insecurity'>><</lanLink>><br>
  <</if>>
<<else>>
  <<language>>
    <<option 'EN'>>
      You have already prayed together today. Robin rests <<his>> hand near yours, leaving the silence undisturbed.
    <<option 'CN'>>
      今天你们已经一起祈祷过。罗宾把手放在你手边，没有打破这份安静。
  <</language>>
  <br><br>
<</if>>
<<if $stress gte $stressmax * 0.8 and $stress lt $stressmax
  and $RobinTemple.rest_day isnot Time.days>>
  <<loveicon 'hug'>><<lanLink '告诉罗宾你快撑不住了 (0:30)' 'RobinTemple Rest'>><</lanLink>><<glove>><<lstress>><br>
<</if>>
<<skinicon 'give'>><<lanLink '给罗宾带来的食物' 'RobinTemple Gifts List'>><</lanLink>><br>
<<if Time.hour lt 19 and $RobinTemple.walk_day isnot Time.days>>
  <<loveicon 'hug'>><<lanLink '问罗宾要不要一起走走' 'RobinTemple Walk'>><</lanLink>><br>
<</if>>
<<if $temple_spear_mission is 1 and !$spear_vessel and !$RobinTemple.spear_seen and $robinromance is 1>>
  <<socialiseicon 'ask'>><<lanLink '问罗宾取矛任务的事' 'RobinTemple Spear'>><</lanLink>><br>
<</if>>
<<if $temple_spear_mission gte 2 and $RobinTemple.spear_seen and !$RobinTemple.spear_return_seen>>
  <<socialiseicon 'ask'>><<lanLink '把取矛的经过告诉罗宾' 'RobinTemple Spear Return'>><</lanLink>><br>
<</if>>
<<if $RobinTemple.donation_day isnot Time.days>>
  <<templeicon 'altar'>><<lanLink '和罗宾一起为神殿捐赠' 'RobinTemple Donation'>><</lanLink>><br>
<</if>>
<<if $RobinTemple.transformation_day isnot Time.days>>
  <<set $RobinTemple.transformation_count to 0>>
<</if>>
<<if $RobinTemple.transformation_count lt 3 and C.npc.Robin.love gte 10>>
  <<set _robinForms to maplebirch.get('RobinTemple').forms>>
  <<if _robinForms.includes('fox')>>
    <<tficon 'fox'>><<lanLink '让罗宾靠在你的尾巴上 (0:10)' 'RobinTemple Transformation'>><<set $RobinTemple.transformation_kind to 'fox'>><<pass 10>><</lanLink>><br>
  <</if>>
  <<if _robinForms.includes('wolf')>>
    <<tficon 'wolf'>><<lanLink '用头轻碰罗宾 (0:10)' 'RobinTemple Transformation'>><<set $RobinTemple.transformation_kind to 'wolf'>><<pass 10>><</lanLink>><br>
  <</if>>
  <<if _robinForms.includes('cat')>>
    <<tficon 'cat'>><<lanLink '挨着罗宾坐下 (0:10)' 'RobinTemple Transformation'>><<set $RobinTemple.transformation_kind to 'cat'>><<pass 10>><</lanLink>><br>
  <</if>>
  <<if _robinForms.includes('bird')>>
    <<birdicon 'sing'>><<lanLink '为罗宾唱歌 (0:10)' 'RobinTemple Transformation'>><<set $RobinTemple.transformation_kind to 'bird'>><<pass 10>><</lanLink>><br>
  <</if>>
  <<if _robinForms.includes('cow')>>
    <<tficon 'cow'>><<lanLink '用角轻碰罗宾 (0:10)' 'RobinTemple Transformation'>><<set $RobinTemple.transformation_kind to 'cow'>><<pass 10>><</lanLink>><br>
  <</if>>
  <<if _robinForms.includes('horse')>>
    <<= maplebirch.get('MoreTransformations').Horse.icon>><<lanLink ['Let Robin brush your tail (0:10)', '让罗宾梳理你的尾巴 (0:10)'] 'RobinTemple Transformation'>><<set $RobinTemple.transformation_kind to 'horse'>><<pass 10>><</lanLink>><br>
  <</if>>
  <<if _robinForms.includes('fish')>>
    <<= maplebirch.get('MoreTransformations').Fish.icon>><<lanLink ['Show Robin your fins (0:10)', '让罗宾看看你的耳鳍 (0:10)'] 'RobinTemple Transformation'>><<set $RobinTemple.transformation_kind to 'fish'>><<pass 10>><</lanLink>><br>
  <</if>>
<</if>>
<br>
<<getouticon>><<lanLink '返回神殿大厅' 'Temple'>><</lanLink>><br>

:: RobinTemple Prayer Others
<<set $outside to 0>><<set $location to 'temple'>><<temple_effects>><<effects>><<npc Robin>><<person1>>
<<if $RobinTemple.prayer_day isnot Time.days>>
  <<set $RobinTemple.prayer_day to Time.days>>
  <<if C.npc.Robin.trauma gte 40>>
    <<language>>
      <<option 'EN'>>
        You pray for the people who will need help tomorrow. Robin listens, then quietly adds the names of the children at the orphanage. <<He>> does not say more, and you leave <<him>> time.
      <<option 'CN'>>
        你为明天需要帮助的人祈祷。罗宾听着，随后轻声添上孤儿院孩子们的名字。<<He>>没有再说什么，你也没有催促。
    <</language>>
  <<elseif C.npc.Robin.doubt gte 20>>
    <<language>>
      <<option 'EN'>>
        You pray for the people who will need help tomorrow, and for a future where things might be better. Robin keeps <<his>> hands together. "I still want that," <<he>> says. "Even when I don't know what I'm doing here." You stay beside <<him>> rather than answering for <<him>>.
      <<option 'CN'>>
        你为明天需要帮助的人祈祷，也盼着日子能变好。罗宾双手相扣。“我还是希望能这样，”<<he>>说，“哪怕有时候，我不知道自己为什么留在这里。”你陪在<<him>>身旁，没有替<<him>>作答。
    <</language>>
  <<else>>
    <<language>>
      <<option 'EN'>>
        You pray for the people who will come through the temple doors tomorrow. Robin mentions the children at the orphanage under <<his>> breath.
      <<option 'CN'>>
        你为明天会走进神殿的人祈祷。罗宾低声念起孤儿院孩子们的名字。
    <</language>>
  <</if>>
  <br><br>
  <<language>>
    <<option 'EN'>>
      When the hour has passed, <<he>> says there are supplies to carry before the doors close. You both rise from the bench.
    <<option 'CN'>>
      一个小时过去，<<he>>说关门前还有物资要搬。你们一起从长椅上站起来。
  <</language>>
  <<set maplebirch.get('RobinTemple').faith += 3>><<ggconviction 'Robin'>>
  <<grace 2>><<stress -4>><<ggrace>><<lstress>>
<<else>>
  <<language>>
    <<option 'EN'>>
      You have already prayed together today.
    <<option 'CN'>>
      今天你们已经一起祈祷过。
  <</language>>
<</if>>
<br><br>
<<templeicon 'altar'>><<lanLink '回到长椅' 'RobinTemple Prayer'>><</lanLink>><br>

:: RobinTemple Prayer Doubt
<<set $outside to 0>><<set $location to 'temple'>><<temple_effects>><<effects>><<npc Robin>><<person1>>
<<if $RobinTemple.prayer_day isnot Time.days>>
  <<set $RobinTemple.prayer_day to Time.days>>
  <<if C.npc.Robin.trauma gte 40>>
    <<language>>
      <<option 'EN'>>
        You tell Robin what has been troubling you. <<He>> listens with <<his>> hands tucked into <<his>> sleeves. "I don't know what to say," <<he>> admits. "But I can stay."
      <<option 'CN'>>
        你把心里的烦恼告诉罗宾。<<He>>把手藏在袖口里，安静地听着。“我不知道该说什么，”<<he>>承认，“不过我可以陪着你。”
    <</language>>
  <<else>>
    <<language>>
      <<option 'EN'>>
        You tell Robin what has been troubling you. <<He>> listens, then admits that <<he>> has wondered about some of the same things. You try to put your questions into words together.
      <<option 'CN'>>
        你把心里的烦恼告诉罗宾。<<He>>听完，承认自己也想过其中一些问题。你们一起试着把疑问说清楚。
    <</language>>
  <</if>>
  <br><br>
  <<language>>
    <<option 'EN'>>
      "We can ask Jordan too," <<he>> says, "if we need to." The two of you stay until the hall begins to empty.
    <<option 'CN'>>
      “如果需要，也能去问约旦。”<<he>>说。你们一直坐到大厅里的人渐渐散去。
  <</language>>
  <<npcincr Robin love 1>><<stress -5>><<glove>><<lstress>>
<<else>>
  <<language>>
    <<option 'EN'>>
      You have already talked today.
    <<option 'CN'>>
      今天你们已经谈过了。
  <</language>>
<</if>>
<br><br>
<<templeicon 'altar'>><<lanLink '回到长椅' 'RobinTemple Prayer'>><</lanLink>><br>

:: RobinTemple Rest
<<set $outside to 0>><<set $location to 'temple'>><<temple_effects>><<effects>><<npc Robin>><<person1>>
<<if $RobinTemple.rest_day isnot Time.days
  and $stress gte $stressmax * 0.8 and $stress lt $stressmax>>
  <<language>>
    <<option 'EN'>>
      You tell Robin the hall feels too crowded. Before you can say more, the sound of the prayers fades. Robin catches your arm and helps you to an empty bunk in the quarters.
    <<option 'CN'>>
      你告诉罗宾，大厅里的人声让你喘不过气。还没等你说完，祈祷声就渐渐远了。罗宾扶住你的手臂，带你到宿舍里一张空床旁坐下。
  <</language>>
  <br><br>
  <<language>>
    <<option 'EN'>>
      Robin brings water and stays nearby while you rest. "I thought you were going to fall," <<he>> says. "Tell me sooner next time. I can leave the work list for a while."
    <<option 'CN'>>
      罗宾端来水，守在旁边等你缓过来。“我以为你要倒下了，”<<he>>说，“下次早点告诉我。工作表可以暂时放着。”
  <</language>>
  <<set $RobinTemple.rest_day to Time.days>><<pass 30>>
  <<run $robinSeen.pushUnique('templeRescue')>>
  <<stress -12>><<npcincr Robin love 1>><<lstress>><<glove>>
<<else>>
  <<language>>
    <<option 'EN'>>
      Robin has already helped you rest today, or you no longer need to leave the hall.
    <<option 'CN'>>
      罗宾今天已经陪你休息过，或是你已经不必离开大厅缓一缓。
  <</language>><br><br>
<</if>>
<<if $RobinTemple.rest_day is Time.days and $RobinTemple.hospital_day isnot Time.days
  and $RobinTemple.hospital_stage is ''>>
  <<socialiseicon 'ask'>><<lanLink '请罗宾陪你去医院检查 (0:30)' 'RobinTemple Hospital Arrival'>><</lanLink>><br>
<</if>>
<<bedicon>><<lanLink '在罗宾床边再坐一会儿' 'RobinTemple Bunk'>><</lanLink>><br>
<<getouticon>><<lanLink '返回大厅' 'Temple'>><</lanLink>><br>

:: RobinTemple Prayer Quiet
<<set $outside to 0>><<set $location to 'temple'>><<temple_effects>><<effects>><<npc Robin>><<person1>>
<<if $RobinTemple.prayer_day isnot Time.days>>
  <<set $RobinTemple.prayer_day to Time.days>><<pass 30>>
  <<language>>
    <<option 'EN'>>
      You decide to keep your prayer to yourself. Robin looks concerned, but does not press you. <<He>> sets <<his>> schoolbook aside and stays on the bench with you until you are ready to leave.
    <<option 'CN'>>
      你决定不说出自己的祈祷。罗宾有些担心，却没有追问。<<He>>把课本放到一旁，陪你坐在长椅上，等你愿意起身。
  <</language>>
<<else>>
  <<language>>
    <<option 'EN'>>
      You have already spent time together in prayer today.
    <<option 'CN'>>
      今天你们已经一起祈祷过了。
  <</language>>
<</if>>
<br><br>
<<templeicon 'altar'>><<lanLink '回到长椅' 'RobinTemple Prayer'>><</lanLink>><br>

:: RobinTemple Prayer Observe
<<set $outside to 0>><<set $location to 'temple'>><<temple_effects>><<effects>><<npc Robin>><<person1>>
<<if $RobinTemple.prayer_day isnot Time.days>>
  <<set $RobinTemple.prayer_day to Time.days>><<pass 60>>
  <<language>>
    <<option 'EN'>>
      You open one eye and watch the hall. Visitors kneel along the benches while attendants move quietly between the side rooms, passing messages. Robin notices you counting the people who come and go.
    <<option 'CN'>>
      你睁开一只眼，打量大厅。访客跪在长椅旁，侍从轻手轻脚地往返侧室，相互传递消息。罗宾注意到你在数进进出出的人。
  <</language>>
  <br><br>
  <<if $awareness gte 400>>
    <<language>>
      <<option 'EN'>>
        Your gaze rises to the shadowed ceiling. For an instant, the darkness above seems to open into an abyss. Fear runs through you, and you cannot keep looking.
      <<option 'CN'>>
        你的视线移向阴影笼罩的天花板。一瞬间，上方的黑暗仿佛裂成深渊。恐惧传遍全身，你无法再看下去。
    <</language>>
    <<trauma 6>><<stress 6>><<gtrauma>><<gstress>><br><br>
  <</if>>
  <<if C.npc.Robin.trauma gte 40>>
    <<language>>
      <<option 'EN'>>
        Robin follows your glance, then looks down at <<his>> hands. You stop watching the doors and sit quietly beside <<him>>.
      <<option 'CN'>>
        罗宾顺着你的目光看过去，又低头看着自己的手。你不再盯着那些门，安静地陪<<him>>坐着。
    <</language>>
  <<elseif C.npc.Robin.doubt gte 20>>
    <<language>>
      <<option 'EN'>>
        Robin has been watching the side-room doors too. "What are they doing in there?" <<he>> whispers. Neither of you has an answer. You agree that guessing will not help, and leave the question for Jordan.
      <<option 'CN'>>
        罗宾也在看侧室的门。“他们在里面做什么？”<<he>>低声问。你们谁也答不上来。胡乱猜测没有用，你们决定把问题留给约旦。
    <</language>>
  <<else>>
    <<language>>
      <<option 'EN'>>
        Robin takes a deep breath. "I don't know," <<he>> says when you ask about the rooms. "We could ask Jordan." <<He>> waits while you gather your thoughts.
      <<option 'CN'>>
        罗宾深吸了一口气。你问起那些房间，<<he>>说：“我不知道。可以问问约旦。”<<He>>等着你整理思绪。
    <</language>>
  <</if>>
<<else>>
  <<language>>
    <<option 'EN'>>
      You have already spent time together in prayer today.
    <<option 'CN'>>
      今天你们已经一起祈祷过了。
  <</language>>
<</if>>
<br><br>
<<templeicon 'altar'>><<lanLink '回到长椅' 'RobinTemple Prayer'>><</lanLink>><br>

:: RobinTemple Faith Transition
<<set $outside to 0>><<set $location to 'temple'>><<temple_effects>><<effects>><<npc Robin>><<person1>>
<<if $RobinTemple.faith_transition isnot '' and getRobinLocation() is 'temple'
  and !$robinmissing and $robin.timer.hurt is 0 and C.npc.Robin.trauma lt 80>>
  <<if C.npc.Robin.trauma gte 40>>
    <<if $RobinTemple.faith_transition is 'belief'>>
      <<language>>
        <<option 'EN'>>
          Robin keeps looking down at the prayer book. "Praying still helps," <<he>> says quietly. <<He>> hesitates before looking at you. "Could we sit here a little longer?"
        <<option 'CN'>>
          罗宾一直低头看着祈祷书。“祈祷还是有用的，”<<he>>小声说。过了一会儿，<<he>>才抬眼看你。“我们能再坐一会儿吗？”
      <</language>>
    <<else>>
      <<language>>
        <<option 'EN'>>
          Robin rubs the edge of a page between <<his>> fingers. "I thought coming here would make things better," <<he>> says. "Did I do something wrong?" You wait beside <<him>> while <<he>> tries to find the rest of the words.
        <<option 'CN'>>
          罗宾用手指揉着书页边缘。“我以为来这里会好一点，”<<he>>说，“是不是我哪里做得不对？”你陪在<<him>>身边，等<<he>>慢慢把话说完。
      <</language>>
    <</if>>
  <<elseif $RobinTemple.faith_transition is 'belief'>>
    <<language>>
      <<option 'EN'>>
        Robin rests <<his>> hands on the closed prayer book. "I kept thinking about why I came here," <<he>> says. "At first it was because you asked. But the people I've helped… I don't want to stop helping them." <<He>> looks toward the hall. "I think I'd come back even if you couldn't come with me."
      <<option 'CN'>>
        罗宾把双手放在合起的祈祷书上。“我一直在想，自己为什么来这里，”<<he>>说，“起初是因为你邀请我。可是那些我帮过的人……我不想就这样不管了。”<<He>>望向大厅。“我想，就算你有事不能陪我，我也会回来。”
    <</language>>
  <<else>>
    <<language>>
      <<option 'EN'>>
        Robin looks toward the side-room doors. "I don't understand everything that happens here," <<he>> says. "Some of it worries me." <<He>> pauses. "I still want to help people. I just don't want to pretend I'm sure about the rest."
      <<option 'CN'>>
        罗宾看向侧室的门。“这里有些事，我还是不明白，”<<he>>说，“有些让我担心。”<<He>>停了停。“我还是想帮人。只是其他那些事，我不想装作自己毫无疑问。”
    <</language>>
  <</if>>
  <br><br>
  <<if C.npc.Robin.trauma gte 40>>
    <<language>>
      <<option 'EN'>>
        Robin falls quiet. You give <<him>> time rather than asking for another answer. When <<he>> is ready, you walk back to the bench together.
      <<option 'CN'>>
        罗宾安静下来。你没有继续追问，而是给<<him>>一些时间。等<<he>>准备好，你们再一起回到长椅旁。
    <</language>>
  <<elseif C.npc.Robin.dom lte 50>>
    <<language>>
      <<option 'EN'>>
        "I'm glad I told you," Robin says quietly. You thank <<him>> for speaking honestly, without asking <<him>> to agree with you.
      <<option 'CN'>>
        “能告诉你，我很高兴。”罗宾小声说。你谢谢<<him>>愿意说实话，没有要求<<him>>与你想得一样。
    <</language>>
  <<else>>
    <<language>>
      <<option 'EN'>>
        Robin asks what you think too. You each have time to answer before returning to the bench.
      <<option 'CN'>>
        罗宾也问起你的想法。你们各自把话说完，才回到长椅旁。
    <</language>>
  <</if>>
  <<set $RobinTemple.faith_transition to ''>>
<<else>>
  <<language>>
    <<option 'EN'>>
      There is no unfinished conversation to return to now.
    <<option 'CN'>>
      现在没有尚未说完的这次谈话。
  <</language>>
<</if>>
<br><br>
<<templeicon 'altar'>><<lanLink '回到长椅' 'RobinTemple Prayer'>><</lanLink>><br>

:: RobinTemple Hospital Arrival
<<set $outside to 0>><<set $location to 'hospital'>><<effects>><<npc Robin>><<person1>>
<<if $RobinTemple.rest_day is Time.days and $RobinTemple.hospital_day isnot Time.days
  and $RobinTemple.hospital_stage is ''>>
  <<set $RobinTemple.hospital_day to Time.days>>
  <<set $RobinTemple.hospital_stage to 'waiting'>>
  <<set $RobinTemple.hospital_support to C.npc.Sydney.init is 1
    and C.npc.Sirris.init is 1 and ($sydneyromance is 1 or C.npc.Sydney.love gte 40)>>
  <<pass 30>>
<</if>>
<<if $RobinTemple.hospital_stage is 'waiting'>>
  <<language>>
    <<option 'EN'>>
      Robin accompanies you to the hospital and tells the nurse how you became unsteady in the temple. <<He>> stays beside the bed while you answer the rest yourself. Doctor Harper arrives with a clipboard and asks to examine you.
    <<option 'CN'>>
      罗宾陪你来到医院，告诉护士你在神殿里站不稳的经过。剩下的问题由你自己回答，<<he>>守在床边。哈珀医生拿着写字板走来，提出为你检查。
  <</language>>
  <br><br>
  <<if $RobinTemple.hospital_support>>
    <<language>>
      <<option 'EN'>>
        Robin helps you contact Sydney. Sydney agrees to ask Sirris for a lift and meet you at the hospital.
      <<option 'CN'>>
        罗宾帮你联系悉尼。悉尼答应请西里斯开车，来医院接你。
    <</language>><br><br>
  <</if>>
  <<socialiseicon 'ask'>><<lanLink '接受检查' 'RobinTemple Hospital Examination'>><</lanLink>><br>
  <<getouticon>><<lanLink '暂时不作决定' 'Hospital front'>><</lanLink>><br>
<<else>>
  <<language>>
    <<option 'EN'>>
      This visit has already been settled, or there is no visit arranged.
    <<option 'CN'>>
      这次就诊已经处理过，或是你尚未安排这次就诊。
  <</language>><br><br>
  <<getouticon>><<lanLink '返回医院前厅' 'Hospital front'>><</lanLink>><br>
<</if>>

:: RobinTemple Hospital Bed
<<language>>
  <<option 'EN'>>
    <<set $outside to 0>><<set $location to "hospital">><<effects>>
    <<set $hunger to 0>><<set $thirst to 0>><<set $tiredness to 0>><<set $hygiene to 0>>
    <<set $stress -= 2000>>

    You awaken in a bed at the civic hospital. You see Robin on the same bed, asleep. You're still holding each other.
    <<generate1>><<person1>>
    "About time." It's a nurse. "The doctor tried to separate you two, but even unconscious you wouldn't let go." <<He>> points to Robin. "Eventually <<nnpc_he "Robin">> stirred and asked us not to take you away. Then <<nnpc_he "Robin">> held on tighter and fell asleep again. Once we'd checked you both, we let you rest together."

    The nurse explains that you have suffered a severe stress response, but you are both otherwise physically healthy. <<He>> asks you to wait a moment while <<he>> fetches the doctor.
    <br><br>
    <<endevent>>

    You don't have to wait long.

    <<npc "Harper" 1>><<person1>><<npc "Robin" 2>><<person2>>
    <<if !$harperSeen.includes("hospital")>>
      A <<person1>><<personsimple>> wearing a white medical coat and carrying a clipboard enters.
      <br><br>

      <<if $harperSeen.includes("livestock")>>
        It's the doctor from the farm. The one who experimented on you. <<He>> smiles at you. "Hello, I'm Doctor Harper," <<he>> says. There's no recognition on <<his>> face. <<He>> takes a seat by your bedside.
      <<elseif $harperSeen.includes("party")>>
        It's the doctor from Avery's party. The one with the pink powder. <<He>> smiles at you. "Hello, I'm Doctor Harper," <<he>> says. <<He>> dons an innocent smile. <<He>> takes a seat by your bedside.
      <<else>>
        <<He>> smiles at you. "Hello, I'm Doctor Harper." <<He>> takes a seat by your bedside and pulls <<his>> blond fringe away from <<his>> eyes. <<He>> looks young for a doctor, can't be older than 25.
      <</if>>

      <<set $harperSeen.pushUnique("hospital")>>
    <<else>>
      Doctor Harper enters, carrying <<person1>><<his>> usual clipboard. <<He>> assures you that there is no immediate concern, but <<he>> would like to examine you further.
    <</if>>
    <br><br>

    <<link [[Next|RobinTemple Hospital Examination]]>><</link>>
    <br>
  <<option 'CN'>>
    <<set $outside to 0>><<set $location to "hospital">><<effects>>
    <<set $hunger to 0>><<set $thirst to 0>><<set $tiredness to 0>><<set $hygiene to 0>>
    <<set $stress -= 2000>>

    你在医院的床上醒来。罗宾就在你的身旁，你们还紧紧相拥着。
    <<generate1>><<person1>>
    “终于醒了。”一个护士说。“医生试图分开你们两个，但即使在昏迷时，你们也不肯松手。”<<He>>指着罗宾。“后来<<nnpc_he "Robin">>迷迷糊糊地醒了一下，求我们别把你带走，抱得更紧了，随后又睡了过去。确认你们都没有大碍后，我们就让你们一起休息了。”

    护士说你们似乎是因为压力导致的昏厥，但身体并无大碍。<<He>>让你们先候着，等自己去喊医生来。
    <br><br>
    <<endevent>>

    你不用等很久。

    <<npc "Harper" 1>><<person1>><<npc "Robin" 2>><<person2>>
    <<if !$harperSeen.includes("hospital")>>
      一个穿着白大褂、拿着写字板的<<person1>><<personsimple>>走了进来。
      <br><br>

      <<if $harperSeen.includes("livestock")>>
        是农场那个医生。那个在你身上做实验的人。<<He>>朝你微笑。“你好，我是哈珀医生。”<<he>>说。<<his>>的脸上看不出任何认出你的表情。<<He>>在你的床边坐下。
      <<elseif $harperSeen.includes("party")>>
        是艾弗里宴会上的那个医生。那个带着粉色粉末的人。<<He>>对你笑了笑。“你好，我是哈珀医生。”<<He>>露出一脸无辜的笑容，拿着一个写字板在你的床边坐下。
      <<else>>
        <<He>>对你微微一笑。“你好，我是哈珀医生。”<<He>>在你床边坐下，将<<his>>金色的刘海从眼前拨开。<<He>>看起来比一般医生年轻许多，应该不超过25岁。
      <</if>>

      <<set $harperSeen.pushUnique("hospital")>>
    <<else>>
      哈珀医生走了进来，手里拿着<<person1>><<his>>常用的写字板。<<He>>向你保证目前没有紧急情况，但希望能对你做进一步检查。
    <</if>>
    <br><br>

    <<link [[继续|RobinTemple Hospital Examination]]>><</link>>
    <br>
<</language>>

:: RobinTemple Hospital Examination
<<set $outside to 0>><<set $location to 'hospital'>><<effects>><<npc Robin>><<person1>>
<<if $RobinTemple.hospital_stage is 'waiting'>>
  <<set $hospitalintro to 1>>
  <<run $harperSeen.pushUnique('hospital')>>
  <<language>>
    <<option 'EN'>>
      Harper asks about home, school and how you have been feeling. Robin listens from the chair beside you. <<He>> leaves the questions for you to answer, but asks the doctor to explain what will happen next.
    <<option 'CN'>>
      哈珀问起你的家庭、学校和近来的状态。罗宾坐在旁边听着，把回答的机会留给你，却也请医生说清接下来要做什么。
  <</language>>
  <br><br>
  <<if $trauma lte $traumamax * 0.2>>
    <<set $RobinTemple.hospital_stage to 'discharged'>>
    <<wash>>
  <<elseif $trauma lt $traumamax * 0.9>>
    <<set $RobinTemple.hospital_stage to 'therapy'>>
    <<set $harper_appointments.enabled to true>><<unset $schoolPsych>>
    <<wash>>
  <<elseif $RobinTemple.hospital_support>>
    <<set $RobinTemple.hospital_stage to 'rescue'>>
    <<language>>
      <<option 'EN'>>
        Harper calls a nurse over. Robin asks you whether you want to leave, but your answer will not come. When the nurse tries to separate you, Robin holds on to you. A cloth is pressed to your face. The room blurs, and the voices in the corridor grow distant.
      <<option 'CN'>>
        哈珀叫来护士。罗宾问你要不要离开，你却说不出话。护士试着将你们分开，罗宾却紧紧拉住你。一块布贴上你的脸，房间渐渐模糊，走廊里的声音也远了。
    <</language>><br><br>
  <<else>>
    <!-- 没有悉尼与西里斯的接应条件时，沿用原版高创伤就医后果。 -->
    <<set $RobinTemple.hospital_stage to 'vanilla'>>
    <<language>>
      <<option 'EN'>>
        Harper calls a nurse over. Robin asks what the doctor intends to do. The nurse asks <<him>> to wait outside while the examination continues.
      <<option 'CN'>>
        哈珀叫来护士。罗宾问医生打算做什么，护士请<<him>>先到外面等候，让检查继续。
    <</language>><br><br>
  <</if>>
<</if>>
<<if ['discharged', 'therapy'].includes($RobinTemple.hospital_stage)>>
  <<if $RobinTemple.hospital_stage is 'therapy'>>
    <<language>>
      <<option 'EN'>>
        <span class='gold'>Harper asks you to return on Fridays for therapy.</span> Robin waits while you check the arrangements, then helps you gather your things.
      <<option 'CN'>>
        <span class='gold'>哈珀请你星期五回来接受治疗。</span>罗宾等你确认安排，随后帮你收好东西。
    <</language>>
  <<else>>
    <<language>>
      <<option 'EN'>>
        Harper says you may leave, but should take care if this happens again. Robin helps you gather your things.
      <<option 'CN'>>
        哈珀说你可以离开，下次再出现这种情况要多加小心。罗宾帮你收好东西。
    <</language>>
  <</if>><br><br>
  <<getouticon>><<lanLink '和罗宾离开医院 (0:10)' 'RobinTemple Hospital Home'>><<pass 10>><</lanLink>><br>
<<elseif $RobinTemple.hospital_stage is 'rescue'>>
  <<getouticon>><<lanLink '继续' 'RobinTemple Hospital Rescue'>><</lanLink>><br>
<<elseif $RobinTemple.hospital_stage is 'vanilla'>>
  <<socialiseicon 'ask'>><<lanLink '继续' 'Hospital Bed Examination'>><<set $RobinTemple.hospital_stage to ''>><<npc Harper 1>><<person1>><</lanLink>><br>
<<elseif $RobinTemple.hospital_stage isnot ''>>
  <<getouticon>><<lanLink '返回医院前厅' 'Hospital front'>><</lanLink>><br>
<</if>>

:: RobinTemple Hospital Rescue
<<set $outside to 0>><<set $location to 'hospital'>><<effects>><<npc Robin>><<person1>>
<<if $RobinTemple.hospital_stage is 'rescue' and $RobinTemple.hospital_support>>
  <<set $RobinTemple.hospital_stage to 'discharged'>><<pass 60>>
  <<language>>
    <<option 'EN'>>
      You become aware of Robin beside you, then Sydney's voice. Sirris has brought the car round. They have dealt with the hospital staff while Robin stayed with you. "We're leaving together," Robin says, checking that you can stand before helping you to the door.
    <<option 'CN'>>
      你先察觉到罗宾在身旁，随后听见悉尼的声音。西里斯已经把车开到门口。他们与医院的人交涉时，罗宾一直陪着你。“我们一起走。”罗宾说，确认你站得稳，才扶你来到门边。
  <</language>>
  <br><br>
  <<language>>
    <<option 'EN'>>
      Sydney warns you to be careful around Harper. Robin listens, then asks Sirris to take you home.
    <<option 'CN'>>
      悉尼提醒你小心哈珀。罗宾听完，请西里斯送你回家。
  <</language>>
  <br><br>
<</if>>
<<if $RobinTemple.hospital_stage is 'discharged'>>
  <<getouticon>><<lanLink '一起离开' 'RobinTemple Hospital Home'>><</lanLink>><br>
<<else>>
  <<getouticon>><<lanLink '返回医院前厅' 'Hospital front'>><</lanLink>><br>
<</if>>

:: RobinTemple Hospital Home
<<set $outside to 0>><<set $location to 'hospital'>><<effects>><<npc Robin>><<person1>>
<<if ['discharged', 'therapy'].includes($RobinTemple.hospital_stage)>>
  <<if $RobinTemple.hospital_support>>
    <<run $sydneySeen.pushUnique('ride')>>
    <<language>>
      <<option 'EN'>>
        Sirris waits while everyone fastens their seat belts. You give directions to where you and Robin live now. Sydney sits beside you; Robin checks once more that you have everything before the car sets off.
      <<option 'CN'>>
        西里斯等大家系好安全带。你说清自己和罗宾现在住在哪里。悉尼坐在你旁边，汽车出发前，罗宾又确认了一遍，你有没有落下东西。
    <</language>>
  <<else>>
    <<language>>
      <<option 'EN'>>
        Robin walks out with you. "Tell me if you need to stop," <<he>> says. You take the journey home slowly.
      <<option 'CN'>>
        罗宾陪你走出医院。“想歇一歇就告诉我。”<<he>>说。回家的路上，你们走得很慢。
    <</language>>
  <</if>>
  <<set $RobinTemple.hospital_stage to ''>>
  <br><br>
  <<robin-temple-return-home 10>>
<<else>>
  <<getouticon>><<lanLink '返回医院前厅' 'Hospital front'>><</lanLink>><br>
<</if>>

:: RobinTemple Prayer Insecurity
<<set $outside to 0>><<set $location to 'temple'>><<temple_effects>><<effects>><<npc Robin>><<person1>>
<<if $RobinTemple.prayer_day isnot Time.days and $daily.templePray isnot 1>>
  <<language>>
    <<option 'EN'>>
      Robin waits while you decide what you want to tell <<him>>. You do not have to explain everything.
    <<option 'CN'>>
      罗宾等着你决定想说什么。你不必把所有事都解释清楚。
  <</language>><br><br>
  <<if insecurityExists('penis_small')>>
    <<socialiseicon 'ask'>><<lanLink '说起被嘲笑尺寸太小的困扰' 'RobinTemple Prayer Acceptance'>><<set $phase to 4>><</lanLink>><br>
  <</if>>
  <<if insecurityExists('penis_big')>>
    <<socialiseicon 'ask'>><<lanLink '说起被嘲笑尺寸太大的困扰' 'RobinTemple Prayer Acceptance'>><<set $phase to 6>><</lanLink>><br>
  <</if>>
  <<if insecurityExists('breasts_small')>>
    <<socialiseicon 'ask'>><<lanLink '说起别人对你胸部偏小的评价' 'RobinTemple Prayer Acceptance'>><<set $phase to 7>><</lanLink>><br>
  <</if>>
  <<if insecurityExists('breasts_big')>>
    <<socialiseicon 'ask'>><<lanLink '说起别人对你胸部偏大的评价' 'RobinTemple Prayer Acceptance'>><<set $phase to 9>><</lanLink>><br>
  <</if>>
  <<if insecurityExists('pregnancy')>>
    <<socialiseicon 'ask'>><<lanLink '说起对孕期外形的困扰' 'RobinTemple Prayer Acceptance'>><<set $phase to 10>><</lanLink>><br>
  <</if>>
<<else>>
  <<language>>
    <<option 'EN'>>
      You have already talked or prayed about this today.
    <<option 'CN'>>
      今天你已经谈过或为这件事祈祷过了。
  <</language>><br><br>
<</if>>
<<templeicon 'altar'>><<lanLink '先不说，回到长椅' 'RobinTemple Prayer'>><</lanLink>><br>

:: RobinTemple Prayer Acceptance
<<set $outside to 0>><<set $location to 'temple'>><<temple_effects>><<effects>><<npc Robin>><<person1>>
<<set _robinConcern to ({4: 'penis_small', 6: 'penis_big', 7: 'breasts_small', 9: 'breasts_big', 10: 'pregnancy'})[$phase]>>
<<if $RobinTemple.prayer_day isnot Time.days and $daily.templePray isnot 1
  and _robinConcern and insecurityExists(_robinConcern)>>
  <<set $RobinTemple.prayer_day to Time.days>><<set $daily.templePray to 1>>
  <<pass 60>>
  <!-- 沿用原版身体接纳祈祷的纯洁分档，并且只在这一次结算，正文分支不再重复加。 -->
  <<set _robinPrayerBand to Math.max(1, Math.min(7, Math.floor($purity * 7 / 1000)))>>
  <<set _robinAcceptanceGain to 6 + _robinPrayerBand * 2>>
  <<set _robinPrayerStress to [12, 12, 10, 8, 7, 6, 5, 5][_robinPrayerBand]>>
  <<acceptance _robinConcern _robinAcceptanceGain>><<stress _robinPrayerStress>>
  <<language>>
    <<option 'EN'>>
      You spend an hour in prayer before telling Robin how the remarks have stayed with you. Saying them aloud is difficult. <<He>> listens without repeating them back as though they were true.
    <<option 'CN'>>
      你祈祷了一个小时，才向罗宾说起那些评价怎样一直留在心里。把它们说出口并不容易。<<He>>认真听着，没有把那些话当成事实再说一遍。
  <</language>><br><br>
  <<if _robinConcern is 'pregnancy'>>
    <<if getActivePregnancies('pc').some(pregnancy => pregnancy.donor is 'Robin')>>
      <<language>>
        <<option 'EN'>>
          "It's our child," Robin says, then pauses. "I don't want you to feel you have to handle everyone else's remarks alone. Tell me what would help."
        <<option 'CN'>>
          “那是我们的孩子，”罗宾说，又停了停，“我不想让你一个人应付那些闲话。告诉我，怎样能帮到你。”
      <</language>>
    <<else>>
      <<language>>
        <<option 'EN'>>
          "You shouldn't have to explain yourself to everyone," Robin says. "I can listen, if you want." <<He>> leaves you to decide how much to say.
        <<option 'CN'>>
          “你不必向每个人解释自己，”罗宾说，“想说的话，我可以听着。”<<He>>让你自己决定要说多少。
      <</language>>
    <</if>>
  <<else>>
    <<if C.npc.Robin.trauma gte 40 or C.npc.Robin.dom lte 50>>
      <<language>>
        <<option 'EN'>>
          "I don't always know what to say when people are cruel," Robin admits. "But I don't think they get to decide what you're worth." <<He>> waits beside you while you collect your thoughts.
        <<option 'CN'>>
          “别人说难听的话时，我也不总知道该怎么回答，”罗宾承认，“不过，我觉得他们没有资格决定你值不值得被喜欢。”<<He>>陪在你身旁，等你理清思绪。
      <</language>>
    <<else>>
      <<language>>
        <<option 'EN'>>
          "Those remarks don't tell me who you are," Robin says. "I've seen how you treat people. That matters to me." <<He>> asks whether you would rather talk or just sit together.
        <<option 'CN'>>
          “那些评价说明不了你是怎样的人，”罗宾说，“我见过你怎样对待别人。那才是我在意的。”<<He>>问你，是想再说说，还是只一起坐一会儿。
      <</language>>
    <</if>>
  <</if>>
  <br><br><<gacceptance>><<gstress>>
<<else>>
  <<language>>
    <<option 'EN'>>
      This conversation has already ended, or the concern no longer applies.
    <<option 'CN'>>
      这次谈话已经结束，或是你已不再有这方面的困扰。
  <</language>>
<</if>>
<br><br>
<<templeicon 'altar'>><<lanLink '回到长椅' 'RobinTemple Prayer'>><</lanLink>><br>
