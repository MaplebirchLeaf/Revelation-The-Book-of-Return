:: RobinTemple Daylight Widgets [widget]
<<widget 'secret-day-check'>>
  <<silently>>
    <<set $_secretMinutes to _args[0] ?? 0>>
    <<set _secretDayReady to false>>
    <<if maplebirch.get('RobinTemple') and $RobinTemple.dual_promise
        and $RobinTemple.secret.stage is 'complete' and Time.days gt $RobinTemple.secret.night
        and ['none', 'meal', 'records'].includes($RobinTemple.secret.followup)
        and $location is 'temple' and !$combat and !$possessed and !$nextPassageCheck
        and !$replayScene and !$statFreeze and !isPregnancyEnding()
        and $exposed lte 0 and $stress lt $stressmax
        and !$RobinTemple.punish and $daily.sydney.punish isnot 1
        and $temple_chastity_timer gt 0 and $RobinTemple.chastity_timer gt 0
        and C.npc.Robin.love gte 60 and C.npc.Sydney.love gte 60>>
      <<sydneySchedule>>
      <<robin-temple-prayer-time `Math.max(1, $_secretMinutes)`>>
      <<set _secretDayReady to _robinPrayerTime and C.npc.Sydney.init is 1
        and C.npc.Sydney.state is 'active' and _sydney_location is 'temple'
        and !['sleep', 'mass', 'anguish'].includes($sydney_templeWork)
        and Time.hour gte 13 and Time.hour * 60 + Time.minute + $_secretMinutes lt 17 * 60>>
    <</if>>
  <</silently>>
<</widget>>

<<widget 'secret-day-link'>>
  <<if _revelationTempleLinks is 'pray'>>
    <<secret-day-check 0>>
    <<if _secretDayReady>>
      <<socialiseicon 'ask'>>
      <<lanLink ['Talk about the night at the lake', '谈起湖边异象'] 'RobinTemple Daylight'>><</lanLink>>
      <br>
    <</if>>
  <</if>>
<</widget>>

<<widget 'secret-day-action' 'container'>>
  <<set $_dayBody to _contents>>
  <<set $_dayMinutes to _args[1]>>
  <<set $_dayTarget to _args[2]>>
  <<set $_dayStep to $RobinTemple.secret.followup>>
  <<set $_dayUsed to false>>
  <<secret-day-check $_dayMinutes>>
  <<if !_secretDayReady>><<exit>><</if>>
  <<capture $_dayBody $_dayMinutes $_dayTarget $_dayStep $_dayUsed>>
    <<lanLink _args[0] $_dayTarget>>
      <<secret-day-check $_dayMinutes>>
      <<if !$_dayUsed and _secretDayReady and $RobinTemple.secret.followup is $_dayStep>>
        <<set $_dayUsed to true>>
        <<set $_daySource to $passage>>
        <<pass $_dayMinutes>>
        <<secret-day-check 0>>
        <<if _secretDayReady and $passage is $_daySource>>
          <<print $_dayBody>>
        <</if>>
      <</if>>
    <</lanLink>>
  <</capture>>
<</widget>>

<<widget 'secret-day-place'>>
  <<set $outside to 0>>
  <<set $location to 'temple'>>
  <<temple_effects>>
  <<effects>>
  <<npc Robin 1>>
  <<npc Sydney 2>>
  <<person1>>
<</widget>>

<<widget 'secret-day-back'>>
  <<getouticon>>
  <<lanLink ['Return to the hall', '回到大厅'] 'Temple'>><</lanLink>>
  <br>
<</widget>>

<<widget 'secret-day-robin-echo'>>
  <<if !$RobinTemple.dual_promise or $RobinTemple.secret.stage isnot 'complete'
      or $RobinTemple.secret.followup isnot 'complete'
      or !['listen', 'hold', 'leave'].includes($RobinTemple.secret.followup_choice)
      or !maplebirch.get('RobinTemple').available or getRobinLocation() isnot 'temple'
      or $location isnot 'temple'>>
    <<exit>>
  <</if>>
  <!-- 回想的是共同经历，不重新触发异象，也不把悉尼带到罗宾的床铺。 -->
  <<language>>
    <<option 'EN'>>
      <<switch $RobinTemple.secret.followup_choice>>
        <<case 'listen'>>Robin remembers the voice repeating the crossed-out word. "If it calls again, we check with each other first. Like we wrote down."
        <<case 'hold'>>Robin glances towards the aisle, keeping the way back to the hall clear. "Next time, don't wait until we're all the way down the passage before you follow."
        <<case 'leave'>>"We didn't have to open that door," Robin says. "I've been thinking about that. We can leave a thing alone."
      <</switch>>
      <<if maplebirch.get('RobinTemple').faith gte 20>> "I still come here to pray," <<nnpc_he 'Robin'>> adds. "I just won't follow something because it knows my name."
      <<elseif maplebirch.get('RobinTemple').faith lte -20>> "I can help people without believing everything I hear here," <<nnpc_he 'Robin'>> adds.
      <</if>>
      <<if C.npc.Robin.trauma gte 40>> <<nnpc_He 'Robin'>> keeps <<nnpc_his 'Robin'>> voice low and watches the people passing nearby. You let the subject rest.
      <<elseif C.npc.Robin.dom gte 50>> "And if I say we should go, I want you to listen," <<nnpc_he 'Robin'>> says, meeting your eyes.
      <<else>> <<nnpc_He 'Robin'>> gives you time to answer, then turns back to the schoolbook.<</if>>
      <<if $robinromance is 1 and C.npc.Robin.love gte 60>> <<nnpc_He 'Robin'>> leaves <<nnpc_his 'Robin'>> hand beside yours.<</if>>
    <<option 'CN'>>
      <<switch $RobinTemple.secret.followup_choice>>
        <<case 'listen'>>罗宾还记得，那道声音重复了被划掉的词。“下次再叫，就先问问彼此。我们写下来过的。”
        <<case 'hold'>>罗宾朝过道看了一眼，没有挡住回大厅的路。“下次，不用等我们都走那么远了，你才跟上。”
        <<case 'leave'>>“那扇门，我们也没必要打开。”罗宾说，“有些东西，放着不管也可以。”
      <</switch>>
      <<if maplebirch.get('RobinTemple').faith gte 20>>“我还是会来祈祷，”<<nnpc_he 'Robin'>>又说，“可也不能因为谁叫得出我的名字，就跟着走。”
      <<elseif maplebirch.get('RobinTemple').faith lte -20>>“我能帮别人，也不用把这里听到的每句话都当真。”<<nnpc_he 'Robin'>>又说。
      <</if>>
      <<if C.npc.Robin.trauma gte 40>><<nnpc_He 'Robin'>>声音很低，仍留意着附近经过的人。你没有接着往下问。
      <<elseif C.npc.Robin.dom gte 50>>“还有，我说该走了的时候，你也得听进去。”<<nnpc_he 'Robin'>>望着你的眼睛说。
      <<else>><<nnpc_He 'Robin'>>等你说完，才重新看向课本。<</if>>
      <<if $robinromance is 1 and C.npc.Robin.love gte 60>><<nnpc_He 'Robin'>>把手留在你的手边。<</if>>
  <</language>>
  <br><br>
<</widget>>

:: RobinTemple Daylight
<<secret-day-place>>
<<secret-day-check 0>>
<<if !_secretDayReady>>
  <<lanSwitch 'The long table is busy. Your conversation can wait until all three of you are free.' '长桌旁有人忙着。等三个人都有空，再谈这件事。'>>
  <br><br>
  <<secret-day-back>>
  <<exit>>
<</if>>
<<language>>
  <<option 'EN'>>
    Robin has saved you a seat at the end of the table. Sydney arrives carrying the notebook from your trip to the lake and puts it between you without opening it.
    <br><br>
    <<if $RobinTemple.secret.followup is 'none'>>
      "You said we'd eat together," Robin says. <<if maplebirch.get('RobinTemple').secret.cornered>>Sydney watches you. "You said we couldn't leave that night. What did you actually know?"<<else>>Sydney pulls a third chair over. "I remember being promised a place too."<</if>>
    <<elseif $RobinTemple.secret.followup is 'meal'>>
      "We're all clear-headed now. I want to compare what we remember of that night," Sydney says, tapping the notebook. Robin has brought a clean page to write down the events again.
    <<else>>
      The copy lies between three empty cups. There is a wet mark beneath one, although the cups have been dry for some time.
    <</if>>
  <<option 'CN'>>
    罗宾在长桌尽头给你留了一个座位。悉尼带来湖边那晚用过的笔记，放在你们中间，没有翻开。
    <br><br>
    <<if $RobinTemple.secret.followup is 'none'>>
      “你说过，要一起吃饭。”罗宾说。<<if maplebirch.get('RobinTemple').secret.cornered>>悉尼看着你。“那晚你说我们走不了。你当时究竟知道什么？”<<else>>悉尼拉来第三张椅子。“我记得，也答应给我留位置了。”<</if>>
    <<elseif $RobinTemple.secret.followup is 'meal'>>
      “现在大家都清醒了，我想核对一下那晚的事。”悉尼轻敲笔记。罗宾也带了张干净纸，准备重新写下记得的经过。
    <<else>>
      誊好的记录放在三只空杯子中间。有只杯子下面留下湿痕，可杯子已经干了好一会儿。
    <</if>>
<</language>>
<br><br>
<<if $RobinTemple.secret.followup is 'none'>>
  <<secret-day-check 30>>
  <<if _secretDayReady>>
  <<socialiseicon>>
  <<secret-day-action `['Share bread and tea, and answer their questions (0:30)', '一起吃面包喝茶，回答两人的问题 (0:30)']` 30 'RobinTemple Daylight Meal'>>
    <<set $RobinTemple.secret.followup to 'meal'>>
    <<stress -8>>
    <<tiredness -20>>
    <<npcincr Robin love 1>>
    <<npcincr Sydney love 1>>
  <</secret-day-action>>
  <<lstress>><<ltiredness>><<glove 'Robin'>><<glove 'Sydney'>>
  <br>
  <</if>>
<<elseif $RobinTemple.secret.followup is 'meal'>>
  <<secret-day-check 30>>
  <<if _secretDayReady>>
  <<historyicon>>
  <<secret-day-action `['Compare the three accounts (0:30)', '核对三个人的记录 (0:30)']` 30 'RobinTemple Daylight Records'>>
    <<set $RobinTemple.secret.followup to 'records'>>
    <<historyskill 2>>
    <<willpower 1>>
  <</secret-day-action>>
  <<ghistory>><<gwillpower>>
  <br>
  <</if>>
<<else>>
  <<socialiseicon 'ask'>>
  <<lanLink ['Ask both to stay to identify sound', '共同辨认声音'] 'RobinTemple Daylight Echo'>><</lanLink>>
  <br>
<</if>>
<<refuseicon>>
<<lanLink ['Stop investigating that night', '放弃调查异象'] 'Temple'>>
  <<secret-day-check 0>>
  <<if _secretDayReady>>
    <<set $RobinTemple.secret.followup to 'declined'>>
  <</if>>
<</lanLink>>
<br><br>
<<secret-day-back>>

:: RobinTemple Daylight Meal
<<secret-day-place>>
<<language>>
  <<option 'EN'>>
    Robin breaks the bread and gives you the larger piece. Sydney notices and shares half of <<nnpc_his 'Sydney'>> own with you too. The notebook stays closed while you begin to eat.
    <br><br>
    <<if maplebirch.get('RobinTemple').secret.cornered>>
      You admit that the way out was open. Robin puts the bread down. "Then when I say I want to leave, we leave." Sydney waits until you answer, then opens the notebook to a blank page. "Write that first."
    <<elseif maplebirch.get('RobinTemple').secret.rushed>>
      "I did mean it when I agreed," Robin tells you. "But now I wish we'd waited a few more days." Sydney notes the date of your first investigation. "Then we'll write that down too. Next time, we find out more before we act."
    <<else>>
      Robin asks whether you are free tomorrow, and Sydney tells you about <<nnpc_his 'Sydney'>> library shift. You drink your tea and work out when you can next meet.
    <</if>>
  <<option 'CN'>>
    罗宾掰开面包，把大些的一块递给你。悉尼看见了，也分了一半给你。你们先吃了几口，没有急着打开笔记。
    <br><br>
    <<if maplebirch.get('RobinTemple').secret.cornered>>
      你承认，那时归路仍然通着。罗宾放下面包。“以后，我说想离开，就离开。”悉尼等你答复，才翻到空白页。“先写这一句。”
    <<elseif maplebirch.get('RobinTemple').secret.rushed>>
      “那晚我确实答应了。”罗宾告诉你，“可我现在想想，还是觉得应该多等几天。”悉尼记下你们初次调查的日期。“那就把这件事也记上。下次先查清楚，再动手。”
    <<else>>
      罗宾问你明天有没有空，悉尼也说起图书馆的值班时间。你们一边喝茶，一边商量下次什么时候能见面。
    <</if>>
<</language>>
<br><br>
<<socialiseicon>>
<<lanLink ['Look at the notebook together', '一起看看笔记'] 'RobinTemple Daylight'>><</lanLink>>
<br>
<<secret-day-back>>

:: RobinTemple Daylight Records
<<secret-day-place>>
<<language>>
  <<option 'EN'>>
    Sydney reads the old notes aloud, then copies the events you can confirm onto a clean page. You remember water at one point, while Robin remembers footsteps, so you record both accounts. On the next page, the same name appears twice in different handwriting. You look at one another. None of you remembers writing it a second time.
    <br><br>
    "No following a voice on your own," Robin says. Sydney closes the old notebook and keeps the copy. "If we hear it, we ask one another first."
  <<option 'CN'>>
    悉尼逐句读出旧笔记，再把你们确认过的经过抄到新纸上。有一处你记得听见了水声，罗宾却说是脚步声，你们暂时都记下来。翻到下一页，同一个名字竟用两种笔迹写了两遍。三个人互相看了看，谁也不记得第二遍是谁写的。
    <br><br>
    “谁都别自己跟着声音走。”罗宾说。悉尼合上旧本，留下副本。“听见了，就先问身边的人。”
<</language>>
<br><br>
<<socialiseicon 'ask'>>
<<lanLink ['Listen together before leaving', '离开前，一起听听'] 'RobinTemple Daylight Echo'>><</lanLink>>
<br>
<<secret-day-back>>

:: RobinTemple Daylight Echo
<<secret-day-place>>
<<secret-day-check 0>>
<<if !_secretDayReady or $RobinTemple.secret.followup isnot 'records'>>
  <<secret-day-back>>
  <<exit>>
<</if>>
<<language>>
  <<option 'EN'>>
    You carry the notes into the short passage leading back to the hall. A voice calls your name from behind a closed door beside you. You turn to Robin and Sydney. Both are standing with you, and neither has spoken.
    "Don't go over there," Robin says, catching your sleeve and pointing back towards the hall. Sydney checks the fresh copy and listens again. "It's repeating what was said that night, but one word is wrong." Neither wants to open the door. They wait for you to decide whether to listen here or return to the hall.
  <<option 'CN'>>
    你们拿着笔记，走到通往大厅的短廊。旁边一扇关着的门后，突然传来叫你名字的声音。你转头看去，罗宾和悉尼都在你身边，谁也没有开口。
    “别过去。”罗宾拉住你的衣袖，指了指回大厅的路。悉尼拿起刚抄好的记录，又听了一遍。“它在重复那晚说过的话，可有一个词不对。”两人都不愿开门，等着你决定是留在原地听清楚，还是先回大厅。
<</language>>
<br><br>
<<set _dayListen to currentSkillValue('history') gte 400 or currentSkillValue('english') gte 500>>
<<set _dayHold to currentSkillValue('willpower') gte 600 or currentSkillValue('physique') gte 5000>>
<<secret-day-check 10>>
<<set _dayLong to _secretDayReady>>
<<if _dayLong and _dayListen>>
  <<historyicon>>
  <<secret-day-action `['Compare the voice with the written account (0:10)', '对照记录，辨认声音 (0:10)']` 10 'RobinTemple Daylight End'>>
    <<set $RobinTemple.secret.followup to 'complete', $RobinTemple.secret.followup_choice to 'listen'>>
    <<historyskill 1>>
    <<stress -6>>
    <<willpower 2>>
  <</secret-day-action>>
  <<ghistory>><<gwillpower>><<lstress>>
  <br>
<</if>>
<<if _dayLong and _dayHold>>
  <<icon 'physique.png'>>
  <<secret-day-action `['Hold the door shut while Robin and Sydney return to the hall (0:10)', '抵住门，让罗宾和悉尼先退回大厅 (0:10)']` 10 'RobinTemple Daylight End'>>
    <<set $RobinTemple.secret.followup to 'complete', $RobinTemple.secret.followup_choice to 'hold'>>
    <<tiredness 5>>
    <<willpower 2>>
    <<stress -4>>
  <</secret-day-action>>
  <<gtiredness>><<gwillpower>><<lstress>>
  <br>
<</if>>
<<secret-day-check 5>>
<<if _secretDayReady>>
<<getouticon>>
<<secret-day-action `['Follow Robin and Sydney back to the busy hall (0:05)', '跟罗宾、悉尼回到热闹的大厅 (0:05)']` 5 'RobinTemple Daylight End'>>
  <<set $RobinTemple.secret.followup to 'complete', $RobinTemple.secret.followup_choice to 'leave'>>
  <<stress 2>>
<</secret-day-action>>
<<gstress>>
<br>
<<else>>
  <<secret-day-back>>
<</if>>

:: RobinTemple Daylight End
<<secret-day-place>>
<<if $RobinTemple.secret.followup isnot 'complete'
    or !['listen', 'hold', 'leave'].includes($RobinTemple.secret.followup_choice)>>
  <<secret-day-back>>
  <<exit>>
<</if>>
<<run statusCheck('Sydney')>>
<<language>>
  <<option 'EN'>>
    <<switch $RobinTemple.secret.followup_choice>>
      <<case 'listen'>>
        You lay the copy beside the closed door. The voice repeats the same line, including the word Sydney crossed out. You read the correction aloud. For a moment, nothing answers. Then the voice begins the old line again. You leave the door shut and take the notes back to the hall.
        <br><br>
        "It isn't answering us," Sydney says, underlining the correction. "That's something we can check if we hear it again. It doesn't tell us who is speaking."
      <<case 'hold'>>
        You plant your feet and keep the door shut while Robin and Sydney move towards the hall. The voice calls again, now from close to the wood. You wait until you can see both companions among the visitors, then let go and follow them. No one comes through behind you.
        <br><br>
        Robin waits where you can see <<nnpc_him 'Robin'>>. Sydney still has all the notes, though one corner is crumpled. "We can look at them somewhere else," <<nnpc_he 'Sydney'>> says.
      <<case 'leave'>>
        You turn away from the door. Robin walks on one side of you, Sydney on the other. The voice calls once more, but the sounds of the hall swallow the rest. None of you goes back to ask it to repeat itself.
        <br><br>
        The notes remain folded on the table. You haven't found out what made the sound. For now, all three of you are here to discuss it.
    <</switch>>
  <<option 'CN'>>
    <<switch $RobinTemple.secret.followup_choice>>
      <<case 'listen'>>
        你把副本摊在关着的门旁。声音重复着同一句话，连悉尼划掉的那个词也没有变。你念出改正后的句子。片刻间，门后没有回应。随后，旧句子又响了起来。你们没有开门，拿着记录回到大厅。
        <br><br>
        “它没有在回答我们。”悉尼在改正的地方划了一道线。“下次再听见，可以核对这一处。但这还说明不了，究竟是谁在说话。”
      <<case 'hold'>>
        你站稳脚步，抵住门，让罗宾和悉尼先往大厅走。那道声音又响了起来，这次就贴在门板后。直到看见两人走到信众中间，你才松手，跟了过去。身后没有人出来。
        <br><br>
        罗宾留在你能看见的地方等你。悉尼仍拿着所有记录，只是纸角被攥皱了。“换个地方，也能看这些。”<<nnpc_he 'Sydney'>>说。
      <<case 'leave'>>
        你转身离开了那扇门。罗宾走在你一侧，悉尼在另一侧。声音又叫了一遍，后面的话很快被大厅的人声盖住。谁也没有折回去，请它再说一次。
        <br><br>
        记录仍折好放在桌上。你们没能查清，是什么发出了声音。不过眼下，三个人都还在这里，可以慢慢商量。
    <</switch>>
<</language>>
<br><br>
<<language>>
  <<option 'EN'>>
    <<if maplebirch.get('RobinTemple').faith gte 20>>
      Robin looks towards the altar. "I'd like to pray before we go."
    <<elseif maplebirch.get('RobinTemple').faith lte -20>>
      Robin looks back at the notes. "Being in the temple doesn't mean we should trust every voice."
    <</if>>
    <<if C.npc.Robin.trauma gte 40>>
      Robin sits facing the busy hall. <<nnpc_He 'Robin'>> startles when a chair scrapes nearby. "Could we stay here a little longer?" <<if $robinromance is 1 and C.npc.Robin.love gte 60>><<nnpc_He 'Robin'>> reaches for your hand.<</if>>
    <<elseif C.npc.Robin.dom gte 50>>
      "Next time we leave together," Robin says. "Nobody goes back on their own." <<nnpc_He 'Robin'>> waits for your answer.
    <<else>>
      "I'm glad we all came back," Robin says quietly. <<nnpc_He 'Robin'>> waits while you find somewhere to put the notes.
    <</if>>
    <br><br>
    <<if _sydneyStatus.includes('pure')>>
      Sydney murmurs a short prayer, then puts the copy beneath the prayer book. "If it calls again, we speak to one another face to face before we go anywhere."
    <<elseif _sydneyStatus.includes('corrupt')>>
      Sydney glances towards the passage. "I still want to know what it is. That doesn't mean I'm going in there alone." <<nnpc_He 'Sydney'>> puts the copy away before looking at you again.
    <<else>>
      Sydney counts the pages. "Let's keep what we heard separate from what we think it means." <<nnpc_He 'Sydney'>> folds the copy carefully, without adding a name for the voice.
    <</if>>
    <<if $sydneyromance is 1 and C.npc.Sydney.love gte 60>> Sydney takes the seat beside you.<<else>> Sydney stays across the table, leaving room for the notes between you.<</if>>
    <<if maplebirch.get('RobinTemple').secret.cornered>><br><br>Robin glances at you. "What I said over the meal still stands." Sydney nods. The way you brought them to the lake has not been forgotten.<</if>>
  <<option 'CN'>>
    <<if maplebirch.get('RobinTemple').faith gte 20>>
      罗宾望向祭坛。“走之前，我想再祈祷一会儿。”
    <<elseif maplebirch.get('RobinTemple').faith lte -20>>
      罗宾又看向记录。“就算在神殿里，也不能听见谁叫，就信了。”
    <</if>>
    <<if C.npc.Robin.trauma gte 40>>
      罗宾面向热闹的大厅坐下。附近有人拖动椅子，<<nnpc_he 'Robin'>>还是惊了一下。“能在这里多待会儿吗？”<<if $robinromance is 1 and C.npc.Robin.love gte 60>><<nnpc_He 'Robin'>>伸手握住你的手。<</if>>
    <<elseif C.npc.Robin.dom gte 50>>
      “下次也一起走。”罗宾说，“谁都不许自己折回去。”<<nnpc_He 'Robin'>>等着你答复。
    <<else>>
      “还好，大家都回来了。”罗宾小声说，等你找地方放好记录。
    <</if>>
    <br><br>
    <<if _sydneyStatus.includes('pure')>>
      悉尼低声念了一句祷词，将副本压在祈祷书下。“下次再听见，我们先当面说清楚，再决定去哪儿。”
    <<elseif _sydneyStatus.includes('corrupt')>>
      悉尼朝短廊看了一眼。“我还是想知道那是什么。可这不代表，我要自己进去找。”<<nnpc_He 'Sydney'>>收好副本，才重新看向你。
    <<else>>
      悉尼数清纸页。“听见的，和猜到的，先分开记。”<<nnpc_He 'Sydney'>>仔细折好副本，没有替那道声音添上名字。
    <</if>>
    <<if $sydneyromance is 1 and C.npc.Sydney.love gte 60>>悉尼在你身旁坐下。<<else>>悉尼留在桌子对面，在你们中间空出放笔记的位置。<</if>>
    <<if maplebirch.get('RobinTemple').secret.cornered>><br><br>罗宾看了你一眼。“吃饭时说的那些话，还是算数的。”悉尼也点点头。你那晚是怎样把两人带到湖边的，谁都没有忘记。<</if>>
<</language>>
<br><br>
<<secret-day-back>>
