:: RobinTemple Vigil Widgets [widget]
<<widget 'robin-temple-vigil-init'>>
  <<set $RobinTemple.vigil_attending to maplebirch.get('RobinTemple').available
    and maplebirch.get('RobinTemple').member
    and $RobinTemple.vigil_result isnot 'passed'
    and ['temple', 'shop', 'orphanage', 'sleep'].includes(getRobinLocation())
    and (!$robinlocationoverride?.during?.includes(Time.hour) or $robinlocationoverride.location is 'temple')>>
  <<set $RobinTemple.vigil_with_robin to false>>
  <<if $RobinTemple.vigil_attending>>
    <<set $RobinTemple.vigil_result to ''>>
    <<set $RobinTemple.vigil_followup to false>>
  <</if>>
<</widget>>

<<widget 'robin-temple-vigil-arrival'>>
  <<if $RobinTemple.vigil_attending>>
    <br><br>
    <<if C.npc.Robin.trauma gte 40>>
      <<language>>
        <<option 'EN'>>
          Robin stands among the initiates. <<nnpc_He 'Robin'>> finds you with <<nnpc_his 'Robin'>> eyes and gives you a small, uncertain smile.
        <<option 'CN'>>
          你在见习教徒中看见罗宾。<<nnpc_He 'Robin'>>望向你，勉强露出一个微笑。
      <</language>>
    <<elseif C.npc.Robin.dom gt 50>>
      <<language>>
        <<option 'EN'>>
          Robin catches your eye and waves. <<nnpc_He 'Robin'>> is smiling, though <<nnpc_his 'Robin'>> hand is trembling.
        <<option 'CN'>>
          罗宾朝你挥了挥手，脸上带着笑，手却有些发抖。
      <</language>>
    <<else>>
      <<language>>
        <<option 'EN'>>
          Robin looks relieved to see you among the initiates. <<nnpc_He 'Robin'>> moves a little closer before the bell rings again.
        <<option 'CN'>>
          看见你也在见习教徒中，罗宾松了口气。第二次钟声响起前，<<nnpc_he 'Robin'>>往你这边挪了挪。
      <</language>>
    <</if>>
  <</if>>
<</widget>>

<<widget 'robin-temple-vigil-cold'>>
  <<if $RobinTemple.vigil_attending>>
    <<language>>
      <<option 'EN'>>
        Robin is shivering nearby. <<nnpc_He 'Robin'>> folds <<nnpc_his 'Robin'>> arms across <<nnpc_his 'Robin'>> chest, trying to hold on to a little warmth.
      <<option 'CN'>>
        罗宾在不远处发着抖。<<nnpc_He 'Robin'>>双臂交叉抱在胸前，想留住一点暖意。
    <</language>>
    <br><br>
  <</if>>
<</widget>>

<<widget 'robin-temple-vigil-group'>><<print lanSwitch($RobinTemple.vigil_attending ? 'The five of you' : 'The four of you', $RobinTemple.vigil_attending ? '你们五人' : '你们四人')>><</widget>>

<<widget 'robin-temple-vigil-carry'>>
  <<language>>
    <<option 'EN'>>
      <<if $RobinTemple.vigil_attending and $phase is 2>>You, Robin and Sydney carry each other forwards.<<elseif $phase is 2>>You and Sydney carry each other forwards.<<else>>You and Robin hold each other up as you move forwards.<</if>>
    <<option 'CN'>>
      <<if $RobinTemple.vigil_attending and $phase is 2>>你、罗宾和悉尼互相搀扶着前进。<<elseif $phase is 2>>你和悉尼互相搀扶着前进。<<else>>你和罗宾互相搀扶着前进。<</if>>
  <</language>>
<</widget>>

<<widget 'robin-temple-vigil-companions'>><<print lanSwitch($RobinTemple.vigil_attending ? ', Sydney, and Robin,' : ', and Sydney,', $RobinTemple.vigil_attending ? '还有悉尼、罗宾' : '还有悉尼')>><</widget>>

<<widget 'robin-temple-vigil-whisper'>>
  <<if $RobinTemple.vigil_attending>>
    <br><br>
    <<language>>
      <<option 'EN'>>
        Robin covers <<nnpc_his 'Robin'>> ears. <<nnpc_He 'Robin'>> looks towards you, wide-eyed, but says nothing.
      <<option 'CN'>>
        罗宾捂住了耳朵，睁大眼睛朝你望来，却没有说话。
    <</language>>
  <</if>>
<</widget>>

<<widget 'robin-temple-vigil-bell'>>
  <<if $RobinTemple.vigil_attending>>
    <<language>>
      <<option 'EN'>>
        Robin flinches at the bell, then looks towards Jordan with the others.
      <<option 'CN'>>
        钟声让罗宾一颤，随后<<nnpc_he 'Robin'>>与其他人一起望向约旦。
    <</language>>
    <br><br>
  <</if>>
<</widget>>

<<widget 'robin-temple-vigil-pyre'>>
  <<if $RobinTemple.vigil_attending>>
    <<language>>
      <<option 'EN'>>
        Robin watches the flames. "It's only a trial," <<nnpc_he 'Robin'>> murmurs. "It's only a trial." <<nnpc_He 'Robin'>> does not look convinced.
      <<option 'CN'>>
        罗宾盯着火焰。“只是试炼，”<<nnpc_he 'Robin'>>小声念着，“只是试炼。”<<nnpc_He 'Robin'>>自己也不太相信。
    <</language>>
    <br><br>
  <</if>>
<</widget>>

<<widget 'robin-temple-vigil-options'>>
  <<if $RobinTemple.vigil_attending and ($robinromance is 1 or C.npc.Robin.love gte 90)>>
    <<if $sydneyromance is 1 or C.npc.Sydney.love gte 90>>
      <<templeicon 'trialcontinue'>><<lanLink ['Take Robin and Sydney by the hand (1:00)', '牵起罗宾与悉尼的手 (1:00)'] 'Temple Vigil 11'>>
        <<set $RobinTemple.vigil_with_robin to true>><<set $phase to 2>>
        <<pain 8>><<if _args[0]>><<stress 8>><</if>>
      <</lanLink>><<gpain>><<if _args[0]>><<gstress>><</if>><<handholdingvirginitywarning>>
      <<NPCvirginitywarning 'Robin' 'handholding'>><<NPCvirginitywarning 'Sydney' 'handholding'>><br>
    <</if>>
    <<templeicon 'trialcontinue'>><<lanLink ['Take Robin by the hand (1:00)', '牵起罗宾的手 (1:00)'] 'Temple Vigil 11'>>
      <<set $RobinTemple.vigil_with_robin to true>><<set $phase to 1>>
      <<pain 8>><<if _args[0]>><<stress 8>><</if>>
    <</lanLink>><<gpain>><<if _args[0]>><<gstress>><</if>><<handholdingvirginitywarning>><<NPCvirginitywarning 'Robin' 'handholding'>><br>
  <</if>>
<</widget>>

<<widget 'robin-temple-vigil-hand'>>
  <<if $RobinTemple.vigil_attending>>
    <!-- 与原版悉尼相同，共同立誓的伴侣在火前会靠过来。 -->
    <<if $RobinTemple.templePromised is 'Robin' or $RobinTemple.vigil_with_robin>>
      <<set $RobinTemple.vigil_with_robin to true>>
      <<canvas-model-override 'arm_right' 'idle'>>
      <<takeHandholdingVirginity 'Robin' 'romantic'>>
      <<language>>
        <<option 'EN'>>
          Robin stumbles towards you. You catch <<nnpc_him 'Robin'>>, taking <<nnpc_his 'Robin'>> hand to steady <<nnpc_him 'Robin'>>. <<nnpc_He 'Robin'>> holds on tightly.
        <<option 'CN'>>
          罗宾跌跌撞撞地走到你身边。你接住<<nnpc_him 'Robin'>>，握着<<nnpc_his 'Robin'>>手，扶<<nnpc_him 'Robin'>>站稳。<<nnpc_He 'Robin'>>紧紧回握住你。
      <</language>>
    <<else>>
      <<language>>
        <<option 'EN'>>
          Robin repeats something under <<nnpc_his 'Robin'>> breath, but the crackle of the flames drowns it out.
        <<option 'CN'>>
          罗宾重复念叨着什么，但被火焰的噼啪声淹没了。
      <</language>>
    <</if>>
    <br><br>
  <</if>>
<</widget>>

<<widget 'robin-temple-vigil-fire-result'>>
  <<if $RobinTemple.vigil_attending>>
    <<if $RobinTemple.vigil_with_robin>>
      <<language>>
        <<option 'EN'>>
          <<if $phase is 2>>You, Robin and Sydney hold each other up as you move forwards.<<else>>You and Robin hold each other up as you move forwards.<</if>>
        <<option 'CN'>>
          <<if $phase is 2>>你、罗宾和悉尼互相搀扶着前进。<<else>>你和罗宾互相搀扶着前进。<</if>>
      <</language>>
    <<else>>
      <<robin-temple-vigil-failed>>
      <<language>>
        <<option 'EN'>>
          Robin falters before the pyre. <<nnpc_He 'Robin'>> reaches towards you once more before an attendant lifts <<nnpc_him 'Robin'>> away.
        <<option 'CN'>>
          罗宾在火堆前踉跄着倒下。侍从将<<nnpc_him 'Robin'>>带走前，<<nnpc_he 'Robin'>>又朝你伸了一次手。
      <</language>>
    <</if>>
    <br><br>
  <</if>>
<</widget>>

<<widget 'robin-temple-vigil-focus'>>
  <<if $RobinTemple.vigil_with_robin>>
    <<if maplebirch.get('RobinTemple').faith gte 20>>
      <<language>>
        <<option 'EN'>>
          You melt away. Your body melds together with Robin's, and you feel Robin's mind reject what you're both seeing.
        <<option 'CN'>>
          你的躯壳融化了，和罗宾的一同融合在一起。你能感觉到，罗宾的意识排斥着你们所看到的一切。
      <</language>>
    <<else>>
      <<language>>
        <<option 'EN'>>
          You melt away. Your body melds together with Robin's, and the two of you share this profane revelation.
        <<option 'CN'>>
          你的躯壳融化了，和罗宾的一同融合在一起。你们共同接受这亵渎般的启示。
      <</language>>
    <</if>>
    <br><br>
  <</if>>
<</widget>>

<<widget 'robin-temple-vigil-yield'>>
  <<if $RobinTemple.vigil_with_robin>>
    <<if maplebirch.get('RobinTemple').faith lte -20>>
      <<language>>
        <<option 'EN'>>
          Yet, there is conflict. You feel Robin's curiosity, as if it were your own, begging you to peer deeper inside, to search for some answer.
        <<option 'CN'>>
          然而，存在某种矛盾。你察觉到了罗宾的求知欲，如同你自己的求知欲般，祈求着更深入的窥探与解答。
      <</language>>
    <<else>>
      <<language>>
        <<option 'EN'>>
          You feel Robin hit the ground, as if you were in <<nnpc_his 'Robin'>> body. As one, you behold glory.
        <<option 'CN'>>
          你感觉到<<nnpc_him 'Robin'>>摔在了地面上，就像你在<<nnpc_his 'Robin'>>身体里一样。融为一体，你们一同凝视这宏伟壮大的美丽。
      <</language>>
    <</if>>
    <br><br>
  <</if>>
<</widget>>

<<widget 'robin-temple-vigil-failed'>>
  <<if $RobinTemple.vigil_attending and $RobinTemple.vigil_result isnot 'passed'>>
    <<set $RobinTemple.vigil_result to 'failed'>>
    <<set $RobinTemple.vigil_attempt_day to Time.days>>
    <<set $RobinTemple.vigil_followup to false>>
  <</if>>
<</widget>>

<<widget 'robin-temple-vigil-failure'>>
  <<if $RobinTemple.vigil_attending>>
    <<robin-temple-vigil-failed>>
    <<language>>
      <<option 'EN'>>
        An attendant brings Robin over. Jordan wraps <<nnpc_him 'Robin'>> in another warm cloth.
      <<option 'CN'>>
        一名侍从带着罗宾过来。约旦用另一块温暖的布料裹住<<nnpc_him 'Robin'>>。
      <</language>>
    <br><br>
  <</if>>
<</widget>>

<<widget 'robin-temple-vigil-success'>>
  <<language>>
    <<option 'EN'>>
      There is no sign of the fire. An unlit pyre lies beneath you; dawn shines above the temple. The bell rings three times. Jordan hurries over and wraps you<<if $phase is 2>> and Sydney<</if>> and Robin in a warm cloth.
    <<option 'CN'>>
      当火焰无迹可寻，仅剩你脚边将熄的余烬时，耀日点亮了神殿之顶，圣洁的黎明驱散了黑夜。三道钟声连鸣。约旦急匆匆地跑来，将钟铃放下。一块温暖的布料盖在你<<if $phase is 2>>、悉尼<</if>>和罗宾身上，遮住了你们的胴体。
  <</language>>
  <<npcincr Jordan love 5>><<gglove 'Jordan'>><br><br>
  <<if $phase is 2>>
    <<language>>
      <<option 'EN'>>
        Sydney is still holding your other hand. Jordan draws the cloth around all three of you. "Normally only one initiate may succeed," <<nnpc_he 'Jordan'>> says. "But you entered the pyre as one. You haven't disobeyed the scripture. Congratulations!"
      <<option 'CN'>>
        悉尼仍握着你的另一只手。约旦把布料拉过来，盖住你们三人。“通常我们仅允许一位见习教徒通过试炼，”<<nnpc_he 'Jordan'>>庆贺道，“但你们如若一体般进入了火堆。这没有违背圣典。祝贺你们！”
    <</language>>
    <br><br>
    <<run statusCheck('Sydney')>>
    <<if _sydneyStatus.includes('corrupt')>>
      <<language>>
        <<option 'EN'>>
          Sydney pushes closer beneath the cloth and squeezes you before hugging you.
        <<option 'CN'>>
          悉尼从布料下拱到你身边，和你贴了贴，然后将你抱住，以此表示感谢。
      <</language>>
    <<else>>
      <<language>>
        <<option 'EN'>>
          Sydney's embarrassment quickly returns, but <<nnpc_he 'Sydney'>> stays close and hugs you.
        <<option 'CN'>>
          悉尼很快又陷入了赤裸的尴尬，但并没有试图离开你，反而感激地抱住了你。
      <</language>>
    <</if>>
    <<language>>
      <<option 'EN'>>
        "I couldn't have done it without you here with me."
      <<option 'CN'>>
        “要是没有你陪着，我肯定做不到的。”
    <</language>>
    <<arousal 10>><<garousal>>
    <<set $sydney.rank to 'monk'>>
    <<run $sydneySeen.pushUnique('initiate')>><<run $sydneySeen.pushUnique('monk')>>
    <<npcincr Sydney love 10>><<gglove 'Sydney'>>
  <<else>>
    <<language>>
      <<option 'EN'>>
        "I knew you'd do it!" Jordan says. "Normally only one initiate may succeed, but you entered the pyre as one. You haven't disobeyed the scripture. Congratulations, both of you." Sydney hurries over and hugs you, stammering words of pride and happiness.
      <<option 'CN'>>
        “我就知道你能做到！”约旦庆贺道，“通常我们仅允许一位见习教徒通过试炼，但你们如若一体般进入了火堆。这没有违背圣典。祝贺你们！”悉尼冲过来抱住你，结结巴巴地吐露着自己的自豪与幸福。
    <</language>>
    <<npcincr Sydney love 5>><<glove 'Sydney'>>
  <</if>>
  <br><br>
  <<if C.npc.Robin.trauma gte 40>>
    <<language>>
      <<option 'EN'>>
        Robin clings to you beneath the cloth. "We made it," <<nnpc_he 'Robin'>> whispers, as if <<nnpc_he 'Robin'>> still cannot believe it.
      <<option 'CN'>>
        罗宾在布料下紧紧抱住你。“我们通过了，”<<nnpc_he 'Robin'>>轻声说，像是仍不敢相信。
    <</language>>
  <<elseif $phase is 2>>
    <<language>>
      <<option 'EN'>>
        Robin hugs you both, smiling through tears. "I couldn't have done it without you," <<nnpc_he 'Robin'>> says, looking between you and Sydney.
      <<option 'CN'>>
        罗宾抱住你们两个，眼里含着泪，脸上却带着笑。“要是没有你们，我肯定做不到的，”<<nnpc_he 'Robin'>>说着，望向你和悉尼。
    <</language>>
  <<else>>
    <<language>>
      <<option 'EN'>>
        Robin hugs you, smiling through tears. "I couldn't have done it without you."
      <<option 'CN'>>
        罗宾抱住你，眼里含着泪，脸上却带着笑。“要是没有你，我肯定做不到的。”
    <</language>>
  <</if>>
  <<npcincr Robin love 10>><<gglove 'Robin'>>
  <<if C.npc.Robin.trauma gt 0>><<npcincr Robin trauma -10>><<llrtrauma>><</if>>
  <<npcincr Robin dom 5>><<gdom 'Robin'>><<stress -20>><<lstress>><br><br>
  <<set $RobinTemple.vigil_result to 'passed'>>
  <<set $RobinTemple.vigil_attempt_day to Time.days>>
  <<set $RobinTemple.vigil_followup to false>>
  <<run $robinSeen.pushUnique('initiate')>><<run $robinSeen.pushUnique('monk')>>
  <!-- 晋升与奖励沿用原版 Temple Vigil 14，不另加信仰奖励或单独面试。 -->
  <<set $grace to 0>><<set $temple_rank to 'monk'>>
  <<set $temple_monk_days to 0>><<set $wardrobes.temple.unlocked to true>>
  <<earnFeat 'Defy the Night'>><<specialClothesUnlock 'set' 'temple_monk_and_nun'>>
  <<if $phase is 2>>
    <<lanLink ['Continue', '继续'] 'Temple Vigil 15 Sydney'>><<clotheson>><<endevent>><</lanLink>><br>
  <<else>>
    <<lanLink ['Continue', '继续'] 'Temple Vigil 15'>><<clotheson>><<endevent>><</lanLink>><br>
  <</if>>
<</widget>>

<<widget 'robin-temple-vigil-result'>>
  <<if $RobinTemple.vigil_attending and !$RobinTemple.vigil_with_robin>>
    <<robin-temple-vigil-failed>>
    <<language>>
      <<option 'EN'>>
        Robin rushes over with the other initiates and hugs you. "You did it!" <<nnpc_he 'Robin'>> says. For the moment, <<nnpc_he 'Robin'>> seems to have forgotten <<nnpc_his 'Robin'>> own failure.
      <<option 'CN'>>
        罗宾与其他见习教徒一起冲过来抱住你。“你做到了！”<<nnpc_he 'Robin'>>说。<<nnpc_He 'Robin'>>似乎并不在意自己的失败，也不在意你的赤裸。
      <</language>>
    <br><br>
  <</if>>
<</widget>>

<<widget 'robin-temple-vigil-return'>>
  <<if $RobinTemple.vigil_attending and $RobinTemple.vigil_result is 'passed'>>
    <<language>>
      <<option 'EN'>>
        Robin follows you into the warm room. <<nnpc_He 'Robin'>> gives you another hug before collecting <<nnpc_his 'Robin'>> clothes.
      <<option 'CN'>>
        罗宾跟着你走进了暖和的房间，在领回自己的衣物前又抱了抱你。
      <</language>>
    <br><br>
  <</if>>
  <<set $RobinTemple.vigil_attending to false>><<set $RobinTemple.vigil_with_robin to false>>
<</widget>>

<<widget 'robin-temple-vigil-reminder'>>
  <<if _revelationTempleLinks is 'pray' and ['monk', 'priest'].includes($temple_rank)
    and (Time.weekDay is 1 and Time.hour gte 20 or Time.weekDay is 2 and Time.hour lt 7)>>
    <<if maplebirch.get('RobinTemple').member
      and $RobinTemple.vigil_result isnot 'passed'
      and !$robinmissing and $robin.timer.hurt is 0 and C.npc.Robin.trauma lt 80
      and getRobinLocation() is 'temple'>>
      <<language>>
        <<option 'EN'>>
          <span class='lblue'>Robin is taking part in tonight's trial of anguish.</span>
        <<option 'CN'>>
          <span class='lblue'>罗宾正在参加今晚的苦难审判。</span>
      <</language>>
      <br>
    <</if>>
    <<if C.npc.Sydney.init is 1 and $sydney.rank is 'initiate'>>
      <<language>>
        <<option 'EN'>>
          <span class='lblue'>Sydney is taking part in tonight's trial of anguish.</span>
        <<option 'CN'>>
          <span class='lblue'>悉尼正在参加今晚的苦难审判。</span>
      <</language>>
      <br>
    <</if>>
  <</if>>
<</widget>>

:: RobinTemple Vigil After
<<set $outside to 0>><<set $location to 'temple'>><<temple_effects>><<effects>><<npc Robin>><<person1>>
<<set $RobinTemple.vigil_followup to true>>
<<if $RobinTemple.vigil_result is 'passed'>>
  <<language>>
    <<option 'EN'>>
      Robin smiles when you mention the vigil. "We really did it," <<he>> says, reaching for your hand.
    <<option 'CN'>>
      提起守夜，罗宾露出笑容，伸手牵住你。“我们真的做到了，”<<he>>说。
  <</language>>
<<elseif $RobinTemple.vigil_result is 'failed'>>
  <<if $temple_rank is 'initiate'>>
    <<language>>
      <<option 'EN'>>
        "I'm sorry about the trial," Robin says with a bitter little smile. "We'll do better next time, won't we?"
      <<option 'CN'>>
        “试炼的事，对不起，”罗宾露出一丝苦涩的微笑，“下次我们会做得更好，对不对？”
    <</language>>
  <<else>>
    <<language>>
      <<option 'EN'>>
        "I didn't make it," Robin says, then smiles at you. "But you did. I'm glad."
      <<option 'CN'>>
        “我没能通过，”罗宾说，随后向你笑了笑，“不过你通过了。我真为你高兴。”
    <</language>>
  <</if>>
<<else>>
  <<language>>
    <<option 'EN'>>
      Robin asks whether you will be at the temple on Sunday evening.
    <<option 'CN'>>
      罗宾问你周日晚上会不会来神殿。
  <</language>>
<</if>>
<br><br>
<<icon 'temple/robin-quarters.png'>><<lanLink ['Return', '返回'] 'RobinTemple Corner'>><</lanLink>><br>
