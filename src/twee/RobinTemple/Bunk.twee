:: RobinTemple Bunk
<<set $outside to 0>><<set $location to 'temple'>><<set $wardrobe_location to 'temple'>>
<<if !maplebirch.get('RobinTemple').bunk>>
  <<getouticon>><<lanLink ['Return to the quarters', '返回神殿宿舍'] 'Temple Quarters'>><</lanLink>><br>
  <<exit>>
<</if>>
<<if setup.clothingLayer.all.some(slot => $store[slot]?.some(item => item.location is 'RobinTemple Bed'))>>
  <<storeon 'RobinTemple Bed'>><<loadTempHairStyle>>
  <<set $wear_outfit to 'none'>>
<</if>>
<<temple_effects>><<effects>><<npc Robin>><<person1>>
<<set _robinHere to $RobinTemple.stage isnot 'none' and !$robinmissing
  and getRobinLocation() is 'temple' and C.npc.Robin.trauma lt 80
  and (Time.weekDay is 7 and Time.hour gte 21 or Time.weekDay is 1 and Time.hour lt 7)>>
<<set _robinAfternoon to maplebirch.get('RobinTemple').member
  and !$robinmissing and getRobinLocation() is 'temple' and C.npc.Robin.trauma lt 80
  and !Time.schoolDay and !Time.isWeekEnd()
  and Time.hour gte 13 and Time.hour lt 16>>
<<language>>
  <<option 'EN'>>
    Robin's bunk stands near the end of a row. A folded blanket lies beneath a schoolbook, and a clean shirt hangs from the bedpost.
  <<option 'CN'>>
    罗宾的床铺靠近这一排的尽头。叠好的毯子上放着一本课本，床柱上挂着干净的衬衫。
<</language>>
<<if maplebirch.get('RobinTemple').residence>>
  <<language>>
    <<option 'EN'>>
      Robin also has a place at your shared home. This bunk remains available when temple duties keep <<him>> here.
    <<option 'CN'>>
      罗宾也在与你同住的家里留有位置。神殿事务需要<<him>>留在这里时，这张床铺仍可使用。
  <</language>>
<</if>>
<br><br>
<<if _robinHere>>
  <<language>>
    <<option 'EN'>>
      After the Saturday shift, Robin stays here until morning. <<He>> shifts aside when you approach, leaving room on the mattress.
    <<option 'CN'>>
      星期六的值班结束后，罗宾会在这里待到天亮。见你走近，<<he>>往旁边挪了挪，在床垫上给你留出位置。
  <</language>>
  <<if $robinromance is 1>>
    <br><br>
    <<loveicon 'hug'>><<lanLink ['Sit with Robin by the bunk (0:15)', '在床边陪罗宾坐会儿 (0:15)'] 'RobinTemple Bunk Talk'>>
      <<robin-temple-bunk-ready>>
      <<if _robinBunkReady>>
        <<pass 15>>
        <<robin-temple-bunk-ready>>
        <<if _robinBunkReady>><<stress -3>><<npcincr Robin love 1>><</if>>
      <</if>>
    <</lanLink>><<lstress>><<glove 'Robin'>><br>
  <</if>>
<<elseif _robinAfternoon>>
  <<language>>
    <<option 'EN'>>
      Robin is finishing the afternoon work list at the long table. The other initiates have gone to their duties. The space around <<his>> bunk is empty.
    <<option 'CN'>>
      罗宾在长桌旁核对下午的工作表。其他见习教徒都去做各自的事了，<<his>>床铺周围没有人。
  <</language>>
  <<if $RobinTemple.templePromised is 'Robin' and $robinromance is 1
    and !$RobinTemple.punish and C.npc.Robin.trauma lt 80
    and $robin.timer.hurt is 0
    and (Time.hour lt 15 or Time.hour is 15 and Time.minute lt 45)>>
    <br><br>
    <<icon 'temple/robin-temple-bed.png'>><<lanLink ['Ask Robin to sit by the bunk (0:10)', '请罗宾到床边坐坐 (0:10)'] 'RobinTemple Bed Afternoon'>><<pass 10>><</lanLink>><br>
  <</if>>
<<elseif getRobinLocation() is 'temple' and !$robinmissing
  and $RobinTemple.vigil_result isnot 'passed'
  and (Time.weekDay is 1 and Time.hour gte 20 or Time.weekDay is 2 and Time.hour lt 7)>>
  <<language>>
    <<option 'EN'>>
      Robin is taking part in the trial of anguish. <<His>> bunk is empty.
    <<option 'CN'>>
      罗宾正在参加苦难审判，床铺空着。
  <</language>>
<<elseif getRobinLocation() is 'temple' and !$robinmissing and C.npc.Robin.trauma lt 80>>
  <<language>>
    <<option 'EN'>>
      Robin is helping elsewhere in the quarters. <<His>> bunk is empty for now.
    <<option 'CN'>>
      罗宾在宿舍别处帮忙，床铺暂时空着。
  <</language>>
<<elseif maplebirch.get('RobinTemple').home>>
  <<language>>
    <<option 'EN'>>
      Robin is at your shared home. The bunk here has been made, ready for another temple shift.
    <<option 'CN'>>
      罗宾现在在与你同住的家里。这里的床铺已经整理好，留待下次值班时使用。
  <</language>>
<<else>>
  <<language>>
    <<option 'EN'>>
      Robin is away. The bed has been made, and the space beside it is quiet.
    <<option 'CN'>>
      罗宾不在。床铺已经整理好，旁边一片安静。
  <</language>>
<</if>>
<br><br>
<<if $earSlime.event and $earSlime.noSleep>>
  <<language>>
    <<option 'EN'>>
      <span class='red'>The slime will not let you sleep yet.</span>
    <<option 'CN'>>
      <span class='red'>史莱姆现在不肯让你睡。</span>
  <</language>><br>
<<else>>
  <<icon 'temple/robin-temple-bed.png'>><<lanLink ['Strip and get under the blanket', '脱衣钻进被窝'] 'RobinTemple Bed'>><<undressSleep 'RobinTemple Bed'>><</lanLink>><br>
  <<if !$earSlime.alwaysSleepNaked or $hypnosis_traits.silence>>
    <<set $storeLocation to 'RobinTemple Bed'>>
    <<wardrobeSelection true>>
    <<for _index, _outfit range $outfit>>
      <<if _outfit.type.includes('sleep')>>
        <<capture _index _outfit>>
          <<icon 'temple/robin-temple-bed.png'>>
          <<set _outfitname to _outfit.name + (_outfit.colors is false ? '' : ' [C]')>>
          <<lanLink `['Wear ' + _outfitname + ' and climb into bed', '穿上' + _outfitname + '并上床']` 'RobinTemple Bed'>>
            <<set $wear_outfit to _index>><<saveTempHairStyle>>
          <</lanLink>><br>
        <</capture>>
      <</if>>
    <</for>>
  <</if>>
<</if>>
<br>
<<if ['monk', 'priest'].includes($temple_rank)>>
  <<bedicon>><<lanLink ['Your bunk', '你的床铺'] 'Temple Bunk'>><</lanLink>><br>
<</if>>
<<wardrobeicon>><<lanLink ['Wardrobe', '衣柜'] 'Temple Wardrobe'>><</lanLink>><br>
<<icon 'mirror.png'>><<lanLink ['Mirror', '镜子'] 'Temple Mirror'>><<preMirror>><<endevent>><</lanLink>><br>
<<if maplebirch.get('RobinTemple').available and getRobinLocation() is 'temple'>>
  <<socialiseicon>><<lanLink ['Talk to Robin', '和罗宾交谈'] 'RobinTemple Corner'>><</lanLink>><br>
<<else>>
  <<socialiseicon 'ask'>><<lanLink ['Ask the attendant where Robin went', '问值班侍从罗宾去了哪里'] 'RobinTemple Whereabouts'>><</lanLink>><br>
<</if>>
<<getouticon>><<lanLink ['Return to the quarters', '返回神殿宿舍'] 'Temple Quarters'>><</lanLink>><br>

:: RobinTemple Bunk Talk
<<set $outside to 0>><<set $location to 'temple'>><<temple_effects>><<effects>><<npc Robin>><<person1>>
<<robin-temple-bunk-ready>>
<<if _robinBunkReady>>
  <<language>>
    <<option 'EN'>>
      <<if C.npc.Robin.trauma gte 40>>Robin holds the schoolbook for a while before closing it and moving closer. When you ask about the day's work, <<he>> only says a little.<<else>>Robin closes the schoolbook and rests against you. <<He>> talks about the day's work, then about a younger initiate who kept asking when morning would come.<</if>>
    <<option 'CN'>>
      <<if C.npc.Robin.trauma gte 40>>罗宾捧着课本，过了一会儿才合上，往你身边挪了挪。你问起今天的工作，<<he>>只说了几句。<<else>>罗宾合上课本，靠在你身边。<<He>>先说起今天的工作，又说起一名总问天什么时候亮的年幼见习教徒。<</if>>
  <</language>>
  <br><br>
  <<language>>
    <<option 'EN'>>
      <<if C.npc.Robin.trauma gte 40>>"Can we just sit here?" <<he>> asks. You stay beside <<him>>.<<else>>"I told them it always does," <<he>> says. <<He>> stays close after the conversation ends.<</if>>
    <<option 'CN'>>
      <<if C.npc.Robin.trauma gte 40>>“就这样坐会儿，可以吗？”<<he>>问。你留在<<him>>身边。<<else>>“我告诉对方，天总会亮的。”<<he>>说。话说完后，<<he>>依旧靠着你。<</if>>
  <</language>>
  <br><br>
  <<secret-day-robin-echo>>
  <<lstress>><<glove 'Robin'>>
<<else>>
  <<language>>
    <<option 'EN'>>
      Robin has already left for the day.
    <<option 'CN'>>
      罗宾已经离开了。
  <</language>>
<</if>>
<br><br>
<<icon 'temple/robin-temple-bed.png'>><<lanLink ['Return to the bunk', '回到床边'] 'RobinTemple Bunk'>><</lanLink>><br>

:: RobinTemple Bed
<<set $outside to 0>><<set $location to 'temple'>><<effects>><<wearoutfit>><<npc Robin>><<person1>>
<<set _robinHere to !$robinmissing and getRobinLocation() is 'temple'
  and C.npc.Robin.trauma lt 80
  and (Time.weekDay is 7 and Time.hour gte 21 or Time.weekDay is 1 and Time.hour lt 7)>>
<<if _robinHere>>
  <<language>>
    <<option 'EN'>>
      You settle beside Robin beneath the blanket. <<He>> waits for you to get comfortable before drawing it over both of you.
    <<option 'CN'>>
      你在毯子下挨着罗宾躺好。<<He>>等你安顿下来，才把毯子拉过你们两人。
  <</language>>
<<else>>
  <<language>>
    <<option 'EN'>>
      Robin's side of the bed is empty. You pull the blanket over yourself while the other initiates settle down.
    <<option 'CN'>>
      罗宾那侧空着。你盖上毯子，听着其他见习教徒渐渐安静下来。
  <</language>>
<</if>>
<br><br>
<<nightmareCheck 'RobinTemple Sleep'>>
<<generateSleepLinks 'RobinTemple Sleep'>>
<<if _robinHere and $robinromance is 1>>
  <<loveicon 'kiss'>><<lanLink ['Kiss Robin under the blanket', '在毯子下吻罗宾'] 'RobinTemple Bed Kiss'>>
    <<robin-temple-bunk-ready>>
    <<if _robinBunkReady>><<takeKissVirginity 'Robin' 'loveInterest'>><<npcincr Robin love 1>><<npcincr Robin lust 1>><</if>>
  <</lanLink>><<kissvirginitywarning>><<NPCvirginitywarning 'Robin' 'kiss'>><br>
  <<loveicon 'hug'>><<lanLink ['Ask Robin to hold you', '请罗宾抱着你'] 'RobinTemple Bed Invite'>><</lanLink>><br>
<</if>>
<br>
<<icon 'temple/robin-temple-bed.png'>><<lanLink ['Get up', '起床'] 'RobinTemple Bunk'>><<storeon 'RobinTemple Bed'>><<loadTempHairStyle>><</lanLink>><br>

:: RobinTemple Bed Kiss
<<set $outside to 0>><<set $location to 'temple'>><<temple_effects>><<effects>><<npc Robin>><<person1>>
<<robin-temple-bunk-ready>>
<<if _robinBunkReady>>
  <<language>>
    <<option 'EN'>>
      You lean in close beneath the rough wool blanket, pressing your lips against Robin's in the dark. The cold air of the temple dormitory fades as <<his>> breath hitches, warm and sweet against your mouth.
      <<if C.npc.Robin.trauma gte 40>>
        Robin returns it with a desperate, trembling softness. When a nearby bunk creaks, <<he>> gasps and freezes, clutching your fingers in a white-knuckled grip, <<his>> racing heart thumping visibly through <<his>> thin tunic until <<he>> realizes nobody woke up.
      <<elseif C.npc.Robin.dom gte 60>>
        Robin pulls you flush against <<his>> chest with a quiet gasp, deepening the kiss as heat pools between your bodies. When a bunk creaks, <<he>> pauses with a low, breathless chuckle, trailing <<his>> lips to your jaw before slowly moving again.
      <<else>>
        Robin returns it softly, melting into your warmth as <<his>> cheeks flush bright red beneath the covers. <<His>> fingers slide into yours, squeezing tightly, shivering with sweet excitement every time your lips part and touch again.
      <</if>>
    <<option 'CN'>>
      你在粗糙的羊毛毯下悄悄凑近，在黑暗中吻上罗宾柔软的双唇。神殿通铺冰冷的空气仿佛瞬间消散，<<his>>呼吸一滞，温热而清甜的气息喷洒在你的唇角。
      <<if C.npc.Robin.trauma gte 40>>
        罗宾带着一丝颤抖而依恋的回应轻轻回吻。旁边的床铺木板突然发出一声微响，<<he>>猛然惊得屏住呼吸僵住，指节泛白地死死攥住你的手，胸腔里剧烈撞击的心跳透过单薄的见习袍清晰可辨，直到确认没有人醒来，才长长地吐出一口热气。
      <<elseif C.npc.Robin.dom gte 60>>
        罗宾发出一声压抑的轻哼，揽住你的后腰将你紧紧按向<<his>>胸膛，反客为主地加深了这个吻，彼此相贴的体温在被窝里迅速升腾。床铺一响，<<he>>才带着低低的喘笑稍稍放缓，唇瓣轻蹭过你的下颌，温热的气息灼烫得令人心尖发颤。
      <<else>>
        罗宾顺从地轻轻回吻，整个人在你的怀抱里融化开来，棉被下的脸颊红得发烫。<<His>>手指慢慢扣进你的指缝，指尖激动得有些轻微发颤，每一次唇瓣的轻触与微启都让彼此的呼吸更乱了几分。
      <</if>>
  <</language>>
  <br><br>
  <<language>>
    <<option 'EN'>>
      A neighbouring initiate turns over. You both wait until the room is quiet again.
    <<option 'CN'>>
      旁边的见习教徒翻了个身。你们等到屋里重新安静下来。
  <</language>>
  <<glove 'Robin'>><<glust 'Robin'>>
<<else>>
  <<language>>
    <<option 'EN'>>
      Robin is not beside you.
    <<option 'CN'>>
      罗宾不在你身边。
  <</language>>
<</if>>
<br><br>
<<icon 'temple/robin-temple-bed.png'>><<lanLink ['Lie back down', '躺回床上'] 'RobinTemple Bed'>><</lanLink>><br>

:: RobinTemple Bed Invite
<<set $outside to 0>><<set $location to 'temple'>><<temple_effects>><<effects>><<npc Robin>><<person1>>
<<robin-temple-bunk-ready>>
<<if _robinBunkReady>>
  <<language>>
    <<option 'EN'>>
      <<if C.npc.Robin.trauma gte 40>>Robin looks at you, then nods. <<He>> takes your hand beneath the blanket. "Just for a while?"<<elseif C.npc.Robin.dom gte 60>>Robin lifts <<his>> arm. "Come here," <<he>> whispers, smiling at you.<<else>>Robin's cheeks turn pink. "I'd like that," <<he>> whispers, lifting <<his>> arm a little.<</if>>
    <<option 'CN'>>
      <<if C.npc.Robin.trauma gte 40>>罗宾看看你，点了点头，在毯子下握住你的手。“就抱一会儿，好吗？”<<elseif C.npc.Robin.dom gte 60>>罗宾抬起手臂，朝你笑了笑。“过来。”<<he>>轻声说。<<else>>罗宾红了脸。“好啊。”<<he>>轻声说，稍稍抬起手臂。<</if>>
  <</language>>
  <br><br>
  <<loveicon 'hug'>><<lanLink ['Cuddle up to Robin', '偎进罗宾怀里'] 'RobinTemple Bed Close'>>
    <<robin-temple-bunk-ready>>
    <<if _robinBunkReady>><<stress -2>><<npcincr Robin love 1>><</if>>
  <</lanLink>><<lstress>><<glove 'Robin'>><br>
  <<icon 'temple/robin-temple-bed.png'>><<lanLink ['Stay where you are', '还是这样躺着'] 'RobinTemple Bed'>><</lanLink>><br>
<<else>>
  <<language>>
    <<option 'EN'>>
      Robin is not here now. You settle back beneath the blanket.
    <<option 'CN'>>
      罗宾现在不在。你重新躺回毯子下。
  <</language>>
  <br><br>
  <<icon 'temple/robin-temple-bed.png'>><<lanLink ['Lie back down', '躺回床上'] 'RobinTemple Bed'>><</lanLink>><br>
<</if>>

:: RobinTemple Bed Close
<<set $outside to 0>><<set $location to 'temple'>><<temple_effects>><<effects>><<npc Robin>><<person1>>
<<robin-temple-bunk-ready>>
<<if _robinBunkReady>>
  <<language>>
    <<option 'EN'>>
      You slide closer beneath the heavy blanket, tucking your head securely against the crook of Robin's neck. The scent of clean soap and temple incense clings to <<his>> skin.
      <<if C.npc.Robin.trauma gte 40>>
        Robin wraps both arms tightly around you, burying <<his>> nose into your hair as another initiate stirs in the dark. As the minutes tick by in quiet safety, you feel the defensive stiffness gradually drain from <<his>> shoulders, <<his>> rapid heartbeat steadying into a slow, soothing rhythm.
      <<else>>
        Robin pulls the wool blanket up over your ears, wrapping <<his>> arms around your back and drawing you into <<his>> warmth. Surrounded by the quiet breathing of the dormitory, the lingering weight in your chest dissolves, and your shoulders fully relax against <<his>> steady heartbeat.
      <</if>>
    <<option 'CN'>>
      你在沉重的毯子下紧紧依偎过去，把头埋进罗宾温暖的颈窝。<<His>>发间散发着神殿熏香与干净皂角的清淡香气。
      <<if C.npc.Robin.trauma gte 40>>
        有其他见习教徒在暗中翻身时，罗宾下意识将双臂收得更紧，把鼻尖埋在你的发丝间。随着时间在静谧与安全中流逝，你清晰地感受到<<he>>肩背处戒备僵硬的肌肉一点点松弛下来，剧烈的心跳也转为平稳舒缓的律动。
      <<else>>
        罗宾将羊毛毯往上拉了拉，严严实实地护住你的耳颈，手臂温柔地环过你的背，将你整个纳入<<his>>融融的暖意里。听着通铺里周围此起彼伏的均匀呼吸声，你胸口压抑的沉闷感缓缓消散，整个人在<<his>>沉稳的心跳声中彻底放松了下来。
      <</if>>
  <</language>>
  <<lstress>><<glove 'Robin'>><br><br>
<<else>>
  <<lanSwitch 'Robin is not beside you now.' '罗宾现在不在你身边。'>><br><br>
<</if>>
<<icon 'temple/robin-temple-bed.png'>><<lanLink ['Go back to sleep', '继续睡觉'] 'RobinTemple Bed'>><</lanLink>><br>

:: RobinTemple Sleep
<<set $outside to 0>><<set $location to 'temple'>>
<<set _requestedHours to $sleephour>>
<<set _robinHere to !$robinmissing and getRobinLocation() is 'temple'
  and C.npc.Robin.trauma lt 80
  and (Time.weekDay is 7 and Time.hour gte 21 or Time.weekDay is 1 and Time.hour lt 7)>>
<<set _nightWake to _robinHere and $robinromance is 1 and _requestedHours gte 3
  and (Time.hour gte 21 or Time.hour lt 3)
  and $RobinTemple.night_day isnot Time.days
  and $nightmares lte 0 and random(1, 6) is 1>>
<<if _nightWake>>
  <!-- 睡前选定并保存场景，避免读档后重新抽取同一次夜醒事件。 -->
  <<set $RobinTemple.night_scene to Weather.precipitation is 'rain' ? 'rain'
    : $RobinTemple.vigil_result is 'passed' and random(1, 3) is 1 ? 'embers'
    : random(1, 3) is 1 ? 'ledger'
    : random(1, 2) is 1 ? 'voice' : 'blanket'>>
  <<set $sleephour to random(1, Math.min(2, _requestedHours - 1))>>
<</if>>
<<set $bedGuest to _robinHere ? 'Robin' : ''>>
<<set _autosavehere to true>><<sleep>>
<<if !_dreaming>>
  <<effects>><<wakingEffects $sleepHoursTotal>>
  <<set _nightWake to _nightWake and !$robinmissing
    and !_wakingEffect and $sleepHoursTotal gte 1
    and (Time.hour gte 22 or Time.hour lt 6)>>
  <<if _nightWake>>
    <<set $RobinTemple.night_day to Time.days>>
    <<set $sleephour to Math.max(1, _requestedHours - $sleepHoursTotal)>>
    <<sleepeffects>>
    <<switch $RobinTemple.night_scene>>
      <<case 'rain'>>
        <<language>>
          <<option 'EN'>>
            Rain taps the high window. Robin is awake beside you, watching the water run down the glass.
          <<option 'CN'>>
            雨点敲着高处的窗。罗宾在你身边醒着，望着水痕顺玻璃流下。
        <</language>>
      <<case 'voice'>>
        <<language>>
          <<option 'EN'>>
            A voice from the next bunk wakes you. Robin has already pulled the fallen blanket back over the younger initiate.
          <<option 'CN'>>
            隔壁床传来的声音惊醒了你。罗宾已经替那名年幼的见习教徒盖好滑落的毯子。
        <</language>>
      <<case 'embers'>>
        <<language>>
          <<option 'EN'>>
            Robin wakes with a start. <<He>> stares at the dark ceiling as if the fire were still there.
          <<option 'CN'>>
            罗宾猛地醒来，盯着黑暗中的天花板，仿佛那堆火还在眼前。
        <</language>>
      <<case 'ledger'>>
        <<language>>
          <<option 'EN'>>
            A page turns beside you. Robin is awake with the business ledger open on <<his>> knees.
          <<option 'CN'>>
            身旁传来翻页声。罗宾还醒着，膝上摊着生意账本。
        <</language>>
      <<default>>
        <<language>>
          <<option 'EN'>>
            You wake when Robin tucks the blanket around your shoulder. <<He>> withdraws <<his>> hand, then notices your eyes are open.
          <<option 'CN'>>
            罗宾替你掖好肩上的毯子时，你醒了。<<He>>收回手，随后发现你正望着<<him>>。
        <</language>>
    <</switch>>
    <br><br>
    <<icon 'temple/robin-temple-bed.png'>><<lanLink ['Open your eyes', '睁开眼'] 'RobinTemple Night Wake'>><</lanLink>><br>
  <<elseif $nightmares gte 1 and $controlled is 0>>
    <<nightmareWake>>
  <<elseif !_wakingEffect>>
    <<language>>
      <<option 'EN'>>
        You sleep beneath the temple's quiet roof.
      <<option 'CN'>>
        你在神殿安静的屋檐下睡了一觉。
    <</language>>
  <</if>>
  <<if !_nightWake>>
    <<sleepeffects>>
    <<set $wardrobe_location to 'temple'>><<wardrobeSelection true>><<radiooutfits>>
    <br><br>
    <<icon 'temple/robin-temple-bed.png'>><<lanLink ['Get up', '起床'] 'RobinTemple Bunk'>><</lanLink>><br>
  <</if>>
  <<set $phase to 0>>
<</if>>

:: RobinTemple Night Wake
<<set $outside to 0>><<set $location to 'temple'>><<temple_effects>><<effects>><<npc Robin>><<person1>>
<<switch $RobinTemple.night_scene>>
  <<case 'rain'>>
    <<language>>
      <<option 'EN'>>
        Robin listens to the rain with you. "The roof at the orphanage leaks in weather like this," <<he>> says. "It's strange to lie still and not fetch a bucket."
      <<option 'CN'>>
        罗宾陪你听雨。“孤儿院的屋顶遇到这种天气会漏水，”<<he>>说，“躺着不去拿水桶，真有点不习惯。”
    <</language>>
  <<case 'voice'>>
    <<language>>
      <<option 'EN'>>
        Robin settles back beside you. "The child was dreaming about home," <<he>> whispers. "Jordan says the first nights can be difficult."
      <<option 'CN'>>
        罗宾重新在你身边躺下。“那孩子梦见家了，”<<he>>低声说，“约旦说，刚来的几晚会很难熬。”
    <</language>>
  <<case 'embers'>>
    <<language>>
      <<option 'EN'>>
        You remind Robin of the route out of the cloister. <<He>> names each door with you. When <<he>> reaches the last one, <<he>> lies back down.
      <<option 'CN'>>
        你陪罗宾回忆离开回廊的路。<<He>>和你一起说出每扇门的位置。数到最后一扇，<<he>>重新躺了下来。
    <</language>>
  <<case 'ledger'>>
    <<language>>
      <<option 'EN'>>
        Robin has been working out what <<he>> can afford for the business next week. You point out that the figures will still be there in the morning. <<He>> closes the book and moves it out of the bed.
      <<option 'CN'>>
        罗宾正算下周还能给生意添些什么。你提醒<<him>>，账本明早也不会跑掉。<<He>>合上本子，把它从床上挪开。
    <</language>>
  <<default>>
    <<language>>
      <<option 'EN'>>
        "I thought you were cold," Robin whispers. <<He>> draws the blanket over both of you and waits for your breathing to slow.
      <<option 'CN'>>
        “我以为你冷，”罗宾轻声说。<<He>>把毯子盖在你们身上，等你的呼吸渐渐平稳。
    <</language>>
<</switch>>
<br><br>
<<loveicon 'hug'>><<lanLink ["Hold Robin's hand", '握住罗宾的手'] 'RobinTemple Night Wake Hand'>>
  <<robin-temple-bunk-ready>>
  <<if _robinBunkReady and $RobinTemple.night_scene isnot '' and $RobinTemple.night_day is Time.days>>
    <<set $phase to 'robin-temple-night-' + $RobinTemple.night_scene>>
    <<set $RobinTemple.night_scene to ''>>
    <<npcincr Robin love 1>><<stress -2>>
  <</if>>
<</lanLink>><<glove 'Robin'>><<lstress>><br>
<<icon 'temple/robin-temple-bed.png'>><<lanLink ['Go back to sleep', '继续睡觉'] 'RobinTemple Sleep'>><</lanLink>><br>
<<getouticon>><<lanLink ['Get up', '起床'] 'RobinTemple Bunk'>><<set $sleephour to 0>><<storeon 'RobinTemple Bed'>><<loadTempHairStyle>><</lanLink>><br>

:: RobinTemple Night Wake Hand
<<set $outside to 0>><<set $location to 'temple'>><<temple_effects>><<effects>><<npc Robin>><<person1>>
<<set _nightHand to typeof $phase is 'string' and $phase.startsWith('robin-temple-night-') ? $phase.slice(19) : ''>>
<<if _nightHand>><<unset $phase>><</if>>
<<if !_nightHand>>
  <<lanSwitch 'You settle back beneath the blanket.' '你重新躺回毯子下。'>><br><br>
  <<icon 'temple/robin-temple-bed.png'>><<lanLink ['Lie back down', '躺回床上'] 'RobinTemple Bed'>><</lanLink>><br>
  <<exit>>
<</if>>
<<if _nightHand is 'embers'>>
  <<language>>
    <<option 'EN'>>
      You find Robin's hand beneath the blanket. <<He>> holds on while you name the familiar sounds of the quarters, one by one.
    <<option 'CN'>>
      你在毯子下握住罗宾的手。你一件件说起宿舍里熟悉的声音，<<he>>一直牵着你。
  <</language>>
<<elseif _nightHand is 'ledger'>>
  <<language>>
    <<option 'EN'>>
      You take Robin's hand away from the closed ledger. <<He>> laughs quietly and settles beside you.
    <<option 'CN'>>
      你把罗宾的手从合上的账本边牵开。<<He>>轻声笑了笑，挨着你躺好。
  <</language>>
<<else>>
  <<language>>
    <<option 'EN'>>
      You find Robin's hand beneath the blanket. <<He>> holds yours until the quarters are quiet again.
    <<option 'CN'>>
      你在毯子下握住罗宾的手。<<He>>一直牵着你，直到宿舍再次安静下来。
  <</language>>
<</if>>
<<glove 'Robin'>><<lstress>><br><br>
<<icon 'temple/robin-temple-bed.png'>><<lanLink ['Go back to sleep', '继续睡觉'] 'RobinTemple Sleep'>><</lanLink>><br>
<<getouticon>><<lanLink ['Get up', '起床'] 'RobinTemple Bunk'>><<set $sleephour to 0>><<storeon 'RobinTemple Bed'>><<loadTempHairStyle>><</lanLink>><br>

:: RobinTemple Bunk Widgets [widget]
<<widget 'robin-temple-bunk-ready'>>
  <<set _robinBunkReady to maplebirch.get('RobinTemple')?.bunk and maplebirch.get('RobinTemple').available
    and C.npc.Robin.state is 'active' and $robinromance is 1 and !$RobinTemple.punish
    and $location is 'temple' and getRobinLocation() is 'temple'
    and (Time.weekDay is 7 and Time.hour gte 21 or Time.weekDay is 1 and Time.hour lt 7)
    and !$combat and !$possessed and !$nextPassage and !$nextPassageCheck and !$eventforced
    and !$replayScene and !$statFreeze>>
<</widget>>
