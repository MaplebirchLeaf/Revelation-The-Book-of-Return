:: RobinTemple Penance Widgets [widget]
<<widget 'robin-temple-punishment-npcs'>>
  <<run statusCheck('Robin')>>
  <<if $RobinTemple.punish.joint>>
    <<run statusCheck('Sydney')>>
    <<npc Robin 1>><<npc Sydney 2>><<generate3>><<generate4>><<generate5>><<person3>>
  <<else>>
    <<npc Robin 1>><<generate3>><<generate4>><<generate5>><<person3>>
  <</if>>
<</widget>>

<<widget 'robin-temple-punishment-exit'>>
  <<templeicon 'altar'>><<lanLink ['Continue', '继续'] 'RobinTemple Penance'>><<endevent>><</lanLink>><br>
<</widget>>

<<widget 'robin-temple-punishment-cleanup'>>
  <<set $worn.face.type.push('broken')>><<faceruined>>
  <<if !($worn.neck.name is 'familiar collar' and $worn.neck.cursed is 1)>>
    <<set $worn.neck.type.push('broken')>><<neckruined>>
  <</if>>
  <<remove_shackle>><<unbindtemp>><<storeon 'duopunish'>><<clotheson>><<endevent>>
<</widget>>

<<widget 'robin-temple-punishment-action'>>
  <<if maplebirch.get('RobinTemple').punishmentChoice(_args[0], _args[1])>>
    <<switch _args[0]>>
      <<case 'hold'>>
        <<set $_pain to _args[1] is 'both' and $RobinTemple.punish.joint ? -6 : -3>>
        <<pain $_pain>>
      <<case 'belt'>>
        <<arousal -2500>>
      <<case 'hit'>>
        <<def 1>><<arousal -3000>><<violence_noncombat 30 0.3>>
      <<case 'plead'>>
        <<sub 1>><<arousal 2000>><<pain -5>>
      <<case 'touch'>>
        <<arousal 1500>>
      <<case 'close'>>
        <<arousal 3000>><<pain -3>>
    <</switch>>
  <</if>>
<</widget>>

<<widget 'robin-temple-punishment-status'>>
  <<language>>
    <<option 'EN'>>
      <<lanSwitch _args[0] (_args[0] is 'Robin' ? '罗宾' : '悉尼')>> looks
      <<switch _args[1].pain>>
        <<case 0>><span class="green">unharmed</span>
        <<case 1>><span class="teal">uncomfortable</span>
        <<case 2>><span class="lblue">stung</span>
        <<case 3>><span class="blue">pained</span>
        <<case 4>><span class="purple">hurt</span>
        <<case 5>><span class="pink">like <<nnpc_he _args[0]>> can't take much more pain,</span>
      <</switch>>
      and
      <<switch _args[1].arousal>>
        <<case 0>><span class="green">calm.</span>
        <<case 1>><span class="teal">stimulated.</span>
        <<case 2>><span class="lblue">aroused.</span>
        <<case 3>><span class="blue">horny.</span>
        <<case 4>><span class="purple"><<nnpc_his _args[0]>> face is flushed with arousal.</span>
        <<case 5>><span class="pink">like <<nnpc_hes _args[0]>> on the edge of climax.</span>
      <</switch>>

    <<option 'CN'>>
      <<lanSwitch _args[0] (_args[0] is 'Robin' ? '罗宾' : '悉尼')>>看起来
      <<switch _args[1].pain>>
        <<case 0>><span class="green">安然无恙</span>
        <<case 1>><span class="teal">有些不适</span>
        <<case 2>><span class="lblue">有些痛苦</span>
        <<case 3>><span class="blue">很痛苦</span>
        <<case 4>><span class="purple">很痛苦</span>
        <<case 5>><span class="pink">已经无法承受更多的痛苦了，</span>
      <</switch>>
      并且
      <<switch _args[1].arousal>>
        <<case 0>><span class="green">面色平静。</span>
        <<case 1>><span class="teal">略微兴奋。</span>
        <<case 2>><span class="lblue">很兴奋。</span>
        <<case 3>><span class="blue">十分兴奋。</span>
        <<case 4>><span class="purple">脸因兴奋而涨得通红。</span>
        <<case 5>><span class="pink">正处于高潮的边缘。</span>
      <</switch>>

  <</language>>
  <br>
<</widget>>

<<widget 'robin-temple-punishment-options'>>
<!-- 原版 passage：Widgets Sydney 的 sydneyTortureOptions / sydneyTortureFail / priestAttack。回合、阈值与选项照原版。罗宾与悉尼的台词各自按人设写。 -->

  <<set _punishNewRound to $RobinTemple.punish.result is 'active'>>
  <<if _punishNewRound>>
    <<hallucinogen 10>><<arousal 1000>><<garousal>>
    <<run maplebirch.get('RobinTemple').punishmentRound()>>
  <</if>>
  <<switch $RobinTemple.punish.result>>
    <<case 'hospital'>>
      <<if _punishNewRound>><<passout>><<trauma 100>><<gggtrauma>><</if>>
      <<language>>
        <<option 'EN'>>
          You feel yourself losing consciousness. Robin's frightened face fades from view<<if $RobinTemple.punish.joint>>, and Sydney's along with it<</if>>.
        <<option 'CN'>>
          你感觉自己正在失去意识。在昏过去前，你看到了罗宾的脸，表情愈发惊恐<<if $RobinTemple.punish.joint>>，悉尼也是如此<</if>>，视野随之逐渐模糊。
      <</language>>
      <br><br>
      <<lanLink ['Everything goes black...', '你眼前一黑……'] 'RobinTemple Penance Hospital'>><<pain -8>><<arousal -2000>><<pass 60>><</lanLink>><br>
    <<case 'passed'>>
      <<language>>
        <<option 'EN'>>
          <<if $RobinTemple.punish.repeats gte 10>>
            <<person3>>The <<priest>> bows to you. <<He>> slowly approaches you, and raises <<his>> hand, causing you<<if $RobinTemple.punish.joint>>, Robin and Sydney<</if>><<if !$RobinTemple.punish.joint>> and Robin<</if>> to flinch in fear.
            <br><br>
            The strike never comes. Instead, you hear metal clattering to the ground. "Congratulations, my children," <<he>> says. "You have endured much suffering, and although you failed time and time again, you've shown your bond to be strong enough to last. <span class="green">You are pure once more.</span>" Your bindings are all released. A <<monk>> steps behind you and unties your gags. <<if $worn.neck.name is "familiar collar">><<He>> also removes Robin's collar<<if $RobinTemple.punish.joint>> and Sydney's<</if>>.<<else>><<He>> also removes your collars.<</if>> <<tearful>> you<<if $RobinTemple.punish.joint>>, Robin and Sydney<</if>><<if !$RobinTemple.punish.joint>> and Robin<</if>> remain clinging to each other, supporting each other to a standing position. Your knees tremble.
            <br><br>
            "A warning," the <<priest>> continues. "Breathe not a word of this to anyone. Not your friends. Not Jordan. Not your parents, should you be so blessed. I'd hate to consider you impure again."
            <br><br>
            The <<monks>> present you your neatly folded clothing.
            <<if $player.virginity.penile isnot true or $player.virginity.vaginal isnot true>>
              <<if $RobinTemple.templePromised is "Robin">>
                You've gained the <span class="blue"><<robin-temple-promise-trait-name>></span> trait.
              <<else>>
                You've gained the <span class="blue">Chastity Vow</span> trait.
              <</if>>
            <</if>>
            <br><br>
            <<link [[Next|RobinTemple Penance End]]>><</link>>
            <br>
          <<else>>
            <<person3>>The <<priest>> holds up <<his>> hand. "Enough." The <<monks>> stop, and snuff the incense burners. <<He>> slowly approaches you, and raises <<his>> hand, causing you<<if $RobinTemple.punish.joint>>, Robin and Sydney<</if>><<if !$RobinTemple.punish.joint>> and Robin<</if>> to flinch in fear.
            <br><br>
            The strike never comes. Instead, you hear metal clattering to the ground. "Congratulations, my children," <<he>> says. "You have endured lust and wrath, showing your bond to be stronger than both. <span class="green">You are pure once more.</span>" Your bindings are all released. A <<monk>> steps behind you and unties your gags. <<if $worn.neck.name is "familiar collar">><<He>> also removes Robin's collar<<if $RobinTemple.punish.joint>> and Sydney's<</if>>.<<else>><<He>> also removes your collars.<</if>> <<tearful>> you<<if $RobinTemple.punish.joint>>, Robin and Sydney<</if>><<if !$RobinTemple.punish.joint>> and Robin<</if>> remain clinging to each other, supporting each other to a standing position. Your knees tremble.
            <br><br>
            "A warning," the <<priest>> continues. "Breathe not a word of this to anyone. Not your friends. Not Jordan. Not your parents, should you be so blessed. I'd hate to consider you impure again."
            <br><br>
            The <<monks>> present you your neatly folded clothing.
            <<if $player.virginity.penile isnot true or $player.virginity.vaginal isnot true>>
              <<if $RobinTemple.templePromised is "Robin">>
                You've gained the <span class="blue"><<robin-temple-promise-trait-name>></span> trait.
              <<else>>
                You've gained the <span class="blue">Chastity Vow</span> trait.
              <</if>>
            <</if>>
            <br><br>
            <<link [[Next|RobinTemple Penance End]]>><</link>>
            <br>
          <</if>>
        <<option 'CN'>>
          <<if $RobinTemple.punish.repeats gte 10>>
            <<person3>><<priest>>向你们鞠了一躬。<<He>>慢慢抬起手，这让你<<if $RobinTemple.punish.joint>>、罗宾和悉尼<</if>><<if !$RobinTemple.punish.joint>>和罗宾<</if>>都害怕地一缩。
            <br><br>
            鞭子没有再落下。相反，你听见金属落地的声音。"恭喜，我的孩子们，"<<he>>一字一句地说着，"你们共同经历了痛苦。尽管多次失败，但你们向我们证明了你们的羁绊足够牢固。<span class="green">你们再次纯洁了。</span>"你们的束缚全部解开。一位<<monk>>走了过来，解开你们的口球，<<if $worn.neck.name is "familiar collar">><<He>>还摘下了罗宾<<if $RobinTemple.punish.joint>>和悉尼<</if>>的项圈。<<else>><<He>>还摘下了你们的项圈。<</if>><<tearful>>你和罗宾<<if $RobinTemple.punish.joint>>、悉尼<</if>>仍保持相拥的姿势，彼此支撑着站起。你的膝盖仍然在打颤。
            <br><br>
            "一个警告，"<<priest>>说，"不要向任何人透露此事。无论朋友，还是约旦。即使你有幸还有双亲，也不要告诉他们。我不希望再发现你们不洁了。"
            <br><br>
            <<monks>>把你叠好的衣服递给你。
            <<if $player.virginity.penile isnot true or $player.virginity.vaginal isnot true>>
              <<if $RobinTemple.templePromised is "Robin">>
                你获得了<span class="blue"><<robin-temple-promise-trait-name>></span>特质。
              <<else>>
                你获得了<span class="blue">贞洁誓言</span>特质。
              <</if>>
            <</if>>
            <br><br>
            <<link [[继续|RobinTemple Penance End]]>><</link>>
            <br>
          <<else>>
            <<person3>><<priest>>举起了一只手，"够了。"<<monks>>停了下来，掐灭了燃香盏。<<He>>慢慢靠近你们，把手伸了出来，你<<if $RobinTemple.punish.joint>>、罗宾和悉尼<</if>><<if !$RobinTemple.punish.joint>>和罗宾<</if>>惊恐地后退。
            <br><br>
            鞭子没有再落下。相反，你听见金属落地的声音。“恭喜，我的孩子们，”<<he>>说，“你们共同经历了痛苦，也一同抵御了欲望。你们证明了你们的羁绊比欲望和痛苦更强大。<span class="green">你们再次纯洁了。</span>”你们的束缚全部解开。一个<<monk>>走了过来，拔掉你们的口球，<<if $worn.neck.name is "familiar collar">><<He>>还把罗宾<<if $RobinTemple.punish.joint>>和悉尼<</if>>的项圈解开了。<<else>><<He>>还把你们的项圈解开了。<</if>><<tearful>>你和罗宾<<if $RobinTemple.punish.joint>>、悉尼<</if>>仍保持相拥的姿势，彼此支撑着站起。你的膝盖打着颤。
            <br><br>
            "一个警告，"<<priest>>继续说道，"不要向任何人透露此事。不要告诉你的朋友。不要告诉约旦。即使你有幸还有双亲，也不要告诉他们。我不希望再发现你们不洁了。"
            <br><br>
            <<monks>>把你叠好的衣服拿给你。
            <<if $player.virginity.penile isnot true or $player.virginity.vaginal isnot true>>
              <<if $RobinTemple.templePromised is "Robin">>
                你获得了<span class="blue"><<robin-temple-promise-trait-name>></span>特质。
              <<else>>
                你获得了<span class="blue">贞洁誓言</span>特质。
              <</if>>
            <</if>>
            <br><br>
            <<link [[继续|RobinTemple Penance End]]>><</link>>
            <br>
          <</if>>
      <</language>>
    <<case 'rest'>>
      <<if _punishNewRound>>
        <<set _punishNpcArousal to !($pain gte 100 and $willpowerpain is 0) and $arousal lt $arousalmax and !Object.values($RobinTemple.punish.partners).some(npc => npc.pain gte 6)>>
        <<if !($pain gte 100 and $willpowerpain is 0) and $arousal gte $arousalmax>><<orgasm>><</if>>
        <<for _punishName, _punishPartner range $RobinTemple.punish.partners>>
          <<if _punishNpcArousal and _punishPartner.arousal gte 6>>
            <<npcincr _punishName lust -1>>
            <<if _punishName is 'Robin'>>
              <<set maplebirch.get('RobinTemple').faith -= 2>><<lconviction 'Robin'>>
            <<else>>
              <<npcincr Sydney purity -2>><<lspurity>>
            <</if>>
          <</if>>
        <</for>>
        <<stress 24>><<gggstress>>
        <<stress -1>><<lstress>>
      <</if>>
      <<set _punishCauseName to $RobinTemple.punish.causeTarget is '' ? 'Robin' : $RobinTemple.punish.causeTarget>>
      <<language>>
        <<option 'EN'>>
          <<person3>><<if $RobinTemple.punish.cause is 'pain'>><span class="red">The pain is too much.</span> You buckle and collapse, tumbling over with <<if $RobinTemple.punish.joint>>Robin and Sydney<<else>>Robin<</if>>.
          <<elseif $RobinTemple.punish.cause is 'arousal'>><span class="red">It's too much.</span>
          <<elseif $RobinTemple.punish.cause is 'partnerPain'>><span class="red"><<lanSwitch _punishCauseName (_punishCauseName is 'Robin' ? '罗宾' : '悉尼')>> lets out a blood-curdling cry through <<nnpc_his _punishCauseName>> gag.</span>
          <<elseif $RobinTemple.punish.cause is 'partnerArousal'>><span class="red"><<lanSwitch _punishCauseName (_punishCauseName is 'Robin' ? '罗宾' : '悉尼')>> moans and shudders against you as <<nnpc_hes _punishCauseName>> forced to climax.</span>
          <</if>>
          <br><br>
          The <<priest>> holds up <<his>> hand. "Cease." The <<monks>> stop, and snuff the incense burners. "Your bodies betray you. You will be given time to recover, and then we will begin again." <<gggstress>>
          <br><br>
          The <<monks>> dim the light in the room, and leave one by one. As the last one leaves, you<<if $RobinTemple.punish.joint>>, Robin and Sydney<</if>><<if !$RobinTemple.punish.joint>> and Robin<</if>> are left in total darkness.
          <br><br>
          <<if $RobinTemple.punish.joint>>
            You can feel their breath on your skin. Something about knowing they're both still there calms you. They hold you tighter, and you squeeze back. <<lstress>>
          <<else>>
            You can feel Robin's breath on your skin. Something about knowing <<nnpc_hes "Robin">> still there calms you. <<nnpc_He "Robin">> holds you tighter. You squeeze back. <<lstress>>
          <</if>>
          <br><br>

          <<if playerBellySize() gte 15>>
            You feel another faint heartbeat between you.
            <br><br>
          <</if>>
        <<option 'CN'>>
          <<person3>><<if $RobinTemple.punish.cause is 'pain'>><span class="red">疼痛已经无法承受。</span>你弯下腰，和罗宾<<if $RobinTemple.punish.joint>>、悉尼<</if>>一起瘫倒在地。
          <<elseif $RobinTemple.punish.cause is 'arousal'>><span class="red">已经到了极限。</span>
          <<elseif $RobinTemple.punish.cause is 'partnerPain'>><span class="red"><<lanSwitch _punishCauseName (_punishCauseName is 'Robin' ? '罗宾' : '悉尼')>>隔着口球发出一声撕心裂肺的叫喊。</span>
          <<elseif $RobinTemple.punish.cause is 'partnerArousal'>><span class="red"><<lanSwitch _punishCauseName (_punishCauseName is 'Robin' ? '罗宾' : '悉尼')>>强行达到了高潮，靠在你的身上呻吟颤抖。</span>
          <</if>>
          <br><br>
          <<priest>>抬起手。"可以了。"<<monks>>纷纷停下，熄灭了燃香盏。"你们的身体背叛了你。给你们点时间恢复，然后我们重新开始。"<<gggstress>>
          <br><br>
          <<monks>>熄灭了房间里的火光，一个接一个地离开。当最后一个人离开后，你<<if $RobinTemple.punish.joint>>、罗宾和悉尼<</if>><<if !$RobinTemple.punish.joint>>和罗宾<</if>>陷入了一片黑暗。
          <br><br>
          <<if $RobinTemple.punish.joint>>
            他们的吐息轻轻拂过你的肌肤。一想到<<lanSwitch 'They' '他们'>>都在这里，你便平静了下来。<<lanSwitch 'They' '他们'>>把你抱得更紧了，你也用力抱了回去。<<lstress>>
          <<else>>
            罗宾的吐息轻轻拂过你的肌肤。一想到<<nnpc_hes "Robin">>在这里，你便平静了下来。<<nnpc_He "Robin">>把你抱得更紧了，你也用力抱了回去。<<lstress>>
          <</if>>
          <br><br>

          <<if playerBellySize() gte 15>>
            你感觉到了另一个微弱的心跳——它就夹在你们之间。
            <br><br>
          <</if>>
      <</language>>
      <<lanLink ['Rest (1:00)', '休息 (1:00)'] 'RobinTemple Penance Trial'>><<pass 60>><<pain -30>><<run maplebirch.get('RobinTemple').punishmentRest()>><</lanLink>><<lllpain>><br>
    <<case 'active'>>
      <<for _punishName, _punishPartner range $RobinTemple.punish.partners>>
        <<capture _punishName _punishPartner>>
          <<robin-temple-punishment-status _punishName _punishPartner>>
        <</capture>>
      <</for>>
      <span class='red'>
      <<switch $RobinTemple.punish.action>>
        <<case 'Player'>><<lanSwitch 'The specialist prepares to lash you.' '专员准备鞭打你。'>>
        <<case 'Robin'>><<lanSwitch 'The specialist prepares to lash Robin.' '专员准备鞭打罗宾。'>>
        <<case 'Sydney'>><<lanSwitch 'The specialist prepares to lash Sydney.' '专员准备鞭打悉尼。'>>
        <<case 'Vibrate'>><<lanSwitch 'The specialist intensifies the vibration.' '专员调高振动的强度。'>>
      <</switch>>
      </span><br><br>
      <<if $RobinTemple.punish.joint and Object.values($RobinTemple.punish.partners).every(npc => npc.hold lt 5)>>
        <<lanLink ['Hold Robin and Sydney tighter', '抱紧罗宾和悉尼'] 'RobinTemple Penance Action'>><<robin-temple-punishment-action 'hold' 'both'>><</lanLink>><<llpain>><br>
      <</if>>
      <<if $RobinTemple.punish.joint and Object.values($RobinTemple.punish.partners).every(npc => npc.touch lt 5 and (npc.touch is 0 or hasSexStat('promiscuity', npc.touch + 1)))>>
        <<lanLink ['Touch Robin and Sydney', '抚摸罗宾和悉尼'] 'RobinTemple Penance Action'>><<robin-temple-punishment-action 'touch' 'both'>><</lanLink>><<garousal>><br>
      <</if>>
      <<for _punishName, _punishPartner range $RobinTemple.punish.partners>>
        <<capture _punishName _punishPartner>>
          <<if _punishPartner.hold lt 5>>
            <<lanLink (_punishName is 'Robin' ? ['Hold Robin tighter', '抱紧罗宾'] : ['Hold Sydney tighter', '抱紧悉尼']) 'RobinTemple Penance Action'>><<robin-temple-punishment-action 'hold' _punishName>><</lanLink>><<lpain>><br>
          <</if>>
          <<if _punishPartner.touch lt 5 and (_punishPartner.touch is 0 or hasSexStat('promiscuity', _punishPartner.touch + 1))>>
            <<lanLink (_punishName is 'Robin' ? ['Touch Robin', '抚摸罗宾'] : ['Touch Sydney', '抚摸悉尼']) 'RobinTemple Penance Action'>><<robin-temple-punishment-action 'touch' _punishName>><</lanLink>><<garousal>><br>
          <</if>>
        <</capture>>
      <</for>>
      <<if Object.values($RobinTemple.punish.partners).every(npc => npc.belt lt 5)>>
        <<lanLink ['Try to stop the vibration', '阻止皮带振动'] 'RobinTemple Penance Action'>><<robin-temple-punishment-action 'belt' 'both'>><</lanLink>><<llarousal>><br>
      <</if>>
      <<if ['Robin', 'Sydney'].includes($RobinTemple.punish.action) and Object.values($RobinTemple.punish.partners).every(npc => npc.hit lt 4)>>
        <<lanLink ['Try to shield them from the lash', '尝试避开鞭打'] 'RobinTemple Penance Action'>><<robin-temple-punishment-action 'hit' 'both'>><</lanLink>><<llarousal>><<gpain>><br>
      <</if>>
      <<if $RobinTemple.punish.action is 'Player' and Object.values($RobinTemple.punish.partners).every(npc => npc.plead lt 4)>>
        <<lanLink ['Plead', '恳求'] 'RobinTemple Penance Action'>><<robin-temple-punishment-action 'plead' 'both'>><</lanLink>><<garousal>><<llpain>><br>
      <</if>>
      <<lanLink ['Close your eyes', '闭上眼睛'] 'RobinTemple Penance Action'>><<robin-temple-punishment-action 'close' 'both'>><</lanLink>><<ggarousal>><<lpain>><br>
  <</switch>>
<</widget>>

:: RobinTemple Penance
<<set $outside to 0>><<set $location to 'temple'>><<effects>>
<<if $RobinTemple.punish>>
  <<robin-temple-punishment-npcs>>
  <<if $RobinTemple.punish.joint>>
    <<language>>
      <<option 'EN'>>
        <<person1>>

        <<person3>> A <<priest>> emerges from a door marked with a red cross. <<Hes>> flanked by many <<monks>>. One of them assures Jordan that you'll all be treated gently.
        <br><br>
        Head bowed, Jordan leaves the room as the <<priest>> pulls a gag from <<his>> habit. "To make amends, you must <<if $RobinTemple.templePromised is "Robin">>prove your bond with each other remains strong.<<else>>rely on each other, as you've all sinned.<</if>> Stay still."
        <br><br>
        <<if maplebirch.get('RobinTemple').faith lte -20 and _sydneyStatus.includes('corrupt')>>
          Robin and Sydney try to step between you and the <<monks>>.
        <<elseif _sydneyStatus.includes('corrupt')>>
          Sydney tries to step between you and the <<monks>>, while Robin holds you tighter.
        <<elseif maplebirch.get('RobinTemple').faith lte -20>>
          Robin tries to step between you and the <<monks>>, while Sydney holds you tighter.
        <<else>>
          Robin and Sydney hold you tighter.
        <</if>>
        <<if maplebirch.get('RobinTemple').faith lte -20>>
          "It's... it's okay. Whatever they do, we did it together." Robin says it like <<he>>'s trying to convince <<himself>>.
          <br>
          Sydney says nothing, and just holds on.
        <<else>>
          "We'll get through this," Robin whispers. "Just... please don't let go."
        <</if>>
        <br><br>
        You're already surrounded by enough <<monks>> to restrain all three of you. They make no effort to separate you.
      <<option 'CN'>>
        <<person2>><<person1>>

        <<person3>>一名<<priest>>从一扇标有红色十字架的门里走出，两侧还跟随着一众<<monks>>。一人示意悉尼和罗宾去你那儿，<<lanSwitch 'They' '他们'>>便立刻跑到了你的身边。
        <br><br>
        一个<<priest>>从长袍里拿出了口球，约旦则低头离开了房间。"为了赎罪，你们必须证明你们之间的羁绊依旧牢固。请不要动。"
        <br><br>
        <<if maplebirch.get('RobinTemple').faith lte -20 && _sydneyStatus.includes("corrupt")>>
          悉尼和罗宾走到你和<<monks>>的中间，努力想把你挡在身后。
        <<elseif _sydneyStatus.includes("corrupt")>>
          悉尼走到你和<<monks>>的中间，努力想把你挡在身后，而罗宾紧紧地搂着你。
        <<elseif maplebirch.get('RobinTemple').faith lte -20>>
          罗宾走到你和<<monks>>的中间，努力想把你挡在身后，而悉尼紧紧地搂着你。
        <<else>>
          悉尼和罗宾把你搂得更紧了。
        <</if>>
        <<if maplebirch.get('RobinTemple').faith lte -20>>
          “没、没事的。不管他们要做什么，我们是一起做的。”罗宾说着，像是在说服自己。
          <br>
          悉尼什么也没说，只是抓紧了你。
        <<else>>
          “我们会挺过去的，”罗宾小声说，“只要……请别松手。”
        <</if>>
        <br><br>
        你们已经完全被<<monks>>包围住了，但众人并没有打算将你们分开。
    <</language>>
  <<else>>
    <<language>>
      <<option 'EN'>>
        <<person1>>

        <<person3>> A <<priest>> emerges from a door marked with a red cross. <<Hes>> flanked by many <<monks>>. One of them assures Jordan that you'll both be treated gently.
        <br><br>
        Head bowed, Jordan leaves the room as the <<priest>> pulls a gag from <<his>> habit. "To make amends, you must <<if $RobinTemple.templePromised is "Robin">>prove your bond with each other remains strong.<<else>>rely on each other, as you've both sinned.<</if>> Stay still."
        <br><br>
        <<if maplebirch.get('RobinTemple').faith lte -20>>
          Robin tries to step between you and the <<monks>>.
        <<else>>
          Robin holds you tighter.
        <</if>>
        <<person1>>
        <<if C.npc.Robin.virginity.temple isnot true>>
          "I'm sorry. We should have been more careful. I tried to tell them it wasn't you, but they didn't believe me. I thought about running, but I don't want you getting punished alone."
        <<else>>
          "It's... it's okay. We'll get through this. Just... please don't leave me..."
        <</if>>
        <br><br>
        You're already surrounded by enough <<monks>> to restrain both of you. They make no effort to separate you.
      <<option 'CN'>>
        <<person1>>

        <<person3>>一名<<priest>>从一扇标有红色十字架的门里走出，两侧还跟随着一众<<monks>>。一人示意罗宾去你那儿，<<nnpc_He 'Robin'>>便立刻跑到了你的身边。
        <br><br>
        一个<<priest>>从长袍里拿出了口球，约旦则低头离开了房间。"为了赎罪，你们必须<<if $RobinTemple.templePromised is "Robin">>证明你们之间的羁绊依旧牢固。<<else>>得彼此依靠，因为你们都有罪。<</if>>请不要动。"
        <br><br>
        <<if maplebirch.get('RobinTemple').faith lte -20>>
          罗宾走到你和<<monks>>的中间，努力想把你挡在身后。
        <<else>>
          罗宾把你搂得更紧了。
        <</if>>
        <<person1>>
        <<if C.npc.Robin.virginity.temple isnot true>>
          “对不起。我们应该更小心的。我试着告诉他们不是你的错，但他们不信。我想过跑掉，可我不想让你一个人挨罚。”
        <<else>>
          “没、没事的。我们一起挺过去。只要……请你不要离开我。”
        <</if>>
        <br><br>
        你们已经完全被<<monks>>包围住了，但众人并没有打算将你们分开。
    <</language>>
  <</if>>
  <br><br>
  <<lanLink ['Hold on to Robin', '抓紧罗宾'] 'RobinTemple Penance Intro 2'>><<set $RobinTemple.punish.phase to ($RobinTemple.punish.joint ? 3 : 1)>><<npcincr Robin love 1>><<if $RobinTemple.punish.joint>><<npcincr Sydney love -5>><</if>><<pass 20>><</lanLink>><<glove 'Robin'>><br>
  <<if $RobinTemple.punish.joint>>
    <<lanLink ['Hold on to Robin and Sydney', '抓紧罗宾和悉尼'] 'RobinTemple Penance Intro 2'>><<set $RobinTemple.punish.phase to 1>><<npcincr Robin love 1>><<npcincr Sydney love 1>><<pass 20>><</lanLink>><<glove 'Robin'>><<glove 'Sydney'>><br>
    <<lanLink ['Hold on to Sydney', '抓紧悉尼'] 'RobinTemple Penance Intro 2'>><<set $RobinTemple.punish.phase to 2>><<npcincr Robin love -5>><<npcincr Sydney love 1>><<pass 20>><</lanLink>><<lllove 'Robin'>><<glove 'Sydney'>><br>
  <</if>>
  <<lanLink ['Push them away', '推开身旁的人'] 'RobinTemple Penance Intro 2'>><<set $RobinTemple.punish.phase to ($RobinTemple.punish.joint ? 4 : 2)>><<npcincr Robin love -5>><<if $RobinTemple.punish.joint>><<npcincr Sydney love -5>><</if>><<pass 20>><</lanLink>><<lllove 'Robin'>><br>
<<else>>
  <<getouticon>><<lanLink ['Return to the temple', '返回神殿'] 'Temple'>><</lanLink>><br>
<</if>>

:: RobinTemple Penance Intro 2
<!-- 原版 passage：Sydney Temple Punish Intro 2。流程照原版。认罪与推责段落已按罗宾/悉尼两个人的口气分开写。 -->

<<set $outside to 0>><<set $location to 'temple'>><<effects>>
<<if $RobinTemple.punish>>
  <<facewear 4>>
  <<if !($worn.neck.name is 'familiar collar' and $worn.neck.cursed is 1)>><<leash 21>><</if>>
  <<if $RobinTemple.punish.joint>>
    <<language>>
      <<option 'EN'>>
        <<if $RobinTemple.punish.phase is 1>>
          You hold on to Robin and Sydney, not daring to let go. Whatever’s coming, you know you can handle it together.
          <br><br>
          The <<person3>><<priest>> nods in approval. "A good start."
        <<elseif $RobinTemple.punish.phase is 2 or $RobinTemple.punish.phase is 3>>
          <<set _punishRejected to $RobinTemple.punish.phase is 2 ? 'Robin' : 'Sydney'>>
          <<set _punishHeld to $RobinTemple.punish.phase is 2 ? 'Sydney' : 'Robin'>>
          You hold on to <<= _punishHeld>> and push <<= _punishRejected>> away. Why should the both of you be punished for this? <<nnpc_He _punishRejected>> looks at you with tears in <<nnpc_his _punishRejected>> eyes, looking utterly betrayed.
          <br><br>
          The <<person3>><<priest>> shakes <<his>> head. "Miserable. Refusing to take responsibility. Your punishment can’t come sooner."
        <<else>>
          You push Robin and Sydney away. Why should you be punished for this? They look at you with tears in their eyes, looking utterly betrayed.
          <br><br>
          The <<person3>><<priest>> shakes <<his>> head. "Miserable. Refusing to take responsibility. Your punishment can’t come sooner."
        <</if>>
        <<He>> pushes the gag into your mouth and ties it firm behind your head. <<He>> walks over to Robin and Sydney and does the same motion. Any sound you make will be muffled and unintelligible.
        <<if $worn.neck.name is "familiar collar" and $worn.neck.cursed is 1>>
          A <<person3>><<monk>> to <<his>> side wraps a collar around their neck, but pauses upon seeing your collar. Wordlessly, <<he>> ties your hands instead.
        <<else>>

          A <<person3>><<monk>> to <<his>> side wraps a collar around your neck along with their. <<He>> holds the attached leashes, and tugs.
        <</if>>
        <br><br>
        You're all led through the marked door and down a cramped passage. There are no lights bar the occasional torch on the wall.
        After a few minutes, you emerge in a small round room with no windows. Various incense burners hang from the ceiling. The room is bare save for some padding in the centre and <span class="red">whips, belts and other disciplinary devices that adorn the walls.</span>
      <<option 'CN'>>
        <<if $RobinTemple.punish.phase is 1>>
          你抓紧悉尼和罗宾，不敢放开。你把手攥得很紧很紧。无论即将发生什么，你知道你都能和悉尼还有罗宾一起面对。<<nnpc_He "Robin">>透过恐惧，向你挤出一个微笑。
          <br><br>
          <<priest>>赞许地点了点头。“很好。”
        <<elseif $RobinTemple.punish.phase is 2>>
          你抓紧悉尼，将罗宾推开。为什么要连带你和悉尼一起惩罚？<<nnpc_He "Robin">>含泪看向你，一脸被背叛的表情。
          <br><br>
          <<priest>>摇了摇头。"可悲，拒绝担负责任。你们的惩罚不会再拖了。"
        <<elseif $RobinTemple.punish.phase is 3>>
          你抓紧罗宾，将悉尼推开。为什么要连带你和罗宾一起惩罚？<<nnpc_He "Sydney">>含泪看向你，一脸被背叛的表情。
          <br><br>
          <<priest>>摇了摇头。"可悲，拒绝担负责任。你们的惩罚不会再拖了。"
        <<elseif $RobinTemple.punish.phase is 4>>
          你猛地一挣，将悉尼和罗宾推开。为什么要连带你一起惩罚？<<lanSwitch 'They' '他们'>>含泪看向你，一脸被背叛的表情。
          <br><br>
          <<priest>>摇了摇头。"可悲，拒绝担负责任。你们的惩罚不会再拖了。"
        <</if>>
        <<He>>将口球塞进你嘴里，在你脑后把它系紧，接着走到了悉尼和罗宾身边，做了同样的动作。你们支支吾吾，发不出任何声音。旁边一名<<person3>><<monk>>在自己的位置上站定，将你和悉尼还有罗宾的脖子一起用项圈套在了一起。<<He>>抓住中间连接的链子，用力拉了拉。
        <br><br>
        你们被带出标记门，走进一个狭窄的通道。墙上除了零星的火把，没有其他光照了。
        几分钟后，你们来到一个没有窗户的圆形小房间里。各种燃香盏从天花板悬下，屋内除了正中央的一些软垫外，空空荡荡。<span class="red">皮鞭，绑带，和其它惩罚用具都挂在墙面上。</span>
    <</language>>
  <<else>>
    <<language>>
      <<option 'EN'>>
        <<if $RobinTemple.punish.phase is 1>>
          You hold on to Robin, not daring to let go. You hold on for dear life. Whatever's coming, you know you'll be able to handle it together. <<nnpc_He "Robin">> smiles through <<his>> panic.
          <br><br>
          The <<priest>> nods in approval. "A good start."
        <<else>>
          You lash out, pushing Robin away. Why should you be punished for this? <<nnpc_He "Robin">> looks to you with tears in <<nnpc_his "Robin">> eyes, looking utterly betrayed.
          <br><br>
          The <<priest>> shakes <<his>> head. "Miserable. Refusing to take responsibility. Your punishment can't come sooner."
        <</if>>
        <<He>> pushes the gag into your mouth and ties it firm behind your head. <<He>> walks over to Robin and does the same motion. Any sound you make will be muffled and unintelligible.
        <<if $worn.neck.name is "familiar collar" and $worn.neck.cursed is 1>>
          A <<person3>><<monk>> to <<his>> side wraps a collar around Robin's neck, but pauses upon seeing your collar. Wordlessly, <<he>> ties your hands instead.
        <<else>>

          A <<person3>><<monk>> to <<his>> side wraps a collar around your neck along with Robin's. <<He>> holds the attached leashes, and tugs.
        <</if>>
        <br><br>
        You're both led through the marked door and down a cramped passage. There are no lights bar the occasional torch on the wall.
        After a few minutes, you emerge in a small round room with no windows. Various incense burners hang from the ceiling. The room is bare save for some padding in the centre and <span class="red">whips, belts and other disciplinary devices that adorn the walls.</span>
      <<option 'CN'>>
        <<if $RobinTemple.punish.phase is 1>>
          你抓紧罗宾，不敢放开。你把手攥得很紧很紧。无论即将发生什么，你知道你都能和罗宾一起面对。<<nnpc_He "Robin">>透过恐惧，向你挤出一个微笑。
          <br><br>
          <<priest>>赞许地点了点头。“很好。”
        <<else>>
          你猛地一挣，将罗宾推开。为什么要连带你一起惩罚？<<nnpc_He "Robin">>含泪看向你，一脸被背叛的表情。
          <br><br>
          <<priest>>摇了摇头。"可悲，拒绝担负责任。你们的惩罚不会再拖了。"
        <</if>>
        <<He>>将口球塞进你嘴里，在你脑后把它系紧，接着走到了罗宾身边，做了同样的动作。你们支支吾吾，发不出任何声音。旁边一名<<person3>><<monk>>在自己的位置上站定，将你和罗宾的脖子一起用项圈套在了一起。<<He>>抓住中间连接的链子，用力拉了拉。
        <br><br>
        你们被带出标记门，走进一个狭窄的通道。墙上除了零星的火把，没有其他光照了。
        几分钟后，你们来到一个没有窗户的圆形小房间里。各种燃香盏从天花板悬下，屋内除了正中央的一些软垫外，空空荡荡。<span class="red">皮鞭，绑带，和其它惩罚用具都挂在墙面上。</span>
    <</language>>
  <</if>>
  <br><br>
  <<lanLink ['Continue', '继续'] 'RobinTemple Penance Intro 3'>><<pass 3>><</lanLink>><br>
<</if>>

:: RobinTemple Penance Intro 3
<!-- 原版 passage：Sydney Temple Punish Intro 3。流程照原版。三人分支的束缚描写已改为三人。 -->

<<set $outside to 0>><<set $location to 'temple'>><<effects>>
<<if $RobinTemple.punish>>
  <<if !$RobinTemple.punish.started>>
    <<set $RobinTemple.punish.started to true>>
    <<undress 'duopunish'>><<bindtemp>><<shackle_feet>>
    <<run $robinSeen.pushUnique('punishment')>>
    <<if $RobinTemple.punish.joint>><<run $sydneySeen.pushUnique('punishment')>><</if>>
    <<violence_noncombat 40 0.3>><<stress 12>>
  <</if>>
  <<if $RobinTemple.punish.joint>>
    <<language>>
      <<option 'EN'>>
        The <<monks>> strip you and Robin and Sydney bare, leaving only your gags and collars.
        You're led to the padding and forced down onto your knees. The <<priest>> pulls out some belts and grabs ahold of your arms. Your arms are wrapped around their waist, and your wrists are bound behind <<person1>>them. their arms are restrained similarly. The <<person3>><<priest>> acquires more belts and wraps them around you and their waists, pressing the three of you together. One more belt wraps around all three of your backs, leaving little wriggle room. Finally, a pair of shackles bind your legs together.
        <br><br>
        "<<if $RobinTemple.templePromised is "Robin">>You have broken your promise to one another,<<else>>The all three of you have succumbed to pleasure and desire with one another,<</if>>" the <<priest>> speaks, brandishing a whip with nine chords hanging from the cudgel. "Given your special bond, you'll experience pain with one another as the first step to make amends." You can feel their heart race. You're overcome with fear yourself at what's coming<<if $masochism_level gte 1>>, along with a hint of excitement<</if>>.
        <br><br>
        The whip strikes down onto your back first without warning, stinging tremendously. Another strike causes you to thrash in pain. You let out a scream into your gag while tears fill your eyes. You can feel their panicked breathing at your pain. <<person1>>They let out a garbled protest at the torment you're receiving. Another strike comes down onto your back, stinging your flesh from the heavy chords. <<gggpain>>
        <br><br>
        The <<person3>><<priest>> moves over to Robin and Sydney and, without hesitation, lashes the whip onto <<person1>>their back. They squeal into their gag and then receives another strike. The whip strikes their back a third time, leaving them in tears. <<ggstress>>
      <<option 'CN'>>
        <<monks>>把你们扒光，只留下口球和项圈。
        你们被领到软垫旁，被迫跪下。<<priest>>拿下一些绑带，一头捆住你的胳膊，然后把你的双手摆弄成环住悉尼和罗宾腰肢的姿势，手腕系在了<<lanSwitch 'They' '他们'>>的身后。悉尼和罗宾也和你一样。<<person3>><<priest>>拿来更多绑带，缠绕上你和悉尼还有罗宾的腰，把你们紧贴在一起。当最后一根绑带捆上你的后背时，你们的身体间几乎没留下空隙。最后，一对脚镣把你们的腿铐上了。
        <br><br>
        "你违背了对彼此许下的承诺，"<<priest>>说着，挥舞起手中的九尾鞭。"鉴于你们特殊的羁绊，你们的第一个弥补就是和对方一起体验痛苦。"你可以感受到悉尼和罗宾加速的心跳。想到即将到来的事，你也被恐惧<<if $masochism_level gte 1>>和一丝兴奋<</if>>所淹没。
        <br><br>
        第一鞭没有任何预兆地落下，强烈的刺痛顿时席卷了全身，紧接的一鞭更是疼得你猛然一抖。你隔着口球尖叫着，泪水涌上眼眶。你可以感受到悉尼和罗宾惊惧的呼吸。看着你所承受的痛苦，<<person2>><<He>>含混地喊着不要。又是重重的一鞭刮在你的皮肉上，随着响亮的鞭响，刺痛袭击了你的肉体。<<gggpain>>
        <br><br>
        <<person3>><<priest>>走到悉尼和罗宾身边，没有任何犹豫地甩鞭挥向<<lanSwitch 'They' '他们'>>的后背。<<lanSwitch 'They' '他们'>>的尖叫闷在口球里，接着又受了一鞭。鞭子再一次落在悉尼和罗宾的背上，<<lanSwitch 'They' '他们'>>痛得满脸泪水。<<ggstress>>
    <</language>>
  <<else>>
    <<language>>
      <<option 'EN'>>
        The <<monks>> strip you and Robin bare, leaving only your gags and collars.
        You're led to the padding and forced down onto your knees. The <<priest>> pulls out some belts and grabs ahold of your arms. Your arms are wrapped around Robin's waist, and your wrists are bound behind <<person1>><<him>>. Robin's arms are restrained similarly. The <<person3>><<priest>> acquires more belts and wraps them around you and Robin's waists, pressing the two of you together. One more belt wraps around both of your backs, leaving little wriggle room. Finally, a pair of shackles bind your legs together.
        <br><br>
        "<<if $RobinTemple.templePromised is "Robin">>You have broken your promise to one another,<<else>>The both of you have succumbed to pleasure and desire with one another,<</if>>" the <<priest>> speaks, brandishing a whip with nine chords hanging from the cudgel. "Given your special bond, you'll experience pain with one another as the first step to make amends." You can feel Robin's heart race. You're overcome with fear yourself at what's coming<<if $masochism_level gte 1>>, along with a hint of excitement<</if>>.
        <br><br>
        The whip strikes down onto your back first without warning, stinging tremendously. Another strike causes you to thrash in pain. You let out a scream into your gag while tears fill your eyes. You can feel Robin's panicked breathing at your pain. <<person1>><<He>> lets out a garbled protest at the torment you're receiving. Another strike comes down onto your back, stinging your flesh from the heavy chords. <<gggpain>>
        <br><br>
        The <<person3>><<priest>> moves over to Robin and, without hesitation, lashes the whip onto <<person1>><<his>> back. <<He>> squeals into <<his>> gag and then receives another strike. The whip strikes Robin's back a third time, leaving <<him>> in tears. <<ggstress>>
      <<option 'CN'>>
        <<monks>>把你们扒光，只留下口球和项圈。
        你们被领到软垫旁，被迫跪下。<<priest>>拿下一些绑带，一头捆住你的胳膊，然后把你的双手摆弄成环住罗宾腰肢的姿势，手腕系在了<<person1>><<him>>的身后。罗宾也和你一样。<<person3>><<priest>>拿来更多绑带，缠绕上你和罗宾的腰，把你俩紧贴在一起。当最后一根绑带捆上你的后背时，你们的身体间几乎没留下空隙。最后，一对脚镣把你们的腿铐上了。
        <br><br>
        "<<if $RobinTemple.templePromised is "Robin">>你违背了对彼此许下的承诺，<<else>>你们都向快感和对彼此的渴求屈服了，<</if>>"<<priest>>说着，挥舞起手中的九尾鞭。"鉴于你们特殊的羁绊，你们的第一个弥补就是和对方一起体验痛苦。"你可以感受到罗宾加速的心跳。想到即将到来的事，你也被恐惧<<if $masochism_level gte 1>>和一丝兴奋<</if>>所淹没。
        <br><br>
        第一鞭没有任何预兆地落下，强烈的刺痛顿时席卷了全身，紧接的一鞭更是疼得你猛然一抖。你隔着口球尖叫着，泪水涌上眼眶。你可以感受到罗宾惊惧的呼吸。看着你所承受的痛苦，<<person1>><<He>>含混地喊着不要。又是重重的一鞭刮在你的皮肉上，随着响亮的鞭响，刺痛袭击了你的肉体。<<gggpain>>
        <br><br>
        <<person3>><<priest>>走到罗宾身边，没有任何犹豫地甩鞭挥向<<person1>><<his>>的后背。<<He>>的尖叫闷在口球里，接着又受了一鞭。鞭子再一次落在罗宾的背上，<<him>>痛得满脸泪水。<<ggstress>>
    <</language>>
  <</if>>
  <br><br>
  <<lanLink ['Reassure Robin', '安抚罗宾'] 'RobinTemple Penance Intro 4'>><<set $RobinTemple.punish.phase to ($RobinTemple.punish.joint ? 3 : 1)>><<npcincr Robin love 1>><<if $RobinTemple.punish.joint>><<npcincr Sydney love -1>><</if>><<set $RobinTemple.punish.partners.Robin.pain -= 1>><</lanLink>><<glove 'Robin'>><br>
  <<if $RobinTemple.punish.joint>>
    <<lanLink ['Reassure Robin and Sydney', '安抚罗宾和悉尼'] 'RobinTemple Penance Intro 4'>><<set $RobinTemple.punish.phase to 1>><<npcincr Robin love 1>><<npcincr Sydney love 1>><<set $RobinTemple.punish.partners.Robin.pain -= 1>><<set $RobinTemple.punish.partners.Sydney.pain -= 1>><</lanLink>><<glove 'Robin'>><<glove 'Sydney'>><br>
    <<lanLink ['Reassure Sydney', '安抚悉尼'] 'RobinTemple Penance Intro 4'>><<set $RobinTemple.punish.phase to 2>><<npcincr Sydney love 1>><<npcincr Robin love -1>><<set $RobinTemple.punish.partners.Sydney.pain -= 1>><</lanLink>><<glove 'Sydney'>><<llove 'Robin'>><br>
  <</if>>
  <<lanLink ['Close your eyes', '闭上眼睛'] 'RobinTemple Penance Intro 4'>><<set $RobinTemple.punish.phase to ($RobinTemple.punish.joint ? 4 : 2)>><<stress -3>><<pain -10>><</lanLink>><<lstress>><<lpain>><br>
<</if>>

:: RobinTemple Penance Intro 4
<!-- 原版 passage：Sydney Temple Punish Intro 4。流程照原版。三人分支的安抚与对话已改为三人。 -->

<<set $outside to 0>><<set $location to 'temple'>><<effects>>
<<if $RobinTemple.punish>>
  <<if $RobinTemple.punish.joint>>
    <<language>>
      <<option 'EN'>>
        <<if $RobinTemple.punish.phase is 1>>
          You lock eyes with Robin and Sydney, silently asking them to focus on you. The tears don’t stop, but you think they’re trying to smile at you.
        <<elseif $RobinTemple.punish.phase is 2 or $RobinTemple.punish.phase is 3>>
          <<set _punishHeld to $RobinTemple.punish.phase is 2 ? 'Sydney' : 'Robin'>>
          <<set _punishRejected to $RobinTemple.punish.phase is 2 ? 'Robin' : 'Sydney'>>
          You lock eyes with <<= _punishHeld>>, silently asking <<nnpc_him _punishHeld>> to focus on you. You think <<nnpc_hes _punishHeld>> trying to smile, while you ignore <<= _punishRejected>>’s cries.
        <<else>>
          You tightly shut your eyes, trying to ignore Robin and Sydney’s cries. After a few moments, you can’t help but peek.
        <</if>>
        <br><br>
        You see the <<person3>><<priest>> come into view. "Your bonds must be strong. Stronger than any desire and stronger than pain itself," <<he>> says in an instructive manner. Despite their sobs, you think the words have emboldened <<person1>>them. Robin and Sydney cling onto you tighter, and you do the same around them. <span class="blue">You'll only get through this together.</span>
        <br><br>
        You receive more lashings on your back and then on your <<bottom>>. Robin and Sydney receive the same amount of lashes in return. After what feels like an eternity, the <<person3>><<priest>> holsters the whip. <<gpain>>
        <br><br>
        "Your atonement has only just begun. Ready yourselves." <<person3>><<His>> voice suddenly sounds muffled. You look over to see the <<priest>> and <<monks>> all donning strange masks, as they begin to light the incense burners. You start to feel a warmth building within you, and <span class="lewd">something inside the waist belts begins to vibrate.</span>
      <<option 'CN'>>
        <<if $RobinTemple.punish.phase is 1>>
          你的眼神死死锁在悉尼和罗宾身上，无声地让<<lanSwitch 'They' '他们'>>专注于你，不要想别的事。眼泪不住地流下，但你想<<lanSwitch 'They' '他们'>>正努力挤出一个笑容。
        <<elseif $RobinTemple.punish.phase is 2>>
          你的眼神死死锁在悉尼身上，无声地让悉尼专注于你，不要想别的事。眼泪不住地流下，但你想<<nnpc_he "Sydney">>正努力挤出一个笑容，却忽视了罗宾的哭泣。
        <<elseif $RobinTemple.punish.phase is 3>>
          你的眼神死死锁在罗宾身上，无声地让罗宾专注于你，不要想别的事。眼泪不住地流下，但你想<<nnpc_he "Robin">>正努力挤出一个笑容，却忽视了悉尼的哭泣。
        <<elseif $RobinTemple.punish.phase is 4>>
          你紧紧闭上双眼，试图忽视悉尼和罗宾的哭泣。过了几分钟，你还是没忍住睁开了眼睛。
        <</if>>
        <br><br>
        那个<<person3>><<priest>>映入眼帘。"你们的羁绊必须坚如磐石，超越任何欲望，强过痛苦本身。"<<he>>循循善诱着。尽管悉尼和罗宾仍在抽泣，但你想这番话让<<lanSwitch 'They' '他们'>>变得坚强了起来。悉尼和罗宾把你缠得更紧了，你也倚在<<lanSwitch 'They' '他们'>>的身上。<span class="blue">你们知道，你们只能共同挺过这一切。</span>
        <br><br>
        你的后背和<<bottom>>受了更多鞭打，悉尼和罗宾也挨了同样的数目。像是过了几辈子，<<person3>><<priest>>终于收起九尾鞭。<<gpain>>
        <br><br>
        "你们的赎罪才刚刚开始。准备好吧。"<<person3>><<His>>的声音突然沉闷了起来。你环顾四周，只见<<priest>>和<<monks>>都戴上了奇怪的面罩，燃香盏也已被点燃。一股温意流淌在你的体内，<span class="lewd">腰带里的什么东西开始震动起来。</span>
    <</language>>
  <<else>>
    <<language>>
      <<option 'EN'>>
        <<if $RobinTemple.punish.phase is 1>>
          You lock eyes with Robin, nonverbally telling <<him>> to focus on you and nothing else. The tears don't stop, but you think <<hes>> trying to smile at you.
        <<else>>
          You tightly shut your eyes, trying to ignore Robin's cries. After a few moments, you can't help but peek.
        <</if>>
        <br><br>
        You see the <<person3>><<priest>> come into view. "Your bonds must be strong. Stronger than any desire and stronger than pain itself," <<he>> says in an instructive manner. Despite Robin's sobs, you think the words have emboldened <<person1>><<him>>. Robin clings onto you tighter, and you do the same around <<him>>. <span class="blue">You'll only get through this together.</span>
        <br><br>
        You receive more lashings on your back and then on your <<bottom>>. Robin receives the same amount of lashes in return. After what feels like an eternity, the <<person3>><<priest>> holsters the whip. <<gpain>>
        <br><br>
        "Your atonement has only just begun. Ready yourselves." <<person3>><<His>> voice suddenly sounds muffled. You look over to see the <<priest>> and <<monks>> all donning strange masks, as they begin to light the incense burners. You start to feel a warmth building within you, and <span class="lewd">something inside the waist belts begins to vibrate.</span>
      <<option 'CN'>>
        <<if $RobinTemple.punish.phase is 1>>
          你的眼神死死锁在罗宾身上，无声地让<<him>>专注于你，不要想别的事。眼泪不住地流下，但你想<<hes>>正努力挤出一个笑容。
        <<else>>
          你紧紧闭上双眼，试图忽视罗宾的哭泣。过了几分钟，你还是没忍住睁开了眼睛。
        <</if>>
        <br><br>
        那个<<person3>><<priest>>映入眼帘。"你们的羁绊必须坚如磐石，超越任何欲望，强过痛苦本身。"<<he>>循循善诱着。尽管罗宾仍在抽泣，但你想这番话让<<person1>><<him>>变得坚强了起来。罗宾把你缠得更紧了，你也倚在<<him>>的身上。<span class="blue">你们知道，你们只能共同挺过这一切。</span>
        <br><br>
        你的后背和<<bottom>>受了更多鞭打，罗宾也挨了同样的数目。像是过了几辈子，<<person3>><<priest>>终于收起九尾鞭。<<gpain>>
        <br><br>
        "你们的赎罪才刚刚开始。准备好吧。"<<person3>><<His>>的声音突然沉闷了起来。你环顾四周，只见<<priest>>和<<monks>>都戴上了奇怪的面罩，燃香盏也已被点燃。一股温意流淌在你的体内，<span class="lewd">腰带里的什么东西开始震动起来。</span>
    <</language>>
  <</if>>
  <br><br>
  <<lanLink ['Continue', '继续'] 'RobinTemple Penance Trial'>><</lanLink>><br>
<</if>>

:: RobinTemple Penance Trial
<<set $outside to 0>><<set $location to 'temple'>><<effects>>
<<if $RobinTemple.punish>>
  <<language>>
    <<option 'EN'>>
      <i>If your pain or arousal, or either companion’s pain or arousal, reaches the limit, your punishment will continue.</i>
    <<option 'CN'>>
      <i>要是你或同伴的疼痛或情欲达到最大值，你们的惩罚都将会继续。</i>
  <</language>>
  <br><br>
  <<robin-temple-punishment-options>>
<</if>>

:: RobinTemple Penance Action
<!-- 原版 passage：Sydney Temple Punish Touch / Belt / Hit / Plead / Hold / Close。选项数值与文本档位照原版。说话人按当前目标切换。 -->

<<set $outside to 0>><<set $location to 'temple'>><<effects>>
<<if $RobinTemple.punish and $RobinTemple.punish.result is 'active'>>
  <<set _punishTarget to $RobinTemple.punish.target is 'Sydney' ? 'Sydney' : 'Robin'>>
  <<set _punishBoth to $RobinTemple.punish.joint and $RobinTemple.punish.target is 'both'>>
  <<set _punishTargetName to _punishBoth ? lanSwitch('Robin and Sydney', '罗宾和悉尼') : lanSwitch(_punishTarget, _punishTarget is 'Robin' ? '罗宾' : '悉尼')>>
  <<set _punishActionCount to $RobinTemple.punish.choice is 'close' ? 0 : _punishBoth ? Math.floor(Object.values($RobinTemple.punish.partners).reduce((sum, npc) => sum + npc[$RobinTemple.punish.choice], 0) / 2) : $RobinTemple.punish.partners[_punishTarget][$RobinTemple.punish.choice]>>
  <<npc _punishTarget 2>><<person2>>
  <<if $RobinTemple.punish.choice is 'touch'>>
    <<switch _punishActionCount>>
      <<case 1>><<promiscuity1>>
      <<case 2>><<promiscuity2>>
      <<case 3>><<promiscuity3>>
      <<case 4>><<promiscuity4>>
      <<case 5>><<promiscuity5>>
    <</switch>>
  <</if>>
  <<switch $RobinTemple.punish.choice>>
    <<case 'hold'>>
      <<language>>
        <<option 'EN'>>
          <<switch _punishActionCount>>
            <<case 1>>
              You hold on to <<= _punishTargetName>> tighter. <<person2>><<if _punishBoth>>They do<<else>><<He>> does<</if>> the same to you, and you brace each other.
            <<case 2>>
              You pull <<= _punishTargetName>> as close as you can, and brace yourself. <<person2>><<if _punishBoth>>They do<<else>><<He>> does<</if>> the same.
            <<case 3>>
              <<= _punishTargetName>> is your lifeline, and you refuse to let go. <<person2>><<if _punishBoth>>They<<else>><<He>><</if>> buries <<if _punishBoth>>their<<else>><<his>><</if>> head in your shoulder.
            <<case 4>>
              You're nearly squeezing the life out of each other, but it's keeping your minds off the pain.
            <<case 5>>
              You use every last ounce of strength to brace yourself with <<= _punishTargetName>>. <span class="red">You can't hold <<person2>><<if _punishBoth>>them<<else>><<him>><</if>> any tighter without hurting <<if _punishBoth>>them<<else>><<him>><</if>> more.</span>
          <</switch>>
        <<option 'CN'>>
          <<switch _punishActionCount>>
            <<case 1>>
              你把<<= _punishTargetName>>抱得更紧了，<<person2>><<if _punishBoth>>他们<<else>><<He>><</if>>也一样。你们紧紧拥住了对方。
            <<case 2>>
              你尽可能地把<<= _punishTargetName>>拉近，做好准备。<<person2>><<if _punishBoth>>他们<<else>><<He>><</if>>也和你一样。
            <<case 3>>
              <<= _punishTargetName>>是你的生命线，你不会放手的。<<person2>><<if _punishBoth>>他们<<else>><<He>><</if>>把头埋在你的肩膀上。
            <<case 4>>
              你们紧拥在一起，用几乎窒息的方式死死抱住对方，但这有助于你们从痛苦中分散注意力。
            <<case 5>>
              你用尽每一丝力气拥抱着<<= _punishTargetName>>，<span class="red"><<person2>><<if _punishBoth>>他们<<else>><<him>><</if>>在你的拥抱下几乎疼痛起来。</span>
          <</switch>>
      <</language>>
    <<case 'belt'>>
      <<language>>
        <<option 'EN'>>
          <<switch _punishActionCount>>
            <<case 1>>
              You wedge your hands into the belt, and hold it in place to stop the vibrations. <<= _punishTargetName>> <<if _punishBoth>>copy<<else>>copies<</if>> you.
            <<case 2>>
              You push the belt away from <<= _punishTargetName>>'s body. The <<person3>><<priest>> intensifies the vibrations in response.
            <<case 3>>
              You put your hands between the vibrating section of the belt and <<= _punishTargetName>>'s body. They're getting more intense by the second.
            <<case 4>>
              You clench your fists, firmly grabbing the belt. The vibrations are making your hands feel numb.
            <<case 5>>
              You can't feel your hands anymore. <span class="red">You won't be able to effectively stop the vibrations any longer.</span>
          <</switch>>
        <<option 'CN'>>
          <<switch _punishActionCount>>
            <<case 1>>
              你将手塞入腰带，紧紧握住，想要止住震动。<<= _punishTargetName>>也模仿你的样子，把手插了进去。
            <<case 2>>
              你把<<= _punishTargetName>>的腰带向外拉了拉，但<<person3>><<priest>>立马加大了震动强度。
            <<case 3>>
              你把手掌搁在腰带的震动部位和<<= _punishTargetName>>的身体中间，但它们马上震动得更为剧烈了。
            <<case 4>>
              你握紧拳头，死死扣在腰带上，震动快把你的手震麻了。
            <<case 5>>
              你已经感觉不到手掌的知觉了。<span class="red">你不能再有效地制止腰带的震动了。</span>
          <</switch>>
      <</language>>
    <<case 'hit'>>
      <<language>>
        <<option 'EN'>>
          <<switch _punishActionCount>>
            <<case 1>>
              You bring your arms up to shield <<= _punishTargetName>>'s back, taking the brunt of the hit. <<larousal>><<gpain>>
            <<case 2>>
              You brace your arms against <<= _punishTargetName>>'s back, protecting <<person2>><<if _punishBoth>>them<<else>><<him>><</if>> from harm at your own cost. <<larousal>><<gpain>>
            <<case 3>>
              You refuse to let <<= _punishTargetName>> come to further harm, blocking the whip with your arms again. The pain is almost unbearable. <<larousal>><<gpain>>
            <<case 4>>
              With one final brutal lash, <span class="red">your arms fall limp.</span> <<larousal>><<gpain>>
          <</switch>>
        <<option 'CN'>>
          <<switch _punishActionCount>>
            <<case 1>>
              你抬起双臂，护住<<= _punishTargetName>>的后背，顶住了一番抽打。<<larousal>><<gpain>>
            <<case 2>>
              你把双臂护在<<= _punishTargetName>>的背上，用自己的身体为<<person2>><<if _punishBoth>>他们<<else>><<him>><</if>>承受鞭笞。<<larousal>><<gpain>>
            <<case 3>>
              你不愿让<<= _punishTargetName>>受到更多伤害，再次用手臂挡下了鞭子，剧痛几乎到了难以承受的地步。<<larousal>><<gpain>>
            <<case 4>>
              随着最后无情的一击，<span class="red">你的双臂软软地垂下了。</span><<larousal>><<gpain>>
          <</switch>>
      <</language>>
    <<case 'plead'>>
      <<language>>
        <<option 'EN'>>
          <<switch _punishActionCount>>
            <<case 1>>
              You stare the <<person3>><<priest>> in the eyes. <<He>> falters.
            <<case 2>>
              You silently plead to the <<person3>><<priest>>. <<His>> whip doesn't raise with as much conviction.
            <<case 3>>
              The tears in your eyes seem to make the <<person3>><<priest>> pause for a moment.
            <<case 4>>
              The <<person3>><<priest>> shakes <<his>> head, and readies to strike with conviction again. <span class="red">Your pleading seems to have no further effect.</span>
          <</switch>>
        <<option 'CN'>>
          <<switch _punishActionCount>>
            <<case 1>>
              你凝视着<<person3>><<priest>>的眼睛，<<He>>动摇了。
            <<case 2>>
              你无声地向<<person3>><<priest>>乞求，<<His>>举鞭的动作没有那么坚定了。
            <<case 3>>
              你眼里的泪水似乎让<<person3>><<priest>>迟疑了一瞬。
            <<case 4>>
              <<person3>><<priest>>摇摇头，重新坚定地准备挥鞭。<span class="red">你的乞求似乎不会再有用了。</span>
          <</switch>>
      <</language>>
    <<case 'touch'>>
      <<language>>
        <<option 'EN'>>
          <<switch _punishActionCount>>
            <<case 1>>
              You give <<= _punishTargetName>>'s bottom a squeeze with your bound hands. <<person2>><<if _punishBoth>>They look<<else>><<He>> looks<</if>> at you, confused.
            <<case 2>>
              You pull <<= _punishTargetName>> in and give <<person2>><<if _punishBoth>>their<<else>><<his>><</if>> bottom a tweak. It seems to help keep <<if _punishBoth>>their<<else>><<his>><</if>> mind off the pain.
            <<case 3>>
              You manage to make contact with <<person2>><<if _punishBoth>>their<<else>><<his>><</if>> <<robin-temple-punishment-genitals _punishTarget _punishBoth>>. <<if _punishBoth>>Their<<else>><<His>><</if>> eyes close.
            <<case 4>>
              You get one of your hands firm on <<person2>><<if _punishBoth>>their<<else>><<his>><</if>> <<robin-temple-punishment-genitals _punishTarget _punishBoth>>. <<if _punishBoth>>They suppress<<else>><<He>> suppresses<</if>> moans, and the pain seems to be rapidly fading.
            <<case 5>>
              You fondle <<= _punishTargetName>> despite everything. <<person2>><<if _punishBoth>>Their<<else>><<His>><</if>> cries of pain are replaced with moans of pleasure.
          <</switch>>
        <<option 'CN'>>
          <<switch _punishActionCount>>
            <<case 1>>
              你用绑住的手往<<= _punishTargetName>>的屁股上一捏，<<person2>><<if _punishBoth>>他们<<else>><<He>><</if>>有些疑惑地看向你。
            <<case 2>>
              你把<<= _punishTargetName>>拉近，往<<person2>><<if _punishBoth>>他们<<else>><<his>><</if>>屁股上一拧。这样似乎可以帮<<if _punishBoth>>他们<<else>><<his>><</if>>忘掉疼痛。
            <<case 3>>
              你努力去触碰<<person2>><<if _punishBoth>>他们<<else>><<his>><</if>>的<<robin-temple-punishment-genitals _punishTarget _punishBoth>>，但<<if _punishBoth>>他们<<else>><<His>><</if>>双目紧闭。
            <<case 4>>
              你把一只手掌压在<<person2>><<if _punishBoth>>他们<<else>><<his>><</if>>的<<robin-temple-punishment-genitals _punishTarget _punishBoth>>上，<<if _punishBoth>>他们<<else>><<He>><</if>>忍着呻吟，疼痛似乎迅速消失了。
            <<case 5>>
              不顾其他，你开始抚弄<<= _punishTargetName>>。很快，<<person2>><<if _punishBoth>>他们<<else>><<His>><</if>>疼痛的哭喊转变成了愉悦的呻吟。
          <</switch>>
      <</language>>
    <<case 'close'>><<lanSwitch 'You close your eyes and try to shut the pain out.' '你闭上眼睛，试图隔绝痛苦。'>>
  <</switch>>
  <br><br>
  <<set _punishAttack to maplebirch.get('RobinTemple').punishmentAttack()>>
  <<if _punishAttack is 'Player'>><<violence_noncombat 30 0.3>><<gpain>>
  <<elseif _punishAttack is 'Vibrate'>><<arousal 2000>><<garousal>>
  <</if>>
  <<if _punishAttack is 'blocked'>><<lanSwitch 'You shield your companion from the lash.' '你挡住了抽向同伴的鞭子。'>>
  <<elseif _punishAttack is 'Robin,Sydney'>><<lanSwitch 'Robin and Sydney shield you from the lash.' '罗宾和悉尼为你承受了打击。'>>
  <<elseif _punishAttack is 'Robin' or _punishAttack is 'Sydney'>><<lanSwitch _punishAttack (_punishAttack is 'Robin' ? '罗宾' : '悉尼')>><<lanSwitch ' bears the lash.' '承受了鞭打。'>>
  <</if>>
  <br><br>
  <<robin-temple-punishment-options>>
<</if>>

:: RobinTemple Penance End
<<set $outside to 0>><<set $location to 'temple'>><<effects>>
<<if $RobinTemple.punish?.result is 'passed'>>
  <<set _punishJoint to $RobinTemple.punish.joint>>
  <<robin-temple-punishment-cleanup>>
  <<run maplebirch.get('RobinTemple').finishPunishment()>>
  <<pass 20>><<npc Robin>><<person1>>
  <<language>>
    <<option 'EN'>>
      You're led through the tunnel and back to the temple. Robin<<if _punishJoint>> and Sydney<</if>> cling<<if !_punishJoint>>s<</if>> to you the whole way.
      <br><br>
      <<if _punishJoint>>
        They collapse onto you when you reach the main temple, and begin sobbing. You hold each other for what feels like forever. You can't help but begin to sob yourself, after everything you've been through.
        <br><br>
        "We... we made it..." Robin looks up to you with tears running down <<nnpc_his 'Robin'>> face. "I love you." Sydney murmurs the same against your shoulder.
      <<else>>
        <<He>> collapses onto you when you reach the main temple, and begins sobbing. You hold each other for what feels like forever. You can't help but begin to sob yourself, after everything you've been through.
        <br><br>
        "We... we made it..." <<He>> looks up to you with tears running down <<his>> face. "I love you."
      <</if>>
      <br><br>

    <<option 'CN'>>
      你们穿过地道，被带回了神殿。罗宾<<if _punishJoint>>和悉尼<</if>>一路上都紧抱着你不放。
      <br><br>
      <<if _punishJoint>>
        当你们抵达主殿时，<<lanSwitch 'They' '他们'>>彻底地瘫软在你的身上，开始抽泣了起来。你们拥住对方，就好像是过了一辈子。你也忍不住开始哭泣……在经历了这一切的一切之后。
        <br><br>
        “我们……我们做到了……”罗宾抬眼看你，眼泪淌下脸颊，“我爱你。”悉尼也靠在你肩上低声说了同样的话。
      <<else>>
        当你们抵达主殿时，<<He>>彻底地瘫软在你的身上，开始抽泣了起来。你们拥住对方，就好像是过了一辈子。你也忍不住开始哭泣……在经历了这一切的一切之后。
        <br><br>
        “我们……我们做到了……”<<He>>抬眼看你，眼泪淌下脸颊，“我爱你。”
      <</if>>
      <br><br>

  <</language>>
  <<language>>
    <<option 'EN'>>
      <<if _punishJoint>>
        You continue to hold each other. Eventually Sydney stands, though <<nnpc_hes 'Sydney'>> still shakes. "I... I need to go home. <<nnpc_Mum 'Sirris'>> is probably worried sick. I'll... I'll see you both tomorrow..." <<nnpc_He 'Sydney'>> walks away, then looks back before leaving the temple, and blows you a weak kiss. Robin stays with you.
      <<else>>
        You continue to hold each other. Eventually, though <<he>> still shakes, Robin stands.
        <br><br>
        "I... I think I need to sit down," <<he>> says. You lead <<him>> to a pew, and stay with <<him>> until <<he>> stops shaking.
      <</if>>
      <<stress -3>><<lstress>>
    <<option 'CN'>>
      <<if _punishJoint>>
        你们继续拥抱着彼此。最后，尽管仍在颤抖，悉尼还是站起了身。“我……我得回家了。<<nnpc_Mum 'Sirris'>>肯定担心坏了。我……明天见……”<<nnpc_He 'Sydney'>>转身离开，在离开神殿时回头又看了你们一眼，给了一个虚弱的飞吻。罗宾留了下来，没有走。
      <<else>>
        你们继续拥抱着彼此。最后，尽管仍在颤抖，罗宾还是站起了身。
        <br><br>
        “我……我想我需要坐一会儿。”<<he>>说。你扶着<<him>>到长椅上坐下，一直陪着<<him>>，直到<<he>>不再发抖。
      <</if>>
      <<stress -3>><<lstress>>
  <</language>>
  <br><br>
<</if>>
<<getouticon>><<lanLink ['Continue', '继续'] 'Temple'>><<set $eventskip to 1>><</lanLink>><br>

:: RobinTemple Penance Hospital
<<set $outside to 0>><<set $location to 'hospital'>><<effects>>
<<if $RobinTemple.punish?.result is 'hospital'>>
  <<set _punishJoint to $RobinTemple.punish.joint>>
  <<robin-temple-punishment-cleanup>>
  <<run maplebirch.get('RobinTemple').finishPunishment()>>
  <<set $RobinTemple.hospital_day to Time.days>><<set $RobinTemple.hospital_stage to 'waiting'>>
  <<set $RobinTemple.hospital_support to C.npc.Sydney.init is 1
    and C.npc.Sirris.init is 1
    and ($sydneyromance is 1 or C.npc.Sydney.love gte 40)>>
  <<language>>
    <<option 'EN'>>
      You feel yourself being lifted onto a stretcher. You're holding onto <<if _punishJoint>>two people. They're holding onto you, too<</if>><<if !_punishJoint>>something. It's holding onto you, too<</if>>. It's warm, and makes you feel safe in a way you can't explain. Something tries to pull <<if _punishJoint>>them<</if>> away from you, so you hold on tighter. You pass out again.
    <<option 'CN'>>
      你感觉自己被举到担架上。你抓住了<<if _punishJoint>>两个人，他们也抓住了你<</if>><<if !_punishJoint>>什么东西，它也抓住了你<</if>>。那感觉非常温暖，以一种你无法理解的方式让你安心。有什么东西试图<<if _punishJoint>>把他们<</if>>从你手中拽走，于是你攥得更紧。你再次昏了过去。
  <</language>>
  <br><br>
<</if>>
<<lanLink ['Sleep', '睡觉'] 'RobinTemple Hospital Bed'>><</lanLink>><br>

