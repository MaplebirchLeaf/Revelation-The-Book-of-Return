:: RobinTemple Evaluation
<<set $outside to 0>><<set $location to "temple">><<temple_effects>><<effects>><<npc Robin>><<person1>>
<<if $RobinTemple.stage isnot 'member' or $robinromance isnot 1
  or !['monk', 'priest'].includes($temple_rank) or $RobinTemple.service lt 3
  or $RobinTemple.penance_day gte 0 or $RobinTemple.joint_sydney_penance
  or $RobinTemple.evaluation_day gte 0 and Time.days lt $RobinTemple.evaluation_day + 7
  or ($templePromised isnot '' and ($templePromised isnot 'Sydney' or !$RobinTemple.joint_consent
  or $sydneyromance isnot 1 or C.npc.Sydney.virginity.temple isnot true))
  or $player.virginity.temple isnot true or C.npc.Robin.virginity.temple isnot true>>
  <<language>>
    <<option 'EN'>>
      Jordan will not open the assessment until your vows and work records are in order.
    <<option 'CN'>>
      誓言与工作记录尚未齐备，约旦现在不会开始评估。
  <</language>>
  <br><br>
  <<icon 'temple/Robinquarters.png'>><<lanLink '回到罗宾的座位' 'RobinTemple Corner'>><</lanLink>><br>
<<else>>
  <<set $RobinTemple.evaluation_marks to 0>>
  <<set $RobinTemple.evaluation_memory to ''>>
  <<set $RobinTemple.evaluation_belief_done to false>>
  <<set $RobinTemple.evaluation_records_done to false>>
  <<set $RobinTemple.evaluation_memory_done to false>>
  <<set $RobinTemple.evaluation_interview to ''>>
  <<set $RobinTemple.evaluation_result to ''>>
  <<language>>
    <<option 'EN'>>
      Jordan shuts the side-room door and opens a notebook. "I will speak to each of you," Jordan says. "I want to know what you have chosen together, and what you would choose alone."
    <<option 'CN'>>
      约旦关上侧室的门，打开笔记本。“我会分别问你们，”约旦说，“我想知道你们一起作了什么选择，各自又会作什么选择。”
  <</language>>
  <br><br>
  <<if C.npc.Robin.trauma gte 40>>
    <<language>>
      <<option 'EN'>>
        An initiate brings the work list. Robin grips the edge of <<his>> seat and looks down. Jordan waits until <<he>> is ready to answer.
      <<option 'CN'>>
        一名见习教徒送来工作表。罗宾攥住椅子边缘，垂下目光。约旦等<<he>>准备好，才让<<he>>回答。
    <</language>>
  <<elseif C.npc.Robin.dom lte 50>>
    <<language>>
      <<option 'EN'>>
        An initiate brings the work list. Robin looks to you, then answers Jordan quietly when asked about <<his>> own work.
      <<option 'CN'>>
        一名见习教徒送来工作表。罗宾先看了看你，等约旦问起，才小声说出自己做过的工作。
    <</language>>
  <<else>>
    <<language>>
      <<option 'EN'>>
        A senior initiate arrives with the evening work list. Robin glances at you before stepping forward to explain <<his>> own part.
      <<option 'CN'>>
        一名资深见习教徒带着晚间工作表进来。罗宾看了你一眼，走上前，亲自说明<<his>>负责的事。
    <</language>>
  <</if>>
  <br><br>
  <<templeicon 'altar'>><<lanLink '让约旦查看工作记录' 'RobinTemple Evaluation Records'>><</lanLink>><br>
<</if>>

:: RobinTemple Evaluation Records
<<set $outside to 0>><<set $location to 'temple'>><<temple_effects>><<effects>><<npc Robin>><<person1>>
<<if $RobinTemple.grace gte 90>>
  <<language>>
    <<option 'EN'>>
      <span class="green">Jordan is very pleased with Robin’s contribution to the temple.</span>
    <<option 'CN'>>
      <span class="green">约旦对罗宾的神殿贡献十分满意。</span>
  <</language>>
<<elseif $RobinTemple.grace gte 75>>
  <<language>>
    <<option 'EN'>>
      <span class="teal">Jordan approves of Robin’s contribution to the temple.</span>
    <<option 'CN'>>
      <span class="teal">约旦认可罗宾对神殿的贡献。</span>
  <</language>>
<<elseif $RobinTemple.grace gte 60>>
  <<language>>
    <<option 'EN'>>
      <span class="lblue">Jordan acknowledges Robin’s contribution, but expects more work.</span>
    <<option 'CN'>>
      <span class="lblue">约旦承认罗宾的贡献，也希望<<he>>继续努力。</span>
  <</language>>
<<else>>
  <<language>>
    <<option 'EN'>>
      <span class="red">Jordan wants to see more of Robin’s contribution before approving the promise.</span>
    <<option 'CN'>>
      <span class="red">约旦认为罗宾对神殿的贡献还有待提高。</span>
  <</language>>
<</if>>
<br><br>
<<if $grace gte 90>>
  <<language>>
    <<option 'EN'>>
      <span class="green">Jordan praises your outstanding contribution to the temple.</span>
    <<option 'CN'>>
      <span class="green">约旦称赞你对神殿作出的出色贡献。</span>
  <</language>>
<<elseif $grace gte 50>>
  <<language>>
    <<option 'EN'>>
      <span class="teal">Jordan recognises the work you have done for the temple.</span>
    <<option 'CN'>>
      <span class="teal">约旦认可你为神殿做过的工作。</span>
  <</language>>
<<elseif $grace gte 1>>
  <<language>>
    <<option 'EN'>>
      <span class="lblue">Jordan acknowledges your contribution, but reminds you there is still work to do.</span>
    <<option 'CN'>>
      <span class="lblue">约旦承认你的贡献，也提醒你仍有需要努力的地方。</span>
  <</language>>
<<else>>
  <<language>>
    <<option 'EN'>>
      <span class="red">Jordan considers your contribution insufficient.</span>
    <<option 'CN'>>
      <span class="red">约旦认为你对神殿的贡献仍然不足。</span>
  <</language>>
<</if>>
<br><br>
<<if $RobinTemple.service gte 5>>
  <<if !$RobinTemple.evaluation_records_done>><<set $RobinTemple.evaluation_marks += 10>><</if>>
  <<language>>
    <<option 'EN'>>
      Jordan finds your names on several evening lists. Robin remembers a missing blanket, a wrong count in the storeroom, and the people who helped correct it. Jordan marks the page.
    <<option 'CN'>>
      约旦在几张晚间工作表上找到了你们的名字。罗宾还记得一条遗失的毯子、储藏室里记错的数量，以及帮忙改正的人。约旦在纸上作了记号。
  <</language>>
<<else>>
  <<language>>
    <<option 'EN'>>
      The work lists show that you have started helping, but the entries are few. "Come back to this when you have more to tell me," Jordan says.
    <<option 'CN'>>
      工作表上已经有你们帮忙的记录，只是还不多。“等你们有更多事可讲，再回到这个问题上。”约旦说。
  <</language>>
<</if>>
<br><br>
<<if C.npc.Robin.revelationConviction gte 120>>
  <<if !$RobinTemple.evaluation_records_done>><<set $RobinTemple.evaluation_marks += 10>><</if>>
  <<if C.npc.Robin.trauma gte 40>>
    <<language>>
      <<option 'EN'>>
        Robin struggles to answer at first. Jordan gives <<him>> time. Eventually <<he>> mentions someone <<he>> helped here, still keeping <<his>> eyes on the list.
      <<option 'CN'>>
        罗宾起初说不出话。约旦给了<<him>>一些时间。过了一会儿，<<he>>提起自己在这里帮助过的人，目光仍停在工作表上。
    <</language>>
  <<elseif C.npc.Robin.dom lte 50>>
    <<language>>
      <<option 'EN'>>
        Robin glances at you before answering quietly. "I like helping here," <<he>> says, then names a duty <<he>> hopes to keep doing.
      <<option 'CN'>>
        罗宾看了你一眼，才小声回答。“我喜欢在这里帮忙。”<<he>>说，随后提起一项想继续做的工作。
    <</language>>
  <<else>>
    <<language>>
      <<option 'EN'>>
        Asked why <<he>> keeps coming to the temple, Robin speaks about the people <<he>> has met here and the duties <<he>> wants to keep doing.
      <<option 'CN'>>
        约旦问罗宾为何一直来神殿。罗宾说起在这里认识的人，以及<<he>>想继续做的事。
    <</language>>
  <</if>>
<<else>>
  <<language>>
    <<option 'EN'>>
      Robin answers carefully, pausing when Jordan asks whether joining was entirely <<his>> choice.
    <<option 'CN'>>
      罗宾答得谨慎。约旦问加入神殿是否完全出于<<his>>自己的选择时，<<he>>停顿了片刻。
  <</language>>
<</if>>
<br><br>
<<language>>
  <<option 'EN'>>
    Jordan closes the work list. "Tell me where your trust began," Jordan says. Robin looks at you, waiting to hear which memory you choose.
  <<option 'CN'>>
    约旦合上工作表。“说说你们从什么时候开始信任彼此。”约旦说。罗宾看着你，等你选一个共同的回忆。
<</language>>
<br><br>
<<set $RobinTemple.evaluation_records_done to true>>
<<socialiseicon 'ask'>><<lanLink '说起你们初次相识' 'RobinTemple Evaluation Memory'>><<set $RobinTemple.evaluation_memory to 'first'>><</lanLink>><br>
<<if C.npc.Robin.crossdress gte 2>>
  <<socialiseicon 'ask'>><<lanLink '说起罗宾对衣服的选择' 'RobinTemple Evaluation Memory'>><<set $RobinTemple.evaluation_memory to 'clothes'>><</lanLink>><br>
<</if>>
<<if $robinSeen.includes('homeBandage') or $robinSeen.includes('favouriteFlower')>>
  <<loveicon 'hug'>><<lanLink '说起孤儿院里相互照顾的日子' 'RobinTemple Evaluation Memory'>><<set $RobinTemple.evaluation_memory to 'care'>><</lanLink>><br>
<</if>>
<<if $robinSeen.includes('pilloryRescue') or $robinSeen.includes('ubEscapeTogether')
  or $robinSeen.includes('templeRescue')>>
  <<socialiseicon 'ask'>><<lanLink '说起你们一起渡过的险境' 'RobinTemple Evaluation Memory'>><<set $RobinTemple.evaluation_memory to 'rescue'>><</lanLink>><br>
<</if>>
<<if maplebirch.get('Robin')
  and ($RobinExpansion?.shop or $RobinExpansion?.tutor
    or $RobinExpansion?.lemonade gt 0 or $RobinExpansion?.chocolate gt 0)>>
  <<socialiseicon 'ask'>><<lanLink '说起你们一起打理的生意' 'RobinTemple Evaluation Memory'>><<set $RobinTemple.evaluation_memory to 'work'>><</lanLink>><br>
<</if>>
<<if maplebirch.get('Robin') and $RobinExpansion?.meteorDay gte 0>>
  <<loveicon 'hug'>><<lanLink '说起一起看过的流星' 'RobinTemple Evaluation Memory'>><<set $RobinTemple.evaluation_memory to 'sky'>><</lanLink>><br>
<</if>>

:: RobinTemple Evaluation Memory
<<set $outside to 0>><<set $location to 'temple'>><<temple_effects>><<effects>><<npc Robin>><<person1>>
<<switch $RobinTemple.evaluation_memory>>
  <<case 'clothes'>>
    <<language>>
      <<option 'EN'>>
        You speak about the clothes Robin wanted to try. Jordan asks whether the choice was Robin's. You leave <<him>> room to answer. "I wanted to," <<he>> says. "It was easier when I knew I wouldn't be laughed at." Jordan asks what you did to help, rather than treating the clothes themselves as a fault.
      <<option 'CN'>>
        你说起罗宾曾想试穿的衣服。约旦问，这是否是罗宾自己的选择。你留出机会让<<him>>作答。“是我想试的，”<<he>>说，“知道不会被笑话，就容易些了。”约旦接着问你做过什么来支持罗宾，没有把衣服本身当成过错。
    <</language>>
    <<if !$RobinTemple.evaluation_memory_done>><<set $RobinTemple.evaluation_marks += 6>><</if>>
  <<case 'care'>>
    <<language>>
      <<option 'EN'>>
        You recall a small kindness at the orphanage. Robin remembers it differently, and fills in a part you had forgotten. Jordan listens to both accounts.
      <<option 'CN'>>
        你说起孤儿院里的一件小事。罗宾记得与你不同，又补上了你忘记的部分。约旦听完了你们各自的讲述。
    <</language>>
    <<if !$RobinTemple.evaluation_memory_done>><<set $RobinTemple.evaluation_marks += 6>><</if>>
  <<case 'rescue'>>
    <<language>>
      <<option 'EN'>>
        You speak of a day when one of you needed help. Robin says what frightened <<him>> most, then what made <<him>> trust you enough to go on.
      <<option 'CN'>>
        你说起其中一人需要帮助的那一天。罗宾讲出当时最害怕的事，也讲出<<he>>后来为何愿意相信你。
    <</language>>
    <<if !$RobinTemple.evaluation_memory_done>><<set $RobinTemple.evaluation_marks += 6>><</if>>
  <<case 'work'>>
    <<if C.npc.Robin.trauma gte 40 or C.npc.Robin.dom lte 50>>
      <<language>>
        <<option 'EN'>>
          You describe the work you share. Robin lets you finish, then quietly adds something <<he>> did <<himself>>. Jordan turns to <<him>> and asks about it.
        <<option 'CN'>>
          你说起共同做过的生意。罗宾等你说完，才轻声补上一件自己做过的事。约旦转向<<him>>，继续问了下去。
      <</language>>
    <<else>>
      <<language>>
        <<option 'EN'>>
          You describe the work you helped Robin begin. Robin corrects you when you claim too much credit. <<He>> tells Jordan which decisions <<he>> made alone, and which burdens you shared.
        <<option 'CN'>>
          你说起曾陪罗宾一起做的生意。你把功劳揽得太多时，罗宾纠正了你。<<He>>告诉约旦，哪些决定是自己作的，哪些重担是与你一起分担的。
      <</language>>
    <</if>>
    <<if maplebirch.get('Robin') and $RobinExpansion?.tutor>>
      <br><br><<language>>
        <<option 'EN'>>
          Jordan asks about the tutoring. Robin describes preparing lessons and fitting them around school. "I still have to do the work myself," <<he>> says. Jordan records that distinction.
        <<option 'CN'>>
          约旦问起家教。罗宾说起如何备课、怎样把它排在上学之外。“活还是得我自己做。”<<he>>说。约旦把这一区别记下来。
      <</language>>
    <<elseif maplebirch.get('Robin') and !$RobinExpansion?.shop>>
      <br><br><<language>>
        <<option 'EN'>>
          Robin describes the stall rather than a shop that has not opened. <<He>> remembers checking the supplies and counting what was left at the end of the day. Jordan asks what each of you contributed.
        <<option 'CN'>>
          罗宾说的是摊位，没有把尚未开业的店铺算进去。<<He>>记得如何检查物资，又怎样在一天结束时清点剩下的东西。约旦问起你们各自做了什么。
      <</language>>
    <</if>>
    <<if !$RobinTemple.evaluation_memory_done>><<set $RobinTemple.evaluation_marks += 6>><</if>>
  <<case 'sky'>>
    <<language>>
      <<option 'EN'>>
        You recall the meteor shower. Robin remembers where you stood and how long you waited in the cold. "We stayed because we both wanted to," <<he>> tells Jordan.
      <<option 'CN'>>
        你说起那场流星雨。罗宾还记得你们站在哪里，在冷风里等了多久。“我们留下，是因为都想留下。”<<he>>对约旦说。
    <</language>>
    <<if !$RobinTemple.evaluation_memory_done>><<set $RobinTemple.evaluation_marks += 6>><</if>>
  <<default>>
    <<if C.npc.Robin.trauma gte 40>>
      <<language>>
        <<option 'EN'>>
          You tell Jordan how you first met. Robin listens quietly. When Jordan asks <<him>> about it, <<he>> nods and adds a few words.
        <<option 'CN'>>
          你告诉约旦，你们是怎样认识的。罗宾安静地听着。约旦向<<him>>问起时，<<he>>点了点头，又补充了几句话。
      <</language>>
    <<elseif C.npc.Robin.dom lte 50>>
      <<language>>
        <<option 'EN'>>
          You tell Jordan how you first met. Robin smiles shyly and waits for a pause before adding a detail you forgot.
        <<option 'CN'>>
          你告诉约旦，你们是怎样认识的。罗宾腼腆地笑了笑，等你停下来，才补上一处你忘记的细节。
      <</language>>
    <<else>>
      <<language>>
        <<option 'EN'>>
          You tell Jordan how you first met. Robin interrupts once to correct a detail, and you both laugh. The story matters less for its beginning than for everything you have done since.
        <<option 'CN'>>
          你告诉约旦，你们是怎样认识的。罗宾打断你，纠正了一处细节。你们都笑了。比起开头，这段相识之后的日子更值得说。
      <</language>>
    <</if>>
    <<if !$RobinTemple.evaluation_memory_done>><<set $RobinTemple.evaluation_marks += 3>><</if>>
<</switch>>
<<set $RobinTemple.evaluation_memory_done to true>>
<br><br>
<<language>>
  <<option 'EN'>>
    Jordan asks how the faith you practise here fits the life you and Robin lead outside these walls.
  <<option 'CN'>>
    约旦问起你在神殿坚持的信念，要怎样融进你与罗宾在神殿外的生活。
<</language>>
<br><br>
<<templeicon 'altar'>><<lanLink '回答约旦对信仰的疑问' 'RobinTemple Evaluation Belief'>><</lanLink>><br>

:: RobinTemple Evaluation Belief
<<set $outside to 0>><<set $location to 'temple'>><<temple_effects>><<effects>><<npc Robin>><<person1>>
<<if !$RobinTemple.evaluation_belief_done>>
  <<set $RobinTemple.evaluation_belief_done to true>>
  <<if $angel gte 6>>
    <<language>>
      <<option 'EN'>>
        Jordan notices the light around you and records it with approval. Robin stares at the glow for a moment, then looks back at you.
      <<option 'CN'>>
        约旦注意到你周身的光，认可地在纸上记了一笔。罗宾望着光芒出了会儿神，又看向你。
    <</language>>
    <<set $RobinTemple.evaluation_marks += 12>>
  <<elseif $fallenangel gte 2 or $demon gte 6>>
    <<if C.npc.Robin.trauma gte 40>>
      <<language>>
        <<option 'EN'>>
          Jordan studies your changed appearance. Robin tenses beside you. When Jordan asks about your work, <<he>> manages to name a task you completed together.
        <<option 'CN'>>
          约旦端详着你变化后的模样。罗宾在你身旁绷紧了身子。约旦问起你们做过的事时，<<he>>总算说出了一项共同完成的工作。
      <</language>>
    <<elseif C.npc.Robin.dom lte 50>>
      <<language>>
        <<option 'EN'>>
          Jordan studies your changed appearance. Robin hesitates. "We have been helping here," <<he>> says quietly. "Does that count too?"
        <<option 'CN'>>
          约旦端详着你变化后的模样。罗宾迟疑片刻。“我们也一直在这里帮忙，”<<he>>小声说，“这些……也能算上吗？”
      <</language>>
    <<else>>
      <<language>>
        <<option 'EN'>>
          Jordan studies your changed appearance. "You know we have been helping here," Robin says. "Could you look at that too?"
        <<option 'CN'>>
          约旦端详着你变化后的模样。“你知道我们一直在这里帮忙，”罗宾说，“也能看看那些吗？”
      <</language>>
    <</if>>
    <<if $forgiveintro is 1>>
      <<language>>
        <<option 'EN'>>
          Jordan recalls that you came to ask for forgiveness rather than hide. Jordan marks the work you have done since.
        <<option 'CN'>>
          约旦记得你曾主动来寻求宽恕，没有躲藏，也记下你后来做过的工作。
      <</language>>
      <<set $RobinTemple.evaluation_marks += 5>>
    <<else>>
      <<language>>
        <<option 'EN'>>
          "I need to see more than one evening of work," Jordan says. Robin agrees that you can return with a fuller record.
        <<option 'CN'>>
          “我得看到的不只是一晚的工作，”约旦说。罗宾也同意，你们可以带着更完整的记录再来。
      <</language>>
      <<set $RobinTemple.evaluation_marks -= 8>>
    <</if>>
  <<elseif $purity gte 900>>
    <<language>>
      <<option 'EN'>>
        Jordan notes how carefully you have kept the temple’s discipline. <<nnpc_He 'Jordan'>> asks you to continue doing so. Robin listens beside you.
      <<option 'CN'>>
        约旦记下你认真遵守神殿戒律的表现，要求你继续保持。罗宾在你身旁听着。
    <</language>>
    <<set $RobinTemple.evaluation_marks += 8>>
  <<else>>
    <<language>>
      <<option 'EN'>>
        You speak about the work you return to even when no one has asked you. Robin names a small task you had forgotten. Jordan writes it down.
      <<option 'CN'>>
        你说起没人要求时仍会主动做的事。罗宾又补上一件你忘了的小事。约旦把它记下。
    <</language>>
    <<set $RobinTemple.evaluation_marks += 2>>
  <</if>>
  <br><br>
<</if>>
<<language>>
  <<option 'EN'>>
    Jordan asks you to wait outside while speaking to Robin alone. The corridor is quiet enough to hear through the door if you move close.
  <<option 'CN'>>
    约旦请你到外面等候，想单独和罗宾谈谈。走廊很安静，靠近门边就能听见里面的话。
<</language>>
<br><br>
<<socialiseicon 'ask'>><<lanLink '留在原处等候 (0:15)' 'RobinTemple Evaluation Wait'>><<pass 15>><</lanLink>><br>
<<if currentSkillValue('skulduggery') gte 400>>
  <<socialiseicon 'ask'>><<lanLink '试着偷听 (0:15)' 'RobinTemple Evaluation Eavesdrop'>><<pass 15>><</lanLink>><br>
<</if>>

:: RobinTemple Evaluation Wait
<<set $outside to 0>><<set $location to 'temple'>><<temple_effects>><<effects>><<npc Robin>><<person1>>
<<language>>
  <<option 'EN'>>
    You wait where Jordan asked you to. A door opens down the hall, and an initiate passes with clean linen. By the time Robin emerges, <<he>> seems less tense.
  <<option 'CN'>>
    你照约旦的话留在原地。一名见习教徒抱着干净的布巾从走廊经过。罗宾出来时，看起来没那么紧张了。
<</language>>
<br><br>
<<if C.npc.Robin.trauma gte 40>>
  <<language>>
    <<option 'EN'>>
      "I tried to explain," Robin whispers. <<He>> rubs <<his>> hands together. "Jordan said I could take my time."
    <<option 'CN'>>
      “我尽量说清楚了。”罗宾低声说，搓了搓双手。“约旦说，不用急着回答。”
  <</language>>
<<elseif C.npc.Robin.dom lte 50>>
  <<language>>
    <<option 'EN'>>
      "I think I said it right," Robin says, glancing at the door. "<<nnpc_He 'Jordan'>> wants to talk to you now."
    <<option 'CN'>>
      “我想，我应该说清楚了。”罗宾看了一眼门。“<<nnpc_He 'Jordan'>>现在想和你谈谈。”
  <</language>>
<<else>>
  <<language>>
    <<option 'EN'>>
      "I told <<nnpc_him 'Jordan'>> what I think," Robin says. "Now it is your turn."
    <<option 'CN'>>
      “我把自己的想法告诉<<nnpc_him 'Jordan'>>了，”罗宾说，“现在轮到你。”
  <</language>>
<</if>>
<<if $RobinTemple.evaluation_interview is ''>>
  <<set $RobinTemple.evaluation_interview to 'wait'>>
  <<set $RobinTemple.evaluation_marks += 3>>
<</if>>
<br><br>
<<templeicon 'altar'>><<lanLink '回答约旦的问题' 'RobinTemple Evaluation Questions'>><</lanLink>><br>

:: RobinTemple Evaluation Eavesdrop
<<set $outside to 0>><<set $location to 'temple'>><<temple_effects>><<effects>><<npc Robin>><<person1>>
<<if $RobinTemple.evaluation_interview is ''>>
  <<if currentSkillValue('skulduggery') gte random(350, 750)>>
    <<set $RobinTemple.evaluation_interview to 'heard'>>
    <<set $RobinTemple.evaluation_marks += 2>>
  <<else>>
    <<set $RobinTemple.evaluation_interview to 'caught'>>
    <<set $RobinTemple.evaluation_marks -= 5>>
  <</if>>
<</if>>
<<if $RobinTemple.evaluation_interview is 'heard'>>
  <<if C.npc.Robin.trauma gte 40>>
    <<language>>
      <<option 'EN'>>
        There is a long silence before Robin answers. "I do want to be here," <<he>> says quietly. Jordan asks what work <<he>> feels able to do, and waits for <<him>> to answer.
      <<option 'CN'>>
        屋里安静了好一会儿，罗宾才低声回答：“我确实想来这里。”约旦问<<he>>觉得自己能做哪些工作，等着<<he>>回答。
    <</language>>
  <<elseif C.npc.Robin.dom lte 50>>
    <<language>>
      <<option 'EN'>>
        Robin asks whether <<he>> can still earn money and help the children at the orphanage. "Of course," Jordan says. "But I also expect you to carry out your duties here."
      <<option 'CN'>>
        罗宾问，自己是否还能挣钱，帮孤儿院里的孩子。“当然，”约旦说，“但我也要求你履行这里的职责。”
    <</language>>
  <<else>>
    <<language>>
      <<option 'EN'>>
        You catch Robin saying that <<he>> wants to remain responsible for <<his>> business and the children, whatever the temple calls <<him>>. Jordan asks if <<he>> can still promise to return here when needed. "Yes," Robin says.
      <<option 'CN'>>
        你听见罗宾说，无论神殿如何称呼<<him>>，<<he>>都想继续照顾生意和孤儿院的孩子。约旦问，需要时<<he>>是否仍愿意回来。“愿意，”罗宾答道。
    <</language>>
  <</if>>
<<elseif $RobinTemple.evaluation_interview is 'caught'>>
  <<language>>
    <<option 'EN'>>
      The door opens while you are leaning close. Jordan sees you and waits until you step back. "You will have your own turn to speak," Jordan says.
    <<option 'CN'>>
      你靠近时，门忽然开了。约旦看见你，等你退开。“你会有自己发言的机会。”约旦说。
  <</language>>
<<else>>
  <<language>>
    <<option 'EN'>>
      Jordan has already spoken to Robin alone. Your own questions are next.
    <<option 'CN'>>
      约旦已经单独问过罗宾，接下来轮到你回答。
  <</language>>
<</if>>
<br><br>
<<templeicon 'altar'>><<lanLink '回答约旦的问题' 'RobinTemple Evaluation Questions'>><</lanLink>><br>

:: RobinTemple Evaluation Questions
<<set $outside to 0>><<set $location to 'temple'>><<temple_effects>><<effects>><<npc Robin>><<person1>>
<<language>>
  <<option 'EN'>>
    Jordan lets you back in. "A promise does not make one person responsible for the other," Jordan says. "Tell me what you mean to offer."
  <<option 'CN'>>
    约旦让你回到屋里。“承诺不是让一个人替另一个人承担所有事，”约旦说，“告诉我，你愿意付出什么。”
<</language>>
<br><br>
<<socialiseicon 'ask'>><<lanLink '告诉约旦你真正能遵守的承诺' 'RobinTemple Evaluation Result'>><<set $RobinTemple.evaluation_style to 'honest'>><</lanLink>><br>
<<loveicon 'hug'>><<lanLink '承诺替罗宾挡下所有事' 'RobinTemple Evaluation Result'>><<set $RobinTemple.evaluation_style to 'protective'>><</lanLink>><br>

:: RobinTemple Evaluation Result
<<set $outside to 0>><<set $location to "temple">><<temple_effects>><<npc Robin>><<person1>>
<<if $RobinTemple.evaluation_result is ''>>
  <!-- 沿用旧版双方贡献分档，在结果页直接计算，避免重访工作记录时重复加分。 -->
  <<set _robinContributionScore to $RobinTemple.grace gte 90 ? 10 : $RobinTemple.grace gte 75 ? 5 : $RobinTemple.grace gte 60 ? 2 : -5>>
  <<set _playerContributionScore to $grace gte 90 ? 10 : $grace gte 50 ? 5 : $grace gte 1 ? 2 : -5>>
  <<set _score to $RobinTemple.service * 5 + _robinContributionScore + _playerContributionScore + C.npc.Robin.dom / 2 - C.npc.Robin.trauma / 2 + C.npc.Robin.revelationConviction / 4 + $RobinTemple.evaluation_marks>>
  <<if $RobinTemple.evaluation_style is "honest">><<set _score += 10>><<else>><<set _score -= 10>><</if>>
  <<if $RobinTemple.stage is 'member' and $robinromance is 1
    and ['monk', 'priest'].includes($temple_rank) and $RobinTemple.service gte 3
    and $RobinTemple.penance_day lt 0 and !$RobinTemple.joint_sydney_penance and _score gte 105 and C.npc.Robin.revelationConviction gte 110
    and ($templePromised is '' or $templePromised is 'Sydney' and $RobinTemple.joint_consent)
    and $player.virginity.temple is true and C.npc.Robin.virginity.temple is true
    and ($templePromised isnot 'Sydney' or $sydneyromance is 1 and C.npc.Sydney.virginity.temple is true)>>
    <<set $RobinTemple.stage to 'approved'>>
    <<set $RobinTemple.evaluation_result to 'passed'>>
  <<else>>
    <<set $RobinTemple.evaluation_result to 'failed'>>
    <<set $RobinTemple.evaluation_day to Time.days>>
  <</if>>
<</if>>
<<if $RobinTemple.evaluation_result is 'passed'>>
  <<language>>
    <<option 'EN'>>
      Jordan checks the notes against your work records, then nods. "You have both shown me enough."
    <<option 'CN'>>
      约旦把笔记和工作记录对照了一遍，随后点头。“你们两人的表现已经足够了。”
  <</language>>
  <br><br>
  <<if C.npc.Robin.trauma gte 40>>
    <<language>>
      <<option 'EN'>>
        Robin lets out a breath <<he>> had been holding. <<He>> looks at you, still gripping the edge of <<his>> seat.
      <<option 'CN'>>
        罗宾长长地松了口气。<<He>>望向你，手仍攥着椅子边缘。
    <</language>>
  <<elseif C.npc.Robin.dom lte 50>>
    <<language>>
      <<option 'EN'>>
        Robin looks up in surprise, then smiles at you. "We did it," <<he>> whispers.
      <<option 'CN'>>
        罗宾惊讶地抬起头，随后朝你笑了。“我们通过了。”<<he>>小声说。
    <</language>>
  <<else>>
    <<language>>
      <<option 'EN'>>
        Robin smiles and reaches for your hand. "Thank you," <<he>> tells Jordan.
      <<option 'CN'>>
        罗宾笑着伸手牵住你，又向约旦道谢。
    <</language>>
  <</if>>
  <br><br>
  <<language>>
    <<option 'EN'>>
      "You may make the promise here. Come back when you are both ready."
    <<option 'CN'>>
      “你们可以在这里立誓。准备好了，就一起来找我。”
  <</language>>
  <br><br><<language>>
    <<option 'EN'>>
      <span class="green">The rite is approved.</span>
    <<option 'CN'>>
      <span class="green">仪式获准举行。</span>
  <</language>>
<<else>>
  <<language>>
    <<option 'EN'>>
      Jordan closes the notebook. "There is care between you, but you have not yet shown me how this promise will hold when life asks more of you. Keep working together. Come back in a week."
    <<option 'CN'>>
      约旦合上笔记本。“你们彼此关心，但我还没看到，当生活要求更多时，这份承诺要如何维系。继续一起做事，一周后再来。”
  <</language>>
  <br><br>
  <<if C.npc.Robin.trauma gte 40>>
    <<language>>
      <<option 'EN'>>
        Robin leaves quietly beside you. Outside, <<he>> asks whether you will come with <<him>> next time too.
      <<option 'CN'>>
        罗宾安静地走在你身旁。出了门，<<he>>问下次你还会不会陪<<him>>一起来。
    <</language>>
  <<else>>
    <<language>>
      <<option 'EN'>>
        Robin is disappointed, but <<he>> takes your hand on the way out.
      <<option 'CN'>>
        罗宾有些失望，出门时却还是牵住了你的手。
    <</language>>
  <</if>>
  <br><br><<language>>
    <<option 'EN'>>
      <span class="blue">You can request another evaluation in one week.</span>
    <<option 'CN'>>
      <span class="blue">一周后可以重新申请评估。</span>
  <</language>>
<</if>>
<br><br>
<<templeicon "quarters">><<lanLink '返回神殿宿舍' 'Temple Quarters'>><</lanLink>><br>
