:: RobinTemple Confession Widgets [widget]
<<widget 'robin-temple-confession-band'>>
  <!-- 原版以 _sydneyStatus 分档，罗宾用信念值对应 belief/doubt/steady。 -->
  <<set _robinBand to C.npc.Robin.conviction gte 20 ? 'belief' : C.npc.Robin.doubt gte 20 ? 'doubt' : 'steady'>>
<</widget>>

<<widget 'robin-temple-confession-lewd'>>
  <<if !$robinSeen.includes('lewd')>>
    <<set $robinSeen.pushUnique('lewd')>>
    <<language>>
      <<option 'EN'>>
        <<if C.npc.Robin.doubt gte 20>>
          "<span class="green">I've been waiting for this since I joined.</span> I was starting to think we'd never get the chance again."
        <<else>>
          "<span class="green">I... I've never done anything like this in here before.</span>" <<He>> can't look at you. You take <<his>> hand and tell <<him>> you'll stop the moment <<he>> asks. It takes <<him>> a while to answer. "O-okay. I trust you."
        <</if>>
      <<option 'CN'>>
        <<if C.npc.Robin.doubt gte 20>>
          “<span class="green">进神殿之后我一直在等这一天。</span>我本来以为再也没有机会了。”
        <<else>>
          “<span class="green">我……我在这种地方从来没做过。</span>”<<He>>不敢看你。你握住<<his>>手，告诉<<him>>只要开口你就会停下。<<He>>过了好一会儿才回答。“好、好的。我相信你。”
        <</if>>
    <</language>>
  <</if>>
<</widget>>

<<widget 'robin-temple-confession-expose'>>
  <<if C.npc.Robin.chastity.penis.includes('chastity') or C.npc.Robin.chastity.vagina.includes('chastity')>>
    <<if $RobinTemple.clasp_discussed>>
      <<if $npcSub or $combat isnot 1>>
        <<language>>
          <<option 'EN'>>You get a glimpse of <<nnpc_his 'Robin'>> protected <<robin-temple-punishment-genitals 'Robin' 'short'>>.<<option 'CN'>>你瞥见了<<nnpc_his 'Robin'>>被遮住的<<robin-temple-punishment-genitals 'Robin' 'short'>>。
        <</language>>
      <</if>>
    <<else>>
      <<set $RobinTemple.clasp_discussed to true>>
      <<if $npcSub or $combat isnot 1>>
        <<language>>
          <<option 'EN'>>You catch sight of the chastity belt <<he>>'s wearing. <<option 'CN'>>你看见了<<him>>身上的贞操带。
        <</language>>
      <</if>>
      <<language>>
        <<option 'EN'>>"I... I should have told you earlier. I'm sorry."<<option 'CN'>>“我……应该提前告诉你的，抱歉。”
      <</language>>
    <</if>>
  <<else>>
    <<language>>
      <<option 'EN'>>You get an unobstructed view of <<his>> <<robin-temple-punishment-genitals 'Robin'>>.<<option 'CN'>>你可以清楚地看到<<his>>的<<robin-temple-punishment-genitals 'Robin'>>。
    <</language>>
  <</if>>
<</widget>>

<<widget 'robin-temple-confession-options'>>
  <<if $attendant.includes('robin')>>
    <br><br>
    <<language>>
      <<option 'EN'>>How do you respond?<<option 'CN'>>你要如何回应？
    <</language>>
    <br>
    <<templeicon 'altar'>><<lanLink ['Forgive', '宽恕'] 'RobinTemple Confession Forgive'>><</lanLink>><br>
    <<templeicon 'altar'>><<lanLink ['Repent', '规劝'] 'RobinTemple Confession Repent'>><</lanLink>><br>
    <<templeicon 'altar'>><<lanLink ['Contrition', '赎罪'] 'RobinTemple Confession Contrition'>><</lanLink>><br>
    <<if $robinSeen.includes('confessionRevealed') and $robinromance is 1>>
      <<loveicon 'kiss'>><<lanLink ['Invite Robin to your side of the booth', '请罗宾到你这侧来'] 'RobinTemple Confession Tempt'>><<set $phase to 1>><</lanLink>><br>
    <</if>>
    <<lanLink ['Purge', '净化'] 'RobinTemple Confession Purge'>><<if !$temple_confessor_intro>><<promiscuous1>><</if>><</lanLink>><br>
  <</if>>
<</widget>>

<<widget 'robin-temple-confession-event'>>
  <!-- 对照原版 Temple Confess 的 confession_sydney_* 事件池，改为罗宾。 -->
  <<if maplebirch.get('RobinTemple').member
    and $RobinTemple.confession_day isnot Time.days
    and $confessionsTaken gte 5
    and getRobinLocation() is 'temple' and !$robinmissing>>
    <<run statusCheck('Robin')>>
    <<if $RobinTemple.templePromised is 'Robin' and $RobinTemple.intimacy_day is Time.days>>
      <<addinlineevent 'confession_robin_promised_1' 4>>
        <<set _noOptions to true>><<npc Robin>><<person1>><<set $attendant to 'robin_promised'>>
        <<set $RobinTemple.confession_day to Time.days>>
        <<if $robinSeen.includes('confessionRevealed')>>
          <<lanSwitch '<span class="blue">You hear three knocks on the door frame.</span>' '<span class="blue">你听到门框上传来三声敲门声。</span>'>>
        <</if>>
        <<language>>
          <<option 'EN'>>
            A <<personssimple>> voice greets you. "Forgive me, <<sister>>, for I have... sinned? I'm... unsure."
            <br><br>
            <<He>> goes silent. You encourage <<him>> to continue.
            <br><br>
            "Me and the... the one I love. We went through the Rite of Promise, but... we've already been intimate today. It feels so sinful, yet I can't seem to get enough of <<pher>> touch."
          <<option 'CN'>>
            你听到了一个<<personssimple>>的声音。“请宽恕我，<<sister>>，我……好像犯下罪过了？我……我也不太确定。”
            <br><br>
            <<He>>沉默了。你鼓励<<him>>继续。
            <br><br>
            “我爱人和我。我们进行了承诺仪式，但是……我们今天已经做过亲密的事了。这感觉很罪恶，可我就是无法抗拒<<pher>>的触碰。”
        <</language>>
        <<robin-temple-confession-options>>
      <</addinlineevent>>
    <<elseif $RobinTemple.templePromised is 'Robin' and $RobinTemple.intimacy_count gte 3>>
      <<addinlineevent 'confession_robin_promised_2' 3>>
        <<set _noOptions to true>><<npc Robin>><<person1>><<set $attendant to 'robin_promised'>>
        <<set $RobinTemple.confession_day to Time.days>>
        <<if $robinSeen.includes('confessionRevealed')>>
          <<lanSwitch '<span class="blue">You hear three knocks on the door frame.</span>' '<span class="blue">你听到门框上传来三声敲门声。</span>'>>
        <</if>>
        <<language>>
          <<option 'EN'>>
            A <<personssimple>> voice greets you. "Forgive me, <<sister>>, for I have... sinned? I'm... unsure."
            <br><br>
            <<He>> goes silent. You encourage <<him>> to continue.
            <br><br>
            "Me and the one I love... we went through the Rite of Promise, but... being with <<phim>> still feels sinful."
          <<option 'CN'>>
            你听到了一个<<personssimple>>的声音。“请宽恕我，<<sister>>，我……好像犯下罪过了？我……我也不太确定。”
            <br><br>
            <<He>>沉默了。你鼓励<<him>>继续。
            <br><br>
            “我爱人和我。我们进行了承诺仪式，但是……我们之间的亲密行为真的是很罪恶。”
        <</language>>
        <<robin-temple-confession-options>>
      <</addinlineevent>>
    <<elseif $robinromance is 1 and $RobinTemple.intimacy_count gte 1>>
      <<addinlineevent 'confession_robin_romance' 2>>
        <<set _noOptions to true>><<npc Robin>><<person1>><<set $attendant to 'robin_romance'>>
        <<set $RobinTemple.confession_day to Time.days>>
        <<if $robinSeen.includes('confessionRevealed')>>
          <<lanSwitch '<span class="blue">You hear three knocks on the door frame.</span>' '<span class="blue">你听到门框上传来三声敲门声。</span>'>>
        <</if>>
        <<language>>
          <<option 'EN'>>
            A <<personssimple>> voice greets you. "Forgive me, <<sister>>, for I have sinned. I've been intimate with someone.
            <<if C.npc.Robin.chastity.penis.includes('chastity') or C.npc.Robin.chastity.vagina.includes('chastity')>>
              My chastity device has stopped me from breaking my vow, but I confess that I've had thoughts of removing it."
            <<elseif C.npc.Robin.virginity.temple is true>>
              I haven't broken my vow, but... I've come close to it."
            <<else>>
              We've done... a lot."
            <</if>>
          <<option 'CN'>>
            你听到一个<<personssimple>>的声音。“请宽恕我，<<sister>>，我犯下了罪过。我和别人进行了亲密行为。
            <<if C.npc.Robin.chastity.penis.includes('chastity') or C.npc.Robin.chastity.vagina.includes('chastity')>>
              加入神殿后让我无法打破誓约，但我承认，我想移除装置。”
            <<elseif C.npc.Robin.virginity.temple is true>>
              我还没有违背誓约，但是……也差不多了。”
            <<else>>
              我们做了……很多。”
            <</if>>
        <</language>>
        <<robin-temple-confession-options>>
      <</addinlineevent>>
    <<elseif !($robinromance is 1) and C.npc.Robin.love gte 60>>
      <<addinlineevent 'confession_robin_love' 1>>
        <<set _noOptions to true>><<npc Robin>><<person1>><<set $attendant to 'robin_love'>>
        <<set $RobinTemple.confession_day to Time.days>>
        <<language>>
          <<option 'EN'>>
            A <<personssimple>> voice greets you. "Forgive me, <<sister>>, for I have sinned. I've coveted someone close to me,
            <<if $temple_rank isnot undefined and $temple_rank isnot 'initiate'>>
              who also holds the rank of <<temple_title>> here."
            <<else>>
              who I've grown up alongside."
            <</if>>
            <br><br>
            "<<Sister>>... they don't even know. These feelings won't go away. It's... it's tearing me apart inside."
          <<option 'CN'>>
            你听到一个<<personssimple>>的声音。“请宽恕我，<<sister>>，我犯下了罪过。我贪恋着身边很近的一个人，
            <<if $temple_rank isnot undefined and $temple_rank isnot 'initiate'>>
              <<he>>在神殿里也持有<<temple_title>>的位阶。”
            <<else>>
              我是和<<he>>一起长大的。”
            <</if>>
            <br><br>
            “<<Sister>>……<<he>>根本不知道。这些感觉赶不走。它快把我从里面撕开了。”
        <</language>>
        <<robin-temple-confession-options>>
      <</addinlineevent>>
    <</if>>
    <<if $RobinTemple.templePromised is 'Robin' and $robinSeen.includes('punishment')>>
      <<addinlineevent 'confession_robin_doubt' 1>>
        <<set _noOptions to true>><<npc Robin>><<person1>><<set $attendant to 'robin_doubt'>>
        <<set $RobinTemple.confession_day to Time.days>>
        <<if $robinSeen.includes('confessionRevealed')>>
          <<lanSwitch '<span class="blue">You hear three knocks on the door frame.</span>' '<span class="blue">你听到门框上传来三声敲门声。</span>'>>
        <</if>>
        <<language>>
          <<option 'EN'>>
            A <<personssimple>> voice greets you. "Forgive me, <<sister>>, for I have sinned," <<he>> says.
            <<if C.npc.Robin.doubt gte 20>>
              <br><br>
              "I've got doubts. I'm promised to someone, and we get to... do it, whenever we want because of it. But if either of us break our vows with someone else, we'll both get punished. I get that happening if we cheat on each other willingly. But what happens if either of us is assaulted? This town is full of holes, and there are many eager to reach through them to harm others."
              <br><br>
              <<if $awarelevel gte 2>>You think you know what <<he>> means.<<else>>You wonder what <<he>> means by holes.<</if>>
              <br><br>
              "This has been making me doubt my faith," <<he>> continues. "Am I putting it in the right place? I think I am, but, <<sister>>, I admit that I've become confused. It's not fair that <<pshe>> has to endure punishment for someone else's sin, let alone me." <<He>> pauses. "That... that was selfish of me to say. I guess I still have some growing to do."
            <<else>>
              <br><br>
              "I... I can't believe I've been thinking about this." <<He>> takes a deep breath. "I've been promised to someone. The one I love. We can be in-intimate with each other because of that. If either of us breaks our vow with someone else, though, we are punished. At least we're punished together, right? But..."
              <br><br>
              There's a catch in <<his>> voice. It's subtle, but in this small space, you hear it. "But what if the one I l-love is assaulted?" <<he>> asks. "Please forgive me for saying this, <<sister>>, but it seems so unfair to punish <<phim>> for that." The words pour out in a flood. You feel <<his>> doubt pushing against your lips to force its way in. <<stress 3>><<gstress>>
              <br><br>
              "It isn't as if <<pshe>> asked for it. Yes, maybe <<pshe>> shouldn't put <<pherself>> in a situation where <<pshe>> could get attacked, but what if <<pshe>> does everything right and it still happens? How is it fair or right to punish <<phim>> for that? And why should I be punished alongside <<phim>>?" <<He>> pauses. "Oh, that sounds so selfish. I guess I'll need to ask forgiveness for that too."
            <</if>>
            <br><br>
            <<He>> sighs. "<<Sister>>, what should I do?"
          <<option 'CN'>>
            一个<<personssimple>>的声音向你问候。“请宽恕我，<<sister>>，我犯下了罪过。”<<he>>说道。
            <<if C.npc.Robin.doubt gte 20>>
              <br><br>
              “我心怀疑虑。我与他人结成誓约，因此我们理所应当地想做就做。但如果我们中的任何一个违背誓言，和别人在一起，我们都会受到惩罚。要是因为自愿出轨，我可以理解。但要是我们中的任何一个被袭击了呢？这个小镇到处都是坏人，很多东西都想钻进去伤害别人。”
              <br><br>
              <<if $awarelevel gte 2>>你知道<<he>>在说什么。<<else>>你想知道<<he>>说的漏洞是什么意思。<</if>>
              <br><br>
              “这让我对神殿产生了怀疑，”<<he>>继续说道。“我做得对吗？我想我是对的，但是，<<sister>>，我承认，我讨厌这些。这不公平，<<pshe>>要为别人的罪过忍受惩罚，更何况是我。”<<he>>顿了顿，“哈哈，我真的该来神殿吗？”
            <<else>>
              <br><br>
              “我一直在想这种事。”<<he>>深吸一口气，“我和我的爱人缔结了契约，亲密无间。但如果我们中的任何一方违背誓言与别人结合，我们就会受到惩罚。至少我们会一起受到惩罚，不是吗？但是……”
              <br><br>
              <<his>>的声音带着一丝哭腔。这很微妙，但在这个狭小的空间里，你听得清清楚楚。“但是如果我的——我最爱的人被侵犯了怎么办？”<<he>>问道。“对不起，<<sister>>，但为此惩罚<<pher>>似乎太不公平了。”话语像雨水般洒出。你感觉到<<his>>的眼泪流到地面，等待着你做出回应。<<stress 3>><<gstress>>
              <br><br>
              “我不是<<pshe>>求着发生这种事。但为此惩罚<<pher>>是公正合理的吗？为什么我也要跟<<pher>>一起受罚？”<<He>>停顿了一下，“我不该这么自私，我想我也得请求宽恕。”
            <</if>>
            <br><br>
            <<He>>止住眼泪。“<<Sister>>，我该怎么做呢？”
        <</language>>
        <<robin-temple-confession-options>>
      <</addinlineevent>>
    <</if>>
    <<if $robinpaid is 1>>
      <<addinlineevent 'confession_robin_things' 1>>
        <<set _noOptions to true>><<npc Robin>><<person1>><<set $attendant to 'robin_things'>>
        <<set $RobinTemple.confession_day to Time.days>>
        <<if $robinSeen.includes('confessionRevealed')>>
          <<lanSwitch '<span class="blue">You hear three knocks on the door frame.</span>' '<span class="blue">你听到门框上传来三声敲门声。</span>'>>
        <</if>>
        <<language>>
          <<option 'EN'>>
            A <<personssimple>> voice greets you. "I don't know what to do, <<sister>>. I regret it so much," <<he>> says.
            <br><br>
            "I told the person I admire most about my troubles, because I owed so much. But <<pshe>> took the debt onto <<pherself>>, and now I feel so guilty, <<sister>>."
            <br><br>
            <<His>> voice outside is small. "I don't know what to do. There's still a knot inside me. Can you forgive me, <<sister>>?"
          <<option 'CN'>>
            一个<<personssimple>>的声音向你问候。“我不知道该怎么办，<<sister>>，我很后悔。”<<he>>说道。
            <br><br>
            “我曾向我最敬仰的人述说我的悲苦，因为我要欠了很多的债务。但<<pshe>>直接替我承担了债务，我感到很愧疚，<<sister>>。”
            <br><br>
            外面的人的声音细小，“我不知道该怎么做，我的内心始终有道坎，能宽恕我吗？<<sister>>。”
        <</language>>
        <<robin-temple-confession-options>>
      <</addinlineevent>>
    <</if>>
  <</if>>
<</widget>>

:: RobinTemple Confession Forgive
<<set $outside to 0>><<set $location to 'temple'>><<temple_effects>><<effects>><<npc Robin>><<person1>>
<<robin-temple-confession-band>>
<<if $attendant isnot 'robin_promised'>>
  <<if $angel gte 6 or ($confessionsTaken gte 10 and $grace gte 25)>>
    <<language>>
      <<option 'EN'>>You stand and draw the shape of a cross against the seal of confession.
        "I name you forgiven by word. You must still forgive yourself by act," you say with confidence.<<option 'CN'>>你站起身，对着木条墙画了一个十字。
        “我以言辞宽恕你，但你也必须用实际行动宽恕自己。”你自信地说。
    <</language>>
  <<elseif $speech_attitude is 'meek'>>
    <<language>>
      <<option 'EN'>>"Y-you're forgiven by word, but you must forgive yourself by act," you say.<<option 'CN'>>“我、我以言辞宽恕你，但你也必须用实际行动宽恕自己。”你说。
    <</language>>
  <<elseif $speech_attitude is 'bratty'>>
    <<language>>
      <<option 'EN'>>"You're forgiven, but you still need to forgive yourself," you say.<<option 'CN'>>“你被宽恕了，但你也需要宽恕自己。”你说。
    <</language>>
  <<else>>
    <<language>>
      <<option 'EN'>>"You're forgiven, but you need to act to forgive yourself," you say.<<option 'CN'>>“你被宽恕了，但你也必须用实际行动去宽恕自己。”你说。
    <</language>>
  <</if>>
<</if>>
<br><br>
<<switch $attendant>>
  <<case 'robin_promised'>>
    <<language>>
      <<option 'EN'>>
        "If you are bound by promise, then you have committed no sin. You were given exception through a holy rite."
        <br><br>
        You hear a sigh of relief. "Thank you, <<sister>>. I needed the reassurance." <<He>> exits the confessional. <<grace 1>><<ggrace>><<arousal 20>><<garousal>>
      <<option 'CN'>>
        “如果你们已经被誓言所绑定，那你就没有犯下任何罪。你们神圣的仪式给了你们特许的例外。”
        <br><br>
        你听见另一个人松了口气。“谢谢你，<<sister>>。我真的很需要这样的安慰。”<<He>>走出了忏悔室。<<grace 1>><<ggrace>><<arousal 20>><<garousal>>
    <</language>>
  <<case 'robin_romance'>>
    <<language>>
      <<option 'EN'>>
        "So long as you remain true and faithful, and keep your vow, you have done little wrong."
        <br><br>
        You hear a sigh of relief. "Thank you, <<sister>>." <<He>> exits the confessional. <<npcincr Robin lust 1>><<set maplebirch.get('RobinTemple').faith -= 1>><<glust 'Robin'>><<lconviction 'Robin'>>
      <<option 'CN'>>
        “你已经保持了真诚和信仰如此长的时间，还信守了自己的承诺，你并没有太大的罪过。”
        <br><br>
        你听见另一个人松了口气。“谢谢你，<<sister>>。”<<He>>走出了忏悔室。<<npcincr Robin lust 1>><<set maplebirch.get('RobinTemple').faith -= 1>><<glust 'Robin'>><<lconviction 'Robin'>>
    <</language>>
  <<case 'robin_love'>>
    <<language>>
      <<option 'EN'>>
        "If your feelings are pure, you will remain free of sin."
        <br><br>
        You hear a sigh of relief. "Thank you, <<sister>>." <<He>> exits the confessional. <<grace 1>><<ggrace>><<npcincr Robin love 3>><<glove 'Robin'>>
      <<option 'CN'>>
        “只要你的感情是纯洁的，你就不会染上罪过。”
        <br><br>
        你听见另一个人松了口气。“谢谢你，<<sister>>。”<<He>>走出了忏悔室。<<grace 1>><<ggrace>><<npcincr Robin love 3>><<glove 'Robin'>>
    <</language>>
  <<case 'robin_doubt'>>
    <<robin-temple-confession-band>>
    <<language>>
      <<option 'EN'>>
        "Doubts are normal. To doubt is human, to know all is divine. You are not lost so long as you do not let your doubts consume you. Forgive yourself, <<nnpc_brother 'Robin'>>, as I forgive you."
        <br><br>
        <<if _robinBand is 'doubt'>>
          "And if my doubts do consume me?" <<he>> challenges. "What then, <<sister>>? Will I still be forgiven?"
          <br><br>
          "Yes," you say with confidence. "For you are loved by God<<if isLoveInterest('Robin')>> and the one you love<</if>>, and that love will keep you from straying. I'm sure of it."
          <br><br>
          <<He>> is quiet for a long time. When <<he>> speaks again, <<his>> voice is unsteady. "I... I didn't think you'd say that. No one's ever had that kind of faith in me before. Thank you, <<sister>>."
        <<else>>
          "Human," <<he>> echoes. "I'm just a <<personsimple>>, that's true. I guess I thought I should be above such things. Thank you for reminding me that I'm not."
        <</if>>
        <<He>> exits the confessional. You sneak a look through your door. <<He>> looks at peace. <<grace 1>><<npcincr Robin love 2>><<ggrace>><<glove 'Robin'>>
      <<option 'CN'>>
        “疑虑是正常的。持有所疑是人之常情，全知则是神的领域。只要你不让疑虑吞噬自己，你就不会迷失。<<nnpc_brother 'Robin'>>，我原谅你，你也要原谅自己。”
        <br><br>
        <<if _robinBand is 'doubt'>>
          “若焦虑把我吞噬呢？”<<he>>质疑道。“那又该如何，<<sister>>？我还能获得宽恕吗？”
          <br><br>
          “是的，”你自信地说道。“因为你被上帝所爱，<<if isLoveInterest('Robin')>>以及你的爱人所爱<</if>>，那份爱会阻止你迷失。我对此深信不疑。”
          <br><br>
          <<He>>沉默了很长时间，再开口时声音有些不稳。“我……我没想过你会这么说。从来没有人这样相信过我。谢谢你，<<sister>>。”
        <<else>>
          “人之常情，”<<he>>轻声重复。“确实，我只是一个<<personsimple>>。谢谢你提醒我，告诉我其实不需要。”
        <</if>>
        <<He>>走出了忏悔室。你偷偷地透过门缝看了一眼，<<He>>看起来很平静。 <<grace 1>><<npcincr Robin love 2>><<ggrace>><<glove 'Robin'>>
    <</language>>
  <<case 'robin_things'>>
    <<language>>
      <<option 'EN'>>
        "<<Sister>>, I can forgive you. You did nothing wrong. If someone helped you, repay them with kindness."
        <br><br>
        You hear a sigh of relief. "Thank you, <<sister>>." <<He>> exits the confessional. <<npcincr Robin love 1>><<npcincr Robin dom 1>><<glove 'Robin'>><<gdom 'Robin'>>
      <<option 'CN'>>
        “<<sister>>，我可以宽恕你。你并没有做错什么，如果有人回报了你，那就对<<pshe>>表示你的善意。”
        <br><br>
        你听见另一个人松了口气。“谢谢你，<<sister>>。”<<He>>走出了忏悔室。<<npcincr Robin love 1>><<npcincr Robin dom 1>><<glove 'Robin'>><<gdom 'Robin'>>
    <</language>>
<</switch>>
<br><br>
<<getouticon>><<lanLink ['Next', '继续'] 'Temple Confess Start'>><<endconfession>><</lanLink>><br>

:: RobinTemple Confession Repent
<<set $outside to 0>><<set $location to 'temple'>><<temple_effects>><<effects>><<npc Robin>><<person1>>
<<if $angel gte 6 or ($confessionsTaken gte 10 and $grace gte 25)>>
  <<language>>
    <<option 'EN'>>You stand and draw the shape of a cross against the seal of confession.
      "Repent. Change your ways, and you'll be forgiven," you say with confidence.<<option 'CN'>>你站起身，对着木条墙画了一个十字。
      “忏悔，然后重新做人，你就会被宽恕。”你用自信的语气说。
  <</language>>
<<elseif $speech_attitude is 'meek'>>
  <<language>>
    <<option 'EN'>>"Y-you're forgiven by word, but you still need to repent," you say.<<option 'CN'>>“你……你被宽恕了，”你说，“但你仍然需要忏悔。”
  <</language>>
<<elseif $speech_attitude is 'bratty'>>
  <<language>>
    <<option 'EN'>>"You're forgiven, but you need to get your shit together and repent," you say.<<option 'CN'>>“你被原谅了。但你必须自己振作起来然后忏悔。”你说。
  <</language>>
<<else>>
  <<language>>
    <<option 'EN'>>"You're forgiven, but you need to repent," you say.<<option 'CN'>>“你被宽恕了。但你必须忏悔。”你说。
  <</language>>
<</if>>
<br><br>
<<switch $attendant>>
  <<case 'robin_promised'>>
    <<language>>
      <<option 'EN'>>
        "Do not abuse the Rite of Promise. You risk corrupting yourself and the one you love."
        <br><br>
        "I... I knew it. I'm sorry, <<sister>>." <<He>> exits the confessional. <<grace 1>><<ggrace>><<npcincr Robin lust -1>><<set maplebirch.get('RobinTemple').faith += 2>><<llust 'Robin'>><<gconviction 'Robin'>>
      <<option 'CN'>>
        “不要辜负你的承诺仪式，你会玷污自己和你所爱的人。”
        <br><br>
        “我……明白了，对不起，<<sister>>。”<<He>>走出了忏悔室。<<grace 1>><<ggrace>><<npcincr Robin lust -1>><<set maplebirch.get('RobinTemple').faith += 2>><<llust 'Robin'>><<gconviction 'Robin'>>
    <</language>>
  <<case 'robin_romance'>>
    <<language>>
      <<option 'EN'>>
        "You mustn't allow yourself to be swayed by another. Remember your vows and your duty to us."
        <br><br>
        "I... I knew it. I'm sorry, <<sister>>." <<He>> exits the confessional. <<grace 1>><<ggrace>><<npcincr Robin lust -1>><<set maplebirch.get('RobinTemple').faith += 2>><<llust 'Robin'>><<gconviction 'Robin'>>
      <<option 'CN'>>
        “你不能让自己被他人支配。记住你的誓言，还有你对我们的承诺。”
        <br><br>
        “我……明白了，对不起，<<sister>>。”<<He>>走出了忏悔室。<<grace 1>><<ggrace>><<npcincr Robin lust -1>><<set maplebirch.get('RobinTemple').faith += 2>><<llust 'Robin'>><<gconviction 'Robin'>>
    <</language>>
  <<case 'robin_love'>>
    <<language>>
      <<option 'EN'>>
        "You risk being swayed by allowing yourself to be so vulnerable. Remember yourself."
        <br><br>
        There's a moment of silence. "You're right, <<sister>>. I... I got carried away. Thank you." <<He>> trudges from the confessional. <<grace 1>><<ggrace>><<npcincr Robin love -8>><<lllove 'Robin'>>
      <<option 'CN'>>
        “让自己如此脆弱，你就容易被牵着走。记住你自己是谁。”
        <br><br>
        沉默了片刻。“你说得对，<<sister>>。我……是我太投入了。谢谢你。”<<He>>拖着步子走出了忏悔室。<<grace 1>><<ggrace>><<npcincr Robin love -8>><<lllove 'Robin'>>
    <</language>>
  <<case 'robin_doubt'>>
    <<robin-temple-confession-band>>
    <<language>>
      <<option 'EN'>>
        <<if $robinSeen.includes('self-sabotage')>>
          "A wise <<monk>> once told me that doubt is self-sabotage," you say. "Repent for hurting yourself, and forgiveness will follow."
        <<else>>
          "You are stronger than your doubts," you say. "Repent for questioning the faith, and you will be forgiven."
        <</if>>
        <br><br>
        <<if _robinBand is 'doubt'>>
          "I... I think I knew that," <<he>> says. "It helps to hear it from someone else, though. Thanks, <<sister>>. I'll try to remember."
        <<else>>
          "You're right," <<he>> says quietly. "Thank you, <<sister>>. Truly."
        <</if>>
        <<He>> exits the confessional. <<grace 1>><<npcincr Robin love 2>><<ggrace>><<glove 'Robin'>>
      <<option 'CN'>>
        <<if $robinSeen.includes('self-sabotage')>>
          “曾有一位睿智的<<monk>>告诉我，怀疑是自我毁灭，”你说道。“为伤害自己而忏悔，宽恕就会随之而来。”
        <<else>>
          “你比你的疑虑更强大，”你说道。“为质疑信仰忏悔，你将获得宽恕。”
        <</if>>
        <br><br>
        <<if _robinBand is 'doubt'>>
          “我……我想我早就知道了，”<<he>>说道，“不过听别人说出来还是不一样。谢谢你，<<sister>>。我会尽量记住的。”
        <<else>>
          “你说得对，”<<he>>轻声说道。“谢谢你，<<sister>>。真的。”
        <</if>>
        <<He>>离开了忏悔室。 <<grace 1>><<npcincr Robin love 2>><<ggrace>><<glove 'Robin'>>
    <</language>>
  <<case 'robin_things'>>
    <<language>>
      <<option 'EN'>>
        "<<Sister>>, you should repent. Even if you did nothing wrong, learn how to repay kindness."
        <br><br>
        You hear a sigh of relief. "Thank you, <<sister>>." <<He>> exits the confessional. <<npcincr Robin love 2>><<glove 'Robin'>>
      <<option 'CN'>>
        “<<sister>>，你应该忏悔。即使你并没有做错什么，你也要学会如何去回报。”
        <br><br>
        你听见另一个人松了口气。“谢谢你，<<sister>>。”<<He>>走出了忏悔室。<<npcincr Robin love 2>><<glove 'Robin'>>
    <</language>>
<</switch>>
<br><br>
<<getouticon>><<lanLink ['Next', '继续'] 'Temple Confess Start'>><<endconfession>><</lanLink>><br>

:: RobinTemple Confession Contrition
<<set $outside to 0>><<set $location to 'temple'>><<temple_effects>><<effects>><<npc Robin>><<person1>>
<<if !$contritionsCycle>><<set $contritionsCycle to 0>>><</if>>
<<switch $attendant>>
  <<case 'robin_promised' 'robin_romance'>>
    <<language>>
      <<option 'EN'>>
        "...What? I haven't broken my vow. I... I would never. I'm sorry, <<sister>>, but I think I should go." <<He>> leaves the confessional. <<grace -2>><<lgrace>>
      <<option 'CN'>>
        “……什么？我没有打破自己的誓言。我……我不会那么做的。对不起，<<sister>>，我想我该走了。”<<He>>离开了忏悔室。<<grace -2>><<lgrace>>
    <</language>>
  <<case 'robin_love'>>
    <<language>>
      <<option 'EN'>>
        "...What? I told you there's someone I love. I... I couldn't. I'm sorry, <<sister>>, I should go." <<He>> leaves the confessional. <<grace -2>><<lgrace>>
      <<option 'CN'>>
        “……什么？我说过我心里有人了。我……我做不到。对不起，<<sister>>，我该走了。”<<He>>离开了忏悔室。<<grace -2>><<lgrace>>
    <</language>>
  <<case 'robin_doubt'>>
    <<robin-temple-confession-band>>
    <<if _robinBand is 'doubt'>>
      <<language>>
        <<option 'EN'>>"Why? I don't... I haven't broken my vow. Neither of us has. I don't think there's anything to make amends for."<<option 'CN'>>“为什么？我……我没有违背誓约，我们都没有。我觉得没什么需要弥补的。”
      <</language>>
    <<else>>
      <<language>>
        <<option 'EN'>>"I don't think..." <<He>> trails off. "I mean, no. I haven't broken my vow, and neither has the one I love. We don't need to be purified."<<option 'CN'>>“为什么这么做……”<<He>>话音渐弱。“对不起，但是。我们都没有违背誓约，我的爱人也没有。我们不需要被净化。”
      <</language>>
    <</if>>
    <<language>>
      <<option 'EN'>>
        You hear <<him>> shuffle as <<he>> stands.
        <br><br>
        "The one I love and I can withstand any test thrown at us. Our faith will drown our doubts. Thank you for being an example of everything the temple isn't, <<sister>>." <<He>> exits the confessional. You sneak a look through your door. <<He>> looks angry. <<grace -4>><<stress 3>><<llgrace>><<gstress>>
      <<option 'CN'>>
        你听见<<him>>起身产生的沙沙声响。
        <br><br>
        “我和我的爱人可以经历任何考验，我们之间的爱意将淹没一切疑虑。真是‘感谢’你对神殿做出的贡献，<<sister>>。”<<He>>走出了忏悔室。你偷偷地透过门缝看了一眼，<<He>>看起来很生气。 <<grace -4>><<stress 3>><<llgrace>><<gstress>>
    <</language>>
  <<case 'robin_things'>>
    <<language>>
      <<option 'EN'>>
        "Why, does this need atonement too?" <<he>> says, a little angry. "I'm sorry, <<sister>>, I should go."
        <br><br>
        You hear the rustle as <<he>> stands.
      <<option 'CN'>>
        “为什么，这也难道要赎罪吗？”，<<nnpc_he 'Robin'>>有些愤怒。“对不起，<<sister>>，我该走了。”
        <br><br>
        你听见<<nnpc_he 'Robin'>>起身产生的沙沙声响。
    <</language>>
<</switch>>
<br><br>
<<getouticon>><<lanLink ['Next', '继续'] 'Temple Confess Start'>><<endconfession>><</lanLink>><br>

:: RobinTemple Confession Purge
<<set $outside to 0>><<set $location to 'temple'>><<temple_effects>><<effects>><<npc Robin>><<person1>>
<<if $temple_confessor_intro>>
  <<language>>
    <<option 'EN'>>"I name you <span class="red">corrupted</span>." You kneel, positioning yourself against the seal and opening the small metal shutter. "Remove your clothes and stand against the seal of confession. I will take your corruption into myself, and you will be forgiven."<<option 'CN'>>“我宣告你已被<span class="red">腐化</span>。”你跪下，靠着木条墙，打开小小的金属活门。“脱下衣服，站在告解封印前。我会把你的腐化引入自身，你将被宽恕。”
  <</language>>
<<else>>
  <<language>>
    <<option 'EN'>>"You need to be purged. Remove your clothes and stand against the seal of confession." You're not entirely sure what you're doing, but you kneel and open the small metal shutter.<<option 'CN'>>“你需要被净化。脱下衣服，站在告解封印前。”你并不太确定自己在做什么，但还是跪下打开了小小的金属活门。
  <</language>>
  <<promiscuity1>>
<</if>>
<br><br>
<<switch $attendant>>
  <<case 'robin_promised' 'robin_romance' 'robin_doubt'>>
    <<set _noOptions to true>>
    <<robin-temple-confession-band>>
    <<language>>
      <<option 'EN'>>
        <<if _robinBand is 'doubt'>>
          "What are you talking about? You can't do this. I'll say it again — I'm taken, creep."
        <<else>>
          "I... I just told you I'm taken. You can't do this to me, <<sister>>. If you insist, I think I'll report you."
        <</if>>
        The outrage in <<his>> voice betrays <<his>> identity. <span class="pink">It's Robin.</span> <<He>> starts to leave the booth. <<grace -2>><<lgrace>>
        <br><br>
        <<lanLink ['Reveal yourself', '现身'] 'RobinTemple Confession Reveal'>><</lanLink>><br>
        <<lanLink ['Let <<him>> leave', '让<<him>>离开'] 'Temple Confess Start'>><<endconfession>><</lanLink>><br>
      <<option 'CN'>>
        <<if _robinBand is 'doubt'>>
          “你在说什么？你不能这样。我要对你再说一遍——我是有对象的，死变态。”
        <<else>>
          “我……我刚才说我有对象了，你不能这么对我，<<sister>>。如果你执意如此，我想我会检举你。”
        <</if>>
        <<his>>声音中的幽愤暴露了<<his>>的真实身份。<span class="pink">是罗宾。</span><<He>>转身准备离开隔间。<<grace -2>><<lgrace>>
        <br><br>
        <<lanLink ['现身', '现身'] 'RobinTemple Confession Reveal'>><</lanLink>><br>
        <<lanLink ['让<<him>>离开', '让<<him>>离开'] 'Temple Confess Start'>><<endconfession>><</lanLink>><br>
    <</language>>
  <<case 'robin_love'>>
    <<language>>
      <<option 'EN'>>
        "Wh-what?! <<Sister>>, you... you can't ask me to do that. I... I have to go." <<He>> flees the confessional. <<grace -2>><<lgrace>>
      <<option 'CN'>>
        “什、什么？！<<Sister>>，你……你不能让我做这种事。我……我得走了。”<<He>>逃出了忏悔室。<<grace -2>><<lgrace>>
    <</language>>
  <<case 'robin_things'>>
    <<language>>
      <<option 'EN'>>
        "Wh-what?! You want me to take off my clothes? <<Sister>>, that's... that's not why I came here." <<He>> leaves the booth in a hurry. <<grace -2>><<lgrace>>
      <<option 'CN'>>
        “什、什么？！你要我脱衣服？<<Sister>>，我……我不是为了这个来的。”<<He>>匆匆离开了隔间。<<grace -2>><<lgrace>>
    <</language>>
<</switch>>
<br><br>
<<getouticon>><<lanLink ['Next', '继续'] 'Temple Confess Start'>><<endconfession>><</lanLink>><br>

:: RobinTemple Confession Reveal
<<set $outside to 0>><<set $location to 'temple'>><<temple_effects>><<effects>><<npc Robin>><<person1>>
<<if !$robinSeen.includes('confessionRevealed')>>
  <<language>>
    <<option 'EN'>>
      <<if $speech_attitude is 'meek'>>
        "It's... it's me, Robin," you say.
      <<elseif $speech_attitude is 'bratty'>>
        "It's just me, Robin, I was only having a bit of fun," you say.
      <<else>>
        "It's just me, Robin," you say.
      <</if>>
      <br><br>
      <<He>> stops.
      <<if C.npc.Robin.doubt gte 20>>
        "Oh wow, you really had me going for a minute there."
      <<else>>
        "You... you really scared me. I mean... it was a little funny. Sort of."
      <</if>>
      <<He>> laughs it off after a moment. "But we... maybe we should have a signal, so we know it's each other in here." <<He>> thinks about it.
      "Oh! How about this. I'll <span class="blue">knock on the door frame three times</span> whenever I come in. That way you'll know it's me."
      <br><br>
      <<run $robinSeen.pushUnique('confessionRevealed')>>
    <<option 'CN'>>
      <<if $speech_attitude is 'meek'>>
        “是……是我，罗宾，”你说。
      <<elseif $speech_attitude is 'bratty'>>
        “是我，罗宾，我只是想找点乐子。”你说道。
      <<else>>
        “是我，罗宾。”你说。
      <</if>>
      <br><br>
      <<He>>停了下来。
      <<if C.npc.Robin.doubt gte 20>>
        “哇，你刚才真的把我骗到了。”
      <<else>>
        “你……你真的吓到我了。不过……是有点好笑。大概吧。”
      <</if>>
      <<He>>很快就对刚才发生的事一笑了之。“但是，我们……要不要想一个暗号或者别的什么，这样我们下次就能认出对方。”<<He>>说着陷入了思考。
      “啊！这个怎么样。下次我会在进门前<span class="blue">敲三下门框</span>这样你就能知道是我来了。”
      <br><br>
      <<run $robinSeen.pushUnique('confessionRevealed')>>
  <</language>>
  <br><br>
  <<loveicon 'kiss'>><<lanLink ['Invite Robin to your side of the booth', '请罗宾到你的这一侧来'] 'RobinTemple Confession Tempt'>><<set $phase to 1>><</lanLink>><br>
<<else>>
  <<language>>
    <<option 'EN'>>Robin knows you are on the other side of the screen.<<option 'CN'>>罗宾知道屏风后坐着你。
  <</language>>
  <br><br>
  <<if $robinromance is 1>>
    <<loveicon 'kiss'>><<lanLink ['Invite Robin to your side of the booth', '请罗宾到你的这一侧来'] 'RobinTemple Confession Tempt'>><<set $phase to 1>><</lanLink>><br>
  <</if>>
<</if>>
<<getouticon>><<lanLink ['Say goodbye', '告别'] 'Temple Confess Start'>><<endconfession>><</lanLink>><br>


:: RobinTemple Confession Tempt
<<set $outside to 0>><<set $location to 'temple'>><<temple_effects>><<effects>><<npc Robin>><<person1>>
<<run statusCheck('Robin')>>
<<language>>
  <<option 'EN'>>
    <<if $speech_attitude is 'meek'>>
      "Want to... come over to this side? We've got some privacy here."
    <<elseif $speech_attitude is 'bratty'>>
      "Why don't you come over here and confess just how naughty you've been?"
    <<else>>
      "Want to come over here? In more than one way?"
    <</if>>
  <<option 'CN'>>
    <<if $speech_attitude is 'meek'>>
      “你想……到我这边来吗？我们可以享受一点私密时间。”
    <<elseif $speech_attitude is 'bratty'>>
      “为什么不到我这边来，直接忏悔你的淘气行为呢？”
    <<else>>
      “想到我这边来吗？我们可以做点别的什么？”
    <</if>>
<</language>>
<br><br>
<<if $phase is 1>>
  <<language>>
    <<option 'EN'>>Robin seems relieved to recognise your voice.<<option 'CN'>>罗宾认出了你的声音后，似乎松了口气。
  <</language>>
<</if>>
<<if C.npc.Robin.doubt gte 20>>
  <<language>>
    <<option 'EN'>>
      "You... again? Here?" <<He>> exits the booth. "Th-thank you, <<sister>>. For listening." <<He>> spends a moment just outside, making sure no one is watching. You open your door for <<him>>.
      <br><br>
      <<He>> sits next to you on the bench, and you lock the door.
      <<if $RobinTemple.stage is 'member'>>
        "S-so... won't you help this poor initiate repent?"
      <<else>>
        "So, um... do you want to confess anything to me?"
      <</if>>
      <<He>> pulls you close.
      <br><br>
      <<loveicon 'kiss'>><<lanLink ['Next', '继续'] 'RobinTemple Confession Sex'>><<set $sexstart to 1>><</lanLink>><br>
    <<option 'CN'>>
      “你……又在这里？现在？”<<He>>走出了隔间，“谢谢你，<<sister>>。谢谢你愿意听。”<<He>>稍微观察了一下周围，确保没人在看。你替<<him>>打开了你这侧的门。
      <br><br>
      <<He>>在你旁边的长凳上坐下，你锁上了门。
      <<if $RobinTemple.stage is 'member'>>
        “那、那个……你能不能帮帮这个见习教徒忏悔？”
      <<else>>
        “那个……你有什么想对我忏悔的吗？”
      <</if>>
      <<He>>把你拉近到身边。
      <br><br>
      <<loveicon 'kiss'>><<lanLink ['继续', '继续'] 'RobinTemple Confession Sex'>><<set $sexstart to 1>><</lanLink>><br>
    <</language>>
<<else>>
  <<language>>
    <<option 'EN'>>
      "Here? In the confessional? I..." <<He>> exits the booth. "Th-thank you, <<sister>>. For listening." <<He>> spends a moment just outside, making sure no one is watching. You open your door for <<him>>.
      <br><br>
      <<He>> sits next to you on the bench.
      <<if C.npc.Robin.lust gte 50>>
        You place a hand on <<his>> chest and gently push <<him>> into a lying position. <<He>> lets out a held breath and embraces you.
        <<robin-temple-confession-lewd>>
        <br><br>
        <<loveicon 'kiss'>><<lanLink ['Next', '继续'] 'RobinTemple Confession Sex'>><<set $sexstart to 1>><</lanLink>><br>
      <<else>>
        <br><br>
        <<set $seductiondifficulty to 7900 - ((C.npc.Robin.love + C.npc.Robin.lust) * 15) - maplebirch.get('RobinTemple').faith>>
        <<seductioncheck>>
        <<seductionskilluptext>>
        <<seductionskilluse>>
        You place a hand on <<his>> chest and ease <<him>> into a lying position.
        <<if $seductionrating gte $seductionrequired>>
          <span class="green"><<He>> lets out a held breath and embraces you.</span>
          <<robin-temple-confession-lewd>>
          <br><br>
          <<loveicon 'kiss'>><<lanLink ['Next', '继续'] 'RobinTemple Confession Sex'>><<set $sexstart to 1>><</lanLink>><br>
        <<else>>
