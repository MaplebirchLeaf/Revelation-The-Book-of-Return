:: RobinTemple Confession Widgets [widget]
<<widget 'robin-temple-confession-event'>>
  <<if ['member', 'approved', 'promised'].includes($RobinTemple.stage)
    and $RobinTemple.confession_day isnot Time.days
    and $confessionsTaken gte 5
    and Time.hour gte 17 and Time.hour lt 20
    and getRobinLocation() is 'temple' and !$robinmissing>>
    <<addinlineevent 'robin_temple_confession' 2>>
      <<npc Robin>><<person1>>
      <<set $attendant to 'robin_temple_confession'>>
      <<set $RobinTemple.confession_day to Time.days>>
      <<set $RobinTemple.confession_resolved to false>>
      <<set _noOptions to true>>
      <<if $RobinTemple.confession_recognized>>
        <<language>>
          <<option 'EN'>>
            Three quiet taps sound on the doorframe before Robin enters. <<He>> takes the bench on the other side of the screen. You greet <<him>> by name in your usual voice. "Oh, it is you," <<he>> says.
          <<option 'CN'>>
            门框传来轻轻的三下敲击。罗宾走进另一侧的隔间，在屏风后坐下。你用平常的声音叫了<<his>>的名字。“啊，是你。”<<he>>说。
        <</language>>
      <<else>>
        <<language>>
          <<option 'EN'>>
            The other door closes softly. You recognise Robin’s voice. <<He>> hesitates at your formal greeting, uncertain who is sitting behind the screen.
          <<option 'CN'>>
            对面的门轻轻关上。你认出了罗宾的声音。听见你一本正经地问候，<<he>>却迟疑了，似乎没认出屏风后坐着谁。
        <</language>>
      <</if>>
      <br><br>
      <<if $RobinTemple.punish>>
        <<language>>
          <<option 'EN'>>
            "Forgive me, <<sister>>. I thought about running," <<he>> says. "But I don’t want to leave <<if $RobinTemple.punish.joint>>the people I made the vow with<<else>>my beloved<</if>> to be punished without me."
          <<option 'CN'>>
            “请宽恕我，<<sister>>。我想过跑掉，”<<he>>说，“可我不想丢下<<if $RobinTemple.punish.joint>>和我一起立誓的人<<else>>我的爱人<</if>>，让<<if $RobinTemple.punish.joint>>他们<<else>><<pshe>><</if>>受罚。”
        <</language>>
      <<elseif $RobinTemple.templePromised is 'Robin'>>
        <<language>>
          <<option 'EN'>>
            "I meant what I promised, <<sister>>," <<he>> says. "But sometimes I worry I only came here because I was afraid of losing my beloved."
          <<option 'CN'>>
            “<<Sister>>，我立下的誓言是真心的，”<<he>>说，“但有时我担心自己来这里，只是因为害怕失去我的爱人。”
        <</language>>
      <<else>>
        <<language>>
          <<option 'EN'>>
            "I want to help the people here," <<he>> says. "I keep wondering whether that is enough of a reason to stay."
          <<option 'CN'>>
            “我想帮这里的人，”<<he>>说，“可我一直在想，这算不算留下来的理由。”
        <</language>>
      <</if>>
      <br><br>
      <<if !$RobinTemple.confession_recognized>>
        <<socialiseicon 'ask'>><<lanLink '先向罗宾表明身份' 'RobinTemple Confession Reveal'>><</lanLink>><br>
        <<templeicon 'altar'>><<lanLink '先不说出自己的名字' 'RobinTemple Confession Anonymous'>><</lanLink>><<gconviction>><br>
      <<else>>
        <<if $RobinTemple.punish>>
          <<socialiseicon 'ask'>><<lanLink '听罗宾说说惩戒的事' 'RobinTemple Confession Doubt'>><</lanLink>><br>
        <</if>>
        <<socialiseicon 'ask'>><<lanLink '请罗宾说说自己的选择' 'RobinTemple Confession Listen'>><</lanLink>><<gdom>><<ggconviction>><br>
        <<loveicon 'hug'>><<lanLink '隔着木板安慰罗宾' 'RobinTemple Confession Comfort'>><</lanLink>><<glove>><<lrtrauma>><br>
        <<templeicon 'altar'>><<lanLink '提醒罗宾认真对待誓言' 'RobinTemple Confession Admonish'>><</lanLink>><<gdom>><<llove>><<lconviction>><br>
      <</if>>
    <</addinlineevent>>
    <<if $robinpaid is 1 and $RobinTemple.confession_recognized
      and !(maplebirch.get('Robin')
      and ($RobinExpansion.selfRent or $RobinExpansion.baileyDefeated))>>
      <<addinlineevent 'robin_temple_confession_debt' 1>>
        <<npc Robin>><<person1>>
        <<set $attendant to 'robin_temple_confession_debt'>>
        <<set $RobinTemple.confession_day to Time.days>>
        <<set $RobinTemple.confession_resolved to false>>
        <<set _noOptions to true>>
        <<language>>
          <<option 'EN'>>
            Robin sits on the other side of the screen. You greet <<him>> by name in your usual voice. "Oh, it is you. You paid what I owed Bailey," <<he>> says. "I still count the day's takings. I know you never asked for it back."
          <<option 'CN'>>
            罗宾在木板另一侧坐下。你用平常的声音叫了<<his>>的名字。“啊，是你。你替我还了欠贝利的钱，”<<he>>说，“每天收工，我还是会把钱数一遍。我知道你从没让我还。”
        <</language>>
        <br><br>
        <<language>>
          <<option 'EN'>>
            "I want to help you too," <<he>> says. "I just don't know how to do that without making it another debt."
          <<option 'CN'>>
            “我也想帮你，”<<he>>说，“可我不知道怎么做，才不会又变成一笔欠账。”
        <</language>>
        <br><br>
        <<loveicon 'hug'>><<lanLink '告诉罗宾你从未记过这笔账' 'RobinTemple Confession Debt Comfort'>><</lanLink>><<glove>><<lrtrauma>><br>
        <<socialiseicon 'ask'>><<lanLink '问罗宾自己想做什么' 'RobinTemple Confession Debt Plan'>><</lanLink>><<gdom>><<gconviction>><br>
      <</addinlineevent>>
    <</if>>
  <</if>>
<</widget>>

:: RobinTemple Confession Reveal
<<set $outside to 0>><<set $location to 'temple'>><<temple_effects>><<effects>><<npc Robin>><<person1>>
<<if !$RobinTemple.confession_recognized>>
  <<set $RobinTemple.confession_recognized to true>>
  <<language>>
    <<option 'EN'>>
      You say Robin’s name. <<He>> stops speaking. "It is you," <<he>> says, almost laughing with relief. "I could not tell through the screen."
    <<option 'CN'>>
      你喊出罗宾的名字。<<He>>停住了。“是你啊，”<<he>>说，几乎要松口气地笑出来，“隔着屏风，我听不出来。”
  <</language>>
  <br><br>
  <<language>>
    <<option 'EN'>>
      "Next time I will knock three times before I come in," <<he>> says. You hear <<him>> tap the wooden frame: once, twice, three times.
    <<option 'CN'>>
      “下次我进来前会敲三下，”<<he>>说。木门框传来轻轻的响声，一下、两下、三下。
  <</language>>
<<else>>
  <<language>>
    <<option 'EN'>>
      Robin knows you are on the other side of the screen.
    <<option 'CN'>>
      罗宾知道屏风后坐着你。
  <</language>>
<</if>>
<br><br>
<<if $RobinTemple.punish>>
  <<socialiseicon 'ask'>><<lanLink '听罗宾说说惩戒的事' 'RobinTemple Confession Doubt'>><</lanLink>><br>
<</if>>
<<socialiseicon 'ask'>><<lanLink '请罗宾说说自己的选择' 'RobinTemple Confession Listen'>><</lanLink>><<gdom>><<ggconviction>><br>
<<getouticon>><<lanLink '结束这次告解' 'Temple Confess Start'>><<endconfession>><</lanLink>><br>

:: RobinTemple Confession Anonymous
<<set $outside to 0>><<set $location to 'temple'>><<temple_effects>><<effects>><<npc Robin>><<person1>>
<<if $RobinTemple.confession_day is Time.days and !$RobinTemple.confession_resolved>>
  <<set $RobinTemple.confession_resolved to true>>
  <<if $RobinTemple.punish>>
    <<language>>
      <<option 'EN'>>
        You let Robin finish without saying <<his>> name. You ask what frightens <<him>> about the punishment. <<He>> speaks quietly, but you let <<him>> take <<his>> time. "Thank you for listening, <<sister>>," <<he>> says.
      <<option 'CN'>>
        你没有叫罗宾的名字，让<<he>>把话说完。你问起惩戒中让<<him>>害怕的事。<<His>>的声音很轻，你没有催促。“谢谢你听我说，<<sister>>。”<<he>>说。
    <</language>>
  <<elseif $RobinTemple.templePromised is 'Robin'>>
    <<language>>
      <<option 'EN'>>
        You let Robin finish without saying <<his>> name. You tell <<him>> that loving someone does not mean <<his>> promise was insincere. "I do want to keep it," <<he>> says. "Thank you, <<sister>>."
      <<option 'CN'>>
        你没有叫罗宾的名字，让<<he>>把话说完。你告诉<<him>>，爱着一个人并不意味着<<his>>的承诺不是真心的。“我确实想遵守它，”<<he>>说，“谢谢你，<<sister>>。”
    <</language>>
  <<else>>
    <<language>>
      <<option 'EN'>>
        You let Robin finish without saying <<his>> name. "I can work here and still go back for the people waiting outside," <<he>> says. You tell <<him>> that the choice is <<his>> to make.
      <<option 'CN'>>
        你没有叫罗宾的名字，让<<he>>把话说完。“我可以在这里做事，也能回去照顾外面等我的人，”<<he>>说。你告诉<<him>>，这个选择该由<<him>>自己来做。
    <</language>>
  <</if>>
  <br><br>
  <<language>>
    <<option 'EN'>>
      The other door closes. Robin leaves without learning who was listening.
    <<option 'CN'>>
      另一侧的门关上了。罗宾离开时，仍不知道刚才是谁在听。
  <</language>>
  <<set C.npc.Robin.conviction to Math.min(200, C.npc.Robin.conviction + 1)>><<gconviction>>
  <br><br>
<<else>>
  <<language>>
    <<option 'EN'>>
      This confession has already ended, or Robin has not come to confess today.
    <<option 'CN'>>
      这次告解已经结束，或是罗宾今天还没有来告解。
  <</language>><br><br>
<</if>>
<<getouticon>><<lanLink '结束这次告解' 'Temple Confess Start'>><<endconfession>><</lanLink>><br>

:: RobinTemple Confession Debt Comfort
<<set $outside to 0>><<set $location to 'temple'>><<temple_effects>><<effects>><<npc Robin>><<person1>>
<<if $RobinTemple.confession_day is Time.days and !$RobinTemple.confession_resolved>>
  <<set $RobinTemple.confession_resolved to true>>
  <<language>>
    <<option 'EN'>>
      "It was not a loan," you say. Robin is quiet. "I know," <<he>> says at last. "I think I wanted to hear you say it again."
    <<option 'CN'>>
      “那不是借你的钱，”你说。罗宾安静了一会儿。“我知道，”<<he>>终于说，“我想再听你亲口说一遍。”
  <</language>>
  <br><br>
  <<language>>
    <<option 'EN'>>
      You hear <<him>> breathe out. When <<he>> speaks again, <<his>> voice is steadier.
    <<option 'CN'>>
      你听见<<he>>缓缓吐出一口气。再次开口时，<<his>>的声音平稳了些。
  <</language>>
  <<npcincr Robin love 2>><<npcincr Robin trauma -2>><br><br><<glove>><<lrtrauma>>
<<else>>
  <<language>>
    <<option 'EN'>>
      This confession has already ended, or Robin has not come to confess today.
    <<option 'CN'>>
      这次告解已经结束，或是罗宾今天还没有来告解。
  <</language>><br><br>
<</if>>
<<getouticon>><<lanLink '结束这次告解' 'Temple Confess Start'>><<endconfession>><</lanLink>><br>

:: RobinTemple Confession Debt Plan
<<set $outside to 0>><<set $location to 'temple'>><<temple_effects>><<effects>><<npc Robin>><<person1>>
<<if $RobinTemple.confession_day is Time.days and !$RobinTemple.confession_resolved>>
  <<set $RobinTemple.confession_resolved to true>>
  <<language>>
    <<option 'EN'>>
      "What would you choose to do?" you ask. Robin thinks about the business, the orphanage, and the work waiting here. "There's plenty I can do," <<he>> says. "I don't need a bill to tell me when to start."
    <<option 'CN'>>
      “那你自己想做什么？”你问。罗宾想起摊位、孤儿院和神殿里等着做的事。“能做的事很多，”<<he>>说，“不需要一张账单来催我。”
  <</language>>
  <br><br>
  <<language>>
    <<option 'EN'>>
      You leave the decision with <<him>>. Robin thanks you for listening.
    <<option 'CN'>>
      你把决定留给<<him>>。罗宾向你道了谢。
  <</language>>
  <<set C.npc.Robin.conviction to Math.min(200, C.npc.Robin.conviction + 2)>><<gconviction>>
  <<npcincr Robin dom 2>><br><br><<gdom>>
<<else>>
  <<language>>
    <<option 'EN'>>
      This confession has already ended, or Robin has not come to confess today.
    <<option 'CN'>>
      这次告解已经结束，或是罗宾今天还没有来告解。
  <</language>><br><br>
<</if>>
<<getouticon>><<lanLink '结束这次告解' 'Temple Confess Start'>><<endconfession>><</lanLink>><br>

:: RobinTemple Confession Doubt
<<set $outside to 0>><<set $location to 'temple'>><<temple_effects>><<effects>><<npc Robin>><<person1>>
<<language>>
  <<option 'EN'>>
    "I know I made a vow," Robin says. "But what if someone hurts me?" <<He>> pauses behind the screen. "Would that mean I'd broken it?"
  <<option 'CN'>>
    “我知道自己立下了誓言，”罗宾说，“可是，如果有人伤害我呢？”屏风后安静了一会儿。“那也算我背誓了吗？”
<</language>>
<br><br>
<<language>>
  <<option 'EN'>>
    You cannot see <<his>> face through the wooden screen. <<He>> waits for you to answer anyway.
  <<option 'CN'>>
    隔着木板，你看不见<<his>>的脸。<<He>>仍等着你回答。
<</language>>
<br><br>
<<loveicon 'hug'>><<lanLink '告诉罗宾受伤不是罪' 'RobinTemple Confession Doubt Answer'>><<set $RobinTemple.confession_response to 'hold'>><</lanLink>><br>
<<templeicon 'altar'>><<lanLink '劝罗宾向约旦问清楚' 'RobinTemple Confession Doubt Answer'>><<set $RobinTemple.confession_response to 'speak'>><</lanLink>><br>

:: RobinTemple Confession Doubt Answer
<<set $outside to 0>><<set $location to 'temple'>><<temple_effects>><<effects>><<npc Robin>><<person1>>
<<if $RobinTemple.confession_day is Time.days and !$RobinTemple.confession_resolved>>
  <<set $RobinTemple.confession_resolved to true>>
  <<if $RobinTemple.confession_response is 'hold'>>
    <<language>>
      <<option 'EN'>>
        "No," you say. "What someone does to you is not a choice you made." Robin is silent for a long time. "Thank you," <<he>> says at last.
      <<option 'CN'>>
        “不算，”你说，“别人对你做的事，不是你的选择。”罗宾沉默了很久。“谢谢，”<<he>>终于说。
    <</language>>
    <<npcincr Robin love 2>><<npcincr Robin trauma -3>><br><br><<glove>><<lrtrauma>>
  <<else>>
    <<if C.npc.Robin.trauma gte 40 or C.npc.Robin.dom lte 50>>
      <<language>>
        <<option 'EN'>>
          You suggest asking Jordan what the vow means. Robin takes a while to answer. "Will you come with me?" <<he>> asks. "I don't know how to explain it."
        <<option 'CN'>>
          你提议向约旦问清誓言的含义。罗宾过了一会儿才回答。“你会陪我去吗？”<<he>>问，“我不知道该怎么说。”
      <</language>>
    <<else>>
      <<language>>
        <<option 'EN'>>
          You suggest asking Jordan what the vow means. "I'll ask," Robin says. "I don't want to keep worrying about it." <<He>> adds, more quietly, "I'd still like you to come."
        <<option 'CN'>>
          你提议向约旦问清誓言的含义。“我会去问，”罗宾说，“我不想总担心这件事。”<<He>>又放轻了声音。“我还是希望你能陪我。”
      <</language>>
    <</if>>
    <<npcincr Robin dom 2>><br><br><<gdom>>
  <</if>>
<<else>>
  <<language>>
    <<option 'EN'>>
      This confession has already ended, or Robin has not come to confess today.
    <<option 'CN'>>
      这次告解已经结束，或是罗宾今天还没有来告解。
  <</language>><br><br>
<</if>>
<<getouticon>><<lanLink '结束这次告解' 'Temple Confess Start'>><<endconfession>><</lanLink>><br>

:: RobinTemple Confession Listen
<<set $outside to 0>><<set $location to 'temple'>><<temple_effects>><<effects>><<npc Robin>><<person1>>
<<if $RobinTemple.confession_day is Time.days and !$RobinTemple.confession_resolved>>
  <<set $RobinTemple.confession_resolved to true>>
  <<if $RobinTemple.punish>>
    <<language>>
      <<option 'EN'>>
        You ask Robin what <<he>> wants to do. "I'm scared," <<he>> admits. "But I don't want to leave anyone behind." You listen as <<he>> tells you what worries <<him>>, without asking <<him>> to pretend otherwise.
      <<option 'CN'>>
        你问罗宾想怎么做。“我很害怕，”<<he>>承认，“可我不想丢下任何人。”你听<<him>>说起担忧，没有让<<him>>装作不怕。
    <</language>>
  <<elseif $RobinTemple.templePromised is 'Robin'>>
    <<language>>
      <<option 'EN'>>
        You ask Robin about the promise. "I wanted to be with you," <<he>> says. "That part hasn't changed." You listen while <<he>> puts the rest into words. <<He>> sounds less hesitant by the time <<he>> finishes.
      <<option 'CN'>>
        你问起那份承诺。“我想和你在一起，”<<he>>说，“这一点没有变。”你听<<him>>把余下的话慢慢说清。说完时，<<he>>不再像刚才那样迟疑。
    <</language>>
  <<else>>
    <<language>>
      <<option 'EN'>>
        You wait. Robin tells you about the work <<he>> chose to do and the work <<he>> still wants to do outside these walls. "I think I can belong to both," <<he>> says at last.
      <<option 'CN'>>
        你等罗宾说完。<<He>>讲起自己在神殿接下的工作，也讲起墙外仍想做的事。“我想两边都能顾到，”<<he>>终于说。
    <</language>>
    <br><br>
    <<language>>
      <<option 'EN'>>
        "Then tell Jordan that," you say. You hear Robin let out a breath behind the screen.
      <<option 'CN'>>
        “那就这样告诉约旦，”你说。屏风后传来罗宾松了口气的声音。
    <</language>>
  <</if>>
  <<set C.npc.Robin.conviction to Math.min(200, C.npc.Robin.conviction + 4)>><<ggconviction>>
  <<npcincr Robin dom 1>><br><br><<gdom>>
<<else>>
  <<language>>
    <<option 'EN'>>
      This confession has already ended, or Robin has not come to confess today.
    <<option 'CN'>>
      这次告解已经结束，或是罗宾今天还没有来告解。
  <</language>><br><br>
<</if>>
<<getouticon>><<lanLink '结束这次告解' 'Temple Confess Start'>><<endconfession>><</lanLink>><br>

:: RobinTemple Confession Comfort
<<set $outside to 0>><<set $location to 'temple'>><<temple_effects>><<effects>><<npc Robin>><<person1>>
<<if $RobinTemple.confession_day is Time.days and !$RobinTemple.confession_resolved>>
  <<set $RobinTemple.confession_resolved to true>>
  <<language>>
    <<option 'EN'>>
      You put your palm against the wooden screen. Robin presses <<his>> hand against the other side. Neither of you can see the other, but <<he>> stays until <<his>> breathing slows.
    <<option 'CN'>>
      你把手掌贴在木板上。罗宾把手贴在另一侧。你们看不见彼此，但<<he>>一直待到呼吸平稳下来。
  <</language>>
  <br><br>
  <<language>>
    <<option 'EN'>>
      "Thank you," <<he>> says. "I wanted to hear your voice."
    <<option 'CN'>>
      “谢谢，”<<he>>说，“我只是想听听你的声音。”
  <</language>>
  <<npcincr Robin love 2>><<npcincr Robin trauma -2>><br><br><<glove>><<lrtrauma>>
<<else>>
  <<language>>
    <<option 'EN'>>
      This confession has already ended, or Robin has not come to confess today.
    <<option 'CN'>>
      这次告解已经结束，或是罗宾今天还没有来告解。
  <</language>><br><br>
<</if>>
<<getouticon>><<lanLink '结束这次告解' 'Temple Confess Start'>><<endconfession>><</lanLink>><br>

:: RobinTemple Confession Admonish
<<set $outside to 0>><<set $location to 'temple'>><<temple_effects>><<effects>><<npc Robin>><<person1>>
<<if $RobinTemple.confession_day is Time.days and !$RobinTemple.confession_resolved>>
  <<set $RobinTemple.confession_resolved to true>>
  <<language>>
    <<option 'EN'>>
      You remind Robin that Jordan asked for a vow made by choice. Robin goes quiet. "I know," <<he>> says quietly. "I meant it. I'm trying."
    <<option 'CN'>>
      你提醒罗宾，约旦要的是自己选择的誓言。罗宾安静下来。“我知道，”<<he>>轻声说，“我是真心的。我在努力。”
  <</language>>
  <br><br>
  <<set C.npc.Robin.conviction to Math.max(0, C.npc.Robin.conviction - 2)>><<lconviction>>
  <<npcincr Robin dom 1>><<npcincr Robin love -1>><br><br><<gdom>><<llove>>
<<else>>
  <<language>>
    <<option 'EN'>>
      This confession has already ended, or Robin has not come to confess today.
    <<option 'CN'>>
      这次告解已经结束，或是罗宾今天还没有来告解。
  <</language>><br><br>
<</if>>
<<getouticon>><<lanLink '结束这次告解' 'Temple Confess Start'>><<endconfession>><</lanLink>><br>
