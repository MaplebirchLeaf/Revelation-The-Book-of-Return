:: Revelation Robin Temple Confession Widgets [widget]
<!-- ./src/twee/RobinTemple/Confession.twee -->
<<widget 'revelation-robin-confession-event'>>
  <<if ['member', 'approved', 'promised'].includes($RevelationRobinTemple.stage)
    and $RevelationRobinTemple.confession_day isnot Time.days
    and $confessionsTaken gte 5
    and Time.hour gte 17 and Time.hour lt 20
    and getRobinLocation() is 'temple' and !$robinmissing>>
    <<addinlineevent 'revelation_robin_confession' 2>>
      <<npc Robin>><<person1>>
      <<set $attendant to 'revelation_robin_confession'>>
      <<set $RevelationRobinTemple.confession_day to Time.days>>
      <<set _noOptions to true>>
      <<lanSwitch 'The other door closes softly. You recognise Robin’s voice before <<he>> finishes greeting you.' '对面的门轻轻关上。罗宾还没问候完，你就认出了<<his>>的声音。'>>
      <br><br>
      <<if $RevelationRobinTemple.penance_day gte 0>>
        <<lanSwitch '"Jordan said we had to answer for our vows," <<he>> says. "I keep wondering who gets to decide what answering for them should mean."' '“约旦说我们得为自己的誓言负责，”<<he>>说，“可我一直在想，该由谁决定怎样才算负责。”'>>
      <<elseif $RevelationRobinTemple.stage is 'promised'>>
        <<lanSwitch '"I meant what I promised," <<he>> says. "But sometimes I worry I only came here because I was afraid of losing you."' '“我立下的誓言是真心的，”<<he>>说，“但有时我担心自己来这里，只是因为害怕失去你。”'>>
      <<else>>
        <<lanSwitch '"I want to help the people here," <<he>> says. "I keep wondering whether that is enough of a reason to stay."' '“我想帮这里的人，”<<he>>说，“可我一直在想，这算不算留下来的理由。”'>>
      <</if>>
      <br><br>
      <<if $RevelationRobinTemple.penance_day gte 0>>
        <<socialiseicon 'ask'>><<lanLink '听罗宾说说惩戒的事' 'Revelation Robin Temple Confession Doubt'>><</lanLink>><br>
      <</if>>
      <<socialiseicon 'ask'>><<lanLink '请罗宾说说自己的选择' 'Revelation Robin Temple Confession Listen'>><</lanLink>><br>
      <<loveicon 'hug'>><<lanLink '隔着木板安慰罗宾' 'Revelation Robin Temple Confession Comfort'>><</lanLink>><br>
      <<templeicon 'altar'>><<lanLink '提醒罗宾认真对待誓言' 'Revelation Robin Temple Confession Admonish'>><</lanLink>><br>
    <</addinlineevent>>
    <<if $robinpaid is 1>>
      <<addinlineevent 'revelation_robin_confession_debt' 1>>
        <<npc Robin>><<person1>>
        <<set $attendant to 'revelation_robin_confession_debt'>>
        <<set $RevelationRobinTemple.confession_day to Time.days>>
        <<set _noOptions to true>>
        <<lanSwitch
          'Robin sits on the other side of the screen. "You paid what I owed Bailey," <<he>> says. "I still count the money whenever I close the stall. I know you never asked for it back."'
          '罗宾在木板另一侧坐下。“你替我还了欠贝利的钱，”<<he>>说，“每天收摊，我还是会把钱数一遍。我知道你从没让我还。”'
        >>
        <br><br>
        <<lanSwitch
          '"I want to help you too," <<he>> says. "I just do not know how to do that without making it another debt."'
          '“我也想帮你，”<<he>>说，“可我不知道怎么做，才不会又变成一笔欠账。”'
        >>
        <br><br>
        <<loveicon 'hug'>><<lanLink '告诉罗宾你从未记过这笔账' 'Revelation Robin Temple Confession Debt Comfort'>><</lanLink>><br>
        <<socialiseicon 'ask'>><<lanLink '问罗宾自己想做什么' 'Revelation Robin Temple Confession Debt Plan'>><</lanLink>><br>
      <</addinlineevent>>
    <</if>>
  <</if>>
<</widget>>

:: Revelation Robin Temple Confession Debt Comfort
<<set $outside to 0>><<set $location to 'temple'>><<temple_effects>><<effects>><<npc Robin>><<person1>>
<<lanSwitch
  '"It was not a loan," you say. Robin is quiet. "I know," <<he>> says at last. "I think I wanted to hear you say it again."'
  '“那不是借你的钱，”你说。罗宾安静了一会儿。“我知道，”<<he>>终于说，“我想再听你亲口说一遍。”'
>>
<br><br>
<<lanSwitch
  'You hear <<him>> breathe out. When <<he>> speaks again, <<his>> voice is steadier.'
  '你听见<<he>>缓缓吐出一口气。再次开口时，<<his>>的声音平稳了些。'
>>
<<npcincr Robin love 2>><<npcincr Robin trauma -2>><br><br><<glove>><<lrtrauma>>
<<getouticon>><<lanLink '结束这次忏悔' 'Temple Confess Start'>><<endconfession>><</lanLink>><br>

:: Revelation Robin Temple Confession Debt Plan
<<set $outside to 0>><<set $location to 'temple'>><<temple_effects>><<effects>><<npc Robin>><<person1>>
<<lanSwitch
  '"What would you choose to do?" you ask. Robin thinks about the stall, the orphanage, and the work waiting here. "There is plenty I can do," <<he>> says. "I do not need a bill to tell me when to start."'
  '“那你自己想做什么？”你问。罗宾想起摊位、孤儿院和神殿里等着做的事。“能做的事很多，”<<he>>说，“不需要一张账单来催我。”'
>>
<br><br>
<<lanSwitch
  'You leave the decision with <<him>>. Robin thanks you for listening.'
  '你把决定留给<<him>>。罗宾向你道了谢。'
>>
<<set C.npc.Robin.revelationConviction to Math.min(200, C.npc.Robin.revelationConviction + 2)>>
<<npcincr Robin dom 2>><br><br><<gdom>>
<<getouticon>><<lanLink '结束这次忏悔' 'Temple Confess Start'>><<endconfession>><</lanLink>><br>

:: Revelation Robin Temple Confession Doubt
<<set $outside to 0>><<set $location to 'temple'>><<temple_effects>><<effects>><<npc Robin>><<person1>>
<<lanSwitch '"I know I made a vow," Robin says. "I also know you can be hurt without choosing it. Is the temple going to call that a broken promise?"' '“我知道自己立下了誓言，”罗宾说，“我也知道，有时人受伤并不是自己选的。神殿也会把那算成背誓吗？”'>>
<br><br>
<<lanSwitch 'You cannot see <<his>> face through the wooden screen. <<He>> waits for you to answer anyway.' '隔着木板，你看不见<<his>>的脸。<<He>>仍等着你回答。'>>
<br><br>
<<loveicon 'hug'>><<lanLink '告诉罗宾受伤不是罪' 'Revelation Robin Temple Confession Doubt Answer'>><<set $RevelationRobinTemple.penance_response to 'hold'>><</lanLink>><br>
<<templeicon 'altar'>><<lanLink '劝罗宾向约旦问清楚' 'Revelation Robin Temple Confession Doubt Answer'>><<set $RevelationRobinTemple.penance_response to 'speak'>><</lanLink>><br>

:: Revelation Robin Temple Confession Doubt Answer
<<set $outside to 0>><<set $location to 'temple'>><<temple_effects>><<effects>><<npc Robin>><<person1>>
<<if $RevelationRobinTemple.penance_response is 'hold'>>
  <<lanSwitch '"No," you say. "What someone does to you is not a choice you made." Robin is silent for a long time. "Thank you," <<he>> says at last.' '“不算，”你说，“别人对你做的事，不是你的选择。”罗宾沉默了很久。“谢谢，”<<he>>终于说。'>>
  <<npcincr Robin love 2>><<npcincr Robin trauma -3>><br><br><<glove>><<lrtrauma>>
<<else>>
  <<lanSwitch
    'You tell Robin that Jordan should answer the question openly. "I will ask," <<he>> says. "And if I do not agree with the answer, I will say that too."'
    '你告诉罗宾，该请约旦公开回答这个问题。“我会去问，”<<he>>说，“如果我不同意答案，也会说出来。”'
  >>
  <<npcincr Robin dom 2>><br><br><<gdom>>
<</if>>
<<getouticon>><<lanLink '结束这次忏悔' 'Temple Confess Start'>><<endconfession>><</lanLink>><br>

:: Revelation Robin Temple Confession Listen
<<set $outside to 0>><<set $location to 'temple'>><<temple_effects>><<effects>><<npc Robin>><<person1>>
<<lanSwitch
  'You wait. Robin tells you about the work <<he>> chose to do and the work <<he>> still wants to do outside these walls. "I think I can belong to both," <<he>> says at last.'
  '你等罗宾说完。<<He>>讲起自己在神殿接下的工作，也讲起墙外仍想做的事。“我想两边都能顾到，”<<he>>终于说。'
>>
<br><br>
<<lanSwitch '"Then tell Jordan that," you say. You hear Robin let out a breath behind the screen.' '“那就这样告诉约旦，”你说。屏风后传来罗宾松了口气的声音。'>>
<<set C.npc.Robin.revelationConviction to Math.min(200, C.npc.Robin.revelationConviction + 4)>>
<<npcincr Robin dom 1>><br><br><<gdom>>
<<getouticon>><<lanLink '结束这次忏悔' 'Temple Confess Start'>><<endconfession>><</lanLink>><br>

:: Revelation Robin Temple Confession Comfort
<<set $outside to 0>><<set $location to 'temple'>><<temple_effects>><<effects>><<npc Robin>><<person1>>
<<lanSwitch
  'You put your palm against the wooden slats. Robin’s fingers find yours on the other side. Neither of you can see the other, but <<he>> stays until <<his>> breathing slows.'
  '你把手掌贴在木板上。罗宾从另一边用手指碰了碰你。你们看不见彼此，但<<he>>一直待到呼吸平稳下来。'
>>
<br><br>
<<lanSwitch '"Thank you," <<he>> says. "I wanted to hear your voice."' '“谢谢，”<<he>>说，“我只是想听听你的声音。”'>>
<<npcincr Robin love 2>><<npcincr Robin trauma -2>><br><br><<glove>><<lrtrauma>>
<<getouticon>><<lanLink '结束这次忏悔' 'Temple Confess Start'>><<endconfession>><</lanLink>><br>

:: Revelation Robin Temple Confession Admonish
<<set $outside to 0>><<set $location to 'temple'>><<temple_effects>><<effects>><<npc Robin>><<person1>>
<<lanSwitch
  'You remind Robin that Jordan asked for a vow made by choice. Robin goes quiet. "I know," <<he>> says. "I will not say the words only because someone wants to hear them."'
  '你提醒罗宾，约旦要的是自己选择的誓言。罗宾安静下来。“我知道，”<<he>>说，“我不会只因为有人想听，就说出那些话。”'
>>
<br><br>
<<set C.npc.Robin.revelationConviction to Math.max(0, C.npc.Robin.revelationConviction - 2)>>
<<npcincr Robin dom 1>><<npcincr Robin love -1>><br><br><<gdom>><<llove>>
<<getouticon>><<lanLink '结束这次忏悔' 'Temple Confess Start'>><<endconfession>><</lanLink>><br>
