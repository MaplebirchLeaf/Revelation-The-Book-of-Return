  <<if (C.npc.Robin.virginity.vaginal and C.npc.Robin.virginity.penile
    and $player.virginity.penile is true and $player.virginity.vaginal is true)
    or ($player.virginity.temple is true and C.npc.Robin.virginity.temple is true)>>
    <<language>>
      <<option 'EN'>>
        <span class="gold">It begins to intensely sparkle.</span> Jordan smiles.
        "You have been faithful to one another, and may it stay that way."
        <<if playerChastity() and $worn.genitals.origin is "temple">>
          With one anxious motion, <<he>> returns your $worn.genitals.name to its place, guarding your crotch.
        <</if>>
        <br><br>
        <<person1>><<He>> turns away to let you both dress.
        <<robin-temple-examination-success>>
        Robin hugs you. "I love you." <<stress -6>><<lstress>>
        <br><br>
        <<clotheson>>
        <<link [[Next|Temple]]>><<endevent>><</link>>
      <<option 'CN'>>
        <span class="gold">粉末闪起了激烈的火花，</span>约旦微笑了起来。
        “你们对彼此忠诚，希望继续保持。”
        <<if playerChastity() and $worn.genitals.origin is "temple">>
          <<he>>飞快地将$worn.genitals.cn_name_cap装了回去，护住你的裆部。
        <</if>>
        <br><br>
        <<person1>><<He>>转过身，让你们将衣物穿好。
        <<robin-temple-examination-success>>
        罗宾抱住你。“我爱你。”<<stress -6>><<lstress>>
        <br><br>
        <<clotheson>>
        <<link [[继续|Temple]]>><<endevent>><</link>>
    <</language>>
  <<else>>
    <<language>>
      <<option 'EN'>>
        <span class='red'>It remains inert.</span> Jordan frowns.
        "I'm sorry, but one of you is spoilt." <<person1>><<His>> voice shakes slightly, you're not sure if you imagined it.
      <<option 'CN'>>
        <span class='red'>粉末毫无反应。</span>约旦皱起了眉头。“抱歉，你们有人已经不洁了。”<<person1>><<His>>的声音有些颤抖，你不确定自己是否听错了。
    <</language>>
    <br><br>
    <<robin-temple-purification-summons false>>
  <</if>>
<</if>>

:: RobinTemple Monthly Refuse
<<set $outside to 0>><<set $location to 'temple'>><<temple_effects>><<effects>><<npc Jordan>><<person1>>
<<if !$RobinTemple.monthly_checked and $RobinTemple.templePromised is 'Robin'>>
  <<language>>
    <<option 'EN'>>
      "Then I must assume the worst," Jordan says, looking at <<his>> feet.
    <<option 'CN'>>
      “那我必须设想最坏的情况。”约旦说，直直地盯着脚尖。
  <</language>>
  <br><br>
  <<robin-temple-purification-summons false>>
<<else>>
  <<getouticon>><<lanLink ['Return to the hall', '返回大厅'] 'Temple'>><</lanLink>><br>
<</if>>

:: RobinTemple Monthly Admit
<<set $outside to 0>><<set $location to 'temple'>><<temple_effects>><<effects>><<npc Jordan>><<person1>>
<<if !$RobinTemple.monthly_checked and $RobinTemple.templePromised is 'Robin'>>
  <<if $speech_attitude is 'meek'>>
    <<language>>
      <<option 'EN'>>
        "I, I haven’t kept it," you say. "I’m sorry. I’m so sorry..."
      <<option 'CN'>>
        “我，我没有守节，”你说，“抱歉，我真的很抱歉……”
    <</language>>
  <<elseif $speech_attitude is 'bratty'>>
    <<language>>
      <<option 'EN'>>
        "No need," you say. "I haven’t been faithful."
      <<option 'CN'>>
        “没必要了，”你说，“我没能保持忠诚。”
    <</language>>
  <<else>>
    <<language>>
      <<option 'EN'>>
        "I’m sorry," you say. "I haven’t been faithful."
      <<option 'CN'>>
        “抱歉，”你说，“我没有保持忠诚。”
    <</language>>
  <</if>><br><br>
  <<language>>
    <<option 'EN'>>
      "Thank you for your honesty," Jordan says, looking at <<his>> feet.
    <<option 'CN'>>
      “谢谢你的坦诚。”约旦说，直直地盯着脚尖。
  <</language>>
  <br><br>
  <<robin-temple-purification-summons false>>
<<else>>
  <<getouticon>><<lanLink ['Return to the hall', '返回大厅'] 'Temple'>><</lanLink>><br>
<</if>>
