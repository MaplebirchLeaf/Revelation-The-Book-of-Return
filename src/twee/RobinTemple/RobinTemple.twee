:: RobinTemple Widgets [widget]
<<widget 'robin-temple-return-home'>>
  <<set _robinResidence to maplebirch.get('VP')?.realEstate.residenceOf('Robin')>>
  <<if _robinResidence>>
    <<getouticon>><<lanLink 'revelation-the-book-of-return:robinTemple:link:sharedHome' 'Deadwood Reblooms Property Home'>>
      <<run maplebirch.get('VP').realEstate.visit(_robinResidence.id)>>
      <<pass _args[0]>>
    <</lanLink>><br>
  <<else>>
    <<getouticon>><<lanLink '送罗宾回孤儿院' 'Orphanage'>><<pass _args[0]>><</lanLink>><br>
  <</if>>
<</widget>>

<<widget 'robin-temple-room-note'>>
  <<language>>
    <<option 'EN'>>
      You go to Robin's room. A note on the door says <<he>> is at the temple.
    <<option 'CN'>>
      你来到罗宾的房间。门上的字条写着，<<he>>去了神殿。
  <</language>>
  <br><br>
  <<main_hall_icon>><<lanLink '返回孤儿院大厅 (0:01)' 'Orphanage'>><<pass 1>><</lanLink>><br>
<</widget>>

<<widget "robin-temple-room-link">>
  <<if ["initiate", "monk", "priest"].includes($temple_rank)
    and C.npc.Robin.init is 1
    and !$robinmissing
    and $exposed lte 0>>
    <<if $RobinTemple.stage is "none" and C.npc.Robin.love gte 100
      and C.npc.Robin.trauma lt 80 and $robin.timer.hurt is 0>>
      <<if playerChastity()>>
        <<socialiseicon "ask">><<lanLink '和罗宾谈谈神殿' 'RobinTemple Invitation'>><</lanLink>><br>
      <<else>>
        <<language>>
          <<option 'EN'>>
            <span class="teal">You could talk to Robin about the temple after taking its vow.</span>
          <<option 'CN'>>
            <span class="teal">立下神殿誓言后，可以和罗宾谈谈神殿的事。</span>
        <</language>><br>
      <</if>>
    <<elseif $RobinTemple.stage is "invited">>
      <<socialiseicon "ask">><<lanLink '问罗宾纯洁试炼的事' 'RobinTemple Schedule'>><</lanLink>><br>
    <<elseif $RobinTemple.stage is 'scheduled'
      and Time.days lt $RobinTemple.exam_day
      and $RobinTemple.prepared_day isnot Time.days
      and getRobinLocation() is 'orphanage'
      and Time.hour gte 17
      and (Time.hour lt 19 or Time.hour is 19 and Time.minute lte 15)
      and !(maplebirch.get('Robin') and $RobinExpansion?.tutor
      and Time.schoolDay and (Time.hour lt 18 or Time.hour is 18 and Time.minute lt 30))
      and !(maplebirch.get('Robin') and $RobinExpansion?.shop
      and $RobinExpansion.shopStaff lt 1 and (Time.hour gt 17 or Time.minute gt 15))>>
      <<templeicon 'altar'>><<lanLink '陪罗宾去神殿准备试炼 (0:45)' 'RobinTemple Prepare'>>
        <<run setRobinLocationOverride('temple', maplebirch.get('Robin') && $RobinExpansion?.shop && $RobinExpansion.shopStaff < 1 ? [17] : [17, 18, 19])>>
        <<pass 45>>
      <</lanLink>><br>
    <<elseif $RobinTemple.stage is "failed" and Time.days gte $RobinTemple.exam_day + 7>>
      <<socialiseicon "ask">><<lanLink '问罗宾愿不愿意再试一次纯洁试炼' 'RobinTemple Retry'>><</lanLink>><br>
    <<elseif ['member', 'approved', 'promised'].includes($RobinTemple.stage)
      and C.npc.Robin.trauma lt 80 and $robin.timer.hurt is 0
      and getRobinLocation() is 'orphanage'
      and !(maplebirch.get('Robin') and $RobinExpansion?.tutor and Time.schoolDay
      and (Time.hour lt 18 or Time.hour is 18 and Time.minute lt 30))
      and !(maplebirch.get('Robin') and $RobinExpansion?.shop
      and $RobinExpansion.shopStaff lt 1 and Time.hour gte 17)
      and ((Time.hour gte 17 and (Time.hour lt 19 or Time.hour is 19 and Time.minute lt 45))
      or (!Time.schoolDay and !Time.isWeekEnd() and Time.hour gte 9
      and (Time.hour lt 15 or Time.hour is 15 and Time.minute lt 45)))>>
      <<templeicon 'altar'>><<lanLink '和罗宾一起去神殿 (0:15)' 'Temple'>><<run setRobinLocationOverride('temple', Time.hour < 16 ? [9, 10, 11, 12, 13, 14, 15] : [17, 18, 19])>><<pass 15>><</lanLink>><br>
    <</if>>
  <</if>>
<</widget>>

<<widget "robin-temple-links">>
  <<if $exposed lte 0 and $stress lt $stressmax and C.npc.Robin.init is 1
    and !$robinmissing and getRobinLocation() isnot 'asylum'>>
    <<if $RobinTemple.stage is "scheduled">>
      <<if Time.days gte $RobinTemple.exam_day and Time.hour gte 6 and (Time.hour lt 8 or !Time.schoolDay and Time.hour lt 18)>>
        <<templeicon "altar">><<lanLink '陪罗宾参加纯洁试炼' 'RobinTemple Assessment'>><</lanLink>><br>
      <</if>>
    <<elseif ["member", "approved", "promised"].includes($RobinTemple.stage)>>
      <<icon 'temple/Robinquarters.png'>><<lanLink '去罗宾在宿舍的座位' 'RobinTemple Corner'>><</lanLink>><br>
      <<if $RobinTemple.punish>>
        <<templeicon 'altar'>><<lanLink ['Continue the purification', '继续净化'] ($RobinTemple.punish.started ? 'RobinTemple Penance Trial' : 'RobinTemple Penance')>><</lanLink>><br>
      <</if>>
      <<if $RobinTemple.vigil_attempt_day gte 0
        and !$RobinTemple.vigil_followup
        and Time.days gte $RobinTemple.vigil_attempt_day
        and $RobinTemple.vigil_result isnot ''
        and getRobinLocation() is 'temple'
        and !($RobinTemple.vigil_result isnot 'passed'
        and (Time.weekDay is 1 and Time.hour gte 20 or Time.weekDay is 2 and Time.hour lt 7))>>
        <<socialiseicon "ask">><<lanLink '和罗宾谈谈守夜试炼' 'RobinTemple Vigil After'>><</lanLink>><br>
      <</if>>
    <</if>>
    <br>
  <</if>>
<</widget>>

<<widget 'robin-temple-examination-ready'>>
  <!-- 任一日历到期都进入同一轮月检；暂时无法到场时不会让 PC 先重复检查。 -->
  <<set _robinTempleExamDue to $RobinTemple.templePromised is 'Robin'
  and ($RobinTemple.chastity_timer lte 0
  or $temple_chastity_timer lte 0
  or !$RobinTemple.monthly_checked)
  and $temple_rank isnot undefined and $temple_rank isnot 'prospective'
  and $exposed lte 0>>
<</widget>>

<<widget 'robin-temple-examination'>>
  <<if C.npc.Robin.init isnot 1 or $robinmissing or $robin.timer.hurt isnot 0
    or C.npc.Robin.trauma gte 80 or getRobinLocation() is 'asylum'>>
    <<language>>
      <<option 'EN'>>
        Robin cannot attend. The examination will wait until <<nnpc_he 'Robin'>> can join you.
      <<option 'CN'>>
        罗宾暂时无法到场。等<<nnpc_he 'Robin'>>能够参加时，再一同接受检查。
    <</language>>
    <br><br>
    <<getouticon>><<lanLink ['Leave the temple (0:01)', '离开神殿 (0:01)'] 'Town'>><<pass 1>><</lanLink>><br>
  <<elseif $RobinTemple.punish>>
    <<templeicon 'altar'>><<lanLink ['Continue the purification', '继续净化'] ($RobinTemple.punish.started ? 'RobinTemple Penance Trial' : 'RobinTemple Penance')>><</lanLink>><br>
  <<else>>
    <<set $RobinTemple.monthly_checked to false>>
    <<set $RobinTemple.chastity_timer to 30>>
    <!-- 两份日历在同一轮检查中重置，PC 不会另行接受单人月检。 -->
    <<set $temple_chastity_timer to 30>>
    <<if $templePromised is 'Sydney'>>
      <<robin-temple-joint-examination>>
    <<else>>
      <<robin-temple-monthly-examination>>
    <</if>>
  <</if>>
<</widget>>

<<widget 'robin-temple-joint-examination'>>
  <<npc Jordan>><<person1>>
  <<language>>
    <<option 'EN'>>
      Jordan meets you at the altar. "Sydney and Robin have both made promises with you. I will hear from all three of you today," <<he>> says.
    <<option 'CN'>>
      约旦在祭坛前等着你。“悉尼和罗宾都与你立过誓。今天我要听你们三个人亲口回答。”<<he>>说。
  <</language>>
  <br><br>
  <<templeicon 'altar'>><<lanLink '请罗宾与悉尼一同接受检查' 'RobinTemple Joint Examination'>><</lanLink>><br>
  <<getouticon>><<lanLink '拒绝检查' 'RobinTemple Joint Refuse'>><<npcincr Robin love -5>><<npcincr Sydney love -5>><</lanLink>><<lllove 'Robin'>><<lllove 'Sydney'>><br>
  <<socialiseicon 'ask'>><<lanLink '先向约旦说明情况' 'RobinTemple Joint Admit'>><<npcincr Robin love -10>><<npcincr Sydney love -10>><</lanLink>><<llllove 'Robin'>><<llllove 'Sydney'>><br>
<</widget>>

<<widget "robin-temple-monthly-examination">>
  <<npc Jordan>><<person1>>
  <<language>>
    <<option 'EN'>>
      Jordan stops you near the altar. "It is time to examine the vow you and Robin made together. I have sent for <<nnpc_him 'Robin'>>."
    <<option 'CN'>>
      约旦在祭坛旁叫住你。“该检查你和罗宾共同立下的誓言了。我已经派人去请<<nnpc_him 'Robin'>>。”
  <</language>>
  <br><br>
  <<templeicon "altar">><<lanLink '和罗宾一起接受检查' 'RobinTemple Monthly Examination'>><</lanLink>><br>
  <<getouticon>><<lanLink '拒绝检查' 'RobinTemple Monthly Refuse'>><<npcincr Robin love -5>><</lanLink>><<lllove 'Robin'>><br>
  <<socialiseicon 'ask'>><<lanLink '先向约旦坦白' 'RobinTemple Monthly Admit'>><<npcincr Robin love -10>><</lanLink>><<llllove 'Robin'>><br>
<</widget>>
