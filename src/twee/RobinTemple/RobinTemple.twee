:: RobinTemple Widgets [widget]
<!-- ./src/twee/RobinTemple/RobinTemple.twee -->
<<widget 'robin-temple-return-home'>>
  <<set _robinResidence to maplebirch.get('VP')?.realEstate.residenceOf('Robin')>>
  <<if _robinResidence>>
    <<getouticon>><<lanLink 'revelation-the-book-of-return:robinTemple:link:sharedHome' 'Deadwood Reblooms Property Home'>>
      <<run maplebirch.get('VP').realEstate.visit(_robinResidence.id)>>
      <<pass _args[0]>>
    <</lanLink>><br>
  <<else>>
    <<getouticon>><<lanLink '送罗宾回孤儿院' 'Orphanage'>><<pass _args[0]>><</lanLink>><br>
  <</if>>
<</widget>>

<<widget 'robin-temple-room-note'>>
  <<language>>
    <<option 'EN'>>You go to Robin's room. A note on the door says <<he>> is at the temple.
    <<option 'CN'>>你来到罗宾的房间。门上的字条写着，<<he>>去了神殿。
  <</language>>
  <br><br>
  <<main_hall_icon>><<lanLink '返回孤儿院大厅 (0:01)' 'Orphanage'>><<pass 1>><</lanLink>><br>
<</widget>>

<<widget "robin-temple-room-link">>
  <<if ["initiate", "monk", "priest"].includes($temple_rank)
    and C.npc.Robin.init is 1
    and !$robinmissing
    and $exposed lte 0>>
    <<if $RobinTemple.stage is "none" and C.npc.Robin.love gte 100
      and C.npc.Robin.trauma lt 80 and $robin.timer.hurt is 0>>
      <<if playerChastity()>>
        <<socialiseicon "ask">><<lanLink '和罗宾谈谈神殿' 'RobinTemple Invitation'>><</lanLink>><br>
      <<else>>
        <<language>>
          <<option 'EN'>><span class="teal">Robin notices you have not put on a chastity device for your temple vow.</span>
          <<option 'CN'>><span class="teal">罗宾注意到你还没有为神殿誓言戴上贞操装置。</span>
        <</language>><br>
      <</if>>
    <<elseif $RobinTemple.stage is "invited">>
      <<socialiseicon "ask">><<lanLink '问罗宾考核的事' 'RobinTemple Schedule'>><</lanLink>><br>
    <<elseif $RobinTemple.stage is 'scheduled'
      and Time.days lt $RobinTemple.exam_day
      and $RobinTemple.prepared_day isnot Time.days
      and getRobinLocation() is 'orphanage'
      and Time.hour gte 17
      and (Time.hour lt 19 or Time.hour is 19 and Time.minute lte 15)
      and !(maplebirch.get('RobinExpansion') and $RobinExpansion?.tutor
        and Time.schoolDay and (Time.hour lt 18 or Time.hour is 18 and Time.minute lt 30))
      and !(maplebirch.get('RobinExpansion') and $RobinExpansion?.shop
        and $RobinExpansion.shopStaff lt 1 and (Time.hour gt 17 or Time.minute gt 15))>>
      <<templeicon 'altar'>><<lanLink '陪罗宾去神殿准备考核 (0:45)' 'RobinTemple Prepare'>>
        <<run setRobinLocationOverride('temple', maplebirch.get('RobinExpansion') && $RobinExpansion?.shop && $RobinExpansion.shopStaff < 1 ? [17] : [17, 18, 19])>>
        <<pass 45>>
      <</lanLink>><br>
    <<elseif $RobinTemple.stage is "failed" and Time.days gte $RobinTemple.exam_day + 7>>
      <<socialiseicon "ask">><<lanLink '问罗宾愿不愿意再试一次考核' 'RobinTemple Retry'>><</lanLink>><br>
    <<elseif ['member', 'approved', 'promised'].includes($RobinTemple.stage)
      and C.npc.Robin.trauma lt 80 and $robin.timer.hurt is 0
      and getRobinLocation() is 'orphanage'
      and !(maplebirch.get('RobinExpansion') and $RobinExpansion?.tutor and Time.schoolDay
        and (Time.hour lt 18 or Time.hour is 18 and Time.minute lt 30))
      and !(maplebirch.get('RobinExpansion') and $RobinExpansion?.shop
        and $RobinExpansion.shopStaff lt 1 and Time.hour gte 17)
      and ((Time.hour gte 17 and (Time.hour lt 19 or Time.hour is 19 and Time.minute lt 45))
        or (!Time.schoolDay and !Time.isWeekEnd() and Time.hour gte 9
          and (Time.hour lt 15 or Time.hour is 15 and Time.minute lt 45)))>>
      <<templeicon 'altar'>><<lanLink '和罗宾一起去神殿 (0:15)' 'Temple'>><<run setRobinLocationOverride('temple', Time.hour < 16 ? [9, 10, 11, 12, 13, 14, 15] : [17, 18, 19])>><<pass 15>><</lanLink>><br>
    <</if>>
  <</if>>
<</widget>>

<<widget "robin-temple-links">>
  <<if $exposed lte 0 and $stress lt $stressmax and C.npc.Robin.init is 1
    and !$robinmissing and getRobinLocation() isnot 'asylum'>>
    <<if $RobinTemple.stage is "scheduled">>
      <<if Time.days gte $RobinTemple.exam_day and Time.hour gte 6 and (Time.hour lt 8 or !Time.schoolDay and Time.hour lt 18)>>
        <<templeicon "altar">><<lanLink '陪罗宾参加考核' 'RobinTemple Assessment'>><</lanLink>><br>
      <</if>>
    <<elseif ["member", "approved", "promised"].includes($RobinTemple.stage)>>
      <<icon 'temple/Robinquarters.png'>><<lanLink '去罗宾在宿舍的座位' 'RobinTemple Corner'>><</lanLink>><br>
      <<if $RobinTemple.penance_day gte 0 and Time.days gte $RobinTemple.penance_day>>
        <<if $RobinTemple.joint_sydney_penance>>
          <<templeicon 'altar'>><<lanLink '向约旦交还三人的工作记录' 'RobinTemple Joint Restoration'>><</lanLink>><br>
        <<else>>
          <<templeicon 'altar'>><<lanLink '和罗宾完成赎罪工作' 'RobinTemple Penance'>><</lanLink>><br>
        <</if>>
      <</if>>
      <<if $RobinTemple.penance_day gte 0
        and $RobinTemple.penance_work_day isnot Time.days
        and Time.hour gte 13 and Time.hour lt 20
        and getRobinLocation() is 'temple'>>
        <<if $RobinTemple.joint_sydney_penance>>
          <<choreicon 'sweep'>><<lanLink '和罗宾、悉尼一起值班 (1:00)' 'RobinTemple Joint Work'>><<pass 60>><</lanLink>><br>
        <<else>>
          <<choreicon 'sweep'>><<lanLink '陪罗宾做赎罪工作 (1:00)' 'RobinTemple Penance Work'>><<pass 60>><</lanLink>><br>
        <</if>>
      <</if>>
      <<if $RobinTemple.vigil_attempt_day gte 0
        and !$RobinTemple.vigil_followup
        and Time.days gte $RobinTemple.vigil_attempt_day
        and $RobinTemple.vigil_result isnot ''>>
        <<socialiseicon "ask">><<lanLink '和罗宾谈谈守夜试炼' 'RobinTemple Vigil After'>><</lanLink>><br>
      <</if>>
    <</if>>
    <br>
  <</if>>
<</widget>>

<<widget 'robin-temple-joint-examination'>>
  <<npc Jordan>><<person1>>
  <<if !$RobinTemple.joint_consent>>
    <<language>>
      <<option 'EN'>>Jordan sees both names on your records and closes the examination book. "First, the three of you must tell me whether this was a choice you all made."
      <<option 'CN'>>约旦看见记录上写着罗宾和悉尼的名字，合上了检查簿。“先告诉我，这是不是你们三个人共同作出的选择。”
    <</language>>
    <br><br>
    <<socialiseicon 'ask'>><<lanLink '请罗宾与悉尼一起谈清楚' 'RobinTemple Joint Reconcile'>><</lanLink>><br>
  <<elseif $RobinTemple.joint_sydney_penance>>
    <<language>>
      <<option 'EN'>>Jordan points to the unfinished work list. "Finish what we agreed first. Then we will speak about the vows again."
      <<option 'CN'>>约旦指向尚未完成的工作表。“先做完约定的事，然后我们再谈誓言。”
    <</language>>
    <br><br>
    <<getouticon>><<lanLink '返回神殿宿舍' 'Temple Quarters'>><</lanLink>><br>
  <<else>>
    <<language>>
      <<option 'EN'>>Jordan meets you at the altar. "Sydney and Robin have both made promises with you. I will hear from all three of you today," <<he>> says.
      <<option 'CN'>>约旦在祭坛前等着你。“悉尼和罗宾都与你立过誓。今天我要听你们三个人亲口回答。”<<he>>说。
    <</language>>
    <br><br>
    <<templeicon 'altar'>><<lanLink '请罗宾与悉尼一同接受检查' 'RobinTemple Joint Examination'>><</lanLink>><br>
    <<getouticon>><<lanLink '请求改日检查' 'RobinTemple Joint Refuse'>><</lanLink>><br>
    <<socialiseicon 'ask'>><<lanLink '先向约旦说明情况' 'RobinTemple Joint Admit'>><</lanLink>><br>
  <</if>>
<</widget>>

<<widget "robin-temple-monthly-examination">>
  <<npc Jordan>><<person1>>
  <<language>>
    <<option 'EN'>>Jordan stops you near the altar. "It is time to examine the vow you and Robin made together. I have sent for <<him>>."
    <<option 'CN'>>约旦在祭坛旁叫住你。“该检查你和罗宾共同立下的誓言了。我已经派人去请<<him>>。”
  <</language>>
  <br><br>
  <<templeicon "altar">><<lanLink '和罗宾一起接受检查' 'RobinTemple Monthly Examination'>><</lanLink>><br>
  <<getouticon>><<lanLink '拒绝检查' 'RobinTemple Monthly Refuse'>><</lanLink>><br>
  <<socialiseicon 'ask'>><<lanLink '先向约旦坦白' 'RobinTemple Monthly Admit'>><</lanLink>><br>
<</widget>>
