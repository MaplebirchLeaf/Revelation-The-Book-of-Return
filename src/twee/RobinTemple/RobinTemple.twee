:: RobinTemple Widgets [widget]
<<widget 'robin-temple-return-home'>>
  <<set _robinResidence to maplebirch.get('VanillaPlus')?.realEstate.residenceOf('Robin')>>
  <<if _robinResidence>>
    <<getouticon>><<lanLink ['Go back to your shared home with Robin', '陪罗宾回你们的住处'] 'Deadwood Reblooms Property Home'>>
      <<run maplebirch.get('VanillaPlus').realEstate.visit(_robinResidence.id)>>
      <<run maplebirch.get('RobinTemple').visit(0)>>
      <<pass _args[0]>>
    <</lanLink>><br>
  <<else>>
    <<getouticon>><<lanLink ['Take Robin back to the orphanage', '送罗宾回孤儿院'] 'Orphanage'>><<run maplebirch.get('RobinTemple').visit(0)>><<pass _args[0]>><</lanLink>><br>
  <</if>>
<</widget>>

<<widget 'robin-temple-room-note'>>
  <<language>>
    <<option 'EN'>>
      You go to Robin's room. A note on the door says <<he>> is at the temple.
    <<option 'CN'>>
      你来到罗宾的房间。门上的字条写着，<<he>>去了神殿。
  <</language>>
  <br><br>
  <<main_hall_icon>><<lanLink ['Return to the main hall (0:01)', '返回孤儿院大厅 (0:01)'] 'Orphanage'>><<pass 1>><</lanLink>><br>
<</widget>>

<<widget 'robin-temple-room-link'>>
  <<if maplebirch.get('RobinTemple').canTalk>>
    <<if $RobinTemple.stage is 'none' and C.npc.Robin.love gte 100>>
      <<socialiseicon 'ask'>><<lanLink ['Ask Robin about the temple', '和罗宾谈谈神殿'] 'RobinTemple Invitation'>><</lanLink>><br>
    <<elseif $RobinTemple.stage is 'invited'>>
      <<socialiseicon 'ask'>><<lanLink ['Ask Robin about the purity trial', '问罗宾纯洁试炼的事'] 'RobinTemple Schedule'>><</lanLink>><br>
    <<elseif $RobinTemple.stage is 'scheduled'
      and Time.days lt $RobinTemple.exam_day
      and $RobinTemple.prepared_day isnot Time.days
      and Time.hour gte 17
      and (Time.hour lt 19 or Time.hour is 19 and Time.minute lte 15)
      and !(maplebirch.get('Robin') and $RobinExpansion?.tutor
      and Time.schoolDay and (Time.hour lt 18 or Time.hour is 18 and Time.minute lt 30))
      and !(maplebirch.get('Robin') and $RobinExpansion?.shop
      and $RobinExpansion.shopStaff lt 1 and (Time.hour gt 17 or Time.minute gt 15))>>
      <<templeicon 'altar'>><<lanLink ['Go to the temple and prepare for the trial with Robin (0:45)', '陪罗宾去神殿准备试炼 (0:45)'] 'RobinTemple Prepare'>>
        <<run maplebirch.get('RobinTemple').visit(45)>>
        <<pass 45>>
      <</lanLink>><br>
    <<elseif $RobinTemple.stage is 'failed' and Time.days gte $RobinTemple.exam_day + 7>>
      <<socialiseicon 'ask'>><<lanLink ['Ask Robin to try the purity trial again', '问罗宾愿不愿意再试一次纯洁试炼'] 'RobinTemple Retry'>><</lanLink>><br>
    <<elseif maplebirch.get('RobinTemple').member
      and !(maplebirch.get('Robin') and $RobinExpansion?.tutor and Time.schoolDay
      and (Time.hour lt 18 or Time.hour is 18 and Time.minute lt 30))
      and !(maplebirch.get('Robin') and $RobinExpansion?.shop
      and $RobinExpansion.shopStaff lt 1 and Time.hour gte 17)
      and ((Time.hour gte 17 and (Time.hour lt 19 or Time.hour is 19 and Time.minute lt 45))
      or (!Time.schoolDay and !Time.isWeekEnd() and Time.hour gte 9
      and (Time.hour lt 15 or Time.hour is 15 and Time.minute lt 45)))>>
      <<templeicon 'altar'>><<lanLink ['Go to the temple with Robin (0:15)', '和罗宾一起去神殿 (0:15)'] 'Temple'>><<run setRobinLocationOverride('temple', Time.hour < 16 ? [9, 10, 11, 12, 13, 14, 15] : [17, 18, 19])>><<pass 15>><</lanLink>><br>
    <</if>>
  <</if>>
<</widget>>

<<widget 'robin-temple-links'>>
  <<if $exposed lte 0 and $stress lt $stressmax and C.npc.Robin.init is 1
    and !$robinmissing and getRobinLocation() isnot 'asylum'>>
    <<if $RobinTemple.stage is 'scheduled'>>
      <<if maplebirch.get('RobinTemple').assessmentReady>>
        <<templeicon 'altar'>><<lanLink ["Attend Robin's purity trial", '陪罗宾参加纯洁试炼'] 'RobinTemple Assessment'>><</lanLink>><br>
      <</if>>
    <<elseif maplebirch.get('RobinTemple').member>>
      <<icon 'temple/robin-quarters.png'>><<lanLink ["Visit Robin's place in the quarters", '去罗宾在宿舍的座位'] 'RobinTemple Corner'>><</lanLink>><br>
      <<if $RobinTemple.punish>>
        <<templeicon 'altar'>><<lanLink ['Continue the purification', '继续净化'] `$RobinTemple.punish.started ? 'RobinTemple Penance Trial' : 'RobinTemple Penance'`>><</lanLink>><br>
      <</if>>
      <<if $RobinTemple.vigil_attempt_day gte 0
        and !$RobinTemple.vigil_followup
        and Time.days gte $RobinTemple.vigil_attempt_day
        and $RobinTemple.vigil_result isnot ''
        and getRobinLocation() is 'temple'
        and !($RobinTemple.vigil_result isnot 'passed'
        and (Time.weekDay is 1 and Time.hour gte 20 or Time.weekDay is 2 and Time.hour lt 7))>>
        <<socialiseicon 'ask'>><<lanLink ['Talk to Robin about the vigil', '和罗宾谈谈守夜试炼'] 'RobinTemple Vigil After'>><</lanLink>><br>
      <</if>>
    <</if>>
    <br>
  <</if>>
<</widget>>

<<widget 'robin-temple-examination'>>
  <<if !maplebirch.get('RobinTemple').available>>
    <<language>>
      <<option 'EN'>>
        Robin cannot attend. The examination will wait until <<nnpc_he 'Robin'>> can join you.
      <<option 'CN'>>
        罗宾暂时无法到场。等<<nnpc_he 'Robin'>>能够参加时，再一同接受检查。
    <</language>>
    <br><br>
    <<getouticon>><<lanLink ['Leave the temple (0:01)', '离开神殿 (0:01)'] 'Wolf Street'>><<pass 1>><</lanLink>><br>
  <<elseif $RobinTemple.punish>>
    <<templeicon 'altar'>><<lanLink ['Continue the purification', '继续净化'] `$RobinTemple.punish.started ? 'RobinTemple Penance Trial' : 'RobinTemple Penance'`>><</lanLink>><br>
  <<else>>
    <<set $RobinTemple.monthly_checked to false>>
    <<set $RobinTemple.chastity_timer to 30>>
    <<set $temple_chastity_timer to 30>>
    <<if $RobinTemple.dual_promise or $templePromised is 'Sydney'>>
      <<robin-temple-joint-examination>>
    <<else>>
      <<robin-temple-monthly-examination>>
    <</if>>
  <</if>>
<</widget>>

<<widget 'robin-temple-joint-examination'>>
  <<npc Jordan>><<person1>>
  <<language>>
    <<option 'EN'>>
      Jordan meets you at the altar. "Sydney and Robin have both made promises with you. I will hear from all three of you today," <<he>> says.
    <<option 'CN'>>
      约旦在祭坛前等着你。“悉尼和罗宾都与你立过誓。今天我要听你们三个人亲口回答。”<<he>>说。
  <</language>>
  <br><br>
  <<templeicon 'altar'>><<lanLink ['Be examined with Robin and Sydney', '请罗宾与悉尼一同接受检查'] 'RobinTemple Joint Examination'>><</lanLink>><br>
  <<getouticon>><<lanLink ['Refuse the examination', '拒绝检查'] 'RobinTemple Joint Refuse'>><<npcincr Robin love -5>><<npcincr Sydney love -5>><</lanLink>><<lllove 'Robin'>><<lllove 'Sydney'>><br>
  <<socialiseicon 'ask'>><<lanLink ['Explain first', '先向约旦说明情况'] 'RobinTemple Joint Admit'>><<npcincr Robin love -10>><<npcincr Sydney love -10>><</lanLink>><<llllove 'Robin'>><<llllove 'Sydney'>><br>
<</widget>>

<<widget 'robin-temple-monthly-examination'>>
  <<npc Jordan>><<person1>>
  <<language>>
    <<option 'EN'>>
      Jordan stops you near the altar. "It is time to examine the vow you and Robin made together. I have sent for <<nnpc_him 'Robin'>>."
    <<option 'CN'>>
      约旦在祭坛旁叫住你。“该检查你和罗宾共同立下的誓言了。我已经派人去请<<nnpc_him 'Robin'>>。”
  <</language>>
  <br><br>
  <<templeicon 'altar'>><<lanLink ['Attend the examination with Robin', '和罗宾一起接受检查'] 'RobinTemple Monthly Examination'>><</lanLink>><br>
  <<getouticon>><<lanLink ['Refuse the examination', '拒绝检查'] 'RobinTemple Monthly Refuse'>><<npcincr Robin love -5>><</lanLink>><<lllove 'Robin'>><br>
  <<socialiseicon 'ask'>><<lanLink ['Tell Jordan first', '先向约旦坦白'] 'RobinTemple Monthly Admit'>><<npcincr Robin love -10>><</lanLink>><<llllove 'Robin'>><br>
<</widget>>
