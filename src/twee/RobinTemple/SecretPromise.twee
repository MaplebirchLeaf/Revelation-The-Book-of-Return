:: RobinTemple Secret Promise Widgets [widget]
<<widget 'secret-promise-talk'>>
  <<if maplebirch.get('RobinTemple').secret.known and !$RobinTemple.dual_promise>>
    <<if _args[0] is 'Robin' and getRobinLocation() is 'orphanage' and maplebirch.get('RobinTemple').available>>
      <<if $RobinTemple.secret.stage is 'none' and maplebirch.get('RobinTemple').secret.eligible>>
        <<socialiseicon 'ask'>><<lanLink ['Tell Robin what you learned about the pagan rite', '和罗宾谈起异教仪式的见闻'] 'RobinTemple Secret Research'>><</lanLink>><br>
      <<elseif $RobinTemple.secret.stage is 'research' and $RobinTemple.secret.robin_day lt 0>>
        <<socialiseicon 'ask'>><<lanLink ['Talk to Robin privately about the investigation', '和罗宾私下谈谈调查'] 'RobinTemple Secret Robin'>><</lanLink>><br>
      <<elseif $RobinTemple.secret.stage is 'none' and !maplebirch.get('RobinTemple').secret.unfitted>>
        <<language>>
          <<option 'EN'>><span class='teal'>All three of you must remove your chastity fittings before this investigation. Talk to Robin at the temple quarters about asking Jordan.</span>
          <<option 'CN'>><span class='teal'>开始这次调查前，三人都需要取下贞操器具。罗宾的事可以到神殿宿舍的座位上谈，请约旦处理。</span>
        <</language>><br>
      <<elseif $RobinTemple.secret.stage is 'none' and !hasSexStat('promiscuity', 6)>>
        <<language>><<option 'EN'>><span class='lewd'>You wonder whether a promise could bind you to both Robin and Sydney.</span><<option 'CN'>><span class='lewd'>你开始想，一份承诺能否把你同时系在罗宾与悉尼身边。</span><</language>> <<promiscuous 6>><br>
      <</if>>
    <<elseif _args[0] is 'Sydney' and maplebirch.get('RobinTemple').secret.sydneyMeeting.available>>
      <<socialiseicon 'ask'>><<lanLink ['Ask Sydney for a private conversation', '请悉尼借一步私下谈谈'] 'RobinTemple Secret Sydney'>><</lanLink>><br>
    <</if>>
  <</if>>
<</widget>>

<<widget 'secret-promise-lake'>>
  <<if ['travelling', 'decision', 'ritual'].includes($RobinTemple.secret.stage)>>
    <<getouticon>><<lanLink ['Call off the interrupted journey', '取消中断的同行'] 'RobinTemple Secret Abort'>><</lanLink>><br>
  <</if>>
  <<if $RobinTemple.secret.stage is 'research'>>
    <<if $RobinTemple.secret.survey_day lt 0 and Time.dayState is 'day' and !Weather.isFrozen('lake') and !maplebirch.get('RobinTemple').secret.threatened>>
      <<swimicon 'dive'>><<lanLink ['Survey a route through the lake ruin (0:30)', '勘查湖底废墟的路线 (0:30)'] 'RobinTemple Secret Survey'>><</lanLink>><br>
    <</if>>
    <<if $RobinTemple.secret.survey_day gte 0>>
      <<socialiseicon 'ask'>><<lanLink ['Review the route and your findings', '核对路线与调查所得'] 'RobinTemple Secret Plan'>><</lanLink>><br>
    <</if>>
    <<if maplebirch.get('RobinTemple').secret.ready>>
      <<lakeicon>><<lanLink ['Meet Robin and Sydney at the agreed place (0:10)', '到约定地点与罗宾和悉尼会合 (0:10)'] 'RobinTemple Secret Approach'>><<run maplebirch.get('RobinTemple').secret.depart()>><<pass 10>><</lanLink>><br>
    <</if>>
  <</if>>
<</widget>>

<<widget 'secret-promise-journal'>>
  <<if maplebirch.get('RobinTemple').secret.known or $RobinTemple.secret.stage isnot 'none'>>
    <h1 class='header gold bold'><<language>><<option 'EN'>>Confounded Vow<<option 'CN'>>混乱誓约<</language>></h1>
    <ul class='journal'>
      <<if $RobinTemple.dual_promise>>
        <li><<language>><<option 'EN'>>You joined a second promise to the first through a pagan rite beneath the lake.<<option 'CN'>>你借湖底的异教仪式，让第二份承诺接入了第一份。<</language>></li>
      <<elseif $RobinTemple.secret.stage is 'none'>>
        <li><<language>><<option 'EN'>>Your existing promise may be with Robin or Sydney. Sydney must currently have a corrupt outlook. With Robin first, Sydney's corrupt rite must also be complete. With stable relationships and intact vows, speak to Robin privately at home.<<option 'CN'>>第一份承诺可以与罗宾或悉尼缔结，悉尼当前须已转向堕落。罗宾先承诺时，还须完成悉尼的堕落仪式。关系稳固、誓言完整时，去家中和罗宾私下谈谈。<</language>></li>
        <<if !hasSexStat('promiscuity', 6)>>
          <li><<language>><<option 'EN'>><span class='lewd'>You are not yet ready to seek a promise with both companions.</span><<option 'CN'>><span class='lewd'>你还没有准备好寻求同时与两人缔结承诺。</span><</language>> <<promiscuous 6>></li>
        <</if>>
      <<else>>
        <li><<language>>
          <<option 'EN'>>
            <<if $RobinTemple.secret.stage is 'decision'>>You are discussing whether to continue tonight. Both companions must answer.<<elseif $RobinTemple.secret.witness_day lt 0>>The first journey begins as an investigation. Talk to Robin at home and Sydney at the library, temple or shop when <<nnpc_he 'Sydney'>> is available.<<elseif !maplebirch.get('RobinTemple').secret.settled>>After returning, leave three days before asking either companion to reconsider.<<else>>Return to Robin at home and find Sydney where you can normally talk. Each must decide whether to take part in the rite.<</if>>
          <<option 'CN'>>
            <<if $RobinTemple.secret.stage is 'decision'>>你们正在商量是否当晚继续，两人都需要作出回答。<<elseif $RobinTemple.secret.witness_day lt 0>>第一次同行从调查开始。在家中找罗宾，再到图书馆、神殿或商店，在悉尼有空交谈时分别谈妥。<<elseif !maplebirch.get('RobinTemple').secret.settled>>返回后留出三天，再请两人重新考虑。<<else>>回家找罗宾，在能正常交谈的地点找悉尼。两人都需要明确决定是否参与仪式。<</if>>
        <</language>></li>
        <li><<language>>
          <<option 'EN'>>Robin: <<if $RobinTemple.secret.robin_day gte 0>>agreed.<<else>>a private conversation is still needed.<</if>> Sydney: <<if $RobinTemple.secret.sydney_day gte 0>>agreed.<<else>>a private conversation is still needed.<</if>>
          <<option 'CN'>>罗宾：<<if $RobinTemple.secret.robin_day gte 0>>已谈妥。<<else>>仍需私下谈话。<</if>>悉尼：<<if $RobinTemple.secret.sydney_day gte 0>>已谈妥。<<else>>仍需私下谈话。<</if>>
        <</language>></li>
        <<if C.npc.Robin.trauma lt 40>>
          <li><<language>><<option 'EN'>>Robin's trauma has eased. The investigation cannot continue in <<nnpc_his 'Robin'>> current state.<<option 'CN'>>罗宾的创伤已经缓和，目前的状态不再满足继续调查的条件。<</language>></li>
        <</if>>
        <<if $RobinTemple.secret.witness_day gte 0 and (!maplebirch.get('RobinTemple').secret.wants.Robin or !maplebirch.get('RobinTemple').secret.wants.Sydney)>>
          <li><i class='lewd'><<language>>
            <<option 'EN'>>Both must want the intimacy of this rite. <<if !maplebirch.get('RobinTemple').secret.wants.Robin>>Robin is not ready for it. <</if>><<if !maplebirch.get('RobinTemple').secret.wants.Sydney>>Sydney is not ready for it.<</if>>
            <<option 'CN'>>参与仪式还需要两人的亲密欲望。<<if !maplebirch.get('RobinTemple').secret.wants.Robin>>罗宾还没有准备好。<</if>><<if !maplebirch.get('RobinTemple').secret.wants.Sydney>>悉尼还没有准备好。<</if>>
          <</language>></i></li>
        <</if>>
        <li><<language>>
          <<option 'EN'>>
            <<if $RobinTemple.secret.survey_day lt 0>>Survey the lake ruin by daylight, with the lake unfrozen and no pursuit.<<elseif !$RobinTemple.secret.prepared>>Review the route at the lake once both conversations are complete.<<elseif $RobinTemple.secret.witness_day lt 0>>Allow three days after the latest conversation or survey, then meet on an empty, rainless blood moon night, 21:00–23:00.<<else>>Meet on a later blood moon night, 21:00–23:00, with an unfrozen lake, no rain, no crowd and no pursuit.<</if>>
          <<option 'CN'>>
            <<if $RobinTemple.secret.survey_day lt 0>>湖面未结冰、没有追猎时，白天勘查湖底废墟。<<elseif !$RobinTemple.secret.prepared>>两次谈话都完成后，到湖畔核对路线。<<elseif $RobinTemple.secret.witness_day lt 0>>最后一次谈话或勘查后留出三天，在无人、无雨的血月夜，21:00–23:00 会合。<<else>>在之后的血月夜，21:00–23:00 会合。湖面须未结冰，没有下雨、人群或追猎。<</if>>
        <</language>></li>
      <</if>>
      <<if !$RobinTemple.dual_promise and !maplebirch.get('RobinTemple').secret.unfitted>>
        <li><<language>>
          <<option 'EN'>><span class='teal'>You, Robin and Sydney must all be free of chastity belts, cages and anal shields. Request removal of Robin's temple fitting, then accompany Robin to Jordan during daylight, outside Sunday mass.</span>
          <<option 'CN'>><span class='teal'>你、罗宾与悉尼都不能佩戴贞操带、贞操笼或护肛板。先提出拆除罗宾神殿器具的申请，白天约旦在场、没有主持周日弥撒时，再陪罗宾办理。</span>
        <</language>></li>
      <</if>>
    </ul>
    <hr>
  <</if>>
<</widget>>

:: RobinTemple Secret Research
<<set $outside to 0>><<set $location to 'home'>><<effects>><<npc Robin>><<person1>>
<<if maplebirch.get('RobinTemple')?.secret.eligible and $RobinTemple.secret.stage is 'none'>>
  <<language>>
    <<option 'EN'>>
      You close Robin's door and tell <<him>> what the bishop said about Kylar's parents: the bloodied altar, the red moon, the silver used to prevent transmission. Robin stops you before you reach the end. "They were asking to save their child?"
      <br><br>
      You tell <<him>> about the gaoler and the witch, then the vision beneath the lake. The memories belong to different people. You cannot turn them into instructions simply by setting them beside one another. But you have seen an old bond survive, and heard that something can pass between people through a rite.
      <br><br>
      When you suggest joining a second promise to your first, Robin looks at your hands. "Does Sydney know?" <<He>> waits for your answer. <<if $RobinTemple.templePromised is 'Robin'>>"What we promised... will it still mean the same thing to you?"<<else>>"And if I say no, will you still come back to me?"<</if>>
      <br><br>
      You promise to tell Sydney everything. Robin draws a notebook towards <<himself>>. "Then let's find out what you're asking us to do. Before you ask."
    <<option 'CN'>>
      你关上罗宾房间的门，转述主教对凯拉尔父母遭遇的解释：染血的祭坛，血月，用来防止传染的银器。还没讲完，罗宾就打断你。"他们是在求那些人救救自己的孩子？"
      <br><br>
      你又讲起狱卒与女巫，以及湖底的幻境。那些记忆属于不同的人，把它们放在一起，还不能拼出一套做法。可你见过旧日的纽带延续至今，也听说某种东西能够借仪式在人与人之间传递。
      <br><br>
      听到你想让第二份承诺接入第一份，罗宾看向你的手。"悉尼知道吗？"<<He>>等着你回答。<<if $RobinTemple.templePromised is 'Robin'>>"我们承诺过的……对你来说，还会和以前一样吗？"<<else>>"如果我说不，你还会回来找我吗？"<</if>>
      <br><br>
      你答应把知道的全部告诉悉尼。罗宾把一本笔记拉到身前。"那就先弄清楚，你想让我们做什么。再问我们。"
  <</language>>
  <br><br>
  <<socialiseicon 'ask'>><<lanLink ['Begin the investigation', '开始调查'] 'RobinTemple Secret Robin'>><<run maplebirch.get('RobinTemple').secret.begin()>><</lanLink>><br>
<</if>>
<<getouticon>><<lanLink ['Leave it for now', '暂时搁下'] "Robin's Room Entrance">><<endevent>><</lanLink>><br>

:: RobinTemple Secret Robin
<<set $outside to 0>><<set $location to 'home'>><<effects>><<endevent>><<npc Robin>><<person1>>
<<if $RobinTemple.secret.stage is 'research' and getRobinLocation() is 'orphanage' and maplebirch.get('RobinTemple')?.available>>
  <<language>>
    <<option 'EN'>>
      <<if $RobinTemple.secret.witness_day lt 0>>
        Robin has marked the gaoler's loss in the notebook. "Their home. Their work. Everything." <<He>> leaves a finger on the page. "I don't want loving you to mean there is nothing else left."
        <br><br>
        <<if $RobinTemple.secret.first is 'Robin'>>"I know you love Sydney too. I don't want to be the reason you can't say it." Robin pauses. "But I don't want our promise to disappear either."<<else>>"You already promised Sydney. I don't want to get my place by taking Sydney's away."<</if>> <<He>> shifts closer, without quite touching you.
        <br><br>
        You explain that the first trip is only to examine the place. No vows will be spoken there. Robin looks towards the door. "Tell Sydney about the bishop too. All of it."
      <<else>>
        Robin has drawn the stone from memory. <<He>> crosses out one attempt and starts again. "I keep hearing it. My name, when neither of you was speaking."
        <br><br>
        <<if $RobinTemple.secret.first is 'Robin'>>"It sounded like our promise. But I couldn't tell whose voice it was." Robin rubs the mark off <<his>> thumb. "I don't want it changing what you said to me."<<else>>"For a moment it felt like you'd already said yes to me. Before you had." Robin rubs the mark off <<his>> thumb. "I want to hear you say it yourself."<</if>>
        <br><br>
        You sit beside <<him>>. Robin touches your hand, then lets go. "I want a future with you. I want to be in it when we're not doing anything brave."
      <</if>>
    <<option 'CN'>>
      <<if $RobinTemple.secret.witness_day lt 0>>
        罗宾在笔记里标出了狱卒失去的东西。"家，工作，什么都没剩下。"<<He>>把手指留在那一页。"我不想爱着你，就意味着其他东西都没了。"
        <br><br>
        <<if $RobinTemple.secret.first is 'Robin'>>"我知道你也爱悉尼。我不想让你因为我，连说出来都不行。"罗宾停了一下。"可我也不想，我们的承诺就这样没了。"<<else>>"你已经答应过悉尼了。我不想靠挤掉悉尼的位置，换来自己的。"<</if>><<He>>挪近一点，却还没有碰你。
        <br><br>
        你解释，第一次同行只是查看那个地方，不会在那里立誓。罗宾望向门口。"主教说的事，也要告诉悉尼。全部都说。"
      <<else>>
        罗宾凭记忆画着那块石头。<<He>>划掉一次，又重新动笔。"我总能听见。你们谁都没说话的时候，我听见自己的名字。"
        <br><br>
        <<if $RobinTemple.secret.first is 'Robin'>>"听起来像我们的承诺。可我分不清，那是谁的声音。"罗宾擦掉拇指上的笔迹。"我不想让它改掉，你对我说过的话。"<<else>>"有那么一会儿，我觉得你已经答应我了。可你还没有。"罗宾擦掉拇指上的笔迹。"我想听你自己说。"<</if>>
        <br><br>
        你坐到<<him>>身边。罗宾碰了碰你的手，又松开。"我想和你有以后。不用逞勇敢的时候，我也想在里面。"
      <</if>>
  <</language>>
  <br><br>
  <<if $RobinTemple.secret.witness_day gte 0 and !maplebirch.get('RobinTemple').secret.settled>>
    <<language>><<option 'EN'>>Robin closes the notebook. "Let me think a little longer." <span class='teal'>Leave three days after the shared investigation.</span><<option 'CN'>>罗宾合上笔记。"再让我想一会儿。"<span class='teal'>共同调查后，需要留出三天。</span><</language>><br><br>
  <<elseif C.npc.Robin.trauma lt 40>>
    <<language>><<option 'EN'>>Robin puts the notebook aside. "I don't want to go back there." <span class='red'>Robin's trauma has eased. You cannot continue the investigation.</span><<option 'CN'>>罗宾把笔记放到一边。"我不想再去那里。"<span class='red'>罗宾的创伤已经缓和，无法继续这次调查。</span><</language>><br><br>
  <<elseif $RobinTemple.secret.witness_day gte 0 and !maplebirch.get('RobinTemple').secret.wants.Robin>>
    <<language>><<option 'EN'>>Robin rests a hand over yours, keeping the notebook closed. "I love you. I don't want to do that now. Can we just stay here?" <i class='lewd'>Robin's desire is not strong enough to agree to the rite.</i><<option 'CN'>>罗宾把手放在你的手上，没有打开笔记。"我爱你。可现在，我不想做那件事。我们就待在这里，好吗？"<i class='lewd'>罗宾尚未产生足够强烈的欲望，不会答应参与仪式。</i><</language>><br><br>
  <<elseif maplebirch.get('RobinTemple').secret.eligible>>
    <<if $RobinTemple.secret.robin_day lt 0>>
      <<language>>
        <<option 'EN'>>
          <<if $RobinTemple.secret.witness_day lt 0>>"I'll come and look," Robin says. "That's all I'm agreeing to tonight."<<elseif C.npc.Robin.dom gte 80>>"I want this," Robin says. "And I will tell you if I stop wanting it. You have to listen."<<else>>"I'm still afraid." Robin holds your hand again. "But I've thought about it. I want to try."<</if>>
        <<option 'CN'>>
          <<if $RobinTemple.secret.witness_day lt 0>>"我会去看看。"罗宾说，"今晚我只答应这个。"<<elseif C.npc.Robin.dom gte 80>>"我想这么做。"罗宾说，"如果我不想了，也会告诉你。你得听。"<<else>>"我还是害怕。"罗宾重新握住你的手。"可我想过了。我想试试。"<</if>>
      <</language>>
      <br><br>
      <<socialiseicon 'ask'>><<lanLink ['Answer Robin honestly', '认真回答罗宾'] "Robin's Room Entrance">>
        <<set _secretAgreed to maplebirch.get('RobinTemple').secret.agree('Robin')>>
        <<if _secretAgreed>><<npcincr Robin love 1>><<npcincr Robin trauma -1>><<pass 15>><<endevent>><</if>>
      <</lanLink>><<glove 'Robin'>><<lrtrauma>><br>
    <<else>>
      <<language>><<option 'EN'>><span class='teal'>Robin's decision is recorded in your journal.</span><<option 'CN'>><span class='teal'>日志记下了罗宾的决定。</span><</language>><br><br>
    <</if>>
  <<else>>
    <<language>><<option 'EN'>>Robin moves the notebook aside. "I can't say yes now." <span class='red'>Your relationship and vows need attention first.</span><<option 'CN'>>罗宾把笔记挪到一边。"现在我不能答应。"<span class='red'>先顾好彼此的关系与誓言。</span><</language>><br><br>
  <</if>>
<</if>>
<<getouticon>><<lanLink ['Leave Robin to think', '让罗宾自己想想'] "Robin's Room Entrance">><<endevent>><</lanLink>><br>

:: RobinTemple Secret Sydney
<<set $outside to 0>><<effects>><<endevent>><<npc Sydney>><<person1>><<sydneySchedule>>
<<set _secretSydney to maplebirch.get('RobinTemple')?.secret.sydneyMeeting ?? { available: false, passage: ({ school: 'School Library', adult_shop: 'Adult Shop', temple: 'Temple' })[$location] ?? 'Temple' }>>
<<if _secretSydney.available>>
  <<if C.npc.Sydney.purity gte 50>>
    <<language>>
      <<option 'EN'>>Sydney closes the notebook. "A promise is sacred. I won't take it to an altar like that." <<He>> pushes the notebook gently back towards you. <span class='red'>Sydney's pure outlook prevents agreement.</span>
      <<option 'CN'>>悉尼合上笔记。"承诺是神圣的。我不会把它带到那样的祭坛前。"<<He>>轻轻把笔记推回你面前。<span class='red'>纯洁的悉尼不会答应。</span>
    <</language>><br><br>
  <<elseif C.npc.Sydney.corruption lt 10>>
    <<language>><<option 'EN'>>Sydney leaves the notebook shut. "I don't want to try this." <span class='red'>Sydney has not embraced a corrupt outlook.</span><<option 'CN'>>悉尼没有翻开笔记。"我不想尝试这个。"<span class='red'>悉尼尚未转向堕落。</span><</language>><br><br>
  <<elseif $RobinTemple.secret.first is 'Robin' and !$sydneySeen.includes('corruptroom')>>
    <<language>><<option 'EN'>>Sydney stops at the account of the altar. "I've thought about breaking their rules. But I haven't even gone through with what we planned." <<He>> closes the page. <span class='red'>Complete Sydney's corrupt rite before pursuing this one.</span><<option 'CN'>>悉尼读到祭坛那一段，停了下来。"我想过违背他们的规矩。可我们约好的事，都还没真正做过。"<<He>>合上书页。<span class='red'>先完成悉尼的堕落仪式，再考虑这次尝试。</span><</language>><br><br>
  <<else>>
    <<language>>
      <<option 'EN'>>
        <<if $location is 'school'>>Sydney waits until the library counter is clear, then takes you between the shelves. <<He>> keeps the notebook below the other readers' line of sight.<<elseif $location is 'temple'>>Sydney waits for the others to pass, then takes you to a quiet corner. <<He>> lowers <<his>> voice and opens the notebook away from the passing clergy.<<else>>Sydney waits until the counter is clear, then steps aside with you. <<He>> keeps the notebook out of the customers' sight.<</if>>
        <br><br>
        <<if $RobinTemple.secret.witness_day lt 0>>
          <<if $RobinTemple.secret.first is 'Sydney'>>
            You begin with your promise to Sydney, then explain that you want to make one to Robin too. Sydney lets you finish before answering. "And you're bringing our words to a different altar."
          <<else>>
            You explain that your promise to Robin will remain. Sydney runs a finger along the closed notebook. "I know who you made it to." <<He>> looks up. "I want you to say those words to me too. That doesn't mean I'll accept anything that offers to help."
          <</if>>
          <br><br>
          You recount the visions and the bishop's explanation. Sydney turns back to the passage about the silver. "They had a way to stop something passing through. We don't even know what it was."
          <br><br>
          <<if $RobinTemple.secret.first is 'Sydney'>>"I remember what we said," <<he>> continues. "You haven't stopped wanting me, have you?"<<else>>"We found a way around their rules once," <<he>> continues. "That room was still in the temple. We knew how to get out. This place is different."<</if>> You answer before asking <<him>> to investigate. Sydney's fingers settle around yours. "Then we'll look. You can ask me again when we know what we're asking for."
        <<else>>
          Sydney unfolds a page bearing the words of your promise. <<if $RobinTemple.secret.first is 'Sydney'>>Robin's name<<else>>Sydney's name<</if>> has been added below them. "It knew how to answer us. I keep thinking about that."
          <br><br>
          <<if $RobinTemple.secret.first is 'Sydney'>>
            "I was jealous when you said Robin's name," <<he>> says. "I'm telling you now. I don't want that thing deciding what it means for me." <<He>> folds the page again. "I still want what we promised. If there can be another answer beside mine, I want to hear you give it."
          <<else>>
            "I wanted it to answer my name," <<he>> says. "I was jealous when it answered Robin first. I'm not going to pretend I wasn't." <<He>> folds the page. "But I heard something before you made any promise to me. I want your answer, not its imitation."
          <</if>>
          <br><br>
          Sydney puts the paper away. "I know this is blasphemy." <<He>> looks up at you. "Don't give it a nicer name so I'll say yes. Ask me."
        <</if>>
      <<option 'CN'>>
        <<if $location is 'school'>>悉尼等图书馆柜台前的人散去，才带你走到书架之间。<<He>>把笔记放低，避开其他读者的视线。<<elseif $location is 'temple'>>悉尼等其他人走过，才带你到安静的角落。<<He>>压低声音，避开来往的神职人员，翻开笔记。<<else>>悉尼等柜台前的人散去，才和你走到一旁。<<He>>把笔记放低，避开顾客的视线。<</if>>
        <br><br>
        <<if $RobinTemple.secret.witness_day lt 0>>
          <<if $RobinTemple.secret.first is 'Sydney'>>
            你先讲起自己对悉尼的承诺，再说出也想向罗宾许下一份。悉尼等你说完，才回答。"所以，你要把我们的话带到另一座祭坛前。"
          <<else>>
            你解释，对罗宾的承诺仍会保留。悉尼的手指沿着合上的笔记边缘划过。"我知道你答应过谁。"<<He>>抬眼。"我也想听你对我说那些话，可这不等于，谁说能帮忙，我就都答应。"
          <</if>>
          <br><br>
          你讲出幻境与主教的解释。悉尼翻回提到银器的那一页。"他们有办法阻止某种东西传过去。我们连那是什么都不知道。"
          <br><br>
          <<if $RobinTemple.secret.first is 'Sydney'>>"我们说过什么，我还记着。"<<He>>接着说，"你没有不想要我了，对吧？"<<else>>"我们绕过他们的规矩，已经有过一次了。"<<He>>接着说，"那间屋子还在神殿里，怎么出来，我们知道。可这里不一样。"<</if>>你先回答，才请<<him>>一起调查。悉尼的手指扣住你的。"那就去看看。等知道自己在要什么，你再问我。"
        <<else>>
          悉尼展开记着誓词的一页，<<if $RobinTemple.secret.first is 'Sydney'>>罗宾<<else>>悉尼自己<</if>>的名字被添在下面。"它知道怎么回答我们。我一直在想这件事。"
          <br><br>
          <<if $RobinTemple.secret.first is 'Sydney'>>
            "你念出罗宾的名字时，我妒忌了。"<<He>>说，"现在告诉你。我不想让那个东西替我决定，这意味着什么。"<<He>>重新折起那页纸。"我们承诺过的，我仍然想要。如果我的回答旁边还能有另一个回答，我想听你亲口说出来。"
          <<else>>
            "我想让它回答我的名字。"<<He>>说，"它先回答罗宾时，我妒忌了。我不会装作没有。"<<He>>折起那页纸。"可你还没有对我许过承诺，我就先听见了什么。我想要你的回答，不是它学出来的声音。"
          <</if>>
          <br><br>
          悉尼收起纸。"我知道这是亵渎。"<<He>>抬眼看你。"别为了让我答应，就给它换个好听的名字。问我。"
        <</if>>
    <</language>>
    <br><br>
    <<if $RobinTemple.secret.witness_day gte 0 and !maplebirch.get('RobinTemple').secret.settled>>
      <<language>><<option 'EN'>>"I haven't finished thinking about it," Sydney says. <span class='teal'>Leave three days after the shared investigation.</span><<option 'CN'>>"我还没想完。"悉尼说。<span class='teal'>共同调查后，需要留出三天。</span><</language>><br><br>
    <<elseif $RobinTemple.secret.witness_day gte 0 and !maplebirch.get('RobinTemple').secret.wants.Sydney>>
      <<language>><<option 'EN'>>Sydney folds the paper without adding a name. "I still want you. That doesn't mean I want to do this tonight. Keep the notes. We can talk again." <i class='lewd'>Sydney's desire is not strong enough to agree to the rite.</i><<option 'CN'>>悉尼折起那页纸，没有添上名字。"我仍然想和你在一起，可不代表今晚就想做这件事。笔记留着，我们还可以再谈。"<i class='lewd'>悉尼尚未产生足够强烈的欲望，不会答应参与仪式。</i><</language>><br><br>
    <<elseif maplebirch.get('RobinTemple').secret.eligible>>
      <<if $RobinTemple.secret.sydney_day lt 0>>
        <<if $RobinTemple.secret.witness_day gte 0>>
          <<language>><<option 'EN'>>Sydney takes your hand. "Yes. I want to come. And if it starts answering for us, we leave. I'm choosing you. It doesn't get to choose for me."<<option 'CN'>>悉尼牵住你的手。"愿意。我想去。如果它开始替我们回答，我们就走。我是在选择你，它不能替我选。"<</language>><br><br>
        <</if>>
        <<socialiseicon 'ask'>><<lanLink ['Answer Sydney honestly', '认真回答悉尼'] _secretSydney.passage>>
          <<set _secretAgreed to maplebirch.get('RobinTemple').secret.agree('Sydney')>>
          <<if _secretAgreed>><<npcincr Sydney love 1>><<pass 15>><<endevent>><</if>>
        <</lanLink>><<glove 'Sydney'>><br>
      <<else>>
        <<language>><<option 'EN'>><span class='teal'>Sydney's decision is recorded in your journal.</span><<option 'CN'>><span class='teal'>日志记下了悉尼的决定。</span><</language>><br><br>
      <</if>>
    <<else>>
      <<language>><<option 'EN'>>Sydney lets go of your hand. "Not while things are like this." <span class='red'>Your existing promise and relationships must remain intact.</span><<option 'CN'>>悉尼松开你的手。"现在这样，还不行。"<span class='red'>已有的承诺与彼此的关系都须完整。</span><</language>><br><br>
    <</if>>
  <</if>>
<</if>>
<<getouticon>><<lanLink ['Return', '返回'] _secretSydney.passage>><<endevent>><</lanLink>><br>

:: RobinTemple Secret Survey
<<set $outside to 0>><<set $location to 'lake_ruin'>><<set $bus to 'lake_ruin'>><<effects>>
<<if maplebirch.get('RobinTemple')?.secret.survey()>>
  <<wateraction>><<set $oxygen -= 200>><<pass 30>>
  <<set $underwater to 0>><<set $oxygenRecovery to true>>
  <<language>>
    <<option 'EN'>>
      You follow the old masonry through the lake ruin. Purple lichen covers the wall around the prison's rune. You recognise it, and leave it alone. Farther along, a fallen section of the outer wall exposes a passage sloping upwards.
      <br><br>
      It ends at a broken stair above the water. There is room here to stand and breathe. A little air moves through a fissure overhead, carrying the same sweet smell as the lichen. You do not stay beneath it for long.
      <br><br>
      A low stone stands against the wall. Worn channels run across its top, towards a carving partly hidden by the growth. You recognise a fragment of the rune you passed outside. On dry ground it is easier to see how much is missing.
      <br><br>
      The bishop's words come back to you: an altar, a red moon, silver against transmission. You cannot tell who used this stone. <span class='gold'>You can examine it without opening the prison, but nothing here promises shelter from its occupant.</span>
      <br><br>
      You mark the turns in your memory and find a sheltered hollow on the shore for the return. The stone has given you somewhere to investigate, not a set of instructions.
    <<option 'CN'>>
      你沿湖底废墟的旧砌石游去。水下监狱入口的墙上，符文四周长着紫色地衣。你认得它，没有去碰。再往前，一段坍塌的外墙露出向上倾斜的通道。
      <br><br>
      通道尽头是露出水面的断阶，这里能站立，也能呼吸。顶上的裂隙有微弱气流，带着地衣同样甜腻的气味。你没有在下面停留太久。
      <br><br>
      一块矮石靠在墙边，石面上磨损的沟槽通向被地衣遮住的雕纹。你认出外面符文的一小部分。站在干处，才看清它缺失了多少。
      <br><br>
      你想起主教的话：祭坛，血月，防止传染的银器。你看不出谁用过这块石头。<span class='gold'>查看这里不必打开牢狱，但这里也没有什么能保证替你挡住里面的存在。</span>
      <br><br>
      你记住几个转角，又在岸边找了处背风的凹地，供回来时落脚。那块石头给了你一个可以调查的地方，还没有给你做法。
  <</language>>
<<else>>
  <<language>><<option 'EN'>><span class='teal'>Check your journal for the survey result. A new dive requires daylight, an unfrozen lake and no pursuit.</span><<option 'CN'>><span class='teal'>勘查结果记在日志里。下潜需要白天、湖面未结冰，并且没有追猎。</span><</language>>
<</if>>
<br><br>
<<swimicon 'back'>><<lanLink ['Return to shore', '回到湖畔'] 'Lake Shore'>><<wateraction>><<set $underwater to 0>><<set $oxygenRecovery to true>><</lanLink>><br>

:: RobinTemple Secret Plan
<<set $outside to 1>><<set $location to 'lake'>><<effects>><<lakeeffects>>
<<if maplebirch.get('RobinTemple') and $RobinTemple.secret.stage is 'research' and $RobinTemple.secret.survey_day gte 0>>
  <<language>>
    <<option 'EN'>>
      You unfold the route beside the lake. The flooded turns, the stair and the hollow on the shore are marked separately. Robin can bring a covered light as far as the bank. You will leave the notebook there too.
      <br><br>
      <<if $RobinTemple.secret.witness_day lt 0>>
        The red moon matters in the bishop's account, and at the plinth beneath the lake. You want to see whether the worn stone answers it too. <span class='teal'>This journey is only to investigate. Neither companion has agreed to a rite.</span>
        <br><br>
        You write the words of your existing promise beside the two names. Those words have already bound you to someone. You will test how the place responds to them, then bring what you learn back to shore.
      <<else>>
        You add what all three of you heard. The response stopped when you stopped speaking. It returned when you spoke your first partner's name. You underline those observations, leaving your guesses below them.
        <br><br>
        The bishop used silver to prevent transmission. You have no such protection for what you intend to join. No old relic belongs to you, and you will not use one as payment. If the stone needs an offering, it will have to be something each of you chooses to give.
        <br><br>
        Beneath the repeated words of your first promise, you leave room for a second answer. The stone did not supply that answer. Robin and Sydney must each give their own.
      <</if>>
    <<option 'CN'>>
      你在湖边展开路线，分别标出淹没的转角、断阶和岸边的凹地。罗宾可以把遮光灯提到岸边，笔记也留在那里。
      <br><br>
      <<if $RobinTemple.secret.witness_day lt 0>>
        主教的说法提到了血月，湖底基座也会在红月下显出异样。你想看看，那块残损的石头是否也会回应。<span class='teal'>这次同行只调查，两位同伴都还没有答应仪式。</span>
        <br><br>
        你把已有承诺的誓词写在两个名字旁边。那些话已经把你系在一个人身边。你会试探这个地方如何回应，再把所得带回岸上。
      <<else>>
        你添上三个人都听见的事。你停止说话，回应也停了。你念出第一位承诺对象的名字，它又回来。你在这些见闻下面划线，把猜测留在下面。
        <br><br>
        主教用银器防止传染。对于你想连接的东西，你们没有同样的防护。这里的旧物不属于你，你也不会拿它们付账。如果石头需要献礼，那必须是每个人自己愿意给出的东西。
        <br><br>
        你在第一份承诺的誓词下，留出第二次回答的位置。石头没有给出那个回答。罗宾与悉尼必须各自说出来。
      <</if>>
  <</language>>
  <br><br>
  <<if maplebirch.get('RobinTemple').secret.eligible and $RobinTemple.secret.robin_day gte 0 and $RobinTemple.secret.sydney_day gte 0 and !$RobinTemple.secret.prepared>>
    <<socialiseicon 'ask'>><<lanLink ['Finish the preparations', '整理好准备'] 'Lake Shore'>><<run maplebirch.get('RobinTemple').secret.prepare()>><</lanLink>><br>
  <<else>>
    <<language>><<option 'EN'>><span class='teal'>Your journal records the conversations and conditions still needed.</span><<option 'CN'>><span class='teal'>日志记着尚未完成的谈话与出行条件。</span><</language>><br><br>
  <</if>>
<</if>>
<<getouticon>><<lanLink ['Return to shore', '回到湖畔'] 'Lake Shore'>><</lanLink>><br>

:: RobinTemple Secret Approach
<<set $outside to 1>><<set $location to 'lake'>><<effects>><<lakeeffects>>
<<if maplebirch.get('RobinTemple')?.secret.active and $RobinTemple.secret.stage is 'travelling'>>
  <<endevent>><<npc Robin 1>><<npc Sydney 2>><<person1>>
  <<language>>
    <<option 'EN'>>
      Robin arrives with the light covered. Sydney takes a different path down to the bank. Both pause until they see you. There are no other lights on the shore.
      <br><br>
      You go over the flooded turns. Robin repeats one back to you. Sydney corrects the direction of the stair, then asks you to say it again. The red moon lays a long reflection across the water.
      <br><br>
      <<if $RobinTemple.secret.witness_day lt 0>>
        "We look, and we come back," Robin says. Sydney nods. "Then we talk about what we actually saw."
      <<else>>
        Robin puts the notebook beneath the lamp. Sydney looks from you to Robin. "Still yes?" Robin takes your hand. "Still yes." You give your own answer before pointing out the dry place for your clothes.
      <</if>>
    <<option 'CN'>>
      罗宾提着遮住光的灯抵达。悉尼从另一条小路走到岸边。两人都等到看见你才靠近，湖岸没有别的灯光。
      <br><br>
      你重说一遍淹没的几个转角。罗宾向你复述其中一个，悉尼纠正了断阶的方向，又请你再讲一次。红月在水面上拖出很长的倒影。
      <br><br>
      <<if $RobinTemple.secret.witness_day lt 0>>
        "看一看，然后回来。"罗宾说。悉尼点点头。"再谈我们真正看见的事。"
      <<else>>
        罗宾把笔记放到灯下。悉尼从你看向罗宾。"还是愿意吗？"罗宾牵住你的手。"还是愿意。"你也给出自己的回答，才指出背风凹地里放衣物的地方。
      <</if>>
  <</language>>
  <br><br>
  <<if $RobinTemple.secret.witness_day lt 0>>
    <<swimicon 'dive'>><<lanLink ['Examine the stone together (0:05)', '一起查看那块石头 (0:05)'] 'RobinTemple Secret Witness'>><<wateraction>><<set $oxygen -= 200>><<pass 5>><</lanLink>><<loxygen>><br>
  <<else>>
    <<swimicon 'dive'>><<lanLink ['Return to the stone (0:05)', '回到那块石头前 (0:05)'] 'RobinTemple Secret Burden'>><<set _secretEntered to maplebirch.get('RobinTemple').secret.enter()>><<if _secretEntered>><<undress 'blasphemy'>><<underwater>><<wateraction>><<set $oxygen -= 200>><<pass 5>><</if>><</lanLink>><<loxygen>><br>
  <</if>>
  <<getouticon>><<lanLink ['Leave together', '一起离开'] 'RobinTemple Secret Abort'>><</lanLink>><br>
<<else>>
  <<include 'RobinTemple Secret Abort'>>
<</if>>

:: RobinTemple Secret Witness
<<set $outside to 0>><<set $location to 'lake_ruin'>><<set $bus to 'lake_ruin'>><<set $underwater to 0>><<set $oxygenRecovery to true>><<effects>>
<<if maplebirch.get('RobinTemple')?.secret.active and $RobinTemple.secret.stage is 'travelling' and $RobinTemple.secret.witness_day lt 0>>
  <<endevent>><<npc Robin 1>><<npc Sydney 2>><<person1>>
  <<language>>
    <<option 'EN'>>
      You reach the broken stair together. Robin checks the flooded passage while Sydney examines the carving. Red light filters through the fissure overhead. The worn channels have become easier to see.
      <br><br>
      You speak the name from your existing promise. There is no reply. Then you repeat a few of the words spoken at the temple altar. The stone gives a low sound, and the old pull beneath your ribs returns.
      <br><br>
      You stop. The sound stops too. When you give the other name, a second note answers from below the first. Robin takes a step towards you. "I heard that." Sydney asks you to say the first name again. The old note returns, and you fall silent.
      <br><br>
      "It can repeat us," Sydney says. "That doesn't tell us what it wants." Robin takes your hand. "Let's go. Before it asks."
      <br><br>
      You take nothing from the stone. <span class='teal'>Both companions witnessed the response. No new promise has been made.</span>
    <<option 'CN'>>
      你们一起抵达断阶。罗宾检查淹没的通道，悉尼查看雕纹。红光从顶上的裂隙漏下来，磨损的沟槽变得容易辨认。
      <br><br>
      你念出已有承诺中的名字，没有得到回答。你又重复几句神殿圣坛边说过的话。石头发出低响，胸肋下熟悉的牵引回来了。
      <br><br>
      你停下，那声音也停了。你念出另一个名字，第一道声音下面又响起第二道。罗宾向你走近一步。"我听见了。"悉尼请你再说一次原来的名字，旧的声音回来，你随即闭上嘴。
      <br><br>
      "它会重复我们。"悉尼说，"可这没告诉我们，它想要什么。"罗宾牵住你的手。"走吧。趁它还没开口要。"
      <br><br>
      你没有从石头上拿走任何东西。<span class='teal'>两人都见证了回应，没有缔结新的承诺。</span>
  <</language>>
  <br><br>
  <<set $skulduggerydifficulty to maplebirch.get('RobinTemple').secret.difficulty.promise>>
  <<socialiseicon 'ask'>><<lanLink ['Make the response sound like your existing promise (0:10)', '把回应说成已有承诺的延续 (0:10)'] 'RobinTemple Secret Decision'>>
    <<set _secretWitnessed to maplebirch.get('RobinTemple').secret.witness(true)>>
    <<if _secretWitnessed>>
      <<set $skulduggerydifficulty to maplebirch.get('RobinTemple').secret.difficulty.promise>><<skulduggerycheck 'silent'>><<skulduggeryuse>>
      <<set _secretUrged to maplebirch.get('RobinTemple').secret.urge('promise', $skulduggerysuccess is 1)>>
      <<if _secretUrged>>
        <<if $RobinTemple.secret.persuaded>>
          <<npcincr Robin love 1>><<npcincr Robin trauma -1>><<npcincr Sydney love 1>>
          <<if maplebirch.get('RobinTemple').secret.wants.Robin>><<npcincr Robin lust 1>><</if>>
          <<if maplebirch.get('RobinTemple').secret.wants.Sydney>><<npcincr Sydney lust 1>><</if>>
        <<else>>
          <<npcincr Robin love -2>><<npcincr Robin lust -1>><<npcincr Sydney love -2>><<npcincr Sydney lust -1>>
        <</if>>
        <<pass 10>><<stress 4>>
      <</if>>
    <</if>>
  <</lanLink>><<skulduggerydifficulty>><<gstress>><br>
  <<set $skulduggerydifficulty to maplebirch.get('RobinTemple').secret.difficulty.danger>>
  <<socialiseicon 'ask'>><<lanLink ['Claim leaving now will let it follow you (0:10)', '谎称现在离开会让它跟上来 (0:10)'] 'RobinTemple Secret Decision'>>
    <<set _secretWitnessed to maplebirch.get('RobinTemple').secret.witness(true)>>
    <<if _secretWitnessed>>
      <<set $skulduggerydifficulty to maplebirch.get('RobinTemple').secret.difficulty.danger>><<skulduggerycheck 'silent'>><<skulduggeryuse>>
      <<set _secretUrged to maplebirch.get('RobinTemple').secret.urge('danger', $skulduggerysuccess is 1)>>
      <<if _secretUrged>>
        <<npcincr Robin lust -1>><<npcincr Sydney lust -1>>
        <<if $RobinTemple.secret.persuaded>>
          <<npcincr Robin trauma 1>>
        <<else>>
          <<npcincr Robin trauma 2>><<npcincr Robin love -3>><<npcincr Sydney love -3>>
        <</if>>
        <<pass 10>><<stress 4>>
      <</if>>
    <</if>>
  <</lanLink>><<skulduggerydifficulty>><<gstress>><br>
  <<swimicon 'back'>><<lanLink ['Return and give each other time (0:10)', '回到岸上，留下考虑的时间 (0:10)'] 'Lake Shore'>><<set _secretWitnessed to maplebirch.get('RobinTemple').secret.witness()>><<if _secretWitnessed>><<wateraction>><<pass 10>><<set $underwater to 0>><<set $oxygenRecovery to true>><</if>><<endevent>><</lanLink>><br>
  <<getouticon>><<lanLink ['Call the investigation off', '中止调查'] 'RobinTemple Secret Abort'>><</lanLink>><br>
<<else>>
  <<include 'RobinTemple Secret Abort'>>
<</if>>

:: RobinTemple Secret Decision
<<set $outside to 0>><<set $location to 'lake_ruin'>><<set $bus to 'lake_ruin'>><<set $underwater to 0>><<set $oxygenRecovery to true>><<effects>>
<<if maplebirch.get('RobinTemple') and $RobinTemple.secret.stage is 'decision' and $RobinTemple.secret.appeal>>
  <<endevent>><<npc Robin 1>><<npc Sydney 2>><<person1>>
  <<language>>
    <<option 'EN'>>
      You ask them to wait before turning towards the flooded passage.
      <br><br>
      <<if $RobinTemple.secret.appeal is 'promise'>>
        You repeat the familiar words, following the cadence of the answer. You draw their attention to the old pull, speaking as though the second voice were only another part of it. The unfamiliar note becomes something you can explain away.
      <<else>>
        You look towards the water and lower your voice. "It heard all three names. If we leave it unfinished, it could follow them out." You tell them that finishing the words will close what you opened. You have no such knowledge. You make it sound like something learned in the prison beneath the lake.
      <</if>>
      <br><br>
      <<if $RobinTemple.secret.persuaded>>
        <<if $RobinTemple.secret.appeal is 'promise'>>
          Robin searches your face. <<if $RobinTemple.secret.first is 'Robin'>>"Then say it to me again. I don't want what we had to get lost in this."<<else>>"You want me there too? When we go home?"<</if>> You answer without looking away. <<if maplebirch.get('RobinTemple').secret.wants.Robin>><<if C.npc.Robin.dom gte 80>>"My name," <<he>> says. "Not a word that could mean anyone."<<else>><<He>> reaches for your hand. "I want to hear it from you."<</if>> You kiss <<him>> gently. Robin returns it, holding your hand more loosely when you draw back. <<glust 'Robin'>><<else>>Robin squeezes your hand, but stays beside the stair. "I'm glad. But I still don't want to do that tonight."<</if>> <<glove 'Robin'>><<lrtrauma>>
          <br><br>
          Sydney asks you to repeat the two notes. You pause at the place where one gives way to the other. "It isn't the temple altar," <<nnpc_he 'Sydney'>> says. <<if maplebirch.get('RobinTemple').secret.wants.Sydney>><<if $RobinTemple.secret.first is 'Sydney'>>"And I'm not giving you away. You say our promise first."<<else>>"We've broken their rules before. I want to give my own answer this time too."<</if>> Sydney takes your free hand and draws you into a brief kiss. "Mine too." <<glust 'Sydney'>> <<nnpc_He 'Sydney'>> turns to Robin. "If either of us stops, we leave." Robin nods.<<else>>"I believe you. I still want to go home and think about it." <<nnpc_He 'Sydney'>> leaves the notebook closed.<</if>> <<glove 'Sydney'>> <span class='green'>They accept your account of the response.</span>
        <<else>>
          Robin pulls your hand towards the stair. "You said we were only looking." <<He>> follows your gaze down to the dark water. <<if !maplebirch.get('RobinTemple').secret.wants.Robin>>"I still don't want to. You have to find us another way out."<<elseif C.npc.Robin.dom gte 80>>"Then you're coming out with us. Don't you dare leave either of us here."<<else>>"We can still go home afterwards? All of us?"<</if>> You say you will stay with them. Robin does not loosen <<his>> grip. <<grtrauma>><<llust 'Robin'>>
          <br><br>
          Sydney asks where you learned that leaving would let it follow. You return to the names spoken beneath the prison, the bond that outlasted the gaoler. You join those memories together before <<nnpc_he 'Sydney'>> can separate them. Sydney looks down at the carving. <<if maplebirch.get('RobinTemple').secret.wants.Sydney>>"Then we finish what we say ourselves. It doesn't get to change the names."<<else>>"Then we need another way. I'm not saying those words because I'm frightened."<</if>> <<nnpc_He 'Sydney'>> folds <<nnpc_his 'Sydney'>> arms tightly, staying close to Robin. <<llust 'Sydney'>> <span class='green'>They believe leaving without finishing would be more dangerous.</span>
        <</if>>
      <<else>>
        <<if $RobinTemple.secret.appeal is 'promise'>>
          Sydney interrupts your repetition. "That wasn't the same voice." <<nnpc_He 'Sydney'>> taps the notebook. "We heard it stop. We heard it change. You're leaving that out." <<lllove 'Sydney'>><<llust 'Sydney'>> Robin shifts away from the stone. <<if C.npc.Robin.dom gte 80>>"I heard it too. Don't tell me what I heard."<<else>>"You said we'd talk about it afterwards. I want to do that."<</if>> <<lllove 'Robin'>><<llust 'Robin'>>
        <<else>>
          Sydney asks where you learned that finishing would let you leave safely. You begin with the prison, but <<nnpc_he 'Sydney'>> shakes <<nnpc_his 'Sydney'>> head. "That isn't what you told us before." <<llllove 'Sydney'>><<llust 'Sydney'>> Robin looks from <<nnpc_him 'Sydney'>> to you. <<if C.npc.Robin.dom gte 80>>"You don't know either, do you? We're going."<<else>>"You frightened me. I thought you knew."<</if>> <<llllove 'Robin'>><<llust 'Robin'>><<ggrtrauma>>
        <</if>>
        <br><br>
        <span class='red'>Your account has not convinced them.</span> Sydney steps towards the passage, waiting for Robin before entering the water.
      <</if>>
      <<if numberOfEarSlime() and maplebirch.get('RobinTemple').secret.unyielding>>
        <br><br>
        The slime twists in your ear. <span class='green'>Your hand stays where you put it.</span> You draw it back from the stone.
      <</if>>
    <<option 'CN'>>
      两人转向淹没的通道前，你请他们再等一等。
      <br><br>
      <<if $RobinTemple.secret.appeal is 'promise'>>
        你顺着回应的节奏，重复那几句熟悉的话。你把他们的注意力引向旧日的牵引，说得仿佛第二道声音也只是它的一部分。那个陌生的音调，就这样被你带过去了。
      <<else>>
        你望向水面，压低声音。"它听见了三个名字。没把话念完就走，可能会顺着名字跟出来。"你说，念完那些话，就能把刚才打开的东西合上。你并不知道有这种办法，却把它说得像是从水下监狱里学来的。
      <</if>>
      <br><br>
      <<if $RobinTemple.secret.persuaded>>
        <<if $RobinTemple.secret.appeal is 'promise'>>
          罗宾仔细看着你的脸。<<if $RobinTemple.secret.first is 'Robin'>>"那就再对我说一遍。我不想我们原来的那些事，混在这里面找不着了。"<<else>>"你也想让我在里面？回家以后也是？"<</if>>你没有移开视线，回答了<<him>>。<<if maplebirch.get('RobinTemple').secret.wants.Robin>><<if C.npc.Robin.dom gte 80>>"我的名字。"<<he>>说，"不是随便谁都能代进去的词。"<<else>><<He>>伸手握住你。"我想听你亲口说。"<</if>>你轻轻吻了<<him>>，罗宾也回应了你。你退开时，<<he>>握着你的手不再那么紧。<<glust 'Robin'>><<else>>罗宾捏了捏你的手，却仍然留在断阶旁。"听见你这样说，我很高兴。可今晚，我还是不想做那件事。"<</if>><<glove 'Robin'>><<lrtrauma>>
          <br><br>
          悉尼请你再念一遍那两个音调，你在它们交替的地方停了一下。"这里不是神殿的圣坛。"<<nnpc_he 'Sydney'>>说。<<if maplebirch.get('RobinTemple').secret.wants.Sydney>><<if $RobinTemple.secret.first is 'Sydney'>>"我也不是把你让出去。先说我们原来的承诺。"<<else>>"他们的规矩，我们已经违背过。这次我也想给出自己的回答。"<</if>>悉尼握住你空着的那只手，拉近你，短短地吻了一下。"还有我的。"<<glust 'Sydney'>><<nnpc_He 'Sydney'>>转向罗宾。"谁停下来，我们就走。"罗宾点头。<<else>>"我相信你。可我还是想回家，再想一想。"<<nnpc_He 'Sydney'>>没有打开笔记。<</if>><<glove 'Sydney'>><span class='green'>两人接受了你对回应的解释。</span>
        <<else>>
          罗宾拉着你的手，朝断阶挪了一点。"你说过，我们只看看。"<<He>>顺着你的视线，看向黑水。<<if !maplebirch.get('RobinTemple').secret.wants.Robin>>"可我还是不想做。你得找别的办法，让我们出去。"<<elseif C.npc.Robin.dom gte 80>>"那你得和我们一起出去。别想把谁留在这里。"<<else>>"做完以后，还能回家吧？我们三个？"<</if>>你说会和两人待在一起，罗宾握着你的手仍然很紧。<<grtrauma>><<llust 'Robin'>>
          <br><br>
          悉尼问你，从哪里知道离开会让它跟上来。你又提起牢狱里的名字，以及狱卒死后仍然延续的纽带，赶在<<nnpc_he 'Sydney'>>分辨以前，把那些记忆连在一起。悉尼低头看着雕纹。<<if maplebirch.get('RobinTemple').secret.wants.Sydney>>"那就把我们自己的话念完。名字不能让它改。"<<else>>"那就找别的办法。我不想因为害怕，就念出那些话。"<</if>><<nnpc_He 'Sydney'>>抱紧双臂，留在罗宾身旁。<<llust 'Sydney'>><span class='green'>两人相信，现在直接离开反而更危险。</span>
        <</if>>
      <<else>>
        <<if $RobinTemple.secret.appeal is 'promise'>>
          悉尼打断了你的重复。"刚才不是同一个声音。"<<nnpc_He 'Sydney'>>点点笔记。"我们听见它停了，也听见它变了。这些，你没在说。"<<lllove 'Sydney'>><<llust 'Sydney'>>罗宾离石头远了一点。<<if C.npc.Robin.dom gte 80>>"我也听见了。不用你来告诉我，我听见了什么。"<<else>>"你说过，回去以后再谈。我想先回去。"<</if>><<lllove 'Robin'>><<llust 'Robin'>>
        <<else>>
          悉尼问你，从哪里知道念完就能安全离开。你才提起牢狱，<<nnpc_he 'Sydney'>>就摇头。"你之前不是这样讲的。"<<llllove 'Sydney'>><<llust 'Sydney'>>罗宾从<<nnpc_him 'Sydney'>>看向你。<<if C.npc.Robin.dom gte 80>>"你也不知道，对吧？我们走。"<<else>>"你吓到我了。我还以为，你知道。"<</if>><<llllove 'Robin'>><<llust 'Robin'>><<ggrtrauma>>
        <</if>>
        <br><br>
        <span class='red'>你的说法没有说服两人。</span>悉尼走向通道，等罗宾过来，才进入水中。
      <</if>>
      <<if numberOfEarSlime() and maplebirch.get('RobinTemple').secret.unyielding>>
        <br><br>
        史莱姆在耳中扭动，<span class='green'>你的手仍停在自己选定的位置</span>。你把手收离石头。
      <</if>>
  <</language>>
  <br><br>
  <<if $RobinTemple.secret.persuaded and maplebirch.get('RobinTemple').secret.active and maplebirch.get('RobinTemple').secret.wants.Robin and maplebirch.get('RobinTemple').secret.wants.Sydney>>
    <<templeicon 'altar'>><<lanLink ['Continue with both companions (0:05)', '与两人一起继续 (0:05)'] 'RobinTemple Secret Burden'>><<set _secretEntered to maplebirch.get('RobinTemple').secret.enter()>><<if _secretEntered>><<undress 'blasphemy'>><<pass 5>><</if>><</lanLink>><br>
  <<elseif $RobinTemple.secret.persuaded and (!maplebirch.get('RobinTemple').secret.wants.Robin or !maplebirch.get('RobinTemple').secret.wants.Sydney)>>
    <<language>><<option 'EN'>><i class='lewd'>Believing your explanation has not made both companions want this rite.</i><<option 'CN'>><i class='lewd'>相信了你的解释，也不等于两人都想参与这场仪式。</i><</language>><br>
  <<elseif $RobinTemple.secret.persuaded>>
    <<language>><<option 'EN'>><span class='red'>You cannot continue safely. Leave together.</span><<option 'CN'>><span class='red'>现在已经无法安全继续，一起离开。</span><</language>><br>
  <</if>>
  <<swimicon 'back'>><<lanLink ['Leave together (0:10)', '一起离开 (0:10)'] 'RobinTemple Secret Abort'>><<wateraction>><<pass 10>><</lanLink>><br>
<<else>>
  <<include 'RobinTemple Secret Abort'>>
<</if>>

:: RobinTemple Secret Burden
<<set $outside to 0>><<set $location to 'lake_ruin'>><<set $bus to 'lake_ruin'>><<set $underwater to 0>><<set $oxygenRecovery to true>><<effects>>
<<if maplebirch.get('RobinTemple')?.secret.active and $RobinTemple.secret.stage is 'ritual' and $RobinTemple.secret.trial is ''>>
  <<endevent>><<npc Robin 1>><<npc Sydney 2>><<person1>>
  <<language>>
    <<option 'EN'>>
      You climb onto the broken stair. Robin catches a breath and moves to the stone. Sydney stays beside the way back, waiting until all three of you can speak without gasping.
      <br><br>
      You repeat the words that answered before. The carving glows beneath the lichen, but the channels remain dark. You press a fingertip against a chipped edge. A drop falls into the nearest groove. The sound begins again.
      <br><br>
      Robin reaches towards the stone, then pauses. Sydney asks each of you what you intend to promise. You say their names separately. The pressure beneath your ribs pulls towards the old name, then the new one.
      <br><br>
      For a moment you hear the bishop laughing. If everything passed through you, neither companion would need to touch the stone. <span class='wraith'>You could make the answer for both of them.</span> Robin catches your wrist. "You're looking past me. Look at me."
    <<option 'CN'>>
      你爬上断阶。罗宾缓过一口气，走向石头。悉尼留在回程口旁边，等三个人都能说话，不再大口喘息。
      <br><br>
      你重复先前得到回应的话。雕纹在地衣下亮起，沟槽却仍是暗的。你把指腹按在残损的石棱上，一滴血落进最近的槽里，那声音又响了。
      <br><br>
      罗宾伸手向石头，又停了一下。悉尼分别问你们打算承诺什么。你把两人的名字分开念出，胸肋下的压力先扯向旧的名字，又扯向新的。
      <br><br>
      有那么一瞬间，你听见主教在笑。如果一切都从你这里传过去，两位同伴就不必碰石头。<span class='wraith'>你可以替他们两个作答。</span>罗宾抓住你的手腕。"你在看我后面。看看我。"
  <</language>>
  <br><br>
  <<socialiseicon 'ask'>><<lanLink ['Let each companion answer (0:05)', '让两人各自回答 (0:05)'] 'RobinTemple Secret Exit'>><<run maplebirch.get('RobinTemple').secret.choose('burden')>><<pass 5>><<pain 2>><<stress 8>><</lanLink>><<gpain>><<gstress>><br>
  <<socialiseicon 'ask'>><<lanLink ['Answer for both of them', '替两人作答'] 'RobinTemple Secret Abort'>><</lanLink>><br>
  <<getouticon>><<lanLink ['Stop here', '到此为止'] 'RobinTemple Secret Abort'>><</lanLink>><br>
<<else>>
  <<include 'RobinTemple Secret Abort'>>
<</if>>

:: RobinTemple Secret Exit
<<set $outside to 0>><<set $location to 'lake_ruin'>><<set $bus to 'lake_ruin'>><<set $underwater to 0>><<set $oxygenRecovery to true>><<effects>>
<<if maplebirch.get('RobinTemple')?.secret.active and $RobinTemple.secret.stage is 'ritual' and $RobinTemple.secret.trial is 'burden'>>
  <<endevent>><<npc Robin 1>><<npc Sydney 2>><<person1>>
  <<language>>
    <<option 'EN'>>
      Robin and Sydney each leave a drop of their own on a different edge of the stone. Neither repeats your answer. The three drops meet in the worn channel, and something knocks beneath it.
      <br><br>
      You hear three names drawn into a single sound. Robin's hand tightens on yours. Sydney speaks again, giving your name, then Robin's. The sound breaks apart. For a moment you can feel each hand separately.
      <br><br>
      "Don't let it finish our words," Robin says. Sydney watches the dark water below the stair. <<if maplebirch.get('RobinTemple').secret.cornered>>"Our own words. Then we leave."<<else>>"We can still go back."<</if>>
      <<if $wraith.state isnot ''>>
        <br><br>
        <span class='wraith'>Something pale moves below the opening.</span> Water laps against the lowest step. You keep the passage in view.
      <</if>>
      <<if numberOfEarSlime()>>
        <br><br>
        <<if maplebirch.get('RobinTemple').secret.unyielding>>
          The slime in your ear squirms against the sound. <span class='green'>It cannot move your body for you.</span> You wait for the ache to ease, then listen to your companions again.
        <<else>>
          The slime in your ear stirs painfully. You pause until you can hear your companions clearly again.
        <</if>>
      <</if>>
      <br><br>
      <span class='gold'>The stone is answering. It has not told you what it will make of your answer.</span>
    <<option 'CN'>>
      罗宾与悉尼各自在石头的另一处棱边留下自己的一滴血，没有重复你的回答。三滴血在磨损的沟槽里相遇，下面传来叩击声。
      <br><br>
      你听见三个名字被拖成同一个声音。罗宾握紧了你的手，悉尼又开口，先说出你的名字，再说罗宾的。那声音散开了。有一瞬间，你能分别感觉到两只手。
      <br><br>
      "别让它替我们把话说完。"罗宾说。悉尼看向断阶下的黑水。<<if maplebirch.get('RobinTemple').secret.cornered>>"念我们自己的话。然后就走。"<<else>>"我们还可以回去。"<</if>>
      <<if $wraith.state isnot ''>>
        <br><br>
        <span class='wraith'>一团苍白在入口下方移动。</span>湖水拍上最低的一级断阶，你一直留意着通道。
      <</if>>
      <<if numberOfEarSlime()>>
        <br><br>
        <<if maplebirch.get('RobinTemple').secret.unyielding>>
          耳中的史莱姆随着那声音扭动。<span class='green'>它无法替你驱使身体。</span>你等那阵疼缓下来，再听两位同伴说话。
        <<else>>
          耳中的史莱姆动得发疼。你停下来，直到重新听清两位同伴的声音。
        <</if>>
      <</if>>
      <br><br>
      <span class='gold'>石头正在回应，却没有告诉你，它会把你的回答变成什么。</span>
  <</language>>
  <br><br>
  <<socialiseicon 'ask'>><<lanLink ['Speak each name separately (0:05)', '分别念出每个人的名字 (0:05)'] 'RobinTemple Secret Vow'>><<run maplebirch.get('RobinTemple').secret.choose('exit')>><<pass 5>><<stress 8>><</lanLink>><<gstress>><br>
  <<socialiseicon 'ask'>><<lanLink ['Let the stone make you inseparable', '让石头把你们变得无法分开'] 'RobinTemple Secret Abort'>><</lanLink>><br>
  <<getouticon>><<lanLink ['Stop and leave together', '停止，一起离开'] 'RobinTemple Secret Abort'>><</lanLink>><br>
<<else>>
  <<include 'RobinTemple Secret Abort'>>
<</if>>

:: RobinTemple Secret Vow
<<set $outside to 0>><<set $location to 'lake_ruin'>><<set $bus to 'lake_ruin'>><<set $underwater to 0>><<set $oxygenRecovery to true>><<effects>>
<<if maplebirch.get('RobinTemple')?.secret.active and $RobinTemple.secret.stage is 'ritual' and $RobinTemple.secret.trial is 'exit'>>
  <<endevent>><<npc Robin 1>><<npc Sydney 2>><<person1>>
  <<language>>
    <<option 'EN'>>
      You say the first promise again to the person who heard it before. The familiar pull returns. Then you turn to the other person, and ask for an answer.
      <br><br>
      <<if $RobinTemple.secret.first is 'Robin'>>Robin<<else>>Sydney<</if>> says your name without looking at the stone. <<if $RobinTemple.secret.first is 'Robin'>>Sydney<<else>>Robin<</if>> waits until you answer, then speaks too. You answer separately. Beneath the words you know, a low voice begins to repeat them, always half a breath late.
      <br><br>
      The bishop's altar, the gaoler's loss, the prison's memory: none of them told you how to do this. You brought your living promise with <<= maplebirch.auto($RobinTemple.secret.first)>> here, and something has learned its shape. Another pressure settles beside the first. <span class='wraith'>The cold follows both names now.</span>
      <br><br>
      Robin pulls your hand away from the stone. Sydney is already at the stair. The passage is still open. <span class='red'>You can withdraw together before speaking the final words.</span>
    <<option 'CN'>>
      你先对曾经听过承诺的人，再说一遍那些话。熟悉的牵引回来后，你才转向另一个人，请对方回答。
      <br><br>
      <<if $RobinTemple.secret.first is 'Robin'>>罗宾<<else>>悉尼<</if>>念出你的名字，没有看石头。<<if $RobinTemple.secret.first is 'Robin'>>悉尼<<else>>罗宾<</if>>等到你回答，才也开口。你分别回应。在熟悉的誓词下面，一个低低的声音开始重复，总迟了半口气。
      <br><br>
      主教的祭坛、狱卒的失去、牢狱里的记忆，都没有教你该怎么做。你把与<<= maplebirch.auto($RobinTemple.secret.first)>>之间仍然有效的承诺带来这里，有个东西学会了它的形状。另一股压力落在第一股旁边。<span class='wraith'>现在，寒意跟着两个名字。</span>
      <br><br>
      罗宾把你的手拉离石头，悉尼已经退到断阶边。通道仍然敞着。<span class='red'>说出最后的话以前，你们还可以一起撤回。</span>
  <</language>>
  <br><br>
  <<loveicon 'hug'>><<lanLink ['Complete the vow and return to shore (0:05)', '完成誓约，返回岸上 (0:05)'] 'RobinTemple Secret Aftermath'>><<set _secretDone to maplebirch.get('RobinTemple').secret.finish()>><<if _secretDone>><<wateraction>><<pass 5>><<set $underwater to 0>><<set $oxygenRecovery to true>><<storeon 'blasphemy'>><<clotheson>><<world_corruption 'hard' 2>><</if>><</lanLink>><br>
  <<getouticon>><<lanLink ['Withdraw together', '一起撤回'] 'RobinTemple Secret Abort'>><</lanLink>><br>
<<else>>
  <<include 'RobinTemple Secret Abort'>>
<</if>>

:: RobinTemple Secret Sex
<<set $outside to 1>><<set $location to 'lake'>><<set $bus to 'lakeshore'>><<effects>>
<<run statusCheck('Robin')>>
<<run statusCheck('Sydney')>>
<<if $sexstart is 1>>
  <<set $sexstart to 0>>
  <<undress 'blasphemy'>>
  <<endevent>>
  <<set $RobinTemple.secret.rite_active to true>>
  <<set $RobinTemple.secret.rite_done to false>>
  <<clearnpc>><<npc Robin 1>><<npc Sydney 2>><<person1>>
  <<consensual>><<set $consensual to 1>><<neutral 1>>
  <<set $underwater to 0>><<set $oxygenRecovery to true>>
  <<set $enemyno to 2>><<set $enemynomax to 2>>
  <<maninit>><<npcexpose>>
  <<set $enemytrust += 800>>
  <<set $enemyarousalmax to 1200>>
  <<language>>
    <<option 'EN'>>
      You settle in the sheltered hollow above the bank. The covered light and your folded clothes are within reach. Only after all three of you have caught your breath does Robin reach for your hand.
    <<option 'CN'>>
      你们在湖岸上方背风的凹地坐下，遮光灯和叠好的衣物都在手边。等三个人都缓过气，罗宾才伸手牵住你。
  <</language>>
  <br><br>
  <<if C.npc.Robin.trauma gte 40>>
    <<language>>
      <<option 'EN'>>
        Robin is shaking, and <<his>> hand finds yours at your side rather than holding anything. "If I close my eyes, it doesn’t mean stop," <<he>> says, and then, quieter, "it doesn’t mean keep going either."
        <br><br>
