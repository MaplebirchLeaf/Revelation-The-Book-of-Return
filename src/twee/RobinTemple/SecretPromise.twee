:: RobinTemple Secret Promise Widgets [widget]
<<widget 'secret-promise-talk'>>
  <<if maplebirch.get('RobinTemple').secret.known and !$RobinTemple.dual_promise>>
    <<if _args[0] is 'Robin' and getRobinLocation() is 'home' and maplebirch.get('RobinTemple').available>>
      <<if $RobinTemple.secret.stage is 'none' and maplebirch.get('RobinTemple').secret.eligible>>
        <<socialiseicon 'ask'>><<lanLink ['Tell Robin about the rite you found', '把发现的仪式告诉罗宾'] 'RobinTemple Secret Research'>><</lanLink>><br>
      <<elseif $RobinTemple.secret.stage is 'research'>>
        <<socialiseicon 'ask'>><<lanLink ['Ask Robin again, in private', '再和罗宾私下谈一次'] 'RobinTemple Secret Robin'>><</lanLink>><br>
      <<elseif $RobinTemple.secret.stage is 'none'>>
        <<language>>
          <<option 'EN'>>
            <span class='teal'>You have seen what waits beneath the lake. To ask Robin to come, you would have to want it more than you fear it.</span> <<promiscuous 6>>
          <<option 'CN'>>
            <span class='teal'>你见过湖底等着什么。要让罗宾同去，你得比害怕更想要它。</span> <<promiscuous 6>>
        <</language>><br>
      <</if>>
    <<elseif _args[0] is 'Sydney' and $bus is 'schoollibrary' and $location is 'school'
      and Time.hour is 12 and $RobinTemple.secret.stage is 'research'>>
      <<socialiseicon 'ask'>><<lanLink ['Ask Sydney for a private conversation', '请悉尼借一步私下谈谈'] 'RobinTemple Secret Sydney'>><</lanLink>><br>
    <</if>>
  <</if>>
<</widget>>

<<widget 'secret-promise-lake'>>
  <<if ['travelling', 'ritual'].includes($RobinTemple.secret.stage)>>
    <<getouticon>><<lanLink ['Call off the interrupted journey', '取消中断的同行'] 'RobinTemple Secret Abort'>><</lanLink>><br>
  <</if>>
  <<if $RobinTemple.secret.stage is 'research'>>
    <<if Time.dayState is 'day' and !Weather.isFrozen('lake') and !maplebirch.get('RobinTemple').secret.threatened>>
      <<swimicon 'dive'>><<lanLink ['Dive to the drowned shrine (0:30)', '下潜到被淹没的神龛 (0:30)'] 'RobinTemple Secret Survey'>><<wateraction>><<set $oxygen -= 200>><<loxygen>><</lanLink>><br>
    <</if>>
    <<if $RobinTemple.secret.survey_day gte 0>>
      <<socialiseicon 'ask'>><<lanLink ['Review the preparations', '核对路线与准备'] 'RobinTemple Secret Plan'>><</lanLink>><br>
    <</if>>
    <<if maplebirch.get('RobinTemple').secret.ready>>
      <<lakeicon>><<lanLink ['Meet Robin and Sydney at the agreed place (0:10)', '到约定地点与罗宾和悉尼会合 (0:10)'] 'RobinTemple Secret Approach'>><<run maplebirch.get('RobinTemple').secret.depart()>><<pass 10>><</lanLink>><br>
    <</if>>
  <</if>>
<</widget>>

<<widget 'secret-promise-journal'>>
  <<if $RobinTemple.secret.stage is 'none' and maplebirch.get('RobinTemple').secret.known>>
    <h1 class='header wraith'><<language>><<option 'EN'>>Confounded Vow<<option 'CN'>>混乱誓约<</language>></h1>
    <ul class='journal'>
      <li><<language>>
        <<option 'EN'>>
          <<if !hasSexStat('promiscuity', 6)>>You have seen what waits beneath the lake, and you want to show it to Robin and Sydney both. You are not yet the kind of person who would ask. <<promiscuous 6>><<elseif !maplebirch.get('RobinTemple').secret.eligible>>The three of you are not ready: love, resolve, intact vows and an untouched temple promise are all required.<<else>>Speak to Robin privately at home.<</if>>
        <<option 'CN'>>
          <<if !hasSexStat('promiscuity', 6)>>你已经见过湖底等着什么，也想让罗宾和悉尼都看看。但你还不是会开口的那种人。<<promiscuous 6>><<elseif !maplebirch.get('RobinTemple').secret.eligible>>你们三人还不够格：爱意、决心、完整的誓言与未被触动的神殿承诺，缺一不可。<<else>>去家中和罗宾私下谈谈。<</if>>
      <</language>></li>
    </ul>
    <hr>
  <<elseif $RobinTemple.secret.stage isnot 'none'>>
    <h1 class='header wraith'><<language>><<option 'EN'>>Confounded Vow<<option 'CN'>>混乱誓约<</language>></h1>
    <<if $RobinTemple.dual_promise>>
      <ul class='journal'>
        <li><<language>>
          <<option 'EN'>>
            <<if $RobinTemple.secret.rite_active>>Robin and Sydney are with you in the ruin. Finish what the three of you began.<<else>>You, Robin and Sydney performed the rite together in the ruin beneath the lake. The temple does not know.<</if>>
          <<option 'CN'>>
            <<if $RobinTemple.secret.rite_active>>罗宾和悉尼就在湖底废墟里。把你们三人开始的事做完。<<else>>你与罗宾、悉尼在湖底废墟一同完成了仪式。神殿并不知道。<</if>>
        <</language>></li>
      </ul>
    <<else>>
      <ul class='journal'>
        <li><<language>>
          <<option 'EN'>>
            <<if $RobinTemple.secret.robin_day gte 0>>Robin has agreed to come.<<else>>Talk to Robin privately at home.<</if>>
          <<option 'CN'>>
            <<if $RobinTemple.secret.robin_day gte 0>>罗宾已经答应同行。<<else>>去家中和罗宾私下谈谈。<</if>>
        <</language>></li>
        <li><<language>>
          <<option 'EN'>>
            <<if $RobinTemple.secret.sydney_day gte 0>>Sydney has agreed to consider the journey.<<else>>Speak to Sydney at the library counter during lunch.<</if>>
          <<option 'CN'>>
            <<if $RobinTemple.secret.sydney_day gte 0>>悉尼已经答应考虑同行。<<else>>午休时，到图书馆柜台找悉尼私下谈谈。<</if>>
        <</language>></li>
        <li><<language>>
          <<option 'EN'>>
            <<if $RobinTemple.secret.survey_day lt 0>>Survey the old shoreline by daylight, when the lake is unfrozen.<<elseif !$RobinTemple.secret.prepared>>Review the route notes and preparations at the lake.<<else>>Leave at least three days after the last conversation or survey. Meet on an empty, rainless blood moon night, between 21:00 and 23:00.<</if>>
          <<option 'CN'>>
            <<if $RobinTemple.secret.survey_day lt 0>>湖面未结冰时，白天到湖畔勘查旧岸线。<<elseif !$RobinTemple.secret.prepared>>到湖畔核对路线笔记与准备。<<else>>最后一次谈话或勘查后，至少留三天考虑。在无人、无雨的血月夜，21:00 至 23:00 到湖畔会合。<</if>>
        <</language>></li>
      </ul>
    <</if>>
    <hr>
  <</if>>
<</widget>>

:: RobinTemple Secret Research
<<set $outside to 0>><<set $location to 'home'>><<effects>><<npc Robin>><<person1>>
<<if maplebirch.get('RobinTemple').secret.eligible and $RobinTemple.secret.stage is 'none'>>
  <<language>>
    <<option 'EN'>>
      You close Robin’s door before recounting the visions. The gaoler’s sacrifice did not make the witch innocent. The prison beneath the lake did not make betrayal holy. Yet both memories contained a bond that outlived the people who made it.
      <br><br>
      Robin listens, then draws back when you suggest joining a second promise to the first. "Would the other person know?" <<he>> asks. "And would you still want me if I said no?"
      <br><br>
      You answer both questions before speaking of the rite. You tell <<him>> that Sydney will hear everything you have told Robin — and that neither of them will hear it from the other. Robin places a hand on the unopened notebook. "Then write down the danger too. Not just what you want to happen."
      <<if $kylar_manor_secret gte 1>>
        <br><br>
        You do not tell <<him>> the rest. Not yet. The candlelit altar the bishop described, the silver that was meant to stop a line of blood from spreading — you have seen the shape of it before, in a manor on the hill. What waits in the ruin is older, and it was never kind.
      <</if>>
    <<option 'CN'>>
      你关上罗宾房间的门，讲起两段幻境。狱卒的牺牲没有让女巫变得无辜，湖底的牢狱也没有让背叛变得神圣。可两段记忆中，都有一条比当事人活得更久的纽带。
      <br><br>
      听到你想让第二份承诺接入第一份，罗宾稍稍退开。"另一个人会知道吗？"<<he>>问，"如果我不同意，你还会想和我在一起吗？"
      <br><br>
      你先回答这两个问题，才谈仪式。你告诉<<him>>，对罗宾说过的话，你也会全部讲给悉尼——而且不会让其中一个人从另一个人那里听到。罗宾按住尚未翻开的笔记。"那就把危险也写下来，别只写你想要的结果。"
      <<if $kylar_manor_secret gte 1>>
        <br><br>
        剩下的你没有说。暂时不说。主教描述过的那座烛台圣坛，那些用来阻断血脉的银器——你在山坡上的宅邸里见过同样的形状。废墟里等着的那个更古老，而且从来都不仁慈。
      <</if>>
  <</language>>
  <br><br>
  <<socialiseicon 'ask'>><<lanLink ['Investigate without making a promise', '先调查，不替任何人做决定'] 'RobinTemple Secret Robin'>><<run maplebirch.get('RobinTemple').secret.begin()>><</lanLink>><br>
<</if>>
<<getouticon>><<lanLink ['Leave it for now', '暂时搁下'] "Robin's Room Entrance">><<endevent>><</lanLink>><br>

:: RobinTemple Secret Robin
<<set $outside to 0>><<set $location to 'home'>><<effects>><<endevent>><<npc Robin>><<person1>>
<<if $RobinTemple.secret.stage is 'research' and getRobinLocation() is 'home'>>
  <<language>>
    <<option 'EN'>>
      Robin turns the notebook back to the account of the gaoler. "They lost their home. Their work. Everything." <<He>> traces the margin rather than the words. "I don’t want to prove I love you by losing everything else."
      <br><br>
      You explain that sharing the burden must not mean handing someone else the right to decide for <<him>>. You will show the route first. Either companion can stop you, even after you arrive. Nothing will be taken from the Ivory Wraith.
      <<if $kylar_manor_secret gte 2>>
        <br><br>
        Then you tell <<him>> the part you left out. The bishop who drinks with strangers and calls a blood-soaked altar scripture. The couple who owned the manor on the hill, and what the temple did to them for coveting the same power. Robin goes very still. "So this isn’t a new thing we’d be doing. It’s an old thing we’d be doing again."
      <</if>>
      <<if $temple_confessor_intro>>
        <br><br>
        And you tell <<him>> about the confessors. How the temple keeps a second set of hands for the work it will not name, and calls anyone who learns of it a danger to the faithful. Robin’s grip tightens on the notebook. "Then they already know how to keep a secret like this. That’s worse, not better."
      <</if>>
    <<option 'CN'>>
      罗宾翻回狱卒的那一页。"他们丢了家，丢了工作，什么都没有了。"<<He>>的指尖沿着纸边挪动，没有碰字。"我不想靠失去其他的一切，证明我爱你。"
      <br><br>
      你解释，共同承担不能意味着把决定权交给别人。路线必须提前看清。抵达以后，两位同伴也都可以叫停。你不会从象牙幽灵那里拿走任何东西。
      <<if $kylar_manor_secret gte 2>>
        <br><br>
        然后你说出之前略过的部分。那个跟陌生人喝酒、把血浸的圣坛称作经文的主教。山坡宅邸的主人，以及神殿因为觊觎同样的力量而对他们做的事。罗宾安静了很久。"所以这不是我们要去做一件新的事。是要把一件旧事再做一遍。"
      <</if>>
      <<if $temple_confessor_intro>>
        <br><br>
        你还说了告解员的事。神殿为它不能说出名字的活计留着另一双手，谁发现了这件事，谁就成了信仰的威胁。罗宾握笔记的手收紧。"那他们早就知道怎么保守这样的秘密了。这不是好事，是更糟。"
      <</if>>
  <</language>>
  <br><br>
  <<if maplebirch.get('RobinTemple').secret.eligible>>
    <<language>>
      <<option 'EN'>>
        <<if C.npc.Robin.dom gte 80>>"I will hold the light," Robin says. "And if you stop listening, I will put it out. Agree to that first."<<else>>"I can try," Robin says, then corrects <<himself>>. "No. I want to try. But you have to listen if I ask to leave."<</if>>
      <<option 'CN'>>
        <<if C.npc.Robin.dom gte 80>>"灯由我拿着，"罗宾说，"如果你不肯听我们说话，我会把它熄灭。你得先答应这个。"<<else>>"我可以试试。"罗宾停了一下，改了口。"不，是我想试试。但我说要走的时候，你得听。"<</if>>
    <</language>>
    <br><br>
    <<if $RobinTemple.secret.robin_day lt 0>>
      <<socialiseicon 'ask'>><<lanLink ['Accept Robin’s conditions', '答应罗宾的条件'] "Robin's Room Entrance">><<run maplebirch.get('RobinTemple').secret.agree('Robin')>><<pass 15>><<endevent>><</lanLink>><br>
    <<else>>
      <<language>><<option 'EN'>><span class='teal'>Robin has agreed. Leave time to think before going.</span><<option 'CN'>><span class='teal'>罗宾已经同意，出发前仍要留下考虑的时间。</span><</language>><br><br>
    <</if>>
  <<else>>
    <<language>>
      <<option 'EN'>>
        Robin shuts the notebook. "I can’t say yes to this now." <span class='red'>Rebuild your relationship, confidence and intact vows first. A frightened agreement would not be consent.</span>
      <<option 'CN'>>
        罗宾合上笔记。"我现在不能答应。"<span class='red'>先修复关系，建立自信，守住誓言。因为害怕失去你而点头，不算自愿。</span>
    <</language>>
    <br><br>
  <</if>>
<</if>>
<<getouticon>><<lanLink ['Leave Robin to think', '让罗宾自己想想'] "Robin's Room Entrance">><<endevent>><</lanLink>><br>

:: RobinTemple Secret Sydney
<<set $outside to 0>><<set $location to 'school'>><<effects>><<endevent>><<npc Sydney>><<person1>>
<<if $RobinTemple.secret.stage is 'research' and $bus is 'schoollibrary' and Time.hour is 12>>
  <<language>>
    <<option 'EN'>>
      Sydney waits until the counter is clear before following you between the shelves. You explain the promise you already hold with Robin, Robin’s place in your life, and the two visions. <<He>> keeps <<his>> hands folded around the notebook.
      <br><br>
      "That isn’t what Jordan taught us," Sydney says. "And what happened below the lake was not love. People were betrayed." <<He>> turns a page. "If we repeat their words, why should the ending be different?"
      <<if $kylar_manor_secret gte 2>>
        <br><br>
        You tell <<him>> what the cowled bishop said in the street, and watch the colour leave <<his>> face. "I have read that account," <<he>> says slowly. "The order calls it a punishment. It was a transmission. Three of them, one altar, one night — the Elk, the Fox, and a third they made. Jordan would say I am mistaken." <<He>> closes the notebook. "Jordan is not always right."
      <</if>>
      <<if $temple_confessor_intro>>
        <br><br>
        "There are confessors," <<he>> adds, quieter. "Priests who take confessions the rest of the order never reads. I only know because I was asked to copy one out, once. If the temple can do that, then the temple can also do this." <<He>> looks at you. "That is not permission. That is only me saying I understand the danger."
      <</if>>
      <br><br>
      You explain the difference you intend to make: no captive, no stolen relic, no person volunteered by another. Two promises will run through you, not between them. Sydney tests that. "So if I withdraw, Robin does not lose you?" You answer that only the second promise lapses, and that you would tell Robin yourself.
    <<option 'CN'>>
      悉尼等柜台前的人离开，才跟你走到书架之间。你讲清你和罗宾已有的承诺、罗宾在你生活中的位置，还有两段幻境。<<He>>把笔记握在交叠的双手之间。
      <br><br>
      "这和约旦教我们的不一样。"悉尼说，"湖底发生的也不是爱。那些人被背叛了。"<<He>>翻过一页。"重复他们的话，结局为什么会不同？"
      <<if $kylar_manor_secret gte 2>>
        <br><br>
        你把那个戴兜帽的主教在街上说的话讲给<<him>>听，看着<<he>>脸上的血色退下去。"我读过那卷记录。"<<he>>缓缓地说，"修会把它叫作惩罚。其实是一次传递。他们三个，一座圣坛，一个晚上——高麋、狐，以及他们造出来的第三个。约旦会说是我记错了。"<<He>>合上笔记。"约旦并不总是对的。"
      <</if>>
      <<if $temple_confessor_intro>>
        <br><br>
        "还有告解员。"<<he>>压低了声音补上一句，"那些听取其余修会永远读不到的告解的神职。我只知道，是因为有人找我抄录过其中一份。如果神殿做得出那种事，那神殿也做得出这件事。"<<He>>看着你。"这不是许可。这只是我在说，我明白危险在哪。"
      <</if>>
      <br><br>
      你讲出必须改变的地方。没有囚徒，没有偷来的圣物，没有被别人替其做出决定的人。两份承诺会穿过你，而不是在他们两人之间。悉尼试着追问。"那如果我退出，罗宾不会失去你？"你回答，消失的只有第二份承诺，而罗宾那边会由你亲口去说。
  <</language>>
  <br><br>
  <<if maplebirch.get('RobinTemple').secret.eligible>>
    <<language>>
      <<option 'EN'>>
        Sydney closes the notebook carefully. "I need time to pray. Not to ask Jordan. To know whether this is my choice." <<He>> looks up. "If I come, I come as myself. You don’t get to call fear a vow."
      <<option 'CN'>>
        悉尼小心合上笔记。"我要留些时间祈祷。不是去问约旦，是想清楚这是不是我自己的选择。"<<He>>抬起眼。"如果我去，是我自己要去。你不能把害怕叫作誓言。"
    <</language>>
    <br><br>
    <<if $RobinTemple.secret.sydney_day lt 0>>
      <<socialiseicon 'ask'>><<lanLink ['Agree to wait and respect a refusal', '答应等待，也接受拒绝'] 'School Library'>><<run maplebirch.get('RobinTemple').secret.agree('Sydney')>><<pass 15>><<endevent>><</lanLink>><br>
    <<else>>
      <<language>><<option 'EN'>><span class='teal'>Sydney has agreed to consider the journey. Do not hurry the decision.</span><<option 'CN'>><span class='teal'>悉尼已经同意考虑同行，不要催促这个决定。</span><</language>><br><br>
    <</if>>
  <<else>>
    <<language>><<option 'EN'>>Sydney shakes <<his>> head. "Not like this." <span class='red'>Deep love, steadfast pure faith and intact vows are essential. Neither desire nor pressure will replace them.</span><<option 'CN'>>悉尼摇了摇头。"不能这样。"<span class='red'>深厚的爱意、坚定的纯洁信仰与完整誓言缺一不可，欲望和施压都不能代替。</span><</language>><br><br>
  <</if>>
<</if>>
<<getouticon>><<lanLink ['Return to the library', '回到图书馆'] 'School Library'>><<endevent>><</lanLink>><br>

:: RobinTemple Secret Survey
<<set $outside to 0>><<set $location to 'lake_ruin'>><<set $bus to 'lake_ruin_prison'>><<effects>>
<<if maplebirch.get('RobinTemple').secret.survey()>>
  <<language>>
    <<option 'EN'>>
      You follow the drowned masonry down, past the reach of daylight. The cold closes over your clothes and finds your skin. It is not the prison from your vision. This is older, and it was drowned on purpose.
      <br><br>
      A seam opens in the wall where the mortar has rotted away. You surface inside it, into a low chamber holding one pocket of stale air. The water laps at your shoulders. A broken carving shows three lines passing through one circle and meeting at a single point.
      <br><br>
      <span class='gold'>Whatever the three of you wear down here will drag you under, and the way back is longer than the way in.</span> You test the ceiling for cracks, fix the turn back to open water in your mind, and leave the carving and every loose object untouched.
      <<if $kylar_manor_secret gte 2>>
        <br><br>
        Three lines, one point. The Elk, the Fox, and the third the order built out of both. The carving is not a marriage knot. It is a diagram of what the vessel is for.
      <</if>>
      <<if $wraithPrison and $wraithPrison.vision>>
        <br><br>
        You have stood on the other side of this stone. You know what the gaoler chose, and what it cost. That is why you are going to do it differently, or not at all.
      <</if>>
      <br><br>
      <span class='teal'>The chamber can be reached without entering the prison, but the dive is long, and the lake does not warm for anyone.</span>
    <<option 'CN'>>
      你沿着被淹没的旧砌石下潜，潜到日光够不到的地方。冷水先是浸透衣服，然后贴上皮肤。这里不是幻境里的牢狱。它更古老，而且是被故意沉进湖里的。
      <br><br>
      灰浆烂尽的地方裂开一道缝。你从缝里浮出头，进到一个低矮的腔室，里面只剩一口发陈的空气。水停在你肩头。一块残损浮雕上，三条线穿过同一个圆，最终汇于一点。
      <br><br>
      <span class='gold'>你们在下面穿的任何东西都会把人往下拽，而回去的路比进来更长。</span>你检查顶上有没有新裂缝，把回到开阔水面的转角记在心里，没有碰浮雕，也没有带走地上的任何东西。
      <<if $kylar_manor_secret gte 2>>
        <br><br>
        三条线，一点。高麋、狐，以及修会用这两者造出的第三个。这块浮雕不是婚结，而是一张说明容器用途的图。
      <</if>>
      <<if $wraithPrison and $wraithPrison.vision>>
        <br><br>
        你在石头的另一侧站过。你知道狱卒选了哪一条路，也知道代价是什么。所以你才会用不一样的方式做，或者干脆不做。
      <</if>>
      <br><br>
      <span class='teal'>不必进牢狱也能到达这个腔室，但下潜很深，湖水对谁都不温暖。</span>
  <</language>>
<<else>>
  <<language>><<option 'EN'>><span class='red'>The dive cannot continue safely now. Come by daylight, with the lake unfrozen and no pursuit behind you.</span><<option 'CN'>><span class='red'>现在无法安全下潜。等湖面未结冰的白天再来，先甩开追猎。</span><</language>>
<</if>>
<br><br>
<<getouticon>><<lanLink ['Return to shore', '回到湖畔'] 'Lake Shore'>><</lanLink>><br>

:: RobinTemple Secret Plan
<<set $outside to 1>><<set $location to 'lake'>><<effects>><<lakeeffects>>
<<if $RobinTemple.secret.stage is 'research' and $RobinTemple.secret.survey_day gte 0>>
  <<language>>
    <<option 'EN'>>
      You review the route and the two visions. The old rite made three people into one instrument, and gave none of them a voice. Your plan leaves space for three separate answers. The final line must be a way out, not a lock.
      <br><br>
      No one brings anything down. Robin will carry a covered light as far as the water's edge and leave it there. Sydney will memorise the words rather than write them. You will keep the route in your head. Nothing that can sink, snag or float away comes with you, and no one surrenders a temple ring, blood, relic or possession belonging to the dead.
      <<if $kylar_manor_secret gte 2>>
        <br><br>
        The bishop said silver prevents transmission. You will bring none. No vessel, no conduit, nothing that could carry a line of blood from one person into another.
      <</if>>
      <br><br>
      <span class='red'>The blood moon also brings the Ivory Wraith, and the lake is its territory. A restless reflection, a pursuing presence or a stolen necklace means calling the whole thing off. So does a low breath. The dive comes before the vow, and a body without air cannot make one.</span>
    <<option 'CN'>>
      你重新核对路线与两段幻境。旧仪式把三个人做成一件器物，谁都没有发言权。你的方案必须留出三个各自回答的位置。最后一笔要是出口，不能是锁。
      <br><br>
      谁都不带东西下水。罗宾会把遮光灯提到水边就放下，悉尼不写字，改为把誓词背下来。你把路线记在脑子里。任何会沉、会挂住、会被水冲走的东西都不带下去，也没人需要交出神殿戒指、鲜血、圣物，或属于死者的东西。
      <<if $kylar_manor_secret gte 2>>
        <br><br>
        主教说银能阻断传递。你什么都不带。不带容器，不带导管，不带任何能把一条血脉从一个人引到另一个人身上的东西。
      <</if>>
      <br><br>
      <span class='red'>血月也会带来象牙幽灵，湖是它的地盘。躁动的倒影、尾随的存在，或偷来的项链，都意味着取消同行。一口气不够也一样。下潜在立誓之前，没有空气的身体立不了誓。</span>
  <</language>>
  <br><br>
  <<if maplebirch.get('RobinTemple').secret.eligible and $RobinTemple.secret.robin_day gte 0 and $RobinTemple.secret.sydney_day gte 0 and !$RobinTemple.secret.prepared>>
    <<socialiseicon 'ask'>><<lanLink ['Finish the route and withdrawal plan', '整理路线与撤退约定'] 'Lake Shore'>><<run maplebirch.get('RobinTemple').secret.prepare()>><</lanLink>><br>
  <<else>>
    <<language>><<option 'EN'>>Check both private conversations and your current vows. After preparation, leave at least three days for reflection. The journal records the meeting conditions.<<option 'CN'>>核对两次私下谈话与当前誓言。准备妥当后，至少留三天考虑。日志记着会合条件。<</language>><br><br>
  <</if>>
<</if>>
<<getouticon>><<lanLink ['Return to shore', '回到湖畔'] 'Lake Shore'>><</lanLink>><br>

:: RobinTemple Secret Approach
<<set $outside to 1>><<set $location to 'lake'>><<effects>><<lakeeffects>>
<<if maplebirch.get('RobinTemple').secret.active and $RobinTemple.secret.stage is 'travelling'>>
  <<endevent>><<npc Robin 1>><<npc Sydney 2>><<person1>>
  <<language>>
    <<option 'EN'>>
      Robin arrives with the light covered. Sydney approaches separately, checking the empty shore before joining you. Neither wears temple robes. All three of you pause beside the marked turn.
      <br><br>
      The red moon stains the water. Something pale moves beneath it, too slowly to be a fish. Sydney catches your sleeve. "That is why we leave the relics alone." Robin sets the covered light down among the roots and steps out of <<his>> clothes. "Then we leave everything we can. Including these."
      <br><br>
      You undress on the cold shore and leave every stitch folded under the light, out of the water's reach. Robin and Sydney do the same. Naked under a red moon, neither of them looks at the other; both look at you, waiting for the word. You point out the turn back to shore, check the entrance one last time, and lead them in.
    <<option 'CN'>>
      罗宾提着遮住光的灯抵达。悉尼独自走来，确认岸边无人，才与你们站到一起。没人穿神殿长袍。你们在标出的转角停下。
      <br><br>
      红月染着湖水。一团苍白在水下移动，慢得不像鱼。悉尼拉住你的袖子。"所以不能动这里的遗物。"罗宾把遮光灯放在树根之间，脱下了衣服。"那就把所有能留下的都留下。包括这些。"
      <br><br>
      你在冰凉的岸上脱光，把所有衣物叠好放在灯下，离开水面能碰到的地方。罗宾和悉尼也照做。红月下赤身裸体，两人都没有看对方，都看着你，等你开口。你指出回岸的转角，最后检查一次入口，带他们下水。
  <</language>>
  <br><br>
  <<swimicon 'dive'>><<lanLink ['Dive in, and confirm anyone may stop the rite (0:05)', '潜入水中，并确认任何人都能叫停 (0:05)'] 'RobinTemple Secret Burden'>><<undress 'blasphemy'>><<underwater>><<wateraction>><<run maplebirch.get('RobinTemple').secret.enter()>><<loxygen>><</lanLink>><br>
  <<getouticon>><<lanLink ['Leave together', '一起离开'] 'RobinTemple Secret Abort'>><</lanLink>><br>
<<else>>
  <<include 'RobinTemple Secret Abort'>>
<</if>>

:: RobinTemple Secret Burden
<<set $outside to 0>><<set $location to 'lake_ruin'>><<set $bus to 'lake_ruin_prison'>><<set $underwater to 0>><<set $oxygenRecovery to true>><<effects>>
<<if maplebirch.get('RobinTemple').secret.active and $RobinTemple.secret.stage is 'ritual' and $RobinTemple.secret.trial is ''>>
  <<endevent>><<npc Robin 1>><<npc Sydney 2>><<person1>>
  <<language>>
    <<option 'EN'>>
      The three of you surface into the air pocket. It is barely high enough to breathe in, and the water sits at your ribs. No light comes down here but the lichen, and its glow is the wrong colour.
      <br><br>
      Sydney presses <<his>> palms flat against the carving instead of writing on it, and says the words from memory. Robin keeps one hand on your shoulder, keeping the two of you above the waterline. You trace the unfinished circle without touching the stone. The old promise pulls tight beneath your ribs.
      <br><br>
      For a moment the water shows a fourth reflection. Chains drag across the floor, though there are no chains to see. A thought presses against your own: give the burden to someone who will never leave. Take all three of them, and make one thing that cannot drown. You need a breath, and the air here will not last much longer.
      <br><br>
      Sydney pulls <<his>> hands away before the last line can close. "It is trying to use you as the knot." Robin shudders, and holds on. "Then hold me instead. Both of you. We came down together, we go up together."
    <<option 'CN'>>
      你们三人从水里浮进那口气穴。顶上矮得几乎立不起身，水面停在胸口。下面没有别的光，只有地衣，而它的光是错的颜色。
      <br><br>
      悉尼没有在浮雕上写字，只是把手掌按上去，凭记忆念出誓词。罗宾一只手按着你的肩，把你们两人托在水面之上。你隔着石面描出未闭合的圆。胸肋深处，原来的承诺忽然收紧。
      <br><br>
      水面一瞬间照出第四道倒影。地上传来锁链拖动声，却看不到锁链。有个念头压上你的思绪，把负担交给一个永远不会离开的人。把三个人一起收下，做成一件淹不掉的器物。你需要呼吸，而这里的气撑不了多久。
      <br><br>
      悉尼在最后一笔闭合前收回手。"它想拿你当那个结。"罗宾打了个寒战，却没有松手。"那就抓住我。你们两个都抓住我。我们一起下来，就一起上去。"
  <</language>>
  <br><br>
  <<socialiseicon 'ask'>><<lanLink ['Keep each burden with its owner (0:05)', '各自承担，不替别人献出什么 (0:05)'] 'RobinTemple Secret Exit'>><<run maplebirch.get('RobinTemple').secret.choose('burden')>><<pass 5>><<stress 8>><</lanLink>><<gstress>><br>
  <<socialiseicon 'ask'>><<lanLink ['Offer to carry everything for them', '提议替两人承担一切'] 'RobinTemple Secret Abort'>><</lanLink>><br>
  <<getouticon>><<lanLink ['Stop here', '到此为止'] 'RobinTemple Secret Abort'>><</lanLink>><br>
<<else>>
  <<include 'RobinTemple Secret Abort'>>
<</if>>

:: RobinTemple Secret Exit
<<set $outside to 0>><<set $location to 'lake_ruin'>><<set $bus to 'lake_ruin_prison'>><<set $underwater to 0>><<set $oxygenRecovery to true>><<effects>>
<<if maplebirch.get('RobinTemple').secret.active and $RobinTemple.secret.stage is 'ritual' and $RobinTemple.secret.trial is 'burden'>>
  <<endevent>><<npc Robin 1>><<npc Sydney 2>><<person1>>
  <<language>>
    <<option 'EN'>>
      You take your hand away. Sydney traces three names in the silt below the waterline, yours in the centre, theirs to either side. The shadow reaches for that gap, then recoils as the surface shudders.
      <br><br>
      A pale shape moves in the lightless water of the doorway. Robin does not have the light, and does not reach for it. "It is still there." Sydney does not look away from the carving. "Then nothing we say should promise that we are safe. And say it soon. The air is going."
      <<if $wraith.state isnot ''>>
        <br><br>
        <span class='wraith'>The wraith does not enter. It stops at the threshold and waits, the way something waits when it has all the time in the world.</span> A cold hand of pressure settles on the back of your neck, interested rather than angry. It wants to see what you do with the gift it never gave you.
      <</if>>
      <<if numberOfEarSlime()>>
        <br><br>
        The slime in your ear presses against your thoughts, and for the first time it does not whisper at you. It whispers at <span class='pink'>them</span>, and Robin flinches as though <<he>> heard a voice that was almost yours. You clamp down on it before it can speak in your place.
      <</if>>
      <br><br>
      You can promise to keep coming back to each of them. You cannot promise that none of you will ever change. <span class='red'>Closing the circle would turn the way out into a restraint, and the three of you cannot stay here to argue with it.</span>
    <<option 'CN'>>
      你收回手。悉尼在水面以下的淤泥里画出三个名字：你在正中，他们各在一侧。影子探向那道空隙，又随着水面晃动缩回去。
      <br><br>
      没有光的入口水里有团苍白在动。罗宾手里没有灯，也没有去够它。"它还在。"悉尼没有从浮雕上移开视线。"那就不能在誓言里写我们已经安全。而且快点说。空气要没了。"
      <<if $wraith.state isnot ''>>
        <br><br>
        <span class='wraith'>幽灵没有进来。它停在门槛外等着，用一种拥有全部时间的东西才有的耐心。</span>一股冰凉的压迫感落在你后颈，更像是好奇，而不是愤怒。它想看看你会拿那份它从没给过你的馈赠做什么。
      <</if>>
      <<if numberOfEarSlime()>>
        <br><br>
        耳中的史莱姆顶着你的思绪，而这一次它没有对你低语。它对着<span class='pink'>他们</span>低语，罗宾猛地一颤，像是听见了一个几乎是你自己的声音。你及时把它压下去，没让它替你开口。
      <</if>>
      <br><br>
      你可以承诺继续回到他们每个人身边，不能承诺谁永远不会改变。<span class='red'>把圆封死，会让出口变成束缚，而你们三个人不能留在这里跟它争。</span>
  <</language>>
  <br><br>
  <<socialiseicon 'ask'>><<lanLink ['Leave the circle open (0:05)', '让圆保持敞开 (0:05)'] 'RobinTemple Secret Vow'>><<run maplebirch.get('RobinTemple').secret.choose('exit')>><<pass 5>><<stress 8>><</lanLink>><<gstress>><br>
  <<socialiseicon 'ask'>><<lanLink ['Seal the circle against abandonment', '封住圆，保证无人离开'] 'RobinTemple Secret Abort'>><</lanLink>><br>
  <<getouticon>><<lanLink ['Stop and leave together', '停止，一起离开'] 'RobinTemple Secret Abort'>><</lanLink>><br>
<<else>>
  <<include 'RobinTemple Secret Abort'>>
<</if>>

:: RobinTemple Secret Vow
<<set $outside to 0>><<set $location to 'lake_ruin'>><<set $bus to 'lake_ruin_prison'>><<set $underwater to 0>><<set $oxygenRecovery to true>><<effects>>
<<if maplebirch.get('RobinTemple').secret.active and $RobinTemple.secret.stage is 'ritual' and $RobinTemple.secret.trial is 'exit'>>
  <<endevent>><<npc Robin 1>><<npc Sydney 2>><<person1>>
  <<language>>
    <<option 'EN'>>
      Water runs off all three of you. The lichen paints your skin purple. Robin takes one of your hands and Sydney takes the other, and neither of them reaches past you.
      <br><br>
      "Say it slowly," Sydney says to you. "I want to hear you mean it. And say it while we can still breathe." Robin nods at <<his>> side, <<his>> chest rising fast. "And it isn’t permission to decide for us. I’m promising you. Not to anyone else."
      <br><br>
      Each of you says the words to you, and you answer each of them. No one repeats after anyone. The first promise does not vanish. Another pressure settles alongside it, cold and unfamiliar, and the three lines on the stone answer it with a low sound like a held breath.
      <<if $kylar_manor_secret gte 2>>
        <br><br>
        You know exactly what you are borrowing. The same shape the order used on the Elk and the Fox. You are using it for the opposite of its purpose, and the stone does not care either way.
      <</if>>
      <<if numberOfEarSlime()>>
        <br><br>
        The slime in your ear has been quiet since you entered the water. Now it stirs, and something that is almost a word presses into the base of your skull. It has been listening. It knows a new door has opened.
      <</if>>
      <br><br>
      The surface shivers between the three of you, and the rite is finished. No one has taken anything, and no one has been taken. <span class='red'>This is the last chance to withdraw before the second bond forms. The air will not wait for you to decide.</span>
    <<option 'CN'>>
      水从三个人身上淌下来。地衣把你们的皮肤染成紫色。罗宾握住你的一只手，悉尼深深呼吸，才握住另一只。两人都没有越过你去碰对方。
      <br><br>
      "说慢一点。"悉尼是对你说的，"我想听出你是认真的。趁我们还能呼吸。"罗宾在另一边点头，胸口起伏得很快。"也不意味着你能替我们决定。我承诺的是你，不是别人。"
      <br><br>
      两人各自对你立誓，你分别回答他们。没有谁跟着谁重复。第一份承诺没有消失，另一股陌生而冰冷的压力落到它旁边，石上三条线随之发出一声低响，像屏住的一口气。
      <<if $kylar_manor_secret gte 2>>
        <br><br>
        你清楚自己在借用什么。修会对高麋和狐用过同样的形状。你把它反过来用，石头并不在乎。
      <</if>>
      <<if numberOfEarSlime()>>
        <br><br>
        从下水起就安静下来的耳中史莱姆动了。一个几乎算得上词的念头压进你的后脑。它一直在听。它知道有一扇新的门开了。
      <</if>>
      <br><br>
      你们三人之间的水面颤了一下，仪式到此结束。没有人献出什么，也没有人被献出去。<span class='red'>第二条纽带形成之前，这是最后一次撤回的机会。空气不会等你决定。</span>
  <</language>>
  <br><br>
  <<loveicon 'hug'>><<lanLink ['Finish the rite, and surface', '完成仪式，浮上水面'] 'RobinTemple Secret Sex'>><<set _secretDone to maplebirch.get('RobinTemple').secret.finish()>><<if _secretDone>><<set $sexstart to 1>><<world_corruption 'hard' 2>><</if>><</lanLink>><br>
  <<getouticon>><<lanLink ['Withdraw together', '一起撤回'] 'RobinTemple Secret Abort'>><</lanLink>><br>
<<else>>
  <<include 'RobinTemple Secret Abort'>>
<</if>>

:: RobinTemple Secret Sex
<<set $outside to 0>><<set $location to 'lake_ruin'>><<set $bus to 'lake_ruin_prison'>><<effects>>
<<run statusCheck('Robin')>>
<<run statusCheck('Sydney')>>
<<if $sexstart is 1>>
  <<set $sexstart to 0>>
  <<endevent>>
  <<set $RobinTemple.secret.rite_active to true>>
  <<set $RobinTemple.secret.rite_done to true>>
  <<clearnpc>><<npc Robin 1>><<npc Sydney 2>><<person1>>
  <<consensual>><<set $consensual to 1>><<neutral 1>>
  <<set $underwater to 0>><<set $oxygenRecovery to true>>
  <<set $enemyno to 2>><<set $enemynomax to 2>>
  <<maninit>><<npcexpose>>
  <<set $enemytrust += 800>>
  <<set $enemyarousalmax to 1200>>
  <<language>>
    <<option 'EN'>>
      The air pocket is shallow and stale, and the three of you stand in it with the water at your ribs. The lichen is the only light, and it is not enough to hide anything. Whatever happens now, you are all naked, and none of you can pretend otherwise.
    <<option 'CN'>>
      气穴又矮又闷，你们三人站在里面，水停在胸口。唯一的光是地衣，而那点光藏不住任何东西。接下来发生什么，你们三个都赤裸着，谁也无法假装不是。
  <</language>>
  <br><br>
  <<if C.npc.Robin.trauma gte 40>>
    <<language>>
      <<option 'EN'>>
        Robin is shaking, and <<his>> hand finds yours under the water rather than holding anything. "If I close my eyes, it doesn’t mean stop," <<he>> says, and then, quieter, "it doesn’t mean keep going either."
        <br><br>
        Sydney stays where <<he>> is, on your other side, close enough to be touched and no closer. "Then we go at your pace," <<he>> says. "Both of yours. I can wait."
      <<option 'CN'>>
        罗宾在发抖，<<his>>的手在水下找到你的手，而不是握着别的东西。"我闭上眼睛不代表停，"<<he>>说，顿了顿又压低声音，"也不代表继续。"
        <br><br>
        悉尼留在你另一侧，近到伸手就能碰到，却没有再靠近。"那就按你们的节奏来，"<<he>>说，"你们两个人的节奏。我可以等。"
    <</language>>
  <<elseif C.npc.Robin.dom gte 70>>
    <<language>>
      <<option 'EN'>>
        Robin turns to you. "I’m not choosing between you," <<he>> says. "I’m asking you to keep me." <<He>> takes your hand and presses it flat against <<his>> own chest.
        <br><br>
        Sydney watches the two of you, and when <<he>> speaks it is only to you. "You started this. Tell us what you want, and I will do it."
      <<option 'CN'>>
        罗宾转向你。"我不是要在你们之间选，"<<he>>说，"我是在求你留下我。"<<He>>握住你的手，按在<<his>>自己胸口上。
        <br><br>
        悉尼看着你们两人，开口时只对着你。"是你把这件事开始的。告诉我们你想要什么，我照做。"
    <</language>>
  <<else>>
    <<language>>
      <<option 'EN'>>
        Robin’s face is red in the purple light, but <<he>> does not look away from you. "I want this," <<he>> says. "I want you. I want..." <<He>> loses the sentence, but does not step back.
        <br><br>
        "You don’t have to say it," Sydney says, to Robin, and then to you, "and neither do I. I already decided before we came down here."
      <<option 'CN'>>
        罗宾的脸在紫光里烧得通红，却没有从你身上移开视线。"我想要这个，"<<he>>说，"我想要你。我想……"<<He>>话没说完，但没有退。
        <br><br>
        "你不用说出来，"悉尼对罗宾说，然后又转向你，"我也不用。下来之前我就决定好了。"
    <</language>>
  <</if>>
<</if>>
<<if $RobinTemple.secret.rite_active>>
  <<set $enemyanger to -10>>
  <<effects>><<effectsman>><<man>><<stateman>>
  <br><br>
  <<actionsman>>
  <<if _combatend>>
    <span id='next'><<lanLink ['Next', '继续'] 'RobinTemple Secret Sex Finish'>><</lanLink>></span><<nexttext>>
  <<else>>
    <span id='next'><<lanLink ['Next', '继续'] 'RobinTemple Secret Sex'>><</lanLink>></span><<nexttext>>
  <</if>>
<<else>>
  <<getouticon>><<lanLink ['Return to the shore', '回到湖畔'] 'Lake Shore'>><</lanLink>><br>
<</if>>

:: RobinTemple Secret Sex Finish
<<set $outside to 0>><<set $location to 'lake_ruin'>><<set $bus to 'lake_ruin_prison'>><<effects>>
<<if $RobinTemple.secret.rite_active>>
  <<if $enemyarousal gte $enemyarousalmax>>
    <<ejaculation>>
    <<language>>
      <<option 'EN'>>
        Robin is against you, breathing hard, hand closed around yours. "I love you," <<he>> says into your shoulder. "I’m so happy."
        <br>
        Sydney<<person2>> is propped on <<his>> elbows on your other side, watching <<his>> own hands. "I love you too," <<he>> says, quiet and level, as though stating a fact <<he>> has checked twice. "I wanted to say it while I still could."
      <<option 'CN'>>
        罗宾贴着你，喘得厉害，手紧紧攥着你的。<<he>>把脸埋进你肩膀，"我爱你，"<<he>>说，"我好高兴。"
        <br>
        <<person2>>悉尼在你另一侧撑着手肘，盯着自己的手。"我也爱你，"<<he>>说，声音很轻，也很平，像是在陈述一件他核对过两遍的事，"我想趁自己还说得出的时候说出来。"
    <</language>>
    <<npcincr Robin lust -20>><<npcincr Sydney lust -20>>
  <<elseif $enemyhealth lte 0>>
    <<language>>
      <<option 'EN'>>
        <<if $enemyarousal gte ($enemyarousalmax / 5) * 2>>
          Robin lets out a pained moan and covers <<his>> mouth to stifle it. <<He>> looks down in shame. "I... I think that’s enough for me..."
        <<else>>
          "W-wait. Please, that..." Robin clings to you. "Th-that really hurt. I mean, I... I still kind of liked it, but..." <<His>> face flushes, and <<he>> looks away. "C...can we finish this another time?"
        <</if>>
      <<option 'CN'>>
        <<if $enemyarousal gte ($enemyarousalmax / 5) * 2>>
          罗宾漏出一丝痛苦的呻吟，然后迅速用手捂住了自己的嘴巴。<<He>>羞愧地埋下了头，"我……我到这里就好……"
        <<else>>
          "等，等一下！求你，那个……"罗宾紧紧抱着你，"那、那真的有点痛……我的意思是，我还是很喜欢的，但……"<<his>>脸红了，看向一边，"能……能不能下次再做完？"
        <</if>>
    <</language>>
    <<npcincr Robin lust 5>><<npcincr Sydney lust 5>><<gglust 'Robin'>><<gglust 'Sydney'>>
    <br><br>
    <<language>>
      <<option 'EN'>>
        "I love you," <<he>> says. "I’m so happy." <<He>> kisses you on the cheek and reluctantly separates from you.
        <br><br>
        Sydney keeps <<his>> hands to <<himself>> and waits. "We stop here," <<he>> says to you. "That was the agreement."
      <<option 'CN'>>
        "我爱你，"<<he>>说，"我好高兴。"<<He>>在你脸上印下一吻，然后不情愿地退开。
        <br><br>
        悉尼没有伸手去碰<<him>>，只是等着。"我们停在这里，"<<he>>对你说，"这就是约定。"
    <</language>>
  <<else>>
    <<language>>
      <<option 'EN'>>
        <<if $enemyarousal gte ($enemyarousalmax / 5) * 2>>
          "S...stop? But I..." <<he>> stammers off while still clinging to you. "O-okay..."
        <<else>>
          Robin looks at you nervously. "Did I... did I do something wrong?"
        <</if>>
      <<option 'CN'>>
        <<if $enemyarousal gte ($enemyarousalmax / 5) * 2>>
          "不……不做了？可是我……"<<he>>仍紧紧抱着你，话说到一半就断了，"好，好吧……"
        <<else>>
          罗宾紧张地看着你。"我……我做错什么了吗？"
        <</if>>
    <</language>>
    <<npcincr Robin lust 5>><<npcincr Sydney lust 5>><<set maplebirch.get('RobinTemple').faith += 2>><<gglust 'Robin'>><<gglust 'Sydney'>><<gconviction 'Robin'>>
    <br><br>
    <<language>>
      <<option 'EN'>>
        "I love you," <<he>> says. "I’m so happy." <<He>> kisses you on the cheek and reluctantly separates from you.
        <br><br>
        Sydney is already sitting up, tidying <<himself>>. "Neither of us did anything wrong," <<he>> says. "I would like to try again. Not tonight."
      <<option 'CN'>>
        "我爱你，"<<he>>说，"我好高兴。"<<He>>在你脸上印下一吻，然后不情愿地从你身上退开。
        <br><br>
        悉尼已经坐了起来，整理着自己。"我们都没做错什么，"<<he>>说，"我想再试一次。不是今晚。"
    <</language>>
  <</if>>
  <br><br>
  <<language>>
    <<option 'EN'>>
      The three of you surface together, and clamber onto the cold shore. Your folded clothes are where you left them, dry under the covered light. Sydney<<person2>> speaks only once <<he>> is dressed. "We should not have done that," <<he>> says, without any conviction at all. Robin laughs, unsteady. "No. Probably not."
      <br><br>
      Neither of them looks at the other. They look at you. You dress last, and cover the light again. Above you the blood moon has not moved.
    <<option 'CN'>>
      你们三人一起浮出水面，爬上冰凉的岸。叠好的衣服还在原处，在遮光灯下干干净净。悉尼直到穿好衣服才开口。"我们不该这么做。"<<he>>说，语气里没有一点底气。罗宾不太稳地笑了一声。"是啊，大概不该。"
      <br><br>
      两人都没有看对方，只看着你。你最后穿上衣服，重新把灯罩上。头顶的血月没有挪动。
  <</language>>
  <br><br>
  <<wateraction>><<storeon 'blasphemy'>><<clotheson>><<endcombat>>
  <<set $RobinTemple.secret.rite_active to false>>
  <<if $oxygen lt $oxygenmax>><<set $oxygenRecovery to true>><</if>>
<</if>>
<<lanLink ['Next', '继续'] 'RobinTemple Secret Aftermath'>><br>

:: RobinTemple Secret Aftermath
<<set $outside to 1>><<set $location to 'lake'>><<effects>><<lakeeffects>>
<<if $RobinTemple.secret.rite_done and $RobinTemple.dual_promise>>
  <<endevent>><<npc Robin 1>><<npc Sydney 2>><<person1>>
  <<language>>
    <<option 'EN'>>
      You surface together and climb out onto the cold shore. Behind you the drowned shrine settles back into the dark, holding the shape the three of you gave it.
      <br><br>
      On the shore the three of you stand apart, and then not apart. Robin gets there first, before <<he>> has the breath for it. "You came back up with both of us," <<he>> says. "I was so scared you wouldn’t want to." Sydney is a moment behind, and says less. "I do not regret it. I only wanted to say that out loud, while we were still standing here."
      <<if $kylar_manor_secret gte 3>>
        <br><br>
        You know the word the order used for a vessel made of people. Sydney knows it too, and works it around in <<his>> mouth without saying it. You do not say it in front of Robin, and you do not intend to.
      <</if>>
      <br><br>
      <span class='wraith'>You have gained Confounded Vow.</span> Beneath the familiar weight of your promise, you feel another pull. Robin notices you touch your chest. Sydney is doing the same.
      <br><br>
      Nothing is free. You gave the old rite somewhere to live again, and the lake noticed.
      <br><br>
      <<set $wraith.timer += 5>><<npcincr "Ivory Wraith" lust 3>>
      <<if numberOfEarSlime()>><<set $earSlime.growth += 20>>
        The slime in your ear has not stopped humming since you came up. A thought arrives in your own voice, and it is almost reasonable: <span class='pink'>bring them here again.</span> You did not put that there. <<gtrauma>><<trauma 4>><<gstress>><<stress 8>>
        <br><br>
      <</if>>
      <<set $awareness += 12>><<ggawareness>>
      You will carry what happened down there for the rest of your life. So will they.
      <br><br>
      The next blood moon will still come. You keep the route notes and the written right to withdraw, rather than throwing them away as proof of faith.
    <<option 'CN'>>
      你们一起浮出水面，爬上冰凉的岸。身后那座被淹没的神龛沉回黑暗，保留着你们三人给它的形状。
      <br><br>
      到了岸边，你们三人先站开，又站回一处。罗宾先开口，气还没喘匀。"你把我们两个都带回来了，"<<he>>说，"我一直在怕你会不想。"悉尼慢了一步，说得也少。"我不后悔。我只是想趁还站在这儿的时候，把这句话说出来。"
      <<if $kylar_manor_secret gte 3>>
        <br><br>
        你知道修会把用人做成的容器叫什么。悉尼也知道，<<he>>把那个词在嘴里过了一遍，没有说出来。你没有当着罗宾的面说，也不打算说。
      <</if>>
      <br><br>
      <span class='wraith'>你获得了混乱誓约。</span>原本熟悉的誓约重量下面，多了一股牵引。罗宾看见你按住胸口，悉尼也正做着同样的动作。
      <br><br>
      没有什么是免费的。你让那个旧仪式重新有了寄身之处，而湖记住了。
      <br><br>
      <<set $wraith.timer += 5>><<npcincr "Ivory Wraith" lust 3>>
      <<if numberOfEarSlime()>><<set $earSlime.growth += 20>>
        从水里上来之后，你耳中的史莱姆就没停过嗡鸣。一个用你自己的声音说出的念头浮上来，而且听起来几乎很讲道理：<span class='pink'>再带他们下来一次。</span>那不是你放进去的。<<gtrauma>><<trauma 4>><<gstress>><<stress 8>>
        <br><br>
      <</if>>
      <<set $awareness += 12>><<ggawareness>>
      你会带着湖底发生的事过完余生。他们也是。
      <br><br>
      下一轮血月仍会到来。你留着路线笔记和写下的退出约定，没有把它们当成证明信仰的东西扔掉。
  <</language>>
  <br><br>
  <<getouticon>><<lanLink ['Return to shore together (0:10)', '一起返回湖畔 (0:10)'] 'Lake Shore'>><<pass 10>><<endevent>><</lanLink>><br>
<<else>>
  <<getouticon>><<lanLink ['Leave the shore', '离开湖畔'] 'Lake Shore'>><<endevent>><</lanLink>><br>
<</if>>

:: RobinTemple Secret Abort
<<set $outside to 0>><<set $location to 'lake'>><<effects>><<lakeeffects>>
<<run maplebirch.get('RobinTemple').secret.abort()>>
<<set $RobinTemple.secret.rite_active to false>>
<<if $underwater or $worn.upper.name is 'naked' or $worn.lower.name is 'naked'>>
  <<set $underwater to 0>><<set $oxygenRecovery to true>>
  <<storeon 'blasphemy'>><<clotheson>>
<</if>>
<<endevent>><<npc Robin 1>><<npc Sydney 2>><<person1>>
<<language>>
  <<option 'EN'>>
    Robin lets go of the carving before you finish the words. "Not this way," <<he>> says, and starts back towards the light. "All three leave," Sydney says. "That was the agreement." No second promise has formed.
    <br><br>
    <span class='teal'>Your investigation survives. Speak to each companion again before another attempt, and leave time to reconsider.</span>
  <<option 'CN'>>
    罗宾没让你把话念完，先从浮雕上收回了手。"不能是这样，"<<he>>说，转身朝灯光的方向去。"三个人一起走，"悉尼说，"这是约定。"第二份承诺没有形成。
    <br><br>
    <span class='teal'>调查仍然保留。再次尝试前，需要重新分别谈妥，留出考虑的时间。</span>
<</language>>
<br><br>
<<if maplebirch.get('RobinTemple').secret.threatened>>
  <<language>>
    <<option 'EN'>>
      <span class='red'>You cannot bring them farther into the pursuit.</span> Robin and Sydney take the marked path towards the road while you turn back towards the presence following you.
    <<option 'CN'>>
      <span class='red'>你不能把两人再带进追猎深处。</span>罗宾和悉尼沿标好的路退向道路，你转身面对尾随的存在。
  <</language>>
  <br><br>
  <<if !$possessed and $wraith.state and npcCanHunt('Ivory Wraith')>>
    <<set $outside to 1>><<set $location to 'lake'>><<set $bus to 'lakeshore'>>
    <<if $wraith.hunt gt 0>><<destinationlake>><<else>><<wHunt 'lake'>><</if>>
  <<else>>
    <<getouticon>><<lanLink ['Return to shore', '回到湖畔'] 'Lake Shore'>><<endevent>><</lanLink>><br>
  <</if>>
<<else>>
  <<getouticon>><<lanLink ['Return to shore together (0:10)', '一起回到湖畔 (0:10)'] 'Lake Shore'>><<pass 10>><<endevent>><</lanLink>><br>
<</if>>
