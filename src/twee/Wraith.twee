:: Revelation Wraith Widgets [widget]
<!-- 原版后代与愤怒冷却是怨恨的唯一事实来源；不另存模组愤怒状态。 -->
<<widget 'revelation-wraith-grievance-check'>>
  <<set _wraithVisitAngry to ['dead', 'sold'].includes($wraith?.offspring) or $wraithAngerCooldown gt 0>>
<</widget>>

<<widget 'ivory-necklace-check'>>
  <<silently>>
    <<set _ivorySafe to Boolean(maplebirch.get('RBR')) and Boolean($RBR?.necklace)
      and !$combat and !$possessed and !$replayScene and !$statFreeze
      and !$nextPassage and !$nextPassageCheck and !$eventforced
      and $stress lt $stressmax and !isPregnancyEnding()>>
    <<set _ivoryHeld to $museumAntiques?.antiques?.antiqueivorynecklace is 'found'
      and $necklaceThief is 'player' and $antiquemoney gte 2000>>
    <<set _ivoryReady to _ivorySafe and _ivoryHeld and !$RBR.necklace.returned
      and $location is 'lake_ruin' and !Time.isBloodMoon()
      and $oxygen gt 0 and !pcAreArmsBound('both')
      and ['Lake Ruin Plinth', 'Revelation Ivory Necklace Return'].includes($passage)>>
  <</silently>>
<</widget>>

<<widget 'ivory-necklace-link'>>
  <<ivory-necklace-check>>
  <<if _ivorySafe and $RBR.necklace.returned and _leave>>
    <span class='red'><<lanSwitch 'The necklace is still on the plinth. Taking it again will bring back the wraith’s full obsession.' '项链仍在基座上。再次拿走它，会重新招来怨灵满额的痴迷。'>></span><br>
  <<elseif _ivoryReady and _leave>>
    <<icon 'clothes/ivory-necklace.png'>>
    <<lanLink ['Examine the plinth with the ivory necklace in hand', '拿着象牙项链，查看基座'] 'Revelation Ivory Necklace Return'>><</lanLink>>
    <br>
  <</if>>
<</widget>>

<<widget 'wraith-necklace-taken'>>
  <<if $RBR?.necklace and ($RBR.necklace.returned or $necklaceThief is 'diver') and !$replayScene and !$statFreeze>>
    <<set $RBR.necklace.returned to false>>
    <!-- 由原版刚写入的盗取者区分PC与潜水队；潜水队不增加PC再取历史。 -->
    <<if $necklaceThief is 'player'>>
      <<set $RBR.necklace.retaken to ($RBR.necklace.retaken ?? 0) + 1>>
      <!-- 不替未登场的怨灵初始化；痴迷20仍由原版取物页结算。 -->
      <<if C.npc['Ivory Wraith']?.init is 1>><<checkWraith>><</if>>
    <</if>>
  <</if>>
<</widget>>

<<widget 'revelation-wraith-visit-check'>>
  <<ivory-necklace-check>>
  <<revelation-wraith-grievance-check>>
  <<set _wraithVisitHere to _ivorySafe and $RBR.necklace.returned
    and $location is 'lake' and $outside is 1 and $bus is 'lakeshore'
    and ['Lake Shore', 'Revelation Wraith Shore'].includes($passage)
    and $wraith?.state is 'active' and C.npc['Ivory Wraith']?.init is 1
    and !Time.isBloodMoon() and !$wraith.hunt and !$foresthunt
    and !(Time.hour gte 15 and $halloween is 1 and Time.monthDay is 31 and $halloween_lake is 1)
    and !($town_projects.diving is 1 or $town_projects.diving is 3)>>
  <<set _wraithVisitReady to _wraithVisitHere and !_wraithVisitAngry
    and C.npc['Ivory Wraith'].lust gte 1
    and Math.floor(Time.days) gte ($RBR.wraithVisitDay ?? -1) + 3>>
<</widget>>

<<widget 'revelation-wraith-visit-link'>>
  <<revelation-wraith-visit-check>>
  <<if _wraithVisitHere and _wraithVisitAngry>>
    <span class='red'><<lanSwitch 'The necklace is back where it belongs, but you remember what happened to the pale creatures. There is more between you than the theft.' '项链已经归还，但你仍记得那些苍白生灵的遭遇。你与怨灵之间，尚有其他旧账。'>></span><br>
  <<elseif _wraithVisitReady>>
    <<lakeicon>>
    <<lanLink ['Sit by the lake and wait', '在湖边坐下，等一会儿'] 'Revelation Wraith Shore'>><</lanLink>><br>
  <</if>>
<</widget>>

<<widget 'ivory-necklace-gwylan-link'>>
  <<ivory-necklace-check>>
  <<if _ivorySafe and $location is 'forest_shop' and _gwylanLocation is 'shop'
      and C.npc.Gwylan.init is 1 and $necklaceThief is 'player'
      and ((!$RBR.necklace.returned and !$RBR.necklace.advised)
      or ($RBR.necklace.returned and !$RBR.necklace.followedUp))>>
    <<socialiseicon 'ask'>>
    <<lanLink `[$RBR.necklace.returned ? 'Tell Gwylan you returned the necklace (0:10)' : 'Ask Gwylan about returning the ivory necklace (0:10)', $RBR.necklace.returned ? '告诉格威岚，你归还了项链 (0:10)' : '询问格威岚，能否归还象牙项链 (0:10)']`>>
      <<ivory-necklace-check>>
      <<if _ivorySafe and $location is 'forest_shop' and _gwylanLocation is 'shop'>>
        <<set _ivoryFollowup to $RBR.necklace.returned>>
        <<if (!_ivoryFollowup and !$RBR.necklace.advised) or (_ivoryFollowup and !$RBR.necklace.followedUp)>>
          <<set _ivorySource to $passage>>
          <<pass 10>>
          <<ivory-necklace-check>>
          <<if _ivorySafe and $passage is _ivorySource and $location is 'forest_shop' and gwylanSchedule() is 'shop'>>
            <<if _ivoryFollowup>><<set $RBR.necklace.followedUp to true>><<else>><<set $RBR.necklace.advised to true>><</if>>
            <<goto 'Revelation Ivory Necklace Gwylan'>>
          <<elseif $passage is _ivorySource and !$nextPassage and !$nextPassageCheck and $location is 'forest_shop'>>
            <<goto 'Forest Shop'>>
          <</if>>
        <</if>>
      <</if>>
    <</lanLink>>
    <br>
  <</if>>
<</widget>>

<<widget 'ivory-necklace-quinn-empty'>>
  <<language>>
    <<option 'EN'>>
      The reinforced case beside the desk is empty. A camera in the corner slowly sweeps back and forth across the room.
    <<option 'CN'>>
      桌旁的加固展示盒空着。角落里的摄像头缓缓转动，来回扫视着房间。
  <</language>>
  <br><br>
<</widget>>

<<widget 'ivory-necklace-journal'>>
  <<if maplebirch.get('RBR') and $RBR?.necklace and ($necklaceThief is 'player' or $RBR.necklace.returnedOnce or $RBR.necklace.returned)>>
    <<revelation-card 'The ivory necklace' '象牙项链'>>
      <ul class='journal'>
        <<if $RBR.necklace.returned>>
          <li><<lanSwitch 'You put the necklace back on the plinth beneath the lake. It remains there, outside the antiques you can sell.' '你把项链放回了湖底的基座。它仍在那里，已经不计入待出售的古董。'>></li>
          <li><<lanSwitch 'You may take it again. Doing so restores the wraith’s full obsession; putting it back again only eases that obsession a little.' '仍然可以再次拿走它。这样会重新招来怨灵满额的痴迷；之后再放回，只能稍微缓和痴迷。'>></li>
          <li><<lanSwitch 'The loss of the necklace no longer keeps the wraith obsessed with you. Other grudges and pursuits remain.' '失去项链的执念不再使怨灵紧盯着你。其他怨恨与追逐仍然存在。'>></li>
          <li><<lanSwitch 'After three days, you may spend a quiet quarter-hour on the lake shore. Further visits must be at least three days apart. A pursuit or a grievance over its offspring prevents this.' '三天后，可以到湖岸安静地待上一刻钟；之后每次至少间隔三天。追逐尚未结束，或怨灵仍因苍白后代的遭遇而怀恨时，无法以这种方式接近它。'>></li>
          <<if !$RBR.necklace.followedUp>><li><<lanSwitch 'You can tell Gwylan what happened during a normal visit to the forest shop.' '下次去森林商店时，可以告诉格威岚发生了什么。'>></li><</if>>
        <<elseif $museumAntiques?.antiques?.antiqueivorynecklace is 'found'>>
          <li><<lanSwitch 'You still have the ivory necklace. Return to the plinth beneath the lake to examine where you found it.' '象牙项链仍在你手里。可以回到湖底的基座旁，查看取走它的地方。'>></li>
          <li><<lanSwitch 'Return it outside a blood moon, while you can still act and have air left. You may ask Gwylan for advice first.' '避开血月，在仍能行动、还有空气时归还。也可以先请教格威岚。'>></li>
          <<if $RBR.necklace.retaken gt 0>><li class='red'><<lanSwitch 'You took it again after putting it back. Repeated returns do not earn the relief of the first return.' '你把已经放回的项链又拿走了。再次归还，不会再有初次归还时的宽慰。'>></li><</if>>
        <<else>>
          <li><<lanSwitch 'You no longer have the necklace. A necklace already handed to the museum or Quinn cannot be returned at the plinth.' '项链已经不在你手里。交给博物馆或奎恩的项链，无法再带到基座旁归还。'>></li>
          <li><<lanSwitch 'Winter can tell you where the museum sent it: the mayor’s office.' '可以向温特打听项链的去向：博物馆已将它送往市长办公室。'>></li>
        <</if>>
      </ul>
    <</revelation-card>>
    <hr>
  <</if>>
<</widget>>

:: Revelation Ivory Necklace Return
<<set $outside to 0>><<set $location to 'lake_ruin'>><<underwater>><<effects>>
<<if $passage isnot 'Revelation Ivory Necklace Return'>><<exit>><</if>>
<<lakeeffects>>
<<if $passage isnot 'Revelation Ivory Necklace Return'>><<exit>><</if>>
<<if $nextPassageCheck or $nextPassage>>
  <<getouticon>><<lanLink ['Continue', '继续'] `$nextPassageCheck || $nextPassage`>><</lanLink>><br>
  <<exit>>
<</if>>
<<ivory-necklace-check>>
<<if !_ivoryReady>>
  <<lanSwitch 'You cannot set the necklace down here now. It would be best to leave.' '你现在无法在这里放下项链，最好先离开。'>>
  <br><br>
  <<swimicon 'back'>><<lanLink ['Leave', '离开'] 'Lake Ruin Deep'>><<set $phase to 0>><</lanLink>><br>
  <<exit>>
<</if>>
<<language>>
  <<option 'EN'>>
    You hold the necklace above the bare plinth. The blue gemstones catch what little light reaches the room. The chain shifts between your fingers, heavy despite the water.
    <br><br>
    It was here when you found it. You could put it back. You curl your fingers around it once, then loosen your grip.
    <br><br>
    <span class='gold'>Giving it back means giving up the necklace and the £2,000 the museum would pay for it.</span> It will not settle every grievance the pale figure has against you.
  <<option 'CN'>>
    你将项链托在空着的基座上方。房间里仅有的一点光落进蓝色宝石中。链子从指间滑动，即使浸在水里，仍有些沉。
    <br><br>
    你就是在这里找到它的。现在，你可以把它放回去。你收紧手指握了一下，又慢慢松开。
    <br><br>
    <span class='gold'>归还后，你会失去项链，也放弃博物馆愿意为它支付的 £2,000。</span>这不能一笔勾销那苍白身影对你的所有怨恨。
<</language>>
<br><br>
<<if $RBR.necklace.returnedOnce>>
  <span class='lblue'><<lanSwitch 'You have put it back before. Without other grievances, doing so again only eases the wraith’s obsession by one point. Grievances over its offspring remain.' '你已经放回过一次。若没有其他怨恨，这次再放回只会使怨灵的痴迷稍缓 1 点；对苍白后代的怨恨仍然保留。'>></span><br><br>
<</if>>
<<icon 'clothes/ivory-necklace.png'>>
<<lanLink ['Set the necklace on the plinth and let go', '将项链放在基座上，松开手']>>
  <<ivory-necklace-check>>
  <<if _ivoryReady>>
    <<set _ivorySource to $passage>>
    <<set _ivoryFirstReturn to !$RBR.necklace.returnedOnce>>
    <!-- 先交还实物、扣除待售账目，再走原版水下行动；时间钩子重入也不会重复结算。 -->
    <<set $RBR.necklace.returned to true>>
    <<set $RBR.necklace.returnedOnce to true>>
    <<set $RBR.wraithVisitDay to Math.floor(Time.days)>>
    <<museumAntiqueStatus 'antiqueivorynecklace' 'notFound'>>
    <<set $antiquemoney -= 2000>>
    <<if ['haunt', 'despair'].includes($wraith?.state)>><<set $wraith.state to 'active'>><</if>>
    <<revelation-wraith-grievance-check>>
    <<if C.npc['Ivory Wraith']?.init is 1 and !_wraithVisitAngry>>
      <<set C.npc['Ivory Wraith'].lust to Math.max(0, C.npc['Ivory Wraith'].lust - (_ivoryFirstReturn ? 10 : 1))>>
    <</if>>
    <<wateraction>>
    <<if $passage is _ivorySource and !$combat>>
      <<goto 'Revelation Ivory Necklace Returned'>>
    <</if>>
  <</if>>
<</lanLink>><<loxygen>><br>
<<swimicon 'back'>><<lanLink ['Keep the necklace and leave', '收好项链，离开'] 'Lake Ruin Deep'>><<set $phase to 0>><</lanLink>><br>

:: Revelation Ivory Necklace Returned
<<set $outside to 0>><<set $location to 'lake_ruin'>><<underwater>><<effects>>
<<if $passage isnot 'Revelation Ivory Necklace Returned'>><<exit>><</if>>
<<lakeeffects>>
<<if $passage isnot 'Revelation Ivory Necklace Returned'>><<exit>><</if>>
<<if $nextPassageCheck or $nextPassage>>
  <<getouticon>><<lanLink ['Continue', '继续'] `$nextPassageCheck || $nextPassage`>><</lanLink>><br>
  <<exit>>
<</if>>
<<if !$RBR?.necklace?.returned>>
  <<swimicon 'back'>><<lanLink ['Leave', '离开'] 'Lake Ruin Deep'>><</lanLink>><br>
  <<exit>>
<</if>>
<<language>>
  <<option 'EN'>>
    The necklace settles on the stone. You take your hands away.
    <br><br>
    A pale hand rests over it. You never saw anyone approach. For a moment, a face hangs beyond the plinth, its eyes fixed on the chain. The fingers close around it, then slowly withdraw.
    <br><br>
    When you blink, the figure is gone. The necklace remains on the stone, its blue gemstones barely visible in the dark.
    <br><br>
    You look down at your empty hands. <<if $RBR.necklace.retaken gt 0>>You have done this before. You leave the necklace where it is, and turn towards the doorway.<<else>>Your fingertips are cold, but the tight feeling at the back of your head eases a little. You turn towards the doorway before your breath runs out.<</if>>
  <<option 'CN'>>
    项链落在石面上。你把双手移开。
    <br><br>
    一只苍白的手搭在它上方。你没有看见有谁游过来。一张脸悬在基座后方，双眼紧盯着链子。那几根手指握住它，又慢慢收了回去。
    <br><br>
    你眨了一下眼，那身影已经不见了。项链仍留在石面上，蓝色宝石在黑暗中隐约可见。
    <br><br>
    你低头看着空空的双手。<<if $RBR.necklace.retaken gt 0>>同样的事，你已经做过一次了。你把项链留在原处，转向门口。<<else>>指尖还有些发冷，脑后那股紧绷的感觉却松了一些。你在憋不住气之前转向门口。<</if>>
<</language>>
<br><br>
<<revelation-wraith-grievance-check>>
<<if _wraithVisitAngry>>
  <<language>>
    <<option 'EN'>>
      Its stare stays with you after it vanishes. Your stomach tightens. You remember the pale creatures, and know that the necklace cannot answer for what happened to them.
    <<option 'CN'>>
      那双紧盯着你的眼睛，仍清晰地留在记忆里。你胃里一紧，想起了那些苍白的生灵。它们的遭遇，不能用一条项链来交代。
  <</language>>
  <br><br>
<</if>>
<<swimicon 'back'>><<lanLink ['Leave', '离开'] 'Lake Ruin Deep'>><<set $phase to 0>><</lanLink>><br>

:: Revelation Ivory Necklace Gwylan
<<set $outside to 0>><<set $location to 'forest_shop'>><<effects>>
<<if $passage isnot 'Revelation Ivory Necklace Gwylan'>><<exit>><</if>>
<<if $nextPassageCheck or $nextPassage>>
  <<getouticon>><<lanLink ['Continue', '继续'] `$nextPassageCheck || $nextPassage`>><</lanLink>><br>
  <<exit>>
<</if>>
<<npc Gwylan>><<person1>>
<<if !maplebirch.get('RBR') or !$RBR?.necklace>>
  <<getouticon>><<lanLink ['Return to the shop', '返回商店'] 'Forest Shop'>><</lanLink>><br>
  <<exit>>
<</if>>
<<if $RBR.necklace.returned>>
  <<language>>
    <<option 'EN'>>
      Gwylan listens without interrupting. When you describe the hand reaching out of the darkness, <<he>> stops turning the ring on <<his>> finger.
      <br><br>
      "Then leave it there," <<he>> says. "Don't go looking for thanks. If that was what it wanted from you, you've given it back."
      <br><br>
      You ask whether it will leave you alone now. Gwylan looks at you for a moment. "I didn't say that." <<He>> lets go of the ring. "Go home. Eat something. You look cold."
    <<option 'CN'>>
      格威岚没有打断你。听见你说有只手从黑暗中伸出来，<<he>>停下了转动指上戒指的动作。
      <br><br>
      “那就把它留在那里，”<<he>>说，“别再回去讨一句感谢。如果它向你要的就是这个，你已经还了。”
      <br><br>
      你问那身影现在会不会放过你。格威岚看了你一会儿。“我可没这么说。”<<He>>松开戒指。“回去吧。吃点东西。你看起来冷得很。”
  <</language>>
<<else>>
  <<language>>
    <<option 'EN'>>
      "You want to give it back?" Gwylan rests <<his>> hands on the counter. "Then start where you found it. Put it down, and be ready to leave."
      <br><br>
      "Away from the red moon," <<he>> adds. "And don't bargain with it. You aren't buying a promise."
      <br><br>
      <<if $museumAntiques?.antiques?.antiqueivorynecklace is 'found'>>
        You feel the weight of the necklace among your belongings. It is still your choice whether to take it back beneath the lake.
      <<else>>
        You tell <<him>> the necklace is no longer in your possession. Gwylan sighs. "I can't give you something I don't have." <<He>> takes <<his>> hands off the counter. "You can't put it back if you haven't got it."
      <</if>>
    <<option 'CN'>>
      “你想把它还回去？”格威岚将双手搭在柜台上。“先回到你找到它的地方。放下它，也做好离开的准备。”
      <br><br>
      “避开红月，”<<he>>又说，“别拿它谈条件。还一样东西，换不来一个承诺。”
      <br><br>
      <<if $museumAntiques?.antiques?.antiqueivorynecklace is 'found'>>
        你感觉到随身物品里那条项链的分量。要不要带它回到湖底，仍由你决定。
      <<else>>
        你告诉<<him>>，项链已经不在你手里。格威岚叹了口气。“我手里没有，也拿不出来给你。”<<He>>将双手从柜台上移开。“东西不在手里，还怎么放回去？”
      <</if>>
  <</language>>
<</if>>
<br><br>
<<getouticon>><<lanLink ['Return to the shop', '返回商店'] 'Forest Shop'>><</lanLink>><br>

:: Revelation Wraith Shore
<<set $outside to 1>><<set $location to 'lake'>><<set $bus to 'lakeshore'>><<effects>>
<<if $passage isnot 'Revelation Wraith Shore'>><<exit>><</if>>
<<lakeeffects>>
<<if $passage isnot 'Revelation Wraith Shore'>><<exit>><</if>>
<<if $nextPassageCheck or $nextPassage>>
  <<getouticon>><<lanLink ['Continue', '继续'] `$nextPassageCheck || $nextPassage`>><</lanLink>><br>
  <<exit>>
<</if>>
<<revelation-wraith-visit-check>>
<<if !_wraithVisitReady>>
  <<lanSwitch 'You cannot find a quiet moment here now.' '现在还不是在这里静坐的时候。'>><br><br>
  <<getouticon>><<lanLink ['Return to the shore', '回到湖岸'] 'Lake Shore'>><</lanLink>><br>
  <<exit>>
<</if>>
<div id='revelation-wraith-visit'>
  <<language>>
    <<option 'EN'>>
      You find a dry place to sit, well back from the water. You remember the pale hand resting over the blue gemstones before leaving the necklace on the plinth. Nothing tells you whether the figure remembers you any differently.
      <br><br>
      You could stay a while, without going into the lake or calling anything closer.
    <<option 'CN'>>
      你找了块干燥的地方坐下，与水边隔着一段距离。你记得那只苍白的手曾搭在蓝色宝石上方，又将项链留在基座上。你不知道，那身影如今会怎样看待你。
      <br><br>
      你可以在这里待一会儿。不下水，也不招呼什么东西靠近。
  <</language>>
  <br><br>
  <<lakeicon>>
  <<lanLink ['Stay quietly for a quarter-hour (0:15)', '安静地坐上一刻钟 (0:15)']>>
    <<revelation-wraith-visit-check>>
    <<if _wraithVisitReady>>
      <<set _wraithVisitSource to $passage>>
      <<pass 15>>
      <<if $passage is _wraithVisitSource>>
        <<lakeeffects>>
        <<if $passage isnot _wraithVisitSource>><<exit>><</if>>
        <<revelation-wraith-visit-check>>
        <<replace '#revelation-wraith-visit'>>
          <<if _wraithVisitReady>>
            <<set $RBR.wraithVisitDay to Math.floor(Time.days)>>
            <<language>>
              <<option 'EN'>>
                <<if C.npc['Ivory Wraith'].lust gte 10>>
                  A pale shape stands near the water. You did not see it arrive. Its hands are clenched, and its eyes stay on you. You keep your hands on your knees. After a while, its fingers loosen.
                <<else>>
                  Something pale moves at the edge of your vision. You turn your head. The figure stands by the water, its pale clothes briefly catching the light. It looks from your empty hands to your face, and stays where it is.
                <</if>>
                <br><br>
                <<if $wraithPrison?.vision>>You remember the loss you felt in its dream. You leave that memory unspoken. <</if>>Neither of you comes any closer. When you look up again, the figure has gone. You let out the breath you were holding, and stand.
              <<option 'CN'>>
                <<if C.npc['Ivory Wraith'].lust gte 10>>
                  一道苍白的身影站在水边。你没有看见它过来。它紧攥着双手，双眼始终盯着你。你把手留在膝上。过了一会儿，那几根手指松开了些。
                <<else>>
                  眼角有什么苍白的东西动了一下。你转过头，那身影站在水边，苍白的衣袍映过一点微光。它看看你空着的双手，又看看你的脸，仍留在原地。
                <</if>>
                <br><br>
                <<if $wraithPrison?.vision>>你想起曾在它的梦里感到的失落，没有将这段记忆说出口。<</if>>你们谁也没有靠近。再次抬头时，那身影已经不见了。你松开一直憋着的那口气，站起身来。
            <</language>>
            <<lobsession 1>>
            <<run UIBar.update()>>
          <<else>>
            <<lanSwitch 'You are interrupted before the quarter-hour is over. Whatever you thought you saw by the water is gone.' '还没坐满一刻钟，就有别的事打断了你。水边那道仿佛出现过的影子，已经不见了。'>>
          <</if>>
          <br><br>
          <<if $nextPassageCheck or $nextPassage>>
            <<getouticon>><<lanLink ['Continue', '继续'] `$nextPassageCheck || $nextPassage`>><</lanLink>><br>
          <<else>>
            <<getouticon>><<lanLink ['Return to the shore', '回到湖岸'] 'Lake Shore'>><</lanLink>><br>
          <</if>>
        <</replace>>
      <</if>>
    <</if>>
  <</lanLink>><br>
  <<getouticon>><<lanLink ['Leave', '离开'] 'Lake Shore'>><</lanLink>><br>
</div>
