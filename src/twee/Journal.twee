:: Revelation Journal Widgets [widget]

<<widget 'lost-lamb-journal'>>
  <<language>>
    <<option 'EN'>>
      It is <<= getFormattedDate(Time.date)>>, <<ampm Time.hour Time.minute>>. <i>You cannot place the year. These dates belong to the dream.</i>
    <<option 'CN'>>
      梦中是 <<= getFormattedDate(Time.date)>>，<<ampm Time.hour Time.minute>>。<i>你无法确定年份，这些日期属于梦境。</i>
  <</language>>
  <<revelation-card 'The manor' '庄园'>>
    <ul class='journal'>
      <li>
      <<language>>
        <<option 'EN'>>
          You are Kylar here. Day <span class='gold'><<= maplebirch.get('LostLamb').day>></span> in the dream.
        <<option 'CN'>>
          在这里，你是凯拉尔。梦中的第 <span class='gold'><<= maplebirch.get('LostLamb').day>></span> 天。
      <</language>>
      </li>
      <<if maplebirch.get('LostLamb').note>>
        <li><<print lanSwitch(...maplebirch.get('LostLamb').note)>></li>
      <</if>>
      <<if !$settings.blindStatsEnabled>>
        <li><<lanSwitch 'Doubt: ' '疑心：'>><span class='lblue'><<= $LostLamb.doubt>>/100</span></li>
        <li><<lanSwitch 'Unease: ' '不安：'>><span class='red'><<= $LostLamb.fear>>/100</span></li>
        <li><<lanSwitch 'Attention drawn: ' '引起的注意：'>><span class='gold'><<= $LostLamb.notice>>/100</span></li>
      <</if>>
      <li>
      <<language>>
        <<option 'EN'>>
          You may wake at any time. Rest at the manor to return to where you stopped.
        <<option 'CN'>>
          随时可以醒来，再到庄园休息便能从中断处继续。
      <</language>>
      </li>
    </ul>
  <</revelation-card>>
  <hr>
<</widget>>

<<widget 'lost-lamb-record'>>
  <<if !maplebirch.get('LostLamb') or $statFreeze>><<exit>><</if>>
  <<set _lamb_bishop_known to $kylar_manor_secret gte 3 and Boolean($per_npc?.bishop)>>
  <<set _lamb_remaining to !$LostLamb.talk or C.npc.Sydney.init is 1 and !$LostLamb.sydneyTalk
    or C.npc.Gwylan.init is 1 and !$LostLamb.gwylanTalk or _lamb_bishop_known and !$LostLamb.bishopTalk>>
  <<if ($LostLamb.scene or $LostLamb.endings.length)
      and (maplebirch.get('LostLamb').paused or !maplebirch.get('LostLamb').reward or _lamb_remaining)>>
    <<revelation-card 'Kylar\'s manor' '凯拉尔的庄园'>>
      <ul class='journal'>
        <<if maplebirch.get('LostLamb').paused>>
          <li><<lanSwitch 'The dream was interrupted. Rest in Kylar\'s room to continue.' '那个梦还没有结束。到凯拉尔的房间休息，可以从中断的地方继续。'>></li>
        <<elseif maplebirch.get('LostLamb').reward>>
          <<if !$LostLamb.talk>>
            <li><<lanSwitch 'The dream has ended. If it is still on your mind, visit the manor in the evening and speak to Kylar in private.' '那个梦已经结束。若还惦记，傍晚可以回庄园，私下找凯拉尔谈谈。'>></li>
          <</if>>
          <<if C.npc.Sydney.init is 1 and !$LostLamb.sydneyTalk>>
            <li><<lanSwitch 'You remember Sydney\'s knock in the dream. You could ask about it when Sydney is free at the library, shop or temple pews.' '你还记得梦里悉尼敲门的暗号。悉尼在图书馆、商店或神殿长椅有空时，可以问一问。'>></li>
          <</if>>
          <<if C.npc.Gwylan.init is 1 and !$LostLamb.gwylanTalk>>
            <li><<lanSwitch 'Gwylan knows the woods around the manor. You could ask about the house during a visit to the forest shop.' '格威岚熟悉庄园附近的树林。到森林商店时，也可以问问那所宅邸。'>></li>
          <</if>>
          <<if _lamb_bishop_known and !$LostLamb.bishopTalk>>
            <li><<lanSwitch 'The bishop has spoken of the manor before. You could ask about it again when you next meet in the temple.' '主教曾谈过庄园的事。下次在神殿见面时，可以再问一问。'>></li>
          <</if>>
        <<elseif maplebirch.get('LostLamb').mainReady and !$LostLamb.endings.includes('main')>>
          <li><<lanSwitch 'You remember the same voice in both dreams. Rest in Kylar\'s room to listen for it again.' '两场梦里都出现过那道声音。到凯拉尔的房间休息，可以再听一听。'>></li>
        <<else>>
          <li><<lanSwitch 'There are still parts of the dream you cannot piece together. Resting in Kylar\'s room may bring back another fragment.' '梦里的事还没有拼凑完整。在凯拉尔的房间休息，或许能想起别的片段。'>></li>
        <</if>>
      </ul>
    <</revelation-card>>
    <hr>
  <</if>>
<</widget>>

<!-- 罗宾与神殿 -->
<<widget 'robin-temple-examination-days'>>
  <<set _templeExamDays to Math.max(0,
    maplebirch.get('RobinTemple') and ($RobinTemple.dual_promise or maplebirch.get('RobinTemple').publicPromise is 'Robin')
      ? ($RobinTemple.monthly_checked ? Math.min($temple_chastity_timer, $RobinTemple.chastity_timer) : 0)
      : $temple_chastity_timer)>>
<</widget>>

<<widget 'robin-temple-journal'>>
  <<if $RobinTemple?.stage and $RobinTemple.stage isnot 'none'>>
    <<revelation-card 'Robin and the temple' '罗宾与神殿'>>
      <ul class='journal'>
        <<switch $RobinTemple.stage>>
          <<case 'invited'>>
            <li>
            <<language>>
              <<option 'EN'>>
                Robin has questions about joining the temple. Find <<nnpc_him 'Robin'>>
                <<if maplebirch.get('RobinTemple').residence>>
                  at your shared home
                <<else>>
                  in <<nnpc_his 'Robin'>> room
                <</if>>
                when <<nnpc_he 'Robin'>> is free, and visit Jordan together during the day, outside the Sunday service.
              <<option 'CN'>>
                罗宾对加入神殿还有疑问。等<<nnpc_he 'Robin'>>有空时，去
                <<if maplebirch.get('RobinTemple').residence>>
                  你们同住的自宅
                <<else>>
                  罗宾房间
                <</if>>
                谈谈，再一起于白天、周日弥撒以外的时段拜访约旦。
            <</language>>
            </li>
          <<case 'scheduled'>>
            <li>
            <<language>>
              <<option 'EN'>>
                Robin's purity trial is booked for <span class='gold'><<= getFormattedDate(new DateTime(Time.startDate).addDays($RobinTemple.exam_day))>></span>. If that date has passed, the appointment remains booked.
              <<option 'CN'>>
                罗宾的纯洁试炼预约在 <span class='gold'><<= getFormattedDate(new DateTime(Time.startDate).addDays($RobinTemple.exam_day))>></span>。日期已过时，预约仍会保留。
            <</language>>
            </li>
            <<if Time.days lt $RobinTemple.exam_day and $RobinTemple.prepared_day isnot Time.days>>
              <li>
              <<language>>
                <<option 'EN'>>
                  Before the trial, find Robin at home from 17:00 to 19:15 and prepare together. Allow forty-five minutes before the next school, tutoring, shop or other commitment.
                <<option 'CN'>>
                  试炼日前，17:00 至 19:15 可在家中找有空的罗宾一起准备。下次上学、家教、看店或其他安排前须留足四十五分钟。
              <</language>>
              </li>
            <</if>>
            <li>
            <<language>>
              <<option 'EN'>>
                If Robin cannot attend or Jordan is unavailable, the appointment will wait. Attend from 06:00 to before 08:00 on school days, or before 18:00 on days without school, outside the Sunday service.
              <<option 'CN'>>
                罗宾无法参加或约旦暂时不能接待时，预约会继续保留。上学日于 06:00 至 08:00 前参加，不上学的日子则可延至 18:00 前，周日弥撒期间需等候。
            <</language>>
            </li>
          <<case 'failed'>>
            <li>
            <<language>>
              <<option 'EN'>>
                Robin needs time to decide freely. Ask again at home from <span class='gold'><<= getFormattedDate(new DateTime(Time.startDate).addDays($RobinTemple.exam_day + 7))>></span>.
              <<option 'CN'>>
                罗宾需要时间自己考虑。<span class='gold'><<= getFormattedDate(new DateTime(Time.startDate).addDays($RobinTemple.exam_day + 7))>></span> 起，可以在家中再询问。
            <</language>>
            </li>
          <<case 'member'>>
            <li>
            <<language>>
              <<option 'EN'>>
                Robin has joined the temple and helps with Sunday mass. When you are both free, you can arrange to go together from home or talk at the temple pews.
              <<option 'CN'>>
                罗宾已经加入神殿，也会协助周日弥撒。两人有空时，可以在家中商量同行，或在神殿长椅谈谈共同的工作。
            <</language>>
            </li>
            <<if !$RobinTemple.punish and $robinromance is 1 and $RobinTemple.service gte 3 and !$templePromised>>
              <li>
              <<language>>
                <<option 'EN'>>
                  Ask Robin about making a promise when <<nnpc_he 'Robin'>> is present at the temple during daylight. Jordan will weigh both your contributions, your shared work and Robin's faith.
                <<option 'CN'>>
                  罗宾白天在神殿时，可以谈承诺仪式。约旦会分别考虑你们的神殿贡献、共同完成的工作，以及罗宾对誓言的信仰。
              <</language>>
              </li>
            <</if>>
          <<case 'approved'>>
            <li>
            <<language>>
              <<option 'EN'>>
                Meet Robin in the temple quarters to hold the approved promise rite.
              <<option 'CN'>>
                去神殿宿舍见罗宾，举行已获批准的承诺仪式。
            <</language>>
            </li>
          <<case 'promised'>>
            <<robin-temple-examination-days>>
            <<if $RobinTemple.dual_promise>>
              <li>
              <<language>>
                <<option 'EN'>>
                  Jordan will summon you, Robin and Sydney together for the next examination.
                <<option 'CN'>>
                  下次检查时，约旦会将你、罗宾与悉尼一并召去。
              <</language>>
              </li>
            <<else>>
              <li>
              <<language>>
                <<option 'EN'>>
                  Jordan will examine the vow you share with Robin.
                <<option 'CN'>>
                  约旦会一同检查你和罗宾的誓言。
              <</language>>
              </li>
            <</if>>
            <<if _templeExamDays is 0 and !$RobinTemple.punish>>
              <li><<lanSwitch 'The examination is due. Go to the temple hall together; if Robin cannot attend, it will wait.' '检查已经到期。一起去神殿大厅，罗宾暂时无法参加时，检查会等候。'>></li>
            <</if>>
        <</switch>>
        <<if !maplebirch.get('RobinTemple').available>>
          <li><<lanSwitch 'Robin cannot visit the temple at present. Your plans will wait.' '罗宾暂时无法去神殿，你们的安排需要等候。'>></li>
        <</if>>
        <<if maplebirch.get('RobinTemple').member and $RobinTemple.punish>>
          <li><<lanSwitch 'Your shared purification is unfinished. Return to the temple to continue.' '共同净化还没有结束。回神殿继续。'>></li>
        <</if>>
        <<if maplebirch.get('RobinTemple').member and $RobinTemple.faith_transition>>
          <li><<lanSwitch 'Robin has something to say about the temple. Listen next time you pray together.' '罗宾有些关于神殿的想法想告诉你。下次一起祈祷时可以听听。'>></li>
        <</if>>
        <<if ['waiting', 'discharged', 'therapy', 'rescue', 'vanilla'].includes($RobinTemple.hospital_stage)>>
          <li><<lanSwitch 'Your hospital visit with Robin is unfinished. You can continue it at the hospital entrance.' '罗宾陪同的这次就诊尚未结束。可以在医院门口继续。'>></li>
        <</if>>
        <<if maplebirch.get('RobinTemple').member and $temple_spear_mission is 1 and !$spear_vessel and !$RobinTemple.spear_seen and $robinromance is 1>>
          <li>
          <<language>>
            <<option 'EN'>>
              Robin has heard about Jordan's spear mission. Speak to Robin at the temple bench before setting out.
            <<option 'CN'>>
              罗宾听说了约旦交代的取矛任务。出发前，可以在神殿长椅与罗宾谈谈。
          <</language>>
          </li>
        <<elseif maplebirch.get('RobinTemple').member and $temple_spear_mission gte 2 and $RobinTemple.spear_seen and !$RobinTemple.spear_return_seen>>
          <li>
          <<language>>
            <<option 'EN'>>
              You promised to tell Robin how the spear journey went. Find <<nnpc_him 'Robin'>> at the temple bench.
            <<option 'CN'>>
              你答应把取矛的经过告诉罗宾。去神殿长椅找<<nnpc_him 'Robin'>>。
          <</language>>
          </li>
        <</if>>
      </ul>
    <</revelation-card>>
    <hr>
  <</if>>
<</widget>>

<!-- 混乱誓约 -->
<<widget 'secret-promise-next-step'>>
  <<set $_secret to maplebirch.get('RobinTemple').secret>>
  <<if !$_secret.eligible>>
    <<if !$_secret.known>>
      <<lanSwitch 'You do not yet know enough about this rite to continue the investigation.' '你对这种仪式还知道得太少，暂时无法继续调查。'>>
    <<elseif !maplebirch.get('RobinTemple').member or !$temple_rank or $temple_rank is 'prospective'>>
      <<lanSwitch 'Both you and Robin must formally join the temple before pursuing this promise.' '你与罗宾都需正式加入神殿，再追查这份承诺。'>>
    <<elseif !$_secret.unfitted>>
      <<lanSwitch 'You, Robin and Sydney must first remove all chastity fittings. If Robin is wearing temple fittings, arrange their removal with Jordan through the quarters.' '你、罗宾和悉尼都需要先取下贞操器具。罗宾若戴着神殿的器具，可以去宿舍商量，再一起找约旦拆除。'>>
    <<elseif !maplebirch.get('RobinTemple').available>>
      <<lanSwitch 'Robin cannot go with you at present. Arrange the journey when Robin is able to leave again.' '罗宾暂时无法同行。等罗宾能出门后，再商量出行。'>>
    <<elseif $RobinTemple.punish or $player.virginity.temple isnot true
        or C.npc.Robin.virginity.temple isnot true or C.npc.Sydney.virginity.temple isnot true>>
      <<lanSwitch 'Resolve the outstanding purification or broken temple vows before continuing.' '先处理尚未结束的净化或破损的神殿誓言，再继续调查。'>>
    <<elseif $robinromance isnot 1 or $sydneyromance isnot 1 or C.npc.Robin.love lt 80 or C.npc.Sydney.love lt 125>>
      <<lanSwitch 'Your relationship with both companions needs to be closer before they will consider this plan.' '你与两人的关系还不够亲密，暂时无法一起商量这件事。'>>
    <<elseif C.npc.Robin.trauma lt 40>>
      <<lanSwitch 'Robin\'s distress has eased, and Robin no longer wants to pursue this investigation. The plan is on hold.' '罗宾的创伤已经缓和，不再愿意追查这件事。计划暂时搁下。'>>
    <<elseif C.npc.Sydney.purity gte 50 or C.npc.Sydney.corruption lt 10>>
      <<lanSwitch 'Sydney\'s faith still stands in the way of this rite. The plan must wait.' '悉尼的信仰仍不容许这场仪式，计划只能暂时搁下。'>>
    <<elseif $RobinTemple.templePromised is 'Robin' and !$sydneySeen?.includes('corruptroom')>>
      <<lanSwitch 'Sydney has not yet completed the corrupt promise rite. Speak with Sydney about that before seeking a second promise.' '悉尼尚未完成堕落仪式。先与悉尼处理这件事，再寻求第二份承诺。'>>
    <<elseif !hasSexStat('promiscuity', 6)>>
      <<lanSwitch 'You are not yet prepared to seek both promises.' '你还没有准备好同时寻求两份承诺。'>><<promiscuous 6>>
    <<else>>
      <<lanSwitch 'This plan requires one existing promise, with Robin or Sydney. If that promise changes during the investigation, you cannot continue with the old plan.' '这个计划需要你已与罗宾或悉尼中的一人承诺。调查期间，已有承诺发生变化，就无法继续原来的计划。'>>
    <</if>>
  <<elseif $RobinTemple.secret.stage is 'none'>>
    <<lanSwitch 'Speak to Robin privately at home to begin the investigation.' '在家中找有空的罗宾，私下谈起调查。'>>
  <<elseif $RobinTemple.secret.witness_day gte 0 and !$_secret.settled>>
    <<lanSwitch 'Give both companions three days after returning from the shared investigation before asking them to reconsider.' '共同调查回来后，先给两人三天考虑，再分别询问。'>>
  <<elseif $RobinTemple.secret.robin_day lt 0
      or $RobinTemple.secret.witness_day gte 0 and $RobinTemple.secret.robin_day lt $RobinTemple.secret.witness_day + 3>>
    <<lanSwitch 'Speak to Robin privately at home when Robin is free. This conversation has not been settled yet.' '仍需和罗宾私下谈妥。在家中找有空的罗宾。'>>
  <<elseif $RobinTemple.secret.sydney_day lt 0
      or $RobinTemple.secret.witness_day gte 0 and $RobinTemple.secret.sydney_day lt $RobinTemple.secret.witness_day + 3>>
    <<lanSwitch 'Speak to Sydney privately at the school library, temple or adult shop when Sydney is free.' '仍需和悉尼私下谈妥。在学校图书馆、神殿或成人用品商店找有空的悉尼。'>>
  <<elseif $RobinTemple.secret.survey_day lt 0>>
    <<lanSwitch 'Survey the lake ruin in daylight, while the lake is unfrozen and no pursuit is underway.' '湖面未结冰、没有追猎时，白天到湖畔勘查废墟路线。'>>
  <<elseif !$RobinTemple.secret.prepared>>
    <<lanSwitch 'At the lake, review the route and your findings, then confirm the departure preparations.' '到湖畔核对路线与调查所得，再确认出发准备。'>>
  <<elseif $RobinTemple.secret.witness_day lt 0
      and Time.days lt Math.max($RobinTemple.secret.robin_day, $RobinTemple.secret.sydney_day, $RobinTemple.secret.survey_day) + 3>>
    <<lanSwitch 'Leave three days after the most recent conversation or survey before setting out together.' '最后一次谈话或勘查后，需留出三天，再一同出发。'>>
  <<elseif $RobinTemple.secret.witness_day gte 0 and (!$_secret.wants.Robin or !$_secret.wants.Sydney)>>
    <<lanSwitch 'One or both companions do not currently want the rite. Do not set out until both freely agree.' '目前仍有人不愿参与仪式。等两人都明确愿意，再商量出发。'>>
  <<elseif $stress gte $stressmax - 40 or $pain gte 50 or $tiredness gte 1500>>
    <<lanSwitch 'Rest before setting out. You are too tense, hurt or tired for the journey.' '先休息，缓和压力、疼痛或疲劳，再安排这次同行。'>>
  <<elseif $RobinTemple.secret.night is Time.days>>
    <<lanSwitch 'You have already set out together tonight. Choose another blood moon night.' '今晚已经一同出发过了，另选一个血月夜吧。'>>
  <<elseif $_secret.threatened>>
    <<lanSwitch 'A pursuit or the wraith\'s hostility makes the lake unsafe. Settle that danger before arranging a meeting.' '追猎或怨灵的敌意仍使湖边不安全。先处理眼前的危险，再安排会合。'>>
  <<elseif Weather.isFrozen('lake') or Weather.precipitation is 'rain'>>
    <<lanSwitch 'Wait for a rainless night with an unfrozen lake.' '等湖面未结冰、没有下雨的夜晚再来。'>>
  <<elseif $laketeenspresent>>
    <<lanSwitch 'People are still at the lake. Wait until the shore is empty.' '湖边还有人，等岸边无人时再来。'>>
  <<elseif !Time.isBloodMoon() or Time.hour lt 21 or Time.hour gte 23>>
    <<lanSwitch 'Your preparations are complete. Meet at the lake on a blood moon night between 21:00 and 23:00.' '准备已经齐全。血月夜 21:00 至 23:00 前，到湖畔会合。'>>
  <<else>>
    <<lanSwitch 'The preparations and conditions are right. You can meet Robin and Sydney at the lake now.' '准备与时机都已合适，现在可以到湖畔与罗宾、悉尼会合。'>>
  <</if>>
<</widget>>

<<widget 'secret-promise-journal'>>
  <<if $RobinTemple.dual_promise and $RobinTemple.secret.stage is 'complete'
      and ['none', 'meal', 'records'].includes($RobinTemple.secret.followup)>>
    <<revelation-card 'After the night at the lake' '湖边那晚之后'>>
      <ul class='journal'>
          <<if $RobinTemple.secret.followup is 'none'>>
            <li><<lanSwitch 'You promised to share a meal with Robin and Sydney after the night at the lake. Find a time when all three of you are free.' '你答应过与罗宾、悉尼一起吃饭，谈谈湖边那晚发生的事。找三人都有空的时候兑现约定。'>></li>
          <<elseif $RobinTemple.secret.followup is 'meal'>>
            <li><<lanSwitch 'The meal is over. Compare your accounts with both companions.' '一起吃过饭了。和两人核对各自的记录。'>></li>
          <<else>>
            <li><<lanSwitch 'You have compared your accounts and agreed to check with one another if a voice calls. When all three of you are free, you can investigate the sound together.' '你们已核对那晚的记录，也约好听见呼唤时先向彼此确认。三个人有空时，可以继续查看那道声音。'>></li>
          <</if>>
          <li><<lanSwitch 'Meet in the temple hall after 13:00, with time before 17:00 and your companions\' next commitments.' '13:00 后到神殿大厅会合，在 17:00 与同伴下一项事务前留足时间。'>></li>
      </ul>
    <</revelation-card>>
    <hr>
  <</if>>
  <<if !$RobinTemple.dual_promise and !$RobinTemple.secret.rite_done
      and $RobinTemple.secret.stage isnot 'complete'
      and $RobinTemple.secret.stage isnot 'none'>>
    <<revelation-card 'Confounded Vow' '混乱誓约'>>
      <ul class='journal'>
        <<if ['travelling', 'decision', 'ritual'].includes($RobinTemple.secret.stage)
            and !maplebirch.get('RobinTemple').secret.active>>
          <li class='red'><<lanSwitch 'This journey has been interrupted. Return to the lake shore to call it off before making another plan.' '这次同行已经中断。回到湖畔取消这次同行，再安排新的计划。'>></li>
        <<else>>
        <<switch $RobinTemple.secret.stage>>
          <<case 'research'>>
            <li>
              <<if $RobinTemple.secret.witness_day lt 0>>
                <<lanSwitch 'The first journey is only to investigate the stone. After returning, each companion will decide whether to attempt the rite.' '第一次同行只调查石头。回来后，再由两人分别决定是否参与仪式。'>>
              <<else>>
                <<lanSwitch 'After examining the stone together, you are considering the rite. Each of you remains free to change your mind.' '你们已经一起查看过石头，接下来要商议是否举行仪式。每个人都可以改变主意。'>>
              <</if>>
            </li>
            <li><<secret-promise-next-step>></li>
          <<case 'decision'>>
            <li><<lanSwitch 'You have examined the stone. Decide whether to attempt the rite tonight. Robin and Sydney must each give their own consent.' '你们已经查看过石头。现在要决定今晚是否举行仪式，罗宾和悉尼都需要各自明确同意。'>></li>
          <<case 'travelling'>>
            <li><<lanSwitch 'You have met Robin and Sydney at the lake. Visit the stone together or call off the journey.' '你和罗宾、悉尼已经在湖边会合。可以一起查看废墟里的石头，也可以结束这次同行。'>></li>
          <<case 'ritual'>>
            <li><<lanSwitch 'The rite is underway. Each of you must give your own answer; no one can decide for the other two.' '仪式正在进行。你们需要各自表明意愿，不能由一个人替另外两人作主。'>></li>
        <</switch>>
        <</if>>
      </ul>
    <</revelation-card>>
    <hr>
  <</if>>
<</widget>>

<!-- 神殿唱诗班 -->
<<widget 'temple-choir-journal'>>
  <<if $TempleChoir.joined and (!$TempleChoir.lead or $TempleChoir.bonus gt 0 or maplebirch.get('TempleChoir').active)>>
    <<revelation-card 'Temple choir' '神殿唱诗班'>>
      <ul class='journal'>
        <li><<lanSwitch 'Practice: 09:00–18:00, once a day, except during Sunday mass (0:30). Service: Sunday, 11:00–13:00 (1:00).' '练习：每天 09:00–18:00 一次，周日弥撒期间暂停（0:30）。唱诗：周日 11:00–13:00（1:00）。'>></li>
        <<if $TempleChoir.bonus gt 0>>
          <li><<lanSwitch 'Uncollected choir earnings: ' '尚未领取的唱诗加款：'>><span class='gold'><<printmoney $TempleChoir.bonus>></span><<lanSwitch '. Collect them after passing a monthly examination when the temple allowance is paid.' '。月度检查通过且神殿津贴获发时领取。'>></li>
        <</if>>
        <li>
        <<if $TempleChoir.lead>>
          <<lanSwitch 'Jordan has allowed you to lead the responses.' '约旦已允许你领唱答唱。'>>
        <<else>>
          <<lanSwitch 'Regular practice, completed services and good singing help you qualify to lead the responses.' '坚持练习、完整参加唱诗并提高歌唱表现，可以争取领唱答唱的资格。'>>
        <</if>>
        </li>
      </ul>
    <</revelation-card>>
    <hr>
  <</if>>
<</widget>>

<!-- 神殿职务、旧资料室与当前委托 -->
<<widget 'temple-duties-journal'>>
  <<if maplebirch.get('TempleDuties') and $TempleDuties.quarters_ready and !$TempleDuties.enrolled>>
    <<revelation-card 'Helping at the temple' '神殿的帮手'>>
      <ul class='journal'><li><<lanSwitch 'The attendant mentioned Jordan needs help. Ask at the duties book in the hall, 09:00–18:00 before dusk, outside Sunday mass.' '侍从提过约旦需要帮手。09:00–18:00、天色未暗时，可以去大厅职务簿旁询问，避开周日弥撒。'>></li></ul>
    <</revelation-card>><hr>
  <</if>>
  <<if maplebirch.get('TempleDuties') and $TempleDuties.enrolled>>
    <<temple-duty-check>>
    <<revelation-card 'Rota and records room' '轮值与资料室'>>
      <ul class='journal'>
        <li><<lanSwitch 'Duties desk: 09:00–18:00, outside Sunday mass. One paid shift daily; leave enough time to finish.' '职务桌：09:00–18:00，周日弥撒期间暂停。每天可完成一班有薪职务，接班前须留足时间。'>></li>
        <<if $TempleDuties.duty_day is Math.floor(Time.days)>>
          <li><<lanSwitch 'Today\'s shift is complete.' '今日已完成值班。'>></li>
        <</if>>
        <<if $temple_rank is 'priest' and $TempleDuties.duty_day isnot Math.floor(Time.days)>>
          <li><<lanSwitch 'People seeking help wait by the duties desk. You can take a half-hour reception before 17:00, outside mass, in place of today\'s paid shift.' '职务桌旁有人等候求助。17:00 前、弥撒以外的时段，可以接下一班半小时的接待，计作今日有薪职务。'>></li>
        <</if>>
        <<if !$TempleDuties.case>>
          <<if $TempleDuties.duties is 0 and !Object.keys($TempleDuties.reports).length and $temple_rank isnot 'priest'>>
            <li><<lanSwitch 'Take your first handover through the duties book. The attendant will show you the work.' '先在职务簿接下一班工作，跟侍从完成首次交接。'>></li>
          <<elseif _dutyNext>>
            <li>
              <<if $TempleDuties.reports[_dutyNext]>>
                <<lanSwitch 'The last assignment is unfinished. Ask Jordan to investigate again: ' '上次委托尚未办妥，可以向约旦重新接取：'>>
              <<else>>
                <<lanSwitch 'Ask Jordan about the next assignment: ' '可以向约旦询问下一件委托：'>>
              <</if>>
              <<temple-case-title _dutyNext>>
            </li>
          <</if>>
        <</if>>
        <<if $TempleDuties.archive.sorted gt 0 and $TempleDuties.archive.sorted lt 3>>
          <li><<lanSwitch 'The loose folios are not all restored. Continue drying and sorting them in the old records room.' '散页尚未全部修复，可以去旧资料室继续晾干、整理。'>></li>
        <</if>>
        <<for _journalRepair range ['roof', 'shelves']>>
          <<if $TempleDuties.archive[_journalRepair] gte 0 and Time.days lt $TempleDuties.archive[_journalRepair]>>
            <li>
            <<lanSwitch `_journalRepair is 'roof' ? 'Roof and drainage: ' : 'Shelves: '` `_journalRepair is 'roof' ? '屋顶与排水：' : '书架：'`>>
            <<lanSwitch 'work underway; completion ' '施工中，竣工日期：'>>
            <span class='gold'><<print getFormattedDate(new DateTime(Time.startDate).addDays($TempleDuties.archive[_journalRepair]))>></span>
            </li>
          <</if>>
        <</for>>
      </ul>
    <</revelation-card>>
    <hr>
    <<if $TempleDuties.case>>
      <<set _caseHeading to $TempleDuties.case.id is 'echo' ? ['Knocking after lights-out', '熄灯后的敲击'] : $TempleDuties.case.id is 'roots' ? ['Roots beneath the records', '卷宗下的根须'] : $TempleDuties.case.id is 'ritual' ? ['Chanting beyond the shore', '湖岸外的祷声'] : ['The returned donation crate', '退回的捐赠箱']>>
      <<revelation-card _caseHeading[0] _caseHeading[1]>>
        <ul class='journal'>
          <<if $TempleDuties.case.stage is 'report' or $TempleDuties.case.stage is 'combat' and !$combat>>
            <li><<lanSwitch 'Return to Jordan\'s duties desk during the day to give your report.' '白天回约旦的职务桌，汇报调查结果。'>></li>
          <<elseif $TempleDuties.case.stage is 'combat'>>
            <li class='red'><<lanSwitch 'An encounter is underway. Finish it or leave safely before filing a report.' '遭遇正在进行。结束或安全撤离后，才能提交报告。'>></li>
            <<if $TempleDuties.case.id is 'ritual'>>
              <<if $enemytype is 'man'>>
                <li><<lanSwitch 'The cultists are blocking your way to the stone. The captive has not been freed.' '邪教徒挡在通向石台的路上，受困者尚未获救。'>></li>
              <<elseif $TempleDuties.case.clues.includes('evacuated')>>
                <li><<lanSwitch 'The person you rescued is being cared for. Clear the remaining danger from the path to the shore.' '获救者已经有人照料。处理小径上剩余的危险，让通往湖岸的道路恢复安全。'>></li>
              <<else>>
                <li><<lanSwitch 'The ritual has been interrupted. Keep the way out clear while bringing the trapped adult to safety.' '仪式已被打断。护住退路，将受困的成年人带到安全处。'>></li>
              <</if>>
            <</if>>
          <<else>>
            <<if $TempleDuties.case.id is 'roots'>>
              <li><<lanSwitch 'Meet the monk at the old storehouse by the docks. Mark a way back before dealing with the moving roots.' '到码头旁的旧仓房与修士会合。处理会动的根须前，先留好退路。'>></li>
            <<elseif $TempleDuties.case.id is 'crate'>>
              <li><<lanSwitch 'Go to the docks warehouse. Bring the worker out and repel the purple tentacles; prepared companions can help.' '前往码头仓库，接出受困工人并击退紫色触手；已完成见习的同伴可以帮忙。'>></li>
              <<if !$TempleDuties.case.clues.includes('departed') and !$TempleDuties.case.clues.includes('visit-quiet')>>
                <li><<lanSwitch 'Before going to the site, invite any companions through the assignment instructions. Leave time for their other duties.' '前往现场前，可以在委托说明中邀请同伴，并为各自的其他职务留足时间。'>></li>
              <</if>>
            <<elseif $TempleDuties.case.id is 'ritual'>>
              <<if $TempleDuties.case.clues.includes('help') and !$TempleDuties.case.clues.includes('departed')>>
                <li><<lanSwitch 'Jordan has arranged help. Meet the older monk at Lake Shore before returning to the hollow.' '约旦已经安排接应。返回低地前，先到湖岸与资深修士会合。'>></li>
              <</if>>
              <<if !$TempleDuties.case.clues.includes('rescued') and ($TempleDuties.case.clues.includes('cultist-defeated') or $TempleDuties.case.clues.includes('cultist-spent') or $TempleDuties.case.clues.includes('cultist-retreated'))>>
                <li><<lanSwitch 'The way to the stone is clear. Free the captive, then escort them towards the shore.' '通向石台的阻拦已经解除。解开受困者的束缚，再护送对方向湖岸撤离。'>></li>
              <<elseif $TempleDuties.case.clues.includesAll('interrupt', 'evacuated')>>
                <li><<lanSwitch 'The person you rescued is being cared for. Return through Lake Shore to check the clearing and deal with the remaining danger.' '获救者已经有人照料。从湖岸返回低地，复查现场并处理剩余的危险。'>></li>
                <<if !$TempleDuties.case.clues.includes('departed')>>
                  <li><<lanSwitch 'Return in daylight between 09:00 and 16:00. You can arrange companions again through the assignment instructions before leaving.' '在 09:00 后、16:00 前的白天再去。出发前，可以在委托说明中重新安排同伴。'>></li>
                <</if>>
              <<elseif !$TempleDuties.case.clues.includes('departed')>>
                <li><<lanSwitch 'Visit Lake Shore in daylight between 09:00 and 16:00 and follow the chanting into the woods.' '在 09:00 后、16:00 前的白天前往湖岸，循着祷声进入树林。'>></li>
                <li><<lanSwitch 'Before leaving, you can invite prepared companions through the assignment instructions.' '出发前，可以在委托说明中邀请已完成见习的同伴。'>></li>
              <<elseif !$TempleDuties.case.clues.includes('interrupt')>>
                <<if $TempleDuties.case.clues.includes('marks') and !$TempleDuties.case.clues.includes('help')>>
                  <li><<lanSwitch 'You have seen enough to report. You can withdraw and ask Jordan to send help before intervening.' '你已看清现场。可以先撤离，向约旦说明所见，请求接应后再行动。'>></li>
                <</if>>
                <<if $TempleDuties.case.clues.includes('loosened')>>
                  <li><<lanSwitch 'The knots are loose. Use the opening to lead the captive away, or confront the cultists directly.' '绳结已经松开。可以趁机带开受困者，也可以正面阻止邪教徒。'>></li>
                <<else>>
                  <li><<lanSwitch 'Observe the gathering and mark a retreat before interrupting the ritual. You may be able to slip in and loosen the knots first.' '先观察聚集的人群，标记退路，再打断仪式。也许可以先潜入松开绳结。'>></li>
                <</if>>
              <<elseif $settings.tentaclesEnabled>>
                <li><<lanSwitch 'The adult is free. Repel the purple tentacles and escort them out of the woods.' '受困者已获自由。击退紫色触手，护送对方离开树林。'>></li>
              <<else>>
                <li><<lanSwitch 'The adult is free. Escort them along the marked retreat and out of the woods.' '受困者已获自由。沿着标记的退路，护送对方离开树林。'>></li>
              <</if>>
            <<else>>
              <li><<lanSwitch 'Inspect the assigned storeroom through the duties desk or old records room.' '从职务桌或旧资料室前往委托中的储藏室。'>></li>
            <</if>>
            <<if !$TempleDuties.case.prepared and ($TempleDuties.case.id isnot 'ritual' or !$TempleDuties.case.clues.includes('departed'))>>
              <li><<lanSwitch 'Before setting out, ask Jordan for a lamp, rope and gloves at the duties desk.' '出发前，可以到职务桌向约旦借灯、绳索与手套。'>></li>
            <</if>>
          <</if>>
        </ul>
      <</revelation-card>>
      <hr>
    <</if>>
    <<if $temple_rank is 'monk' and $TempleDuties.ordained lt 0
        and ($TempleDuties.review or _dutyReady or _dutyTrained)>>
      <<revelation-card 'Priest appointment' '司祭任命'>>
        <ul class='journal'>
          <<if $TempleDuties.review>>
            <li><<lanSwitch 'Your appointment interview is unfinished. Return to Jordan before 17:00 to continue.' '任职面谈还没有结束。17:00 前回去找约旦，继续交谈。'>></li>
          <<elseif _dutyReady>>
            <li><<lanSwitch 'Your service and vows are approved. Speak to Jordan before 17:00 about the appointment review.' '你的职责与誓约已符合要求。17:00 前找约旦，商谈司祭任命。'>></li>
          <<else>>
            <li><<lanSwitch 'Ask Jordan about priest appointments before 17:00. You can review the work still required at the interview.' '17:00 前可以找约旦询问司祭任命，在面谈时核对尚未完成的职责。'>></li>
          <</if>>
        </ul>
      <</revelation-card>>
      <hr>
    <</if>>
    <<for _journalCandidate range ['Robin', 'Sydney']>>
      <<set $_journalRank to _journalCandidate is 'Robin' ? maplebirch.get('RobinTemple')?.rank : $sydney?.rank>>
      <<set _journalPreparation to $TempleDuties.candidates[_journalCandidate]>>
      <<if C.npc[_journalCandidate]?.init is 1 and _journalPreparation.agreed and $_journalRank is 'monk'>>
        <<revelation-card `maplebirch.auto(_journalCandidate) + ' · Ordination'` `maplebirch.auto(_journalCandidate) + ' · 司祭任职'`>>
          <ul class='journal'>
            <<if !_journalPreparation.lessons.includes('care')>>
              <li><<lanSwitch 'Accompany prayers and a parish visit through the preparation book.' '通过任职准备名册，陪同参与祈祷与教区成员接待。'>></li>
            <<elseif !_journalPreparation.lessons.includes('wards')>>
              <li><<lanSwitch 'Accompany a ward inspection with the older priest.' '陪同资深司祭检查护符。'>></li>
            <<elseif !_journalPreparation.reviewed and _journalPreparation.trial_day lt 0>>
              <li><<lanSwitch 'Invite your companion on the warehouse or lakeside assignment and work with them at the site. Report the outcome to Jordan. A priest can also bring companions on an available return inspection.' '接下仓库或湖岸委托时，邀请同伴并在现场一起做事，再向约旦汇报。已经受封为司祭时，也可以在旧委托开放回访后带同伴前往。'>></li>
            <<elseif !_journalPreparation.reviewed>>
              <li><<lanSwitch 'Accompany the appointment interview with Jordan.' '陪同参加约旦的任职面谈。'>></li>
            <<else>>
              <li><<lanSwitch 'Jordan has heard your companion\'s answers. When you are both ready, go to the hall altar for the appointment ceremony.' '约旦已听过同伴的回答。两人有空时，到大厅祭坛前参加司祭任命仪式。'>></li>
            <</if>>
          </ul>
        <</revelation-card>>
        <hr>
      <</if>>
    <</for>>
    <<if $TempleDuties.bishop is 'accepted'>>
      <<revelation-card 'The sealed comparison' '密封的比对记录'>>
        <ul class='journal'>
          <<if $TempleDuties.bishop_checked>>
            <li><<lanSwitch 'Return to the duties desk and give the sealed copy to the bishop waiting there as a confessor.' '回职务桌，把密封副本交给以告解员身份等候的主教。'>></li>
          <<elseif !$TempleDuties.archive.topics.includes('deliveries')>>
            <li><<lanSwitch 'Read the old crate handover records in the records room.' '到旧资料室查阅旧货箱交接记录。'>></li>
          <<elseif !$TempleDuties.reports.crate?.honest or $TempleDuties.reports.crate?.result isnot 'resolved'>>
            <li><<lanSwitch 'Finish the returned-crate investigation and give Jordan a truthful report before making the private comparison.' '先完成退回货箱的调查，向约旦如实汇报，再做私下的比对。'>></li>
          <<else>>
            <li><<lanSwitch 'Your report and the old receipts are ready to compare. Return to the old records room to make the separate copy.' '调查报告与旧收据都已备好。回旧资料室比对，抄出单独的副本。'>></li>
          <</if>>
        </ul>
      <</revelation-card>>
      <hr>
    <</if>>
    <<if ['accepted', 'copied'].includes($TempleDuties.manor)>>
      <<revelation-card 'The manor’s monstrance' '庄园中的圣体匣'>>
        <ul class='journal'>
          <<if !$TempleDuties.archive.topics.includes('monstrance')>>
            <li><<lanSwitch 'Read the indexed description in the old records room.' '到旧资料室查阅索引中的描述。'>></li>
          <<elseif $TempleDuties.manor is 'accepted'>>
            <li><<lanSwitch 'Speak to Kylar at the manor during an evening visit.' '傍晚去庄园拜访凯拉尔，询问圣体匣。'>></li>
          <<else>>
            <li><<lanSwitch 'Take Kylar\'s description back to the duties desk to collect the payment promised for the copy.' '把凯拉尔同意提供的描述带回职务桌，领取约好的抄录报酬。'>></li>
          <</if>>
        </ul>
      <</revelation-card>>
      <hr>
    <</if>>
  <</if>>
<</widget>>
