:: Temple Companion Duties Widgets [widget]
<<widget 'temple-duty-pew-check'>>
  <<silently>>
    <<temple-duty-check>>
    <<set _pewName to _args[0]>>
    <<set _pewReady to false>>
    <<if !_dutySafe or $location isnot 'temple'>><<exit>><</if>>
    <<if _pewName is 'Robin'>>
      <<set _pewReady to Boolean(maplebirch.get('RobinTemple')?.canPray)>>
    <<elseif _pewName is 'Sydney'>>
      <<sydneySchedule>>
      <<set _pewReady to C.npc.Sydney.init is 1 and C.npc.Sydney.state is 'active'
        and _sydney_location is 'temple' and $sydney_templeWork is 'pray'
        and $daily.sydney.punish isnot 1>>
    <</if>>
  <</silently>>
<</widget>>

<<widget 'temple-duty-pew-link'>>
  <<temple-duty-pew-check _args[0]>>
  <<if !_pewReady>><<exit>><</if>>
  <<capture _pewName>>
    <<temple-candidate-check _pewName 0>>
    <!-- 只问一次。答应之后，见习与外勤准备都回职务桌办理。 -->
    <<if _candidateRank is 'monk' and _candidateStanding and !_candidate.agreed>>
      <<socialiseicon 'ask'>>
      <<lanLink `['Ask ' + maplebirch.auto(_pewName) + ' about becoming a priest', '问' + maplebirch.auto(_pewName) + '愿不愿意当司祭']` 'Revelation Temple Candidate Talk'>>
        <<set $TempleDuties.speaker to _pewName>>
      <</lanLink>><br>
    <</if>>
    <<if $TempleDuties.enrolled and $TempleDuties.companion_day isnot Math.floor(Time.days)>>
      <<set _talkUsed to false>>
      <<capture _talkUsed>>
        <<socialiseicon>>
        <<lanLink `['Talk with ' + maplebirch.auto(_pewName) + ' about your duties (0:05)', '与' + maplebirch.auto(_pewName) + '谈谈职务 (0:05)']`>>
          <<temple-duty-pew-check _pewName>>
          <<if !_talkUsed and _pewReady and $TempleDuties.enrolled
              and $TempleDuties.companion_day isnot Math.floor(Time.days)>>
            <<set _talkUsed to true>>
            <<set _talkSource to $passage>>
            <<pass 5>>
            <<temple-duty-pew-check _pewName>>
            <<if $passage is _talkSource and !$nextPassage and !$nextPassageCheck and !$eventforced>>
              <<if _pewReady>>
                <<set $TempleDuties.speaker to _pewName>>
                <<set $TempleDuties.companion_day to Math.floor(Time.days)>>
                <<goto 'Revelation Temple Companion'>>
              <<else>>
                <<goto 'Temple'>>
              <</if>>
            <</if>>
          <</if>>
        <</lanLink>><br>
      <</capture>>
    <</if>>
  <</capture>>
<</widget>>

<<widget 'temple-companion-check'>>
  <<temple-duty-check>>
  <<set $_companionName to _args[0]>>
  <<temple-companion-time $_companionName `_args[1] ?? 0`>>
  <<set _companionFree to _dutyToday and $temple_rank is 'priest' and _templeCompanionTime>>
  <<if $_companionName is 'Robin'>>
    <<set _companionFree to _companionFree and maplebirch.get('RobinTemple')?.rank is 'priest'
      and maplebirch.get('RobinTemple').available and getRobinLocation() is 'temple'
      and !$RobinTemple.punish and $RobinTemple.monthly_checked
      and $RobinTemple.chastity_timer gt 0 and C.npc.Robin.virginity.temple is true>>
    <<if (_args[1] ?? 0) gt 0>>
      <<robin-temple-prayer-time _args[1]>>
      <<set _companionFree to _companionFree and _robinPrayerTime>>
    <</if>>
  <<elseif $_companionName is 'Sydney'>>
    <<sydneySchedule>>
    <<set _companionFree to _companionFree and $sydney?.rank is 'priest'
      and C.npc.Sydney.init is 1 and C.npc.Sydney.state is 'active'
      and _sydney_location is 'temple' and $sydney_templeWork isnot 'mass'
      and $daily.sydney.punish isnot 1 and C.npc.Sydney.virginity.temple is true>>
  <<else>>
    <<set _companionFree to false>>
  <</if>>
<</widget>>

<<widget 'temple-companion-shift'>>
  <<set _shiftName to $TempleDuties.speaker>>
  <<set _shiftUsed to false>>
  <<capture _shiftName _shiftUsed>>
    <<socialiseicon>>
    <<lanLink _args[0]>>
      <<temple-companion-check _shiftName 30>>
      <<if !_shiftUsed and _companionFree>>
        <<set _shiftUsed to true>>
        <<set _shiftSource to $passage>>
        <<pass 30>>
        <<temple-companion-check _shiftName 0>>
        <<if $passage is _shiftSource and !$nextPassageCheck and _companionFree>>
          <<set $TempleDuties.duty_day to Math.floor(Time.days)>>
          <<set $TempleDuties.duties += 1>>
          <<set $TempleDuties.speaker to _shiftName>>
          <<set $TempleDuties.note to 'joint-' + _shiftName>>
          <<if _shiftName is 'Robin'>>
            <<housekeeping 2>>
            <<set maplebirch.get('RobinTemple').faith += 1>>
            <<money 3000 'templeDuty'>>
          <<else>>
            <<historyskill 1>>
            <<mathsskill 1>>
            <<money 3500 'templeDuty'>>
          <</if>>
          <<grace 1>>
          <<stress -2>>
          <<npcincr _shiftName love 1>>
          <<goto 'Revelation Temple Companion Shift'>>
        <</if>>
      <</if>>
    <</lanLink>>
  <</capture>>
<</widget>>

<<widget 'temple-priest-recollection'>>
  <!-- 只回想本人亲自完成并报过的事，不让同伴知道未参与的面谈或仪式。 -->
  <<set _priest_name to _args[0]>>
  <<set _priest_deeds to $TempleDuties.candidates[_priest_name]?.deeds ?? []>>
  <<if !_priest_deeds.length or (_priest_name is 'Robin' ? maplebirch.get('RobinTemple')?.rank : $sydney?.rank) isnot 'priest'>><<exit>><</if>>
  <<set _priest_deed to _priest_deeds[Math.floor(Time.days) % _priest_deeds.length]>>
  <br><br>
  <<language>>
    <<option 'EN'>>
      <<if _priest_name is 'Robin'>>
        <<switch _priest_deed>>
          <<case 'rescue'>>
            Robin runs a hand over the folded blanket. "It was different, helping someone get out. I kept thinking about where we could take them."
          <<case 'evidence'>>
            "I went over the records I brought back," Robin says. "I was afraid I'd missed something. It's easier to find things now they're written down here."
          <<case 'ward'>>
            Robin looks towards the altar. "I still think about the part we took apart. I was glad when we could leave it behind."
        <</switch>>
        <<if C.npc.Robin.trauma gte 40>>
          <<nnpc_He 'Robin'>> rubs <<nnpc_his 'Robin'>> palms against the cloth. "I don't want to go back there today. These need doing too."
        <<elseif maplebirch.get('RobinTemple').faith gte 20>>
          "I prayed afterwards," <<nnpc_he 'Robin'>> says. "I didn't know what else to say. Just, thank you."
        <<elseif maplebirch.get('RobinTemple').faith lte -20>>
          "I don't know what the prayers changed. But I know we did something."
        <<elseif C.npc.Robin.dom gte 50>>
          "I'd check who was taking over first, next time. It doesn't have to be the same person doing everything."
        <<else>>
          "I used to think I'd only be in the way. I don't think that so much now."
        <</if>>
        <<if isLoveInterest('Robin')>>You sit close enough for <<nnpc_his 'Robin'>> shoulder to rest against yours.<<else>>You stay beside <<nnpc_him 'Robin'>> while <<nnpc_he 'Robin'>> finishes the fold.<</if>>
      <<else>>
        <<run statusCheck('Sydney')>>
        <<switch _priest_deed>>
          <<case 'rescue'>>
            Sydney pauses over the receipts. "At the time, all I could think about was getting that person out of danger. There was still so much to do once we had."
          <<case 'evidence'>>
            Sydney sets a finger beside the date in the book. "I still have my copy of the records we brought back. I know where to look if something doesn't match."
          <<case 'ward'>>
            Sydney looks up from the book. "I can still remember the part of the ritual we stopped. I don't think I'll mistake it if I see it again."
        <</switch>>
        <<if _sydneyStatus.includes('pure')>>"I'm glad Jordan trusted us to help. I want to be worthy of that."<<elseif _sydneyStatus.includes('corrupt')>>"A prayer wouldn't have put those things right by itself." <<nnpc_He 'Sydney'>> smooths the page. "Neither will sitting here admiring the title."<<else>>"I still have questions. At least now I know what to ask about."<</if>>
        <<if isLoveInterest('Sydney')>><<nnpc_His 'Sydney'>> fingers find yours beside the book before returning to the page.<<else>><<nnpc_He 'Sydney'>> turns the book so you can read the entry together.<</if>>
      <</if>>
    <<option 'CN'>>
      <<if _priest_name is 'Robin'>>
        <<switch _priest_deed>>
          <<case 'rescue'>>
            罗宾抚过叠好的毯子。“帮人脱离危险，感觉不太一样。我当时一直想着，接下来能把对方带到哪里。”
          <<case 'evidence'>>
            “带回来的记录，我又看了一遍。”罗宾说。“总怕漏了什么。现在记在这里，想找就方便些了。”
          <<case 'ward'>>
            罗宾望向祭坛。“我还会想起被拆掉的那一处。能离开那里时，真是松了口气。”
        <</switch>>
        <<if C.npc.Robin.trauma gte 40>>
          <<nnpc_He 'Robin'>>隔着毯子搓了搓掌心。“今天，我不想再去那里了。这里也还有事要做。”
        <<elseif maplebirch.get('RobinTemple').faith gte 20>>
          “后来，我祈祷了一会儿。”<<nnpc_he 'Robin'>>说。“也不知道说什么好。就说了，谢谢。”
        <<elseif maplebirch.get('RobinTemple').faith lte -20>>
          “我不知道祈祷改变了什么。不过，我知道，我们做了些事。”
        <<elseif C.npc.Robin.dom gte 50>>
          “下次，我会先问清谁来接班。总不能什么事，都让同一个人做。”
        <<else>>
          “以前，我总觉得自己只会碍手碍脚。现在，不太会那么想了。”
        <</if>>
        <<if isLoveInterest('Robin')>>你挪近些，让<<nnpc_his 'Robin'>>肩膀靠着你。<<else>>你留在身旁，等<<nnpc_he 'Robin'>>叠好手中的毯子。<</if>>
      <<else>>
        <<run statusCheck('Sydney')>>
        <<switch _priest_deed>>
          <<case 'rescue'>>
            悉尼在收据前停住。“当时，我只想着先让那人离开危险。接出来以后，才发现还有那么多事要做。”
          <<case 'evidence'>>
            悉尼把手指放在簿中的日期旁。“带回来的记录，我还留着副本。以后有对不上的地方，就知道该去哪里找了。”
          <<case 'ward'>>
            悉尼从书上抬起头。“我们阻止的那一处，我还记得。再看见的话，应该不会认错了。”
        <</switch>>
        <<if _sydneyStatus.includes('pure')>>“还好，约旦相信我们能帮上忙。我想对得起这份信任。”<<elseif _sydneyStatus.includes('corrupt')>>“光是祈祷，可不能把那些事弄妥。”<<nnpc_He 'Sydney'>>抚平书页。“坐在这里，想着司祭的头衔，也一样。”<<else>>“我还有些问题没弄明白。不过，至少知道，该问些什么了。”<</if>>
        <<if isLoveInterest('Sydney')>>书旁的手指轻轻碰过你的手，才回到页间。<<else>><<nnpc_He 'Sydney'>>转过簿子，方便你一起看。<</if>>
      <</if>>
  <</language>>
<</widget>>

:: Revelation Temple Sealed Note
<<temple-duty-place>>
<<if !_dutyOffice or !_bishopKnown or !$TempleDuties.enrolled
    or !['monk', 'priest'].includes($temple_rank)
    or ['refused', 'reported'].includes($TempleDuties.bishop)>>
  <<temple-duty-back>>
  <<exit>>
<</if>>
<<language>>
  <<option 'EN'>>
    A clerk hands you a folded note. You recognise the bishop's dark wax seal, though there is no signature. It asks you to compare the mark on the returned crate at the docks with the old relief records. "Make a separate copy of your findings for me, child. Keep Jordan's official report accurate."
    A smaller sheet gives the reply instructions: "Leave word with the clerk at the duties desk. When the copy is ready, bring it here. I will receive it as your confessor."
  <<option 'CN'>>
    侍从递给你一张折好的便条。上面没有署名，但你认得主教所用的深色蜡封。便条请你核对码头退回货箱上的标记与旧救济记录。“把查到的结果另抄一份给我，孩子。交给约旦的正式报告，仍要如实写。”
    里面夹着一张小纸，交代如何答复：“先把答复留给职务桌的侍从。副本备好后，也带到这里。我会以告解员的身份接收。”
<</language>>
<br><br>
<<if $TempleDuties.bishop isnot 'accepted'>>
  <<socialiseicon>>
  <<temple-duty-action `['Accept the bishop’s private request (0:05)', '答应替主教私下核对记录 (0:05)']` 5 'Revelation Temple Sealed Answer'>>
    <<set $TempleDuties.bishop to 'accepted'>>
    <<set $TempleDuties.note to 'bishop-accepted'>>
  <</temple-duty-action>>
  <br>
  <<refuseicon>>
  <<temple-duty-action `['Decline the private request (0:05)', '拒绝这份私下委托 (0:05)']` 5 'Revelation Temple Sealed Answer'>>
    <<set $TempleDuties.bishop to 'refused'>>
    <<set $TempleDuties.note to 'bishop-refused'>>
  <</temple-duty-action>>
  <br>
<<elseif !$TempleDuties.bishop_checked>>
  <span class='lblue'><<lanSwitch 'Read the old delivery records, resolve the returned-crate investigation and give Jordan a truthful report. Then compare the two in the old records room and make the separate copy.' '先查阅旧交货记录，完成货箱调查并向约旦如实汇报，再到旧资料室比对两份记录，抄出要交给主教的副本。'>></span><br>
  <<icon 'temple/records-room.png'>>
  <<lanLink ['Go to the records room', '前往资料室'] 'Temple Library'>>
  <</lanLink>>
  <br>
<<elseif $per_npc.bishop>>
  <<socialiseicon 'ask'>>
  <<temple-duty-action `['Give the sealed copy to the bishop waiting as a confessor (0:05)', '把密封副本交给以告解员身份等候的主教 (0:05)']` 5 'Revelation Temple Bishop'>>
    <<if $TempleDuties.bishop is 'accepted' and $TempleDuties.bishop_checked>>
      <<set $TempleDuties.bishop to 'reported'>>
      <<historyskill 3>>
    <</if>>
  <</temple-duty-action>>
  <br>
<<else>>
  <span class='lblue'><<lanSwitch 'The bishop is not here to receive the copy. Keep it sealed until you can hand it over.' '主教不在这里，暂时不能接收副本。你收好封好的副本，留待再次见面。'>></span><br>
<</if>>
<br>
<<temple-duty-back>>

:: Revelation Temple Sealed Answer
<<temple-duty-place>>
<<language>>
  <<option 'EN'>>
    <<switch $TempleDuties.note>>
      <<case 'bishop-accepted'>>
        You write that you will compare the records and give the reply to the clerk to pass on. Your original investigation report will stay in Jordan's duties book. The bishop will receive a separate copy of the comparison.
      <<case 'bishop-refused'>>
        You write that you will keep to your duties for Jordan. The clerk takes your reply to pass on. The private request is over; Jordan's assignments remain available.
      <<case 'bishop-checked'>>
        The old ledger gives the crate's weight and collection date, but the signature that should identify the collector is missing. You copy the mark and note the blank space. It leaves a gap in the shipment's history, not proof of who sent it. You seal the comparison, ready to take back to the duties desk.
    <</switch>>
  <<option 'CN'>>
    <<switch $TempleDuties.note>>
      <<case 'bishop-accepted'>>
        你写下答应核对记录的回信，交给侍从转交。原始调查报告仍留在约旦的职务簿里，交给主教的，是另外抄出的比对结果。
      <<case 'bishop-refused'>>
        你写明只接约旦交办的职务，把回信交给侍从转交。这份私下委托到此为止，职务簿里的工作仍照常交接。
      <<case 'bishop-checked'>>
        旧账簿写着货箱的重量和提货日期，确认提货者身份的签字处却是空的。你抄下标记，也注明缺了签字。货物经过了谁的手，记录在这里断了，还不能据此认定寄件人。你把比对结果封好，准备带回职务桌交付。
    <</switch>>
<</language>>
<br><br>
<<temple-duty-back>>

:: Revelation Temple Bishop
<<temple-duty-place>>
<<if $TempleDuties.bishop isnot 'reported' or !$per_npc.bishop>>
  <<temple-duty-back>>
  <<exit>>
<</if>>
<<loadNPC 0 'bishop'>>
<<person1>>
<<language>>
  <<option 'EN'>>
    The confessor waiting beside the duties desk is the bishop who sent the note. <<He>> takes you through a side door, then breaks the seal and reads your comparison. "You even noted what was missing. Most people prefer to fill the empty space."
    <<He>> folds the comparison into <<his>> robe. "Jordan needs to keep the storerooms safe and the accounts honest. I want to know whose hands that crate passed through." <<He>> pauses. "You promised me the comparison, child. Nothing more."
    The bishop opens the side door for you. You keep your own copy of the records and return to the duties desk.
  <<option 'CN'>>
    职务桌旁等候的告解员，正是送来便条的那位主教。<<He>>领你穿过侧门，拆开蜡封，低头读你的比对记录。“你连缺失的部分也记下了。多数人更喜欢把空白填满。”
    <<He>>把比对结果折进袍里。“约旦得确保储藏室安全，账目也不出差错。我想知道的，是那只货箱究竟经过了谁的手。”<<He>>停了一会儿。“孩子，你答应替我核对记录。仅此而已。”
    主教替你打开侧门。你收好自己留存的记录，回到职务桌。
<</language>>
<br><br>
<<temple-manor-offer>>
<br>
<<getouticon>>
<<lanLink ['Return through the side door', '从侧门返回'] 'Revelation Temple Office'>>
  <<endevent>>
<</lanLink>>
<br>

:: Revelation Temple Companion
<<temple-duty-place>>
<<temple-duty-pew-check $TempleDuties?.speaker>>
<<if !_pewReady>>
  <<lanSwitch 'The person you meant to speak to has another duty now. You can talk when you next meet here.' '你想交谈的人已经有了别的安排。下次在这里遇见时，可以再聊。'>><br><br>
  <<temple-duty-hall-back>>
  <<exit>>
<</if>>
<<npc `$TempleDuties.speaker`>>
<<person1>>
<<if $TempleDuties.speaker is 'Robin'>>
  <<language>>
    <<option 'EN'>>
      Robin rests a bundle of blankets against the pew.
      <<if C.npc.Robin.trauma gte 40>>
        "If something feels wrong, come back," <<he>> says. "Promise you won't push yourself."
      <<elseif C.npc.Robin.dom gte 50>>
        "Check your lamp before you go," <<he>> says, tugging the rope loose to look at its end. "Come back and tell me how it went."
      <<else>>
        "I can check the list with you," <<he>> offers. "It'll be quicker with two of us."
      <</if>>
      <<if maplebirch.get('RobinTemple').rank is 'priest'>>
        Robin opens the prayer book at a folded corner. "Someone asked for me today." <<if C.npc.Robin.dom gte 50>> <<He>> smiles. "I thought they'd mistaken me for someone else. But they stayed, so I stayed too."<<else>> <<He>> rubs the edge of the page. "I didn't know what to say at first. They mostly wanted someone to sit with them."<</if>>
      <<elseif $temple_rank is 'priest'>>
        "A priest," Robin repeats, smiling at you. <<if isLoveInterest('Robin')>>"Will you be much busier?" <<He>> moves the blankets aside to make room for you.<<else>>"Will you be leading the prayers? I'll listen out for you."<</if>>
      <</if>>
    <<option 'CN'>>
      罗宾把一捆毯子靠在长椅边。
      <<if C.npc.Robin.trauma gte 40>>
        “感觉不对就回来吧，”<<he>>说，“别硬撑着，好吗？”
      <<elseif C.npc.Robin.dom gte 50>>
        “出发前检查灯，”<<he>>说，把绳子松开，查看末端。“回来告诉我，事情怎么样了。”
      <<else>>
        “我可以和你核对清单，”<<he>>提议，“两个人总会快一点。”
      <</if>>
      <<if maplebirch.get('RobinTemple').rank is 'priest'>>
        罗宾翻到祷书折角的那一页。“今天有人找我。”<<if C.npc.Robin.dom gte 50>><<He>>笑了笑。“我还以为认错了人。可对方一直坐着，我也就留下来了。”<<else>><<He>>摩挲着书页边缘。“起初，我还不知道说什么。其实，对方只是想找人陪着坐一会儿。”<</if>>
      <<elseif $temple_rank is 'priest'>>
        “司祭啊。”罗宾望着你笑了。<<if isLoveInterest('Robin')>>“以后会忙很多吗？”<<He>>把毯子挪开，给你留出位置。<<else>>“以后会由你领着祈祷吗？我会留意的。”<</if>>
      <</if>>
  <</language>>
<<else>>
  <<run statusCheck('Sydney')>>
  <<language>>
    <<option 'EN'>>
      Sydney puts a bookmark between the pages.
      <<if _sydneyStatus.includes('pure')>>
        "You can hear the prayers from here," <<he>> says. <<He>> pauses until the voices in the hall reach the end of the verse, then adds the response under <<his>> breath.
      <<elseif _sydneyStatus.includes('corrupt')>>
        "If Jordan asks, we've been working very hard." <<He>> slides a neat stack of receipts towards you. "Which is true. I'd still like to finish before the next prayers."
      <<else>>
        "I found the missing receipt," <<he>> says, showing you the page. "It was tucked into a hymnbook. Will you help me put these in order?"
      <</if>>
      <<if $sydney.rank is 'priest'>>
        "Jordan asked me to lead the prayers." <<He>> smooths the marked page, though <<he>> has not needed to read it. "I've known the words for years. It feels different when everyone waits for me to begin."
      <<elseif $temple_rank is 'priest'>>
        "Congratulations." <<He>> smiles. <<if isLoveInterest('Sydney')>>"Should I be more respectful now?" <<He>> brushes your hand beneath the books.<<else>>"I'll see you at prayers, then."<</if>>
      <</if>>
    <<option 'CN'>>
      悉尼把书签夹进页间。
      <<if _sydneyStatus.includes('pure')>>
        “坐在这里，也能听见祈祷。”<<he>>停了一会儿，等大厅里的声音念完这一节，便轻声接上答词。
      <<elseif _sydneyStatus.includes('corrupt')>>
        “约旦要是问起，我们一直在认真干活。”<<He>>把整齐的一叠收据推给你。“本来就是。我还是想在下一次祈祷前弄完。”
      <<else>>
        “找到那张漏下的收据了。”<<he>>指给你看。“夹在赞美诗集里。能帮我把这些排好吗？”
      <</if>>
      <<if $sydney.rank is 'priest'>>
        “约旦让我领着祈祷。”<<He>>抚平做了标记的那页，却没有低头去读。“那些话，我早就背熟了。可是，所有人都等我先开口时，感觉不太一样。”
      <<elseif $temple_rank is 'priest'>>
        “恭喜。”<<He>>笑了。<<if isLoveInterest('Sydney')>>“以后是不是得对你恭敬一点？”<<He>>藏在书下的手轻轻碰过你的手。<<else>>“那么，祈祷时见。”<</if>>
      <</if>>
  <</language>>
<</if>>
<<temple-priest-recollection $TempleDuties.speaker>>
<<temple-pastoral-recollection $TempleDuties.speaker>>
<br><br>
<<temple-companion-check $TempleDuties.speaker 30>>
<<if _companionFree>>
  <<if $TempleDuties.speaker is 'Robin'>>
    <<temple-companion-shift `['Take the blanket handover with Robin (£30 0:30)', '和罗宾接一班毯子交接 (£30 0:30)']`>>
    <<ghousekeeping>>
    <<ggrace>>
    <<glove 'Robin'>>
    <<lstress>><br>
  <<else>>
    <<temple-companion-shift `['Check the archive receipts with Sydney (£35 0:30)', '和悉尼核对档案收据 (£35 0:30)']`>>
    <<ghistory>>
    <<gmaths>>
    <<ggrace>>
    <<glove 'Sydney'>>
    <<lstress>><br>
  <</if>>
<</if>>
<<getouticon>>
<<lanLink ['Return to the pew', '返回长椅'] `$TempleDuties.speaker is 'Robin' ? 'RobinTemple Prayer' : 'Temple Sydney'`>>
<</lanLink>><br>

:: Revelation Temple Companion Shift
<<temple-duty-place>>
<<set _dutyAid to maplebirch.get('Finance')?.donations?.state.aid?.temple>>
<<if $TempleDuties.duty_day isnot Math.floor(Time.days)
    or !['joint-Robin', 'joint-Sydney'].includes($TempleDuties.note)>>
  <<temple-duty-back>>
  <<exit>>
<</if>>
<<npc `$TempleDuties.speaker`>>
<<person1>>
<<if $TempleDuties.speaker is 'Sydney'>>
  <<run statusCheck('Sydney')>>
<</if>>
<<language>>
  <<option 'EN'>>
    <<if $TempleDuties.speaker is 'Robin'>>
      Robin unfolds the list before handing over the blankets. A visitor cannot remember the name on the request. <<if C.npc.Robin.trauma gte 40>><<He>> hesitates, then pulls a chair nearer. "You can sit while we find it."<<elseif C.npc.Robin.dom gte 50>>"One thing at a time," <<he>> says. "Tell us where you stayed last night."<<else>><<He>> checks the next name with you quietly before asking the visitor again.<</if>> You count the dry bundles while <<he>> listens. <<if _dutyAid?.signed_at != null>>The relief fund's signed receipt stays beside the distribution list; you check the bundles against it before passing them over.<<elseif Weather.precipitation is 'rain'>>Robin keeps the damp returns away from the dry bundles you have counted.<</if>> The missing name turns up on the back of the page. <<if $RobinTemple.service gte 10>>Robin points it out before the visitor has finished. "Here. The next shift should know to check both sides."<<else>>"I would have rushed past that," Robin admits.<</if>> <<He>> checks the clock before you both leave the signed handover. Jordan has set your pay beside it.
    <<else>>
      Sydney sets the old receipt beside the new entry and asks you to read the names back. <<if _sydneyStatus.includes('pure')>><<He>> apologises when a page sticks, then smooths it carefully before continuing. "They should be able to find their own name."<<elseif _sydneyStatus.includes('corrupt')>>"A heroic account, three spelling mistakes," <<he>> murmurs. The smile fades when <<he>> finds the wrong collection date. "That part needs fixing."<<else>><<He>> traces the collection date with a finger, then checks it against the other receipt. "These are a day apart."<</if>> <<if _roofReady and _shelvesReady>>Sydney sends an initiate to the numbered shelf for the matching receipt. "Let them find it," <<he>> says quietly. You check the date while the initiate reads back the amount.<<else>>You hold the loose pages apart while Sydney compares the faint figures. <<He>> leaves a separate note where the damaged original cannot be read.<</if>> Sydney closes the book and glances towards the hall before the next duty. Jordan signs the corrected receipt and leaves your pay with the clerk.
    <</if>>
  <<option 'CN'>>
    <<if $TempleDuties.speaker is 'Robin'>>
      交出毯子前，罗宾先展开名单。一名访客想不起申请时写下的名字。<<if C.npc.Robin.trauma gte 40>><<He>>迟疑了一下，把椅子拉近。“找的时候，你可以先坐着。”<<elseif C.npc.Robin.dom gte 50>>“一件件来，”<<he>>说，“先告诉我们，昨晚住在哪里。”<<else>><<He>>低声与你核对下一个名字，再问访客一遍。<</if>>你清点干毯子，<<he>>听对方说。<<if _dutyAid?.signed_at != null>>救济基金的签收单就放在分发名单旁，你对照捆包核过一遍，才交出去。<<elseif Weather.precipitation is 'rain'>>罗宾把送回来的湿毯子分开放好，没有混进你数过的干毯子里。<</if>>漏掉的名字就在纸背面。<<if $RobinTemple.service gte 10>>没等访客说完，罗宾便指给对方看。“在这里。得告诉下一班，两面都要看。”<<else>>“我可能会急着翻过去。”罗宾承认。<</if>>留下签好的交接记录前，<<he>>看了一眼钟。约旦已经把你的报酬放在旁边。
    <<else>>
      悉尼把旧收据放在新记录旁，请你读回名字。<<if _sydneyStatus.includes('pure')>>一页纸粘住了，<<he>>先道歉，再仔细展平。“他们也该找得到自己的名字。”<<elseif _sydneyStatus.includes('corrupt')>>“一份英勇的记录，三个错字。”<<he>>低声说。发现收货日期不对时，笑容便收起来了。“这里得改。”<<else>><<He>>用手指划过收货日期，又看向另一张收据。“差了一天。”<</if>><<if _roofReady and _shelvesReady>>悉尼请一名见习教徒去编号书架找收据。“让对方找找看。”<<he>>低声说。见习教徒读回金额，你核对日期。<<else>>你分开散页，悉尼比对褪色的数字。原稿损坏到读不清的地方，<<he>>另外留了说明。<</if>>悉尼合上簿子，在下项事务前望了望大厅。约旦在更正的收据上签字，把你的报酬交给侍从。
    <</if>>
<</language>>
<<ggrace>>
<<lstress>>
<<glove `$TempleDuties.speaker`>>
<br><br>
<<temple-duty-rest-link>>
<<temple-duty-back>>
