:: Temple Ordinand Widgets [widget]
<<widget 'temple-companion-time'>>
  <<silently>>
    <<set $_templeCompanionName to _args[0]>>
    <<set $_templeCompanionMinutes to _args[1] ?? 0>>
    <<set $_templeCompanionEnd to new DateTime(Time.date).addMinutes($_templeCompanionMinutes)>>
    <<set _templeCompanionTime to Number.isFinite($_templeCompanionMinutes) and $_templeCompanionMinutes gte 0
      and $_templeCompanionEnd.hour lt 18 and !['night', 'dusk'].includes($_templeCompanionEnd.dayState)
      and !(Time.weekDay is 1 and Time.hour lt 11 and $_templeCompanionEnd.hour gte 11)
      and !($englishPlay is 'ongoing' and $englishPlayDays is 0
        and Time.hour lt 17 and $_templeCompanionEnd.hour gte 17)>>
    <<if $_templeCompanionName is 'Sydney' and Time.hour lt 16
        and $_templeCompanionEnd.hour gte 16 and $adultshophelped isnot 1>>
      <<set _templeCompanionTime to _templeCompanionTime and Time.weekDay isnot 6
        and !($adultshopunlocked and (Time.weekDay is 4 and C.npc.Sydney.corruption gt 10
          or Time.weekDay is 5 and C.npc.Sydney.corruption gt 20))>>
    <</if>>
    <<set $_templeCompanionOutings to maplebirch.get('Finance')?.realEstate.outings>>
    <<set $_templeCompanionRide to maplebirch.get('Transport')?.state.commute>>
    <<if $_templeCompanionOutings?.live and $_templeCompanionOutings.plan?.name is $_templeCompanionName
        and ($_templeCompanionOutings.travelling or $_templeCompanionOutings.plan.stage is 'booked'
          and $_templeCompanionOutings.plan.at lte $_templeCompanionEnd.timeStamp)
        or $_templeCompanionRide?.npc is $_templeCompanionName and $_templeCompanionRide.boarded and !$_templeCompanionRide.arrived>>
      <<set _templeCompanionTime to false>>
    <</if>>
  <</silently>>
<</widget>>

<<widget 'temple-candidate-check'>>
  <<silently>>
    <<set $_candidateName to _args[0]>>
    <<set _candidate to $TempleDuties.candidates[$_candidateName]>>
    <<set _candidateRank to $_candidateName is 'Robin' ? maplebirch.get('RobinTemple')?.rank : $sydney?.rank>>
    <<set _candidatePresent to false>>
    <<set _candidateStanding to false>>
    <<set _candidateWilling to true>>
    <<if $_candidateName is 'Robin'>>
      <<set _candidatePresent to Boolean(maplebirch.get('RobinTemple')?.available) and getRobinLocation() is 'temple'>>
      <<set _candidateStanding to Boolean(maplebirch.get('RobinTemple')?.member)
        and !maplebirch.get('RobinTemple').examinationDue and !$RobinTemple.punish
        and C.npc.Robin.virginity.temple is true>>
      <<set _candidateWilling to maplebirch.get('RobinTemple')?.faith gte 20 and C.npc.Robin.trauma lt 60>>
    <<elseif $_candidateName is 'Sydney'>>
      <<sydneySchedule>>
      <<set _candidatePresent to C.npc.Sydney.init is 1 and C.npc.Sydney.state is 'active'
        and _sydney_location is 'temple' and $sydney_templeWork isnot 'mass'>>
      <<set _candidateStanding to $daily.sydney.punish isnot 1 and C.npc.Sydney.virginity.temple is true>>
    <</if>>
    <<temple-companion-time $_candidateName `_args[1] ?? 0`>>
    <<set _candidateFree to _dutyOffice and _candidatePresent and _candidateStanding
      and _candidateWilling and _candidateRank is 'monk' and _templeCompanionTime>>
    <<if $_candidateName is 'Robin' and (_args[1] ?? 0) gt 0
        and maplebirch.get('RobinTemple')?.templeTime and Time.weekDay isnot 1>>
      <<set _candidateFree to _candidateFree and Time.hour * 60 + Time.minute + (_args[1] ?? 0) lt 16 * 60>>
    <</if>>
    <<set _candidateReady to _candidateFree and _candidate.agreed and _candidate.reviewed
      and _candidate.lessons.includes('care') and _candidate.lessons.includes('wards')>>
  <</silently>>
<</widget>>

<<widget 'temple-ordination-roster'>>
  <<if $TempleDuties.party.length>>
    <<socialiseicon>>
    <<lanLink ['Cancel all invitations', '取消所有邀请']>>
      <<set $TempleDuties.party to []>>
      <<replace '#temple-ordination-roster'>>
        <<temple-ordination-roster>>
      <</replace>>
    <</lanLink>>
    <br>
  <</if>>
  <<for _ordinand range ['Robin', 'Sydney']>>
    <<temple-candidate-check _ordinand 25>>
    <<if _candidateReady>>
      <<capture _ordinand>>
        <<socialiseicon>>
        <<lanLink `[$TempleDuties.party.includes(_ordinand) ? 'Cancel invitation: ' + maplebirch.auto(_ordinand) : 'Invite ' + maplebirch.auto(_ordinand) + ' to the appointment ceremony', $TempleDuties.party.includes(_ordinand) ? '取消对' + maplebirch.auto(_ordinand) + '的邀请' : '邀请' + maplebirch.auto(_ordinand) + '参加任命仪式']`>>
          <<if $TempleDuties.party.includes(_ordinand)>>
            <<run $TempleDuties.party.delete(_ordinand)>>
          <<else>>
            <<run $TempleDuties.party.pushUnique(_ordinand)>>
          <</if>>
          <<replace '#temple-ordination-roster'>>
            <<temple-ordination-roster>>
          <</replace>>
        <</lanLink>>
        <<if $TempleDuties.party.includes(_ordinand)>>
          <span class='teal'><<lanSwitch ' · Invited' ' · 已邀请'>></span>
        <</if>>
        <br>
      <</capture>>
    <</if>>
  <</for>>
  <<set _ordinationReady to $TempleDuties.party.length gt 0
        and (_dutyReady and $TempleDuties.review and ['care', 'obedience'].includes($TempleDuties.oath)
    or $temple_rank is 'priest' and $temple_chastity_timer gt 0 and $player.virginity.temple is true)>>
  <<for _ordinand range $TempleDuties.party>>
    <<temple-candidate-check _ordinand `340 + 20 * ($TempleDuties.party.length + ($temple_rank is 'monk' ? 1 : 0))`>>
    <<if !_candidateReady>>
      <<set _ordinationReady to false>>
    <</if>>
  <</for>>
  <<if _ordinationReady>>
    <br>
    <<templeicon 'altar'>>
    <<lanSwitch 'Allow six to seven hours together. Jordan has checked that no school, service or other duty is due during that time.' '请一起留出六至七小时。约旦已经核对过，这段时间不会赶上上课、弥撒或别的职务。'>><br>
    <<lanLink ['Prepare for ordination together', '一起准备接受授职考验']>>
      <<set _ordination_party to clone($TempleDuties.party)>>
      <<if $temple_rank is 'monk'>><<run _ordination_party.unshift('Player')>><</if>>
      <<temple-ordination-start _ordination_party>>
      <<if $TempleDuties.ordination>><<goto 'Revelation Temple Ordination'>><</if>>
    <</lanLink>>
    <br>
  <<else>>
    <span class='lblue'><<lanSwitch 'Invite a companion who has completed the interview. Allow six to seven hours before their next duty; the ordination cannot replace school or mass.' '先邀请已完成面谈的同伴。授职需要六至七小时，应避开上课、弥撒和对方的下一项职务。'>></span><br>
  <</if>>
<</widget>>

:: Revelation Temple Candidates
<<temple-duty-place>>
<<if !_dutyOffice or !$TempleDuties.enrolled
    or !['monk', 'priest'].includes($temple_rank)>>
  <<temple-duty-hall-back>>
  <<exit>>
<</if>>
<<npc Jordan>>
<<person1>>
<<language>>
  <<option 'EN'>>
    Jordan sets the candidates' book beside the prayers. "They can join us here, if they wish. There's always someone glad of another pair of hands." <<He>> turns a blank page. "I'd like to speak with them about the priesthood myself."
  <<option 'CN'>>
    约旦把候任名册放在祷文旁。“他们愿意的话，也可以来帮忙。这里总有人需要搭把手。”<<He>>翻到空白的一页。“司祭的事，我也想亲自和他们谈谈。”
<</language>>
<br><br>
<<set _ordinandList to ['Robin', 'Sydney']>>
<<for _ordinand range _ordinandList>>
  <<temple-candidate-check _ordinand 15>>
  <<if _candidateRank is 'monk' or _candidate.agreed>>
    <<capture _ordinand>>
      <<revelation-card `maplebirch.auto(_ordinand)` `maplebirch.auto(_ordinand)`>>
        <<if _candidateRank is 'priest'>>
          <span class='teal'><<temple_title _ordinand>></span><br>
        <<elseif _candidateRank isnot 'monk'>>
          <span class='lblue'><<lanSwitch 'They have not taken the vigil yet. Companions can prepare for the appointment only after becoming a monk or nun themselves.' '对方还没有完成守夜试炼。同伴先成为修士或修女，才能准备司祭任命。'>></span><br>
        <<elseif !_candidatePresent>>
          <<lanSwitch 'Continue the preparation when your companion is at the temple and has time free from other duties.' '等同伴回到神殿，并且有空参加见习时，再继续准备。'>><br>
        <<elseif !_candidateStanding>>
          <<if _ordinand is 'Robin' and !$RobinTemple.punish and !maplebirch.get('RobinTemple').examinationDue>>
            <span class='lblue'><<lanSwitch 'Robin\'s temple vow is broken. Resolve this with the temple before applying for appointment.' '罗宾的神殿誓言已被打破。请先处理誓言问题，再来申请任职。'>></span><br>
          <<else>>
            <span class='lblue'><<lanSwitch 'Complete your companion\'s outstanding temple examination or purification before applying for appointment.' '请先完成同伴尚未处理的神殿检查或净化，再来申请任职。'>></span><br>
          <</if>>
          <<if _ordinand is 'Robin' and $RobinTemple.punish>>
            <<templeicon 'altar'>><<lanLink ['Continue the purification', '继续净化'] `$RobinTemple.punish.started ? 'RobinTemple Penance Trial' : 'RobinTemple Penance'`>><</lanLink>><br>
          <<elseif _ordinand is 'Robin' and maplebirch.get('RobinTemple').examinationDue>>
            <span class='lblue'><<lanSwitch 'Robin is due for an examination in the main hall.' '罗宾需要在大厅接受检查。'>></span><br>
          <</if>>
        <<elseif !_candidate.agreed>>
          <<socialiseicon 'ask'>>
          <<lanLink `['Ask ' + maplebirch.auto(_ordinand) + ' about becoming a priest', '问' + maplebirch.auto(_ordinand) + '愿不愿意成为司祭']` 'Revelation Temple Candidate Talk'>>
            <<set $TempleDuties.speaker to _ordinand>>
          <</lanLink>>
          <br>
        <<elseif !_candidateWilling>>
          <<socialiseicon 'ask'>>
          <<lanLink ['Talk about continuing the preparation', '谈谈是否继续准备'] 'Revelation Temple Candidate Talk'>>
            <<set $TempleDuties.speaker to _ordinand>>
          <</lanLink>>
          <br>
        <<else>>
          <<for _lesson range ['care', 'wards']>>
            <<capture _lesson>>
              <<if !_candidate.lessons.includes(_lesson)>>
                <<temple-candidate-check _ordinand 30>>
                <<if _candidateFree>>
                  <<if _lesson is 'wards'>><<icon 'temple/ward-stone.png'>><<else>><<templeicon 'pray'>><</if>>
                  <<temple-duty-action `[_lesson is 'care' ? 'Pray together and hear a parishioner seeking help (0:30)' : 'Inspect the garden wards with an older priest (0:30)', _lesson is 'care' ? '一起祈祷，接待前来求助的教徒 (0:30)' : '陪资深司祭巡查花园围墙的护符 (0:30)']` 30 'Revelation Temple Candidate Practice' `_ordinand`>>
                    <<if !$TempleDuties.candidates[_ordinand].lessons.includes(_lesson)>>
                      <<run $TempleDuties.candidates[_ordinand].lessons.push(_lesson)>>
                      <<set $TempleDuties.speaker to _ordinand>>
                      <<set $TempleDuties.exercise to _lesson>>
                      <<grace 1>>
                    <</if>>
                  <</temple-duty-action>>
                  <<ggrace>><br>
                <</if>>
              <<else>>
                <span class='teal'><<lanSwitch `_lesson is 'care' ? 'Prayers and parishioner reception completed.' : 'Garden ward inspection completed.'` `_lesson is 'care' ? '已完成祈祷与接待教徒的见习。' : '已完成花园护符巡查。'`>></span><br>
              <</if>>
            <</capture>>
          <</for>>
          <<temple-candidate-check _ordinand 15>>
          <<if _candidate.lessons.includesAll('care', 'wards') and _candidate.trial_day gte 0 and !_candidate.reviewed and _candidateFree>>
            <<socialiseicon 'ask'>>
            <<temple-duty-action `['Accompany ' + maplebirch.auto(_ordinand) + ' to the appointment interview (0:15)', '陪' + maplebirch.auto(_ordinand) + '参加任职面谈 (0:15)']` 15 'Revelation Temple Candidate Review' `_ordinand`>>
              <<if $TempleDuties.candidates[_ordinand].agreed
                  and $TempleDuties.candidates[_ordinand].lessons.includesAll('care', 'wards')
                  and $TempleDuties.candidates[_ordinand].trial_day gte 0>>
                <<set $TempleDuties.speaker to _ordinand>>
                <<set $TempleDuties.candidates[_ordinand].reviewed to true>>
              <</if>>
            <</temple-duty-action>>
            <br>
          <<elseif _candidate.lessons.includesAll('care', 'wards') and _candidate.trial_day lt 0 and !_candidate.reviewed>>
            <span class='lblue'><<lanSwitch 'Invite your companion on the warehouse or woodland assignment. Give them the chance to help with a rescue, bring back evidence or break a dangerous ritual arrangement, then tell Jordan what they actually did.' '接下仓库或林中的委托时，可以邀请同伴同行。遇到救助、取证或处理危险仪式布置的事，让对方实际参与，再向约旦说明各自做过什么。'>></span><br>
          <<elseif _candidate.reviewed>>
            <span class='green'><<lanSwitch 'Your companion has passed Jordan\'s appointment interview. When you are ready, go to the hall altar for the appointment ceremony.' '同伴已通过约旦的任职面谈。准备好后，到大厅祭坛前参加任命仪式。'>></span><br>
          <</if>>
          <<if !_candidateFree>>
            <span class='lblue'><<lanSwitch 'Leave time before the next duty or service.' '为下一项职务或弥撒留足时间。'>></span><br>
          <</if>>
        <</if>>
      <</revelation-card>>
    <</capture>>
  <</if>>
<</for>>
<<if $temple_rank is 'priest'>>
  <<templeicon 'altar'>>
  <<lanLink ['Attend companions\' appointment', '陪同参加任命仪式'] 'Revelation Temple Shared Oath'>>
  <</lanLink>>
  <br>
<</if>>
<br>
<<temple-duty-hall-back>>

:: Revelation Temple Candidate Talk
<<temple-duty-place>>
<<temple-candidate-check $TempleDuties.speaker 15>>
<<if _dutySafe isnot true or !_candidatePresent or _candidateRank isnot 'monk'>>
  <<temple-duty-hall-back>>
  <<exit>>
<</if>>
<<npc `$TempleDuties.speaker`>>
<<person1>>
<<if $TempleDuties.speaker is 'Robin'>>
  <<language>>
    <<option 'EN'>>
      Robin touches the edge of the prayer book.
      <<if C.npc.Robin.trauma gte 60>>
        "I don't think I can. Not yet." <<He>> closes the book when footsteps approach the pew. "Can we talk about something else?"
      <<elseif maplebirch.get('RobinTemple').faith lt 20>>
        "I like helping here. But leading prayers? I don't know if I believe enough to mean them." <<He>> watches your face. "Could we keep praying together first?"
      <<elseif C.npc.Robin.dom gte 60>>
        "I could do that." <<He>> turns the book over. "You won't have to do everything on your own. Shall we ask Jordan?"
      <<else>>
        "Me? A priest?" <<He>> looks down at the book, then back at you. "Do you really think I could? I'd like to try. Will you come with me?"
      <</if>>
      <<if maplebirch.get('Robin') and $RobinExpansion?.shop>>
        "I'd still have to get back to the shop," <<he>> adds, checking the time.
      <<else>>
        <<He>> tucks <<his>> schoolwork beneath the prayer book. "I'd have to finish this first."
      <</if>>
    <<option 'CN'>>
      罗宾摸着祷书的边缘。
      <<if C.npc.Robin.trauma gte 60>>
        “我想，我还不行。”有人走近长椅，<<he>>合上了书。“我们能聊点别的吗？”
      <<elseif maplebirch.get('RobinTemple').faith lt 20>>
        “我喜欢在这里帮忙。可是带人祈祷……我不知道自己是不是足够相信，才能真心说出那些话。”<<He>>望着你。“我们先继续一起祈祷，好吗？”
      <<elseif C.npc.Robin.dom gte 60>>
        “我可以试试。”<<He>>翻过书。“也不能什么都让你一个人来。去问问约旦？”
      <<else>>
        “我？当司祭？”<<He>>低头看看书，又望向你。“你真的觉得我能行？我想试试。你会陪我吗？”
      <</if>>
      <<if maplebirch.get('Robin') and $RobinExpansion?.shop>>
        “我还得赶回去照看店铺，”<<he>>看了眼时间，又补充道。
      <<else>>
        <<He>>把学校作业压在祷书下面。“不过，得先把这些写完。”
      <</if>>
  <</language>>
<<else>>
  <<run statusCheck('Sydney')>>
  <<language>>
    <<option 'EN'>>
      Sydney traces a familiar line in the prayer book.
      <<if _sydneyStatus.includes('pure')>>
        "I'd like that. I've been coming here for so long." <<He>> smiles towards the altar. "Do you think Jordan would agree?"
      <<elseif _sydneyStatus.includes('corrupt')>>
        "Priest Sydney. How does that sound?" <<He>> tries to keep a straight face, then laughs. "I should ask Jordan before I get used to it."
      <<else>>
        "I hadn't thought about it." <<He>> looks towards the altar. "I do like being here. Perhaps we could ask Jordan."
      <</if>>
      <<if isLoveInterest('Sydney')>>"Especially if you're coming with me." <<He>> glances at you, cheeks warming.<</if>>
    <<option 'CN'>>
      悉尼沿着祷书里熟悉的一行字，慢慢划过手指。
      <<if _sydneyStatus.includes('pure')>>
        “我愿意。我来这里已经这么久了。”<<He>>朝祭坛微笑。“你觉得约旦会答应吗？”
      <<elseif _sydneyStatus.includes('corrupt')>>
        “悉尼司祭。听起来怎么样？”<<He>>试着板起脸，随后笑出了声。“趁还没叫顺口，得先问问约旦。”
      <<else>>
        “我还没想过。”<<He>>望向祭坛。“不过，我确实喜欢待在这里。也许可以问问约旦。”
      <</if>>
      <<if isLoveInterest('Sydney')>>“你也陪着的话，就更好了。”<<He>>朝你瞥了一眼，脸颊渐渐红了。<</if>>
  <</language>>
<</if>>
<br><br>
<<if _candidateFree>>
  <<socialiseicon>>
  <<temple-duty-action `['Offer to prepare together (0:15)', '提议一起准备任职 (0:15)']` 15 'Revelation Temple Candidates' `$TempleDuties.speaker`>>
    <<set $TempleDuties.candidates[$TempleDuties.speaker].agreed to true>>
  <</temple-duty-action>>
  <br>
<</if>>
<<refuseicon>>
<<lanLink ['Leave the appointment for now', '暂时放下任职的事'] 'Temple'>>
  <<set $TempleDuties.candidates[$TempleDuties.speaker].agreed to false>>
<</lanLink>>
<br>

:: Revelation Temple Candidate Practice
<<temple-duty-place>>
<<temple-candidate-check $TempleDuties.speaker 0>>
<<if !_candidatePresent or !$TempleDuties.candidates[$TempleDuties.speaker].agreed>>
  <<temple-duty-hall-back>>
  <<exit>>
<</if>>
<<npc `$TempleDuties.speaker`>>
<<person1>>
<<language>>
  <<option 'EN'>>
    <<if $TempleDuties.exercise is 'care'>>
      Incense drifts through the chapel. You and your companion recite the prayer together, facing the many-winged angel above the altar. After the others leave, a visitor remains on the pew, hands clasped tightly.
      <<if $TempleDuties.speaker is 'Robin'>>
        <<if C.npc.Robin.trauma gte 40>>Robin sits beside you, letting the visitor speak before quietly offering a cushion.<<elseif C.npc.Robin.dom gte 60>>Robin moves a cushion along the bench. "Here. There's room." <<He>> sits down with the visitor.<<else>>Robin moves a cushion along the bench and sits down to listen.<</if>> When the visitor asks where they can eat tonight, <<he>> looks towards the soup kitchen. The priest nods and tells them when it opens.
      <<else>>
        <<run statusCheck('Sydney')>>
        Sydney sits beside the visitor. <<if _sydneyStatus.includes('pure')>>"You can tell us," <<he>> says. "You're welcome here." <<He>> listens, then joins the priest in a prayer for them.<<elseif _sydneyStatus.includes('corrupt')>>"It's not another examination," <<he>> says, with a small smile. "You can breathe." When the visitor begins to speak, <<he>> grows quiet and listens.<<else>>Sydney offers the visitor a prayer book, then waits when they shake their head. "That's all right. What did you want to talk about?"<</if>>
      <</if>>
      The visitor stays after the prayer. The priest brings another cushion, and you sit with them a little longer.
    <<else>>
      The priest leads you along the garden wall, comparing the worn wards with an older pattern. One ward has curled up at a damp corner. The priest holds the pattern while your companion repairs the damaged ward, then burns incense beneath the stone angel.
      <<if $TempleDuties.speaker is 'Robin'>>
        <<if C.npc.Robin.trauma gte 40>>Robin avoids a root pushing through the mortar. "That's just a root, isn't it?"<<elseif C.npc.Robin.dom gte 60>>Robin points out a root pushing through the mortar before anyone steps across it. "Mind that."<<else>>Robin pauses at a root pushing through the mortar and follows it with <<his>> eyes towards the wall.<</if>> The priest holds the lamp closer, then leaves fresh incense beside it.
      <<else>>
        Sydney knows the path without looking. <<run statusCheck('Sydney')>><<if _sydneyStatus.includes('pure')>><<He>> kneels beside the stone angel while the priest lights the incense.<<elseif _sydneyStatus.includes('corrupt')>>"I always wondered why this corner smelled so strongly." <<He>> leans closer to the repaired ward, then draws back at the priest's glance.<<else>><<He>> holds the loose edge of the ward in place while the priest fastens it.<</if>>
      <</if>>
      You return through the garden gate together. The priest carries the old ward inside; your companion brings the lamp.
    <</if>>
  <<option 'CN'>>
    <<if $TempleDuties.exercise is 'care'>>
      礼拜堂里飘着焚香的烟雾。你和同伴面向祭坛上多翼的天使，一起念诵祷文。其他人离开后，一名访客仍坐在长椅上，双手紧紧交握。
      <<if $TempleDuties.speaker is 'Robin'>>
        <<if C.npc.Robin.trauma gte 40>>罗宾坐在你旁边，等访客开口，才轻轻递去一只软垫。<<elseif C.npc.Robin.dom gte 60>>罗宾挪了挪长椅上的软垫。“这里。还有地方。”<<He>>在访客身边坐下。<<else>>罗宾挪了挪长椅上的软垫，坐下来听对方诉说。<</if>>访客问起今晚能去哪里吃饭时，<<he>>看向施粥所。司祭点了点头，告诉对方开放的时间。
      <<else>>
        <<run statusCheck('Sydney')>>
        悉尼在访客身边坐下。<<if _sydneyStatus.includes('pure')>>“可以告诉我们，”<<he>>说，“这里欢迎你。”<<He>>听对方说完，随后与司祭一起为对方祈祷。<<elseif _sydneyStatus.includes('corrupt')>>“又不是来做检查的，”<<he>>微微一笑，“先喘口气。”访客开始说话，<<he>>便安静下来听着。<<else>>悉尼递过一本祷书，见对方摇头，又放了回去。“没关系。你想聊些什么？”<</if>>
      <</if>>
      祷告结束，访客仍坐在原处。司祭又拿来一只软垫，你们陪对方多坐了一会儿。
    <<else>>
      司祭领你们沿花园围墙巡视，把磨损的护符与旧图样逐一比对。其中一张护符受了潮，边角已经翘起。司祭拿稳旧图样，让同伴照着修补墙上的护符，随后在石刻天使下焚香。
      <<if $TempleDuties.speaker is 'Robin'>>
        <<if C.npc.Robin.trauma gte 40>>罗宾绕开一根挤进灰缝的树根。“那只是树根，对吧？”<<elseif C.npc.Robin.dom gte 60>>罗宾先指了指挤进灰缝的树根。“小心那里。”<<else>>罗宾在挤进灰缝的树根前停下，目光沿着它望向围墙。<</if>>司祭将灯举近，随后在根旁留下新香。
      <<else>>
        悉尼不用看也认得小路。<<run statusCheck('Sydney')>><<if _sydneyStatus.includes('pure')>>司祭点燃熏香时，<<he>>在石刻天使旁跪下。<<elseif _sydneyStatus.includes('corrupt')>>“我一直好奇，这一角怎么总是这么香。”<<He>>凑近修补过的护符，司祭看了<<him>>一眼，<<he>>又退开了。<<else>>司祭固定护符时，<<he>>帮忙按住松开的边角。<</if>>
      <</if>>
      你们一起从花园门返回。司祭将旧护符带进屋，同伴提着灯跟上。
    <</if>>
<</language>>
<br><br>
<<temple-candidates-back>>

:: Revelation Temple Candidate Review
<<temple-duty-place>>
<<temple-candidate-check $TempleDuties.speaker 0>>
<<if !_candidateFree or !_candidate.reviewed>>
  <<temple-duty-hall-back>>
  <<exit>>
<</if>>
<<npc Jordan>>
<<person1>>
<<language>>
  <<option 'EN'>>
    Jordan asks you to let your companion answer. "What did you do when you went out to help?"
    <<if $TempleDuties.speaker is 'Robin'>>
      <<if _candidate.deeds?.includes('rescue')>>Robin describes helping the rescued person out and making sure somebody stayed with them.<<elseif _candidate.deeds?.includes('ward')>>Robin describes the dangerous arrangement you found and the part <<nnpc_he 'Robin'>> helped dismantle.<<elseif _candidate.deeds?.includes('evidence')>>Robin tells Jordan about the records <<nnpc_he 'Robin'>> brought back.<<else>>Robin gives <<nnpc_his 'Robin'>> own account of the duties <<nnpc_he 'Robin'>> has carried out.<</if>> <<if C.npc.Robin.trauma gte 40>>"I was glad there was something I could do."<<elseif C.npc.Robin.dom gte 60>>"Somebody had to do it. I could do that much."<<else>>"I didn't want to leave it all to somebody else."<</if>> Jordan listens, then asks Robin if <<nnpc_he 'Robin'>> wishes to continue serving here.
    <<else>>
      <<run statusCheck('Sydney')>>
      <<if _candidate.deeds?.includes('evidence')>>Sydney opens the records <<nnpc_he 'Sydney'>> brought back and points out what did not match.<<elseif _candidate.deeds?.includes('ward')>>Sydney describes the ritual arrangement <<nnpc_he 'Sydney'>> helped break, following its lines on a scrap of paper.<<elseif _candidate.deeds?.includes('rescue')>>Sydney tells Jordan how the rescued person reached safety and who stayed with them.<<else>>Sydney gives <<nnpc_his 'Sydney'>> own account of the duties <<nnpc_he 'Sydney'>> has carried out.<</if>> <<if _sydneyStatus.includes('pure')>>"It wasn't right. I wanted you to know."<<elseif _sydneyStatus.includes('corrupt')>>"I wasn't going to take their word for it."<<else>>"We both noticed it. I thought we should tell you."<</if>> Jordan asks a few questions, and Sydney answers in <<nnpc_his 'Sydney'>> own words.
    <</if>>
    When the questions turn to keeping the vows, your companion answers without looking to you.
  <<option 'CN'>>
    约旦示意你让同伴自己回答。“出去帮忙时，你做了什么？”
    <<if $TempleDuties.speaker is 'Robin'>>
      <<if _candidate.deeds?.includes('rescue')>>罗宾讲起怎样将获救者接出来，又怎样确认对方有人照料。<<elseif _candidate.deeds?.includes('ward')>>罗宾说起当时危险的布置，以及自己帮忙拆开的那一处。<<elseif _candidate.deeds?.includes('evidence')>>罗宾说明自己带回了哪些记录。<<else>>罗宾亲口说明自己做过的职务。<</if>><<if C.npc.Robin.trauma gte 40>>“知道自己还能做点什么，我就放心些了。”<<elseif C.npc.Robin.dom gte 60>>“总得有人做这件事。这个我能做。”<<else>>“我不想把事情全留给别人。”<</if>>约旦听完，问罗宾是否愿意继续在这里侍奉。
    <<else>>
      <<run statusCheck('Sydney')>>
      <<if _candidate.deeds?.includes('evidence')>>悉尼展开带回的记录，指出其中不符的地方。<<elseif _candidate.deeds?.includes('ward')>>悉尼在一小片纸上比画，说明自己怎样帮忙破坏了仪式的布置。<<elseif _candidate.deeds?.includes('rescue')>>悉尼讲起获救者怎样到了安全处，又由谁留下照料。<<else>>悉尼亲口说明自己做过的职务。<</if>><<if _sydneyStatus.includes('pure')>>“那是不对的。我想，应该让你知道。”<<elseif _sydneyStatus.includes('corrupt')>>“我可不会照单全信。”<<else>>“我们都发现了。我想，应该回来告诉你。”<</if>>约旦又问了几句，悉尼自己一一回答。
    <</if>>
    问到是否愿意继续守誓时，同伴没有再看向你，便给出了回答。
<</language>>
<br><br>
<<temple-candidates-back>>

:: Revelation Temple Shared Oath
<<temple-duty-place>>
<<if $TempleDuties.ordination and $TempleDuties.ordination.stage isnot 'complete'>>
  <<lanSwitch 'Jordan has kept your place in the ordination. The book is still open at the unfinished prayer.' '约旦留着你在授职考验中的位置。祷书仍摊在尚未完成的那一段。'>><br><br>
  <<templeicon 'altar'>><<lanLink ['Continue the ordination', '继续授职考验'] 'Revelation Temple Ordination'>><</lanLink>><br><br>
  <<temple-duty-hall-back>><<exit>>
<</if>>
<<if !_dutyOffice or !$TempleDuties.enrolled or !($temple_rank is 'priest' or _dutyReady and $TempleDuties.review and ['care', 'obedience'].includes($TempleDuties.oath))>>
  <<temple-duty-hall-back>>
  <<exit>>
<</if>>
<<npc Jordan>>
<<person1>>
<<language>>
  <<option 'EN'>>
    Jordan checks the names in the book. "I'll ask each of you for your own answer." <<He>> waits while you decide who is ready to come to the altar. In the hall, the others are putting their prayer books aside.
    "The vows you have already taken still hold. Will you also hear those who ask for help, and help protect the temple and its flock?"
  <<option 'CN'>>
    约旦核对着名册上的名字。“我会分别问你们，听每个人自己的回答。”<<He>>等你确认谁已经准备好，一起走向祭坛。大厅里，其他人正放下手中的祷书。
    “已经立下的誓言，仍要守持。你们也愿意倾听求助者，帮助保护神殿与教徒吗？”
<</language>>
<br><br>
<div id='temple-ordination-roster'>
  <<temple-ordination-roster>>
</div>
<br>
<<temple-candidates-back>>

