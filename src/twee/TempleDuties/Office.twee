:: Temple Duties Widgets [widget]
<<widget 'temple-duty-check'>>
  <<if !maplebirch.get('TempleDuties') or !$TempleDuties>>
    <<set _dutySafe to false>>
    <<set _dutyAccess to false>>
    <<set _dutyOffice to false>>
    <<set _dutyReady to false>>
    <<set _dutyToday to false>>
    <<set _dutyReport to false>>
    <<exit>>
  <</if>>
  <<silently>>
    <!-- 日常变脏不撤回资格，已有职务、调查和任命进度照常保留。此处只检查，不消耗首次清扫后的交谈。 -->
    <<set _dutyAccess to $TempleDuties.quarters_ready or $TempleDuties.enrolled or $temple_rank is 'priest'
      or $TempleDuties.duties gt 0 or $TempleDuties.case or Object.keys($TempleDuties.reports).length
      or $TempleDuties.review or $TempleDuties.ordained gte 0>>
    <<set _dutySafe to Boolean(maplebirch.get('TempleDuties'))
      and ['initiate', 'monk', 'priest'].includes($temple_rank)
      and _dutyAccess
      and !$combat and !$possessed and !$nextPassage and !$nextPassageCheck and !$eventforced
      and !$replayScene and !$statFreeze and !$frozenValues and $exposed lte 0
      and $stress lt $stressmax and !isPregnancyEnding()>>
    <<set _dutyOffice to _dutySafe and C.npc.Jordan.init is 1
      and $daily.jordanMissing isnot 1 and Time.hour gte 9 and Time.hour lt 18
      and !['night', 'dusk'].includes(Time.dayState)
      and !(Time.weekDay is 1 and Time.hour gte 11 and Time.hour lt 13)>>
    <<set _dutyToday to _dutyOffice and $TempleDuties.enrolled
      and $TempleDuties.duty_day isnot Math.floor(Time.days)>>
    <<set _dutyReport to _dutyOffice and $TempleDuties.case
      and ($TempleDuties.case.stage is 'report'
      or ($TempleDuties.case.stage is 'combat' and !$combat))>>
    <<set _dutyNext to ''>>
    <<for _caseId range ['echo', 'roots', 'crate', 'ritual']>>
      <<if !_dutyNext and !$TempleDuties.rewards.includes(_caseId)>>
        <<set _dutyNext to _caseId>>
      <</if>>
    <</for>>
    <<if $TempleDuties.duties is 0 and !Object.keys($TempleDuties.reports).length and !$TempleDuties.rewards.length and $temple_rank isnot 'priest'>>
      <<set _dutyNext to ''>>
    <</if>>
    <<set _roofReady to $TempleDuties.archive.roof gte 0 and Time.days gte $TempleDuties.archive.roof>>
    <<set _shelvesReady to $TempleDuties.archive.shelves gte 0 and Time.days gte $TempleDuties.archive.shelves>>
    <<set _studyMinutes to (_roofReady and _shelvesReady ? 20 : 30) - ($TempleDuties.archive.sorted gte 3 ? 5 : 0)>>
    <<set _spearReturned to $temple_spear_mission gte 2 and $spear_vessel is 'temple'>>
    <<set _flockRescued to $jordan_ritual_dance gte 4>>
    <<set _dutyCredentials to _dutyOffice and ['monk', 'priest'].includes($temple_rank)
      and _spearReturned and _flockRescued
      and $templetest isnot 'failed' and $temple_chastity_timer gt 0
      and $player.virginity.temple is true
      and $TempleDuties.enrolled>>
    <!-- 首次如实完成后保留资历，后续回访的退出与失败不撤销。 -->
    <<set _dutyTrained to $TempleDuties.rewards.includes('roots')>>
    <<set _dutyFieldwork to $TempleDuties.rewards.includes('crate')>>
    <<set _dutyRitual to $TempleDuties.rewards.includes('ritual')>>
    <<set _dutyReady to _dutyCredentials and $temple_rank is 'monk' and $grace gte 100 and _dutyTrained and _dutyFieldwork and _dutyRitual>>
    <<set _bishopKnown to Boolean($per_npc.bishop) and ($temple_confessor_intro or $kylar_manor_secret is 3)>>
  <</silently>>
<</widget>>

<<widget 'temple-duty-action' 'container'>>
  <<set $_dutyBody to _contents>>
  <<set $_dutyMinutes to _args[1]>>
  <<set $_dutyTarget to _args[2]>>
  <<set $_dutyPartners to Array.isArray(_args[3]) ? clone(_args[3]) : (_args[3] ? [_args[3]] : [])>>
  <<set $_dutyUsed to false>>
  <<set $_dutySource to $passage, $_dutyLocation to $location>>
  <<capture $_dutyBody $_dutyMinutes $_dutyTarget $_dutyPartners $_dutyUsed $_dutySource $_dutyLocation>>
    <<lanLink _args[0]>>
      <<temple-duty-check>>
      <<set $_dutyGuests to true>>
      <<for _guest range $_dutyPartners>>
        <<temple-candidate-check _guest $_dutyMinutes>>
        <<if !_candidateFree>>
          <<set $_dutyGuests to false>>
        <</if>>
      <</for>>
      <<if !$_dutyUsed and _dutySafe and $_dutyGuests
          and $passage is $_dutySource and maplebirch.passage.title is $_dutySource and $location is $_dutyLocation>>
        <<set $_dutyUsed to true>>
        <<set $_dutyStarted to Time.date.timeStamp>>
        <<pass $_dutyMinutes>>
        <<temple-duty-check>>
        <<for _guest range $_dutyPartners>>
          <<temple-candidate-check _guest 0>>
          <<if !_candidateFree>>
            <<set $_dutyGuests to false>>
          <</if>>
        <</for>>
        <<if $passage is $_dutySource and $location is $_dutyLocation
            and Time.date.timeStamp gte $_dutyStarted + $_dutyMinutes * 60
            and !$nextPassageCheck and _dutySafe and $_dutyGuests>>
          <<print $_dutyBody>>
          <<revelation-next $_dutySource $_dutyTarget>>
        <<else>>
          <<revelation-next $_dutySource>>
        <</if>>
      <</if>>
    <</lanLink>>
  <</capture>>
<</widget>>

<<widget 'temple-duty-link'>>
  <<temple-duty-check>>
  <<if _revelationTempleLinks is 'pray'>><<temple-ordination-link>><</if>>
  <<if _revelationTempleLinks is 'pray' and _dutyOffice>>
    <<icon 'temple/duties-book.png'>>
    <<lanLink ['Check the temple duties book', '查看神殿职务簿'] 'Revelation Temple Office'>>
    <</lanLink>>
    <br>
  <</if>>
<</widget>>

<<widget 'temple-ordination-link'>>
  <<if $TempleDuties.ordination and !['complete', 'withdrawn'].includes($TempleDuties.ordination.stage)>>
    <<temple-ordination-check>>
    <<if _ordinationSafe>>
      <<templeicon 'altar'>>
      <<lanLink ['Return to the appointment ceremony', '回到受职仪式'] 'Revelation Temple Ordination'>><</lanLink>><br>
    <</if>>
  <</if>>
<</widget>>

<<widget 'temple-duty-quarters'>>
  <!-- 记录与转告放在实际宿舍入口，避免日志等共享检查提前消耗这次契机。 -->
  <<if maplebirch.get('TempleDuties') and $TempleDuties and !$TempleDuties.quarters_ready
      and ['initiate', 'monk', 'priest'].includes($temple_rank) and $temple_quarters gte 100
      and !$combat and !$possessed and !$nextPassage and !$nextPassageCheck and !$eventforced
      and !$replayScene and !$statFreeze and !$frozenValues and $exposed lte 0
      and $stress lt $stressmax and !isPregnancyEnding()>>
    <<set $TempleDuties.quarters_ready to true>>
    <<if !$TempleDuties.enrolled and $temple_rank isnot 'priest'>>
      <<lanSwitch 'An attendant looks over the clean bunks and nods. "Thank you. Jordan could use another pair of hands with the daily duties. Ask in the hall if you want to help."' '一名侍从看了看整理干净的床铺，点点头。“辛苦了。约旦那边的日常职务也缺人手。你要是愿意帮忙，可以去大厅问问。”'>><br><br>
    <</if>>
  <</if>>
<</widget>>

<<widget 'temple-duty-place'>>
  <<set $outside to 0>>
  <<set $location to 'temple'>>
  <<sydneySchedule>>
  <<temple_effects>>
  <<effects>>
  <<temple-duty-check>>
<</widget>>

<<widget 'temple-duty-back'>>
  <<getouticon>>
  <<lanLink ['Return to the duties desk', '返回职务桌'] 'Revelation Temple Office'>>
  <</lanLink>>
  <br>
<</widget>>

<<widget 'temple-duty-hall-back'>>
  <<getouticon>>
  <<lanLink ['Return to the hall', '返回大厅'] 'Temple'>>
  <</lanLink>>
  <br>
<</widget>>

<<widget 'temple-duty-book-body'>>
  <<if !$TempleDuties.enrolled>>
    <<socialiseicon 'ask'>>
    <<temple-duty-action `['Ask Jordan for duties (0:10)', '向约旦申请职务 (0:10)']` 10 'Revelation Temple Task Done'>>
      <<if !$TempleDuties.enrolled>>
        <<set $TempleDuties.enrolled to true>>
        <<set $TempleDuties.note to 'joined'>>
      <</if>>
    <</temple-duty-action>>
    <br>
  <<else>>
    <<if _dutyToday and Time.hour * 60 + Time.minute lte 17 * 60>>
      <<icon 'temple/duties-book.png'>>
      <<lanLink ['Choose today\'s shift', '选择今日值班职务'] 'Revelation Temple Shift'>>
      <</lanLink>>
      <br>
    <</if>>
    <<icon 'temple/records-room.png'>>
    <<lanLink ['Visit the old records room', '去旧资料室'] 'Temple Library'>>
    <</lanLink>>
    <br>
    <<if _dutyReport>>
      <<socialiseicon 'ask'>>
      <<lanLink ['Report to Jordan', '向约旦汇报'] 'Revelation Temple Report'>>
      <</lanLink>>
      <<if $TempleDuties.case?.id>>
        — <<temple-case-title $TempleDuties.case.id>>
      <</if>>
      <br>
    <<elseif $TempleDuties.case?.stage is 'field'>>
      <<icon 'temple/duties-book.png'>>
      <<lanLink ['Review assignment', '查看委托说明'] 'Revelation Temple Case Brief'>>
      <</lanLink>>
      <<if $TempleDuties.case?.id>>
        — <<temple-case-title $TempleDuties.case.id>>
      <</if>>
      <br>
    <<elseif !$TempleDuties.case and _dutyNext and !$TempleDuties.reports[_dutyNext]>>
      <<socialiseicon 'ask'>>
      <<lanLink ['Ask what needs investigating', '询问需要调查的事情'] 'Revelation Temple Case Brief'>>
      <</lanLink>>
      — <<temple-case-title _dutyNext>>
      <br>
    <</if>>
    <<for _retryId range ['echo', 'roots', 'crate', 'ritual']>>
      <<if $TempleDuties.reports[_retryId] and !$TempleDuties.case
          and (!($TempleDuties.reports[_retryId].honest and $TempleDuties.reports[_retryId].result is 'resolved') or (_retryId isnot 'ritual' and $temple_rank is 'priest' and Time.days gte $TempleDuties.reports[_retryId].day + 7)
            or _retryId is 'ritual' and Object.values($TempleDuties.candidates).some(candidate => candidate.agreed and candidate.trial_day lt 0))>>
        <<capture _retryId>>
          <<socialiseicon>>
          <<temple-duty-action `['Accept a return inspection (0:05)', '接下回访检查 (0:05)']` 5 'Revelation Temple Case Accepted'>>
            <<temple-case-take _retryId true>>
          <</temple-duty-action>>
          — <<temple-case-title _retryId>><br>
        <</capture>>
      <</if>>
    <</for>>
  <</if>>
<</widget>>

<<widget 'temple-duty-jordan-links'>>
  <<temple-duty-check>>
  <<if _dutySafe and $temple_rank is 'monk' and !$TempleDuties.review>>
    <<socialiseicon 'ask'>>
    <<lanLink ['Enquire about ordination', '询问司祭任命'] 'Revelation Temple Review'>>
    <</lanLink>><br>
  <<elseif _dutySafe and $temple_rank is 'monk' and $TempleDuties.review>>
    <<socialiseicon 'ask'>>
    <<lanLink ['Continue the ordination interview', '继续任命面谈'] 'Revelation Temple Review'>>
    <</lanLink>><br>
  <</if>>
<</widget>>

<<widget 'temple-duty-confessor-note'>>
  <<if ['monk', 'priest'].includes($temple_rank) and _bishopKnown
      and !['refused', 'reported'].includes($TempleDuties.bishop)>>
    <<revelation-card 'Sealed note' '密封便条'>>
      <<socialiseicon 'ask'>>
      <<lanLink ['Read the sealed note left for you', '读留给你的密封便条'] 'Revelation Temple Sealed Note'>>
      <</lanLink>>
      <br>
    <</revelation-card>>
  <</if>>
<</widget>>

<<widget 'temple-duty-rest-link'>>
  <<temple-duty-check>>
  <<if _dutySafe and $TempleDuties.enrolled and $location is 'temple'
      and $TempleDuties.rest_day isnot Math.floor(Time.days)
      and ($pain gt 0 or $tiredness gt 0 or $stress gt 0)>>
    <<bedicon>>
    <<temple-duty-action `['Warm up and have your cuts dressed (0:30)', '暖一暖身子，包扎伤口 (0:30)']` 30 'Revelation Temple Rest'>>
      <<if $TempleDuties.rest_day isnot Math.floor(Time.days)>>
        <<set $TempleDuties.rest_day to Math.floor(Time.days)>>
        <<set $TempleDuties.note to 'rested'>>
        <<pain -8>>
        <<tiredness -12>>
        <<stress -6>>
      <</if>>
    <</temple-duty-action>>
    <<lpain>>
    <<ltiredness>>
    <<lstress>><br><br>
  <</if>>
<</widget>>

<<widget 'temple-case-title'>>
  <<switch _args[0]>>
    <<case 'echo'>>
      <<lanSwitch 'Knocking after lights-out' '熄灯后的敲击'>>
    <<case 'roots'>>
      <<lanSwitch 'Roots beneath the records' '卷宗下的根须'>>
    <<case 'crate'>>
      <<lanSwitch 'The returned donation crate' '退回的捐赠箱'>>
    <<case 'ritual'>>
      <<lanSwitch 'Chanting beyond the shore' '湖岸外的祷声'>>
  <</switch>>
<</widget>>

:: Revelation Temple Office
<<temple-duty-place>>
<<temple-ordination-link>>
<<if !_dutyOffice>>
  <<if !_dutyAccess>>
    <<lanSwitch 'The duties book is closed to you for now. There is still work to finish in the quarters upstairs.' '你暂时还不能接下这里的职务。楼上的宿舍还有活没干完。'>>
  <<else>>
    <<lanSwitch 'The duties book is closed. The next clerk will take over during the day, outside Sunday mass.' '职务簿合上了。下一班侍从会在白天、周日弥撒以外的时段接待。'>>
  <</if>><br><br>
  <<getouticon>>
  <<lanLink ['Return to the hall', '返回大厅'] 'Temple'>>
  <</lanLink>>
  <br>
  <<exit>>
<</if>>
<<npc Jordan>>
<<person1>>
<<language>>
  <<option 'EN'>>
    You come to the duties desk. Lists of blankets and names lie beside a ring of keys. The high priest reads the last clerk's note before looking up. Behind <<him>>, incense hangs beneath the angel's wings. "Looking for work, child? The handover will tell you where we need help." <<He>> turns the duties book towards you.
  <<option 'CN'>>
    你来到职务桌前。毯子清单和名册旁放着一圈钥匙。大司祭约旦读完上一班留下的便条，才抬起头。香烟悬在<<him>>身后天使的翼下。“想来帮忙吗，孩子？先看看交接记录，哪里缺人手，都记在上面。”<<He>>把职务簿转向你。
<</language>>
<br><br>
<<if !['monk', 'priest'].includes($temple_rank)>>
    <<revelation-card 'Duties book · initiate' '职务簿 · 见习教徒'>>
      <<temple-duty-book-body>>
    <</revelation-card>>
<<elseif $temple_rank is 'monk'>>
    <<revelation-card 'Duties book · monk' '职务簿 · 修士／修女'>>
      <<temple-duty-book-body>>
    <</revelation-card>>
<<else>>
    <<revelation-card 'Duties book · priest' '职务簿 · 司祭'>>
      <<temple-duty-book-body>>
      <<if $TempleDuties.enrolled>>
        <span class='teal'><<lanSwitch 'A list of wards needing attention lies beside the next shift\'s report.' '需要检查的护符清单压在下一班的报告旁。'>></span><br>
        <<temple-pastoral-check>>
        <<if _pastoral_ready>>
          <<socialiseicon>>
          <<lanLink ['Receive people seeking help', '接待前来求助的教徒'] 'Revelation Temple Pastoral'>><<temple-pastoral-start>><</lanLink>><br>
        <</if>>
        <<if _dutyToday and Time.hour * 60 + Time.minute lte 17 * 60>>
          <<socialiseicon>>
          <<temple-duty-action `['Supervise the next shift (0:45)', '指导下一班值班 (0:45)']` 45 'Revelation Temple Task Done'>>
            <<if $TempleDuties.enrolled and $TempleDuties.duty_day isnot Math.floor(Time.days)>>
              <<set $TempleDuties.duty_day to Math.floor(Time.days)>>
              <<set $TempleDuties.duties += 1>>
              <<set $TempleDuties.note to 'supervised'>>
              <<grace 2>>
              <<money 4000 'templeDuty'>>
              <<famegood 2 null true>>
            <</if>>
          <</temple-duty-action>>
          <<ggrace>><br>
          <<icon 'temple/ward-stone.png'>>
          <<temple-duty-action `['Inspect the garden and repair the wards (1:00)', '巡查花园，修补护符 (1:00)']` 60 'Revelation Temple Task Done'>>
            <<if $TempleDuties.duty_day isnot Math.floor(Time.days)>>
              <<set $TempleDuties.duty_day to Math.floor(Time.days)>>
              <<set $TempleDuties.duties += 1>>
              <<set $TempleDuties.note to 'wards'>>
              <<if $temple_garden lt 100>>
                <<set _gardenGain to currentSkillValue('tending') gte 1500 ? 9
                  : currentSkillValue('tending') gte 1200 ? 8
                  : currentSkillValue('tending') gte 800 ? 7
                  : currentSkillValue('tending') gte 600 ? 6
                  : currentSkillValue('tending') gte 400 ? 5
                  : currentSkillValue('tending') gte 200 ? 4 : 3>>
                <<set $temple_garden to Math.min(100, $temple_garden + _gardenGain)>>
              <</if>>
              <<tending 1>>
              <<housekeeping 1>>
              <<tiredness 3>>
              <<grace 2>>
              <<money 4000 'templeDuty'>>
            <</if>>
          <</temple-duty-action>>
          <<gtending>>
          <<ghousekeeping>>
          <<ggrace>>
          <<gtiredness>><br>
        <</if>>
        <<temple-manor-offer>>
      <</if>>
    <</revelation-card>>
<</if>>
<<if $TempleDuties.enrolled>>
  <<temple-duty-confessor-note>>
<</if>>
<br>
<<temple-duty-rest-link>>
<<getouticon>>
<<lanLink ['Return to the hall', '返回大厅'] 'Temple'>>
<</lanLink>>
<br>

:: Revelation Temple Shift
<<temple-duty-place>>
<<npc Jordan>>
<<person1>>
<<if !_dutyToday or Time.hour * 60 + Time.minute gt 17 * 60>>
  <<temple-duty-back>>
  <<exit>>
<</if>>
<<language>>
  <<option 'EN'>>
    A clerk has left two things unfinished: the kitchen received fewer bowls than the list says, and someone folded damp blankets onto the dry shelf. Jordan points to the crossed-out figures. "Choose one for this shift. Check it before you write the handover."
  <<option 'CN'>>
    上一班留了两件没处理完的事：厨房收到的碗比清单上少，另有人把潮湿的毯子叠进了干货架。约旦指着划掉的数字。“这一班先选一件做。核对清楚，再写交接记录。”
<</language>>
<br><br>
<<icon 'temple/delivery-records.png'>>
<<temple-duty-action `['Count the bowls and trace the receipt (0:45)', '清点碗并核对收据 (0:45)']` 45 'Revelation Temple Task Done'>>
  <<if $TempleDuties.enrolled and $TempleDuties.duty_day isnot Math.floor(Time.days)>>
    <<set $TempleDuties.duty_day to Math.floor(Time.days)>>
    <<set $TempleDuties.duties += 1>>
    <<set $TempleDuties.note to 'accounts'>>
    <<mathsskill 2>>
    <<grace 1>>
    <<money 2500 'templeDuty'>>
    <<famegood 2 null true>>
  <</if>>
<</temple-duty-action>>
<<gmaths>>
<<ggrace>><br>
<<socialiseicon>>
<<temple-duty-action `['Air the blankets and leave a handover (1:00)', '晾开毯子，留下交接记录 (1:00)']` 60 'Revelation Temple Task Done'>>
  <<if $TempleDuties.enrolled and $TempleDuties.duty_day isnot Math.floor(Time.days)>>
    <<set $TempleDuties.duty_day to Math.floor(Time.days)>>
    <<set $TempleDuties.duties += 1>>
    <<set $TempleDuties.note to 'blankets'>>
    <<housekeeping 2>>
    <<grace 2>>
    <<tiredness 3>>
    <<money 3000 'templeDuty'>>
    <<famegood 2 null true>>
  <</if>>
<</temple-duty-action>>
<<ghousekeeping>>
<<gggrace>>
<<gtiredness>><br><br>
<<temple-duty-back>>

:: Revelation Temple Task Done
<<temple-duty-place>>
<<set _dutyAid to maplebirch.get('Finance')?.donations?.state.aid?.temple>>
<<language>>
  <<option 'EN'>>
    <<switch $TempleDuties.note>>
      <<case 'joined'>>
        Jordan adds your name to the duties book. "Come when you're free. Keep school and your other commitments in order." <<He>> gives you the key to the old records room. "Take a handover with the attendant first. They'll show you what needs doing."
      <<case 'accounts'>>
        <<if _dutyAid?.signed_at != null>>
          The signed relief receipt is clipped to the kitchen list. You keep the food and blanket entries separate from the kitchenware count, then check the bowls still wrapped beside the door. The delivery is complete; some of it has not been shelved.
        <<elseif $TempleDuties.duties gte 6>>
          You check the kitchen doorway before starting the count. The missing bowls are still wrapped there. You enter the delivered and stored amounts in separate columns so the next shift can find them.
        <<else>>
          The missing bowls are still wrapped beside the kitchen door. You count them twice before correcting the receipt. The clerk shows you where the handover is kept.
        <</if>>
        Jordan initials your handover; your payment is placed beside it.
      <<case 'blankets'>>
        <<if Weather.precipitation is 'rain'>>
          Rain keeps you from using the outside line. You spread the blankets over the empty bunks and leave space between them. The next clerk checks your note before setting aside the dry bundles for visitors.
        <<else>>
          You carry the damp blankets to the line, then mark the shelf so they will not be mixed with the dry bundles. By the time the next clerk arrives, the outer folds are already drying.
        <</if>>
        Jordan leaves your payment with the completed list.
      <<case 'supervised'>>
        <<if _roofReady and _shelvesReady>>
          You show the clerk where the numbered receipts are kept, then let them find the matching copy. The figures agree once the returned bundles are counted separately.
        <<else>>
          You hold the damaged receipt flat while the clerk reads the count back. You show them how to note the unclear figure without guessing what it says.
        <</if>>
        <<if $TempleDuties.duties gte 12>>The clerk handles the next entry without prompting. You check the finished line before passing on the book.<<else>>You wait while the clerk writes the handover, pointing out the date they nearly missed.<</if>> Jordan reads both reports and adds your payment to the handover.
      <<case 'wards'>>
        You pull creeping stems away from the flower beds and clear the damp growth from the inscribed stones.
        <<if $TempleDuties.archive.topics.includes('ward-notes')>>You spread your recovered pattern beside the stone. An initiate holds the lamp while you show them which gaps belong to the pattern and which have worn away.<<else>>An older priest holds the copied pattern while you mend the damaged lines. You compare each stroke before moving to the next stone.<</if>>
        <<if Weather.precipitation is 'rain'>>Water is running across the approach. You clear the drain before carrying the lamp back inside.<<else>>You leave the gate and its approach clear before returning the lamp.<</if>> Jordan marks the inspection complete. Beyond the wall, branches still press against the stone.
      <<case 'sorted'>>
        <<switch $TempleDuties.archive.sorted>>
          <<case 1>>You separate the first damp leaves with a thin knife. Their edges stay caught together until you ease them onto dry sheets. The page numbers are faint, but legible.
          <<case 2>>This batch contains plans and folded delivery slips. You lay them flat and match the torn edges without filling any gaps in the writing.
          <<default>>The last leaves are dry enough to handle. You number their sleeves and return the references to the bound volumes. A clerk finds the right page without having to empty the box.
        <</switch>>
        <<if $TempleDuties.rewards.includes('crate')>>You leave a slip marking the receipts you checked in the crate investigation.<</if>>
      <<case 'funded'>>
        Your payment and its purpose are written on the receipt. Jordan files the contractor's copy separately from the kitchen accounts. The work has been arranged; the completion date is recorded with the estimate.
      <<case 'unpaid'>>
        The payment could not be completed. The clerk leaves the agreement unsigned.
    <</switch>>
  <<option 'CN'>>
    <<switch $TempleDuties.note>>
      <<case 'joined'>>
        约旦把你的名字添进职务簿。“有空时来。学校和其他事情，也要安排妥当。”<<He>>交给你旧资料室的钥匙。“先跟侍从接一班活吧。让对方告诉你，要做些什么。”
      <<case 'accounts'>>
        <<if _dutyAid?.signed_at != null>>
          签过字的救济收据夹在厨房清单上。你把食物、毯子与餐具的数量分栏核对，再清点仍包在门边的碗。东西已经送齐，只是有一部分还没入架。
        <<elseif $TempleDuties.duties gte 6>>
          开始清点前，你先去看了厨房门边。少的碗果然还包在那里。你把送到的数量与入库的数量分栏写下，方便下一班查找。
        <<else>>
          少的碗还包在厨房门边。你数了两遍，才更正收据。侍从给你指出交接簿放在哪里。
        <</if>>
        约旦在交接记录上签字，把报酬放在旁边。
      <<case 'blankets'>>
        <<if Weather.precipitation is 'rain'>>
          外面还在下雨，没法用晾衣绳。你把毯子铺在空床上，彼此留出空隙。下一班先看过便条，再把干燥的捆包留给访客。
        <<else>>
          你把湿毯子搬到晾衣绳上，在货架做了标记，免得与干毯子混在一起。下一班来时，外面的几层已经开始干了。
        <</if>>
        约旦把报酬留在完成的清单旁。
      <<case 'supervised'>>
        <<if _roofReady and _shelvesReady>>
          你给侍从指出编号收据存放的位置，让对方找出相应的副本。把退回的捆包另外计数后，两笔账就对上了。
        <<else>>
          你压平受损的收据，听侍从读回数量，告诉对方该怎样注明辨认不清的数字，不必猜着填上。
        <</if>>
        <<if $TempleDuties.duties gte 12>>下一笔，侍从没等你开口便办好了。你核过写完的那行，把簿子传下去。<<else>>你等侍从写完交接记录，指出差点漏下的日期。<</if>>约旦读过两份报告，把报酬记进交接单。
      <<case 'wards'>>
        你把蔓生的枝茎从花坛边拉开，清理符石上的湿苔。
        <<if $TempleDuties.archive.topics.includes('ward-notes')>>你在石旁铺开修复的图样。一名见习教徒替你举灯，你给对方指出哪些缺口原本就有，哪些是磨损留下的。<<else>>年长的司祭替你举着抄录的图样。你逐笔比对，修补受损的线条，再走到下一块石前。<</if>>
        <<if Weather.precipitation is 'rain'>>雨水漫过门前的路。你先疏通排水口，才提灯回到屋里。<<else>>归还灯具前，门口与通路也已清理妥当。<</if>>约旦在清单上标记巡查完成。墙外的枝条，仍紧贴着石头。
      <<case 'sorted'>>
        <<switch $TempleDuties.archive.sorted>>
          <<case 1>>你用薄刀一点点分开第一批湿纸，把粘连的边缘托到干纸上。页码很淡，还能辨认。
          <<case 2>>这一批夹着图纸和折起的交货单。你将它们铺平，对好撕裂的边缘，留下字迹缺失的地方。
          <<default>>最后一批纸页已经干到可以拿取。你给封套编号，把索引归回装订好的书里。侍从不用倒空整只箱子，便找到了要查的那页。
        <</switch>>
        <<if $TempleDuties.rewards.includes('crate')>>你留下一张纸条，标出货箱调查中核对过的收据。<</if>>
      <<case 'funded'>>
        收据上写着你支付的款项和用途。约旦把承包商的副本与厨房账簿分开放好。施工已经安排，完工日期也记在报价单上。
      <<case 'unpaid'>>
        付款未能完成。侍从把协议留着，没有签字。
    <</switch>>
<</language>>
<<if ['accounts', 'blankets'].includes($TempleDuties.note) and $TempleDuties.duties is 1 and !$TempleDuties.reports.echo>>
  <br><br>
  <<language>>
    <<option 'EN'>>
      As you hand over the book, the attendant points to a note in the margin. "The night shift keeps hearing knocking downstairs. Could you have a look?" Jordan puts the note aside for you. "Rest first. Come back to the desk when you're ready."
    <<option 'CN'>>
      交回簿子时，侍从指给你看页边的便条。“夜班总听见楼下有敲击声。你能去看看吗？”约旦把便条留在一旁。“先歇一歇。准备好了，再到桌边来。”
  <</language>>
<</if>>
<br><br>
<<temple-duty-back>>

:: Revelation Temple Rest
<<temple-duty-place>>
<<if $TempleDuties.rest_day is Math.floor(Time.days) and $TempleDuties.note is 'rested'>>
  <<npc Jordan>>
  <<person1>>
  <<language>>
    <<option 'EN'>>
      A clerk places a cup beside the fire. You put your things down slowly, then hold still while an older priest checks your hands. Jordan waits until your fingers have stopped shaking. "The doors can wait half an hour, child." Warm water loosens the ache in your fingers. You drink before taking the cup back.
    <<option 'CN'>>
      侍从在炉边放下一杯水。你慢慢放下手里的东西，让年长的司祭看看双手。约旦等到你的手指不再发抖，才开口：“那些门能等半小时，孩子。”热水让指间的酸痛松开了一些。你喝完，把杯子交回去。
  <</language>>
  <<lpain>>
  <<ltiredness>>
  <<lstress>>
<<else>>
  <<lanSwitch 'The clerk has cleared the place beside the fire. Ask about resting when you next return.' '侍从已经收拾好炉边的位置。下次回来时，可以再问休息的事。'>>
<</if>>
<br><br>
<<temple-duty-back>>
