:: Temple Duties Combat Widgets [widget]

<!-- 保留已有任职与试炼收益，回放和梦中冻结不结算战斗加成。 -->
<<widget 'temple-exorcism-ready'>>
  <<silently>>
    <<set _exorcismReady to Boolean(maplebirch.get('TempleDuties') and ($TempleDuties?.ordained gte 0 or $TempleDuties?.trial_day gte 0 or $temple_rank is 'priest') and $combat is 1 and !$possessed and !$statFreeze and !$replayScene)>>
  <</silently>>
<</widget>>

<!-- 原版普通触手动作不设置结束标记。调用方另行保留强制事件优先级与实际撤离过程。 -->
<<widget 'temple-tentacle-outcome'>>
  <<silently>>
    <<set _templeTentacleOutcome to 'active'>>
    <<if $combat is 1 and $enemytype is 'tentacles' and $tentacles?.max gt 0>>
      <<if $stress gte $stressmax or $possessed or ($pain gte 100 and $willpowerpain is 0) or _combatend>>
        <<set _templeTentacleOutcome to 'withdrawn'>>
      <<elseif $tentacles.active lte $tentacles.max / 2>>
        <<set _templeTentacleOutcome to 'resolved'>>
      <</if>>
    <</if>>
  <</silently>>
<</widget>>

<!-- 使用实际目标的物种，机器与伪装成人形的普通人不由 enemytype 推断。 -->
<<widget 'temple-exorcism-target'>>
  <<silently>>
    <<temple-exorcism-ready>>
    <<set _exorcismTarget to false>>
    <<set _exorcismFoe to _args[0]>>
    <<if _exorcismReady and _exorcismFoe>>
      <<if typeof _exorcismFoe.tentaclehealth is 'number'>>
        <<set _exorcismTarget to ['tentacle', 'vine', 'root', 'shoot', 'tendril'].includes(_exorcismFoe.type) and !_exorcismFoe.fullDesc?.includes('metal')>>
      <<elseif $enemytype is 'struggle' and Object.values($struggle.enemy).includes(_exorcismFoe)>>
        <<set _exorcismTarget to true>>
      <<elseif ['man', 'beast', 'plant'].includes($enemytype)>>
        <<set $_exorcismSpecies to String(_exorcismFoe.type ?? '').replace(/(boy|girl)$/, '')>>
        <<set _exorcismTarget to Boolean($BeastList?.includes($_exorcismSpecies) or ['bull', 'centaur', 'harpy', 'plant'].includes($_exorcismSpecies) or ['deadwood_harbour_ghost', 'deadwood_ship_undead', 'deadwood_coin_guard'].includes(_exorcismFoe.per) or _exorcismFoe.fullDescription is 'Ivory Wraith' or ($abomination is 1 and _exorcismFoe is $NPCList[0]))>>
      <</if>>
    <</if>>
  <</silently>>
<</widget>>

<<widget 'temple-exorcism-damage'>>
  <<silently>>
    <<set _exorcismDamage to _args[1]>>
    <<set _exorcismTarget to false>>
    <<if _args[2] isnot 'passive'>>
      <<temple-exorcism-target _args[0]>>
      <<if _exorcismTarget and _exorcismDamage gt 0>>
        <<set _exorcismDamage *= 1.2>>
      <</if>>
    <</if>>
  <</silently>>
<</widget>>

<<widget 'temple-exorcism-defiance'>>
  <<silently>>
    <<if $enemyno lt 2 and ['man', 'beast', 'plant'].includes($enemytype)>>
      <<set _exorcismFoe to $NPCList.find(npc => npc.active is 'active' and npc.stance isnot 'defeated') ?? $NPCList[0]>>
      <<temple-exorcism-damage _exorcismFoe _thedamage _args[0]>>
      <<set _thedamage to _exorcismDamage>>
    <</if>>
  <</silently>>
<</widget>>

<!-- 分摊伤害逐个判定，原版随后继续处理击倒与溢出伤害。 -->
<<widget 'temple-exorcism-npcs'>>
  <<silently>>
    <<set _exorcismHits to []>>
    <<set $_exorcismBase to _thedamage>>
    <<if _args[0] isnot undefined>>
      <<temple-exorcism-damage $NPCList[_args[0]] $_exorcismBase _args[1]>>
      <<set _exorcismHits[_args[0]] to _exorcismDamage>>
      <<set _thedamage to _exorcismDamage>>
    <<else>>
      <<for _exorcismIndex to 0; _exorcismIndex lt $enemynomax; _exorcismIndex++>>
        <<if $NPCList[_exorcismIndex].active is 'active' and $NPCList[_exorcismIndex].stance isnot 'defeated' and (!$fightTargets or $fightTargets.includes(_exorcismIndex))>>
          <<set $_exorcismShare to $_exorcismBase / ($fightTargets ? $fightTargets.length : $enemyno)>>
          <<temple-exorcism-damage $NPCList[_exorcismIndex] $_exorcismShare _args[1]>>
          <<set _exorcismHits[_exorcismIndex] to _exorcismDamage>>
          <<set _thedamage += _exorcismDamage - $_exorcismShare>>
        <</if>>
      <</for>>
    <</if>>
  <</silently>>
<</widget>>

<!-- 原伤害已从触手扣除，只追加增幅，记录与实际扣血使用同一数值。 -->
<<widget 'temple-exorcism-tentacle'>>
  <<silently>>
    <<set $_exorcismOrgan to _args[0]>>
    <<set $_exorcismPower to _args[1]>>
    <<temple-exorcism-damage $_exorcismOrgan $_exorcismPower>>
    <<if _exorcismTarget and _exorcismDamage gt $_exorcismPower>>
      <<set $_exorcismOrgan.tentaclehealth -= _exorcismDamage - $_exorcismPower>>
    <</if>>
  <</silently>>
<</widget>>

<<widget 'temple-exorcism-record'>>
  <<silently>>
    <<set _exorcismDamage to _args[1]>>
    <<if ['damage', 'banish'].includes(_args[0]) and !['passive', 'settled', 'derived'].includes(_args[3])>>
      <<temple-exorcism-tentacle _args[2] _args[1]>>
    <</if>>
  <</silently>>
<</widget>>

<!-- 枯木的清除有独立结算，捕获实际扣血再追加，未启用归途时不调用。 -->
<<widget 'temple-exorcism-expunge-start'>>
  <<silently>>
    <<temple-exorcism-ready>>
    <<set _exorcismExpunge to []>>
    <<set _exorcismMode to _args[0]>>
    <<if _exorcismReady>>
      <<if _exorcismMode is 'Default' and ['man', 'beast', 'plant'].includes($enemytype)>>
        <<set _exorcismFoe to $NPCList.find(npc => npc.active is 'active' and npc.stance isnot 'defeated') ?? $NPCList[0]>>
        <<temple-exorcism-target _exorcismFoe>>
        <<if _exorcismTarget>>
          <<set _exorcismExpunge.push({target: _exorcismFoe, health: $enemyhealth})>>
        <</if>>
      <<elseif _exorcismMode is 'Struggle' or _exorcismMode is 'Tentacle'>>
        <<set $_exorcismList to _exorcismMode is 'Struggle' ? ($struggle?.enemy ?? []) : Object.values($tentacles ?? {})>>
        <<for _exorcismFoe range $_exorcismList>>
          <<temple-exorcism-target _exorcismFoe>>
          <<if _exorcismTarget>>
            <<set _exorcismHealth to _exorcismMode is 'Struggle' ? _exorcismFoe.health : _exorcismFoe.tentaclehealth>>
            <<set _exorcismExpunge.push({target: _exorcismFoe, health: _exorcismHealth})>>
          <</if>>
        <</for>>
      <</if>>
    <</if>>
  <</silently>>
<</widget>>

<<widget 'temple-exorcism-expunge-end'>>
  <<silently>>
    <<for _exorcismEntry range _exorcismExpunge>>
      <<set _exorcismHealth to _exorcismMode is 'Default' ? $enemyhealth : (_exorcismMode is 'Struggle' ? _exorcismEntry.target.health : _exorcismEntry.target.tentaclehealth)>>
      <<set $_exorcismDelta to _exorcismEntry.health - _exorcismHealth>>
      <<if $_exorcismDelta gt 0>>
        <<temple-exorcism-damage _exorcismEntry.target $_exorcismDelta>>
        <<set $_exorcismExtra to _exorcismDamage - $_exorcismDelta>>
        <<if _exorcismMode is 'Default'>>
          <<set $enemyhealth to Math.max(0, $enemyhealth - $_exorcismExtra)>>
        <<elseif _exorcismMode is 'Struggle'>>
          <<set _exorcismEntry.target.health to Math.max(0, _exorcismHealth - $_exorcismExtra)>>
        <<else>>
          <<set _exorcismEntry.target.tentaclehealth to Math.max(0, _exorcismHealth - $_exorcismExtra)>>
          <<tentacle_record 'banish' `_exorcismEntry.health - _exorcismEntry.target.tentaclehealth` _exorcismEntry.target 'settled'>>
        <</if>>
      <</if>>
    <</for>>
    <<unset _exorcismExpunge>>
  <</silently>>
<</widget>>
