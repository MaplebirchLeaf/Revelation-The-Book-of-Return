:: Temple Duties Combat Widgets [widget]

<!-- 保留已有任职与试炼收益，回放和梦中冻结不结算战斗加成。 -->
<<widget 'temple-watch-ready'>>
  <<silently>>
    <<set _watchReady to Boolean(maplebirch.get('TempleDuties') and ($TempleDuties?.ordained gte 0 or $TempleDuties?.trial_day gte 0 or $temple_rank is 'priest') and $combat is 1 and !$possessed and !$statFreeze and !$replayScene)>>
  <</silently>>
<</widget>>

<!-- 原版普通触手动作不设置结束标记；调用方另行保留强制事件优先级与实际撤离过程。 -->
<<widget 'temple-tentacle-outcome'>>
  <<silently>>
    <<set _templeTentacleOutcome to 'active'>>
    <<if $combat is 1 and $enemytype is 'tentacles' and $tentacles?.max gt 0>>
      <<if $stress gte $stressmax or $possessed or ($pain gte 100 and $willpowerpain is 0) or _combatend>>
        <<set _templeTentacleOutcome to 'withdrawn'>>
      <<elseif $tentacles.active lte $tentacles.max / 2>>
        <<set _templeTentacleOutcome to 'resolved'>>
      <</if>>
    <</if>>
  <</silently>>
<</widget>>

<!-- 使用实际目标的物种，机器与伪装成人形的普通人不由 enemytype 推断。 -->
<<widget 'temple-watch-target'>>
  <<silently>>
    <<temple-watch-ready>>
    <<set _watchTarget to false>>
    <<set _watchFoe to _args[0]>>
    <<if _watchReady and _watchFoe>>
      <<if typeof _watchFoe.tentaclehealth is 'number'>>
        <<set _watchTarget to ['tentacle', 'vine', 'root', 'shoot', 'tendril'].includes(_watchFoe.type) and !_watchFoe.fullDesc?.includes('metal')>>
      <<elseif $enemytype is 'struggle' and Object.values($struggle.enemy).includes(_watchFoe)>>
        <<set _watchTarget to true>>
      <<elseif ['man', 'beast', 'plant'].includes($enemytype)>>
        <<set $_watchSpecies to String(_watchFoe.type ?? '').replace(/(boy|girl)$/, '')>>
        <<set _watchTarget to Boolean($BeastList?.includes($_watchSpecies) or ['bull', 'centaur', 'harpy', 'plant'].includes($_watchSpecies) or _watchFoe.fullDescription is 'Ivory Wraith' or ($abomination is 1 and _watchFoe is $NPCList[0]))>>
      <</if>>
    <</if>>
  <</silently>>
<</widget>>

<<widget 'temple-watch-damage'>>
  <<silently>>
    <<set _watchDamage to _args[1]>>
    <<set _watchTarget to false>>
    <<if _args[2] isnot 'passive'>>
      <<temple-watch-target _args[0]>>
      <<if _watchTarget and _watchDamage gt 0>>
        <<set _watchDamage *= 1.2>>
      <</if>>
    <</if>>
  <</silently>>
<</widget>>

<<widget 'temple-watch-defiance'>>
  <<silently>>
    <<if $enemyno lt 2 and ['man', 'beast', 'plant'].includes($enemytype)>>
      <<set _watchFoe to $NPCList.find(npc => npc.active is 'active' and npc.stance isnot 'defeated') ?? $NPCList[0]>>
      <<temple-watch-damage _watchFoe _thedamage _args[0]>>
      <<set _thedamage to _watchDamage>>
    <</if>>
  <</silently>>
<</widget>>

<!-- 分摊伤害逐个判定，原版随后继续处理击倒与溢出伤害。 -->
<<widget 'temple-watch-npcs'>>
  <<silently>>
    <<set _watchHits to []>>
    <<set $_watchBase to _thedamage>>
    <<if _args[0] isnot undefined>>
      <<temple-watch-damage $NPCList[_args[0]] $_watchBase _args[1]>>
      <<set _watchHits[_args[0]] to _watchDamage>>
      <<set _thedamage to _watchDamage>>
    <<else>>
      <<for _watchIndex to 0; _watchIndex lt $enemynomax; _watchIndex++>>
        <<if $NPCList[_watchIndex].active is 'active' and $NPCList[_watchIndex].stance isnot 'defeated' and (!$fightTargets or $fightTargets.includes(_watchIndex))>>
          <<set $_watchShare to $_watchBase / ($fightTargets ? $fightTargets.length : $enemyno)>>
          <<temple-watch-damage $NPCList[_watchIndex] $_watchShare _args[1]>>
          <<set _watchHits[_watchIndex] to _watchDamage>>
          <<set _thedamage += _watchDamage - $_watchShare>>
        <</if>>
      <</for>>
    <</if>>
  <</silently>>
<</widget>>

<!-- 原伤害已从触手扣除，只追加增幅，记录与实际扣血使用同一数值。 -->
<<widget 'temple-watch-tentacle'>>
  <<silently>>
    <<set $_watchOrgan to _args[0]>>
    <<set $_watchPower to _args[1]>>
    <<temple-watch-damage $_watchOrgan $_watchPower>>
    <<if _watchTarget and _watchDamage gt $_watchPower>>
      <<set $_watchOrgan.tentaclehealth -= _watchDamage - $_watchPower>>
    <</if>>
  <</silently>>
<</widget>>

<<widget 'temple-watch-record'>>
  <<silently>>
    <<set _watchDamage to _args[1]>>
    <<if ['damage', 'banish'].includes(_args[0]) and !['passive', 'settled', 'derived'].includes(_args[3])>>
      <<temple-watch-tentacle _args[2] _args[1]>>
    <</if>>
  <</silently>>
<</widget>>

<!-- 枯木的清除有独立结算，捕获实际扣血再追加，未启用归途时不调用。 -->
<<widget 'temple-watch-expunge-start'>>
  <<silently>>
    <<temple-watch-ready>>
    <<set _watchExpunge to []>>
    <<set _watchMode to _args[0]>>
    <<if _watchReady>>
      <<if _watchMode is 'Default' and ['man', 'beast', 'plant'].includes($enemytype)>>
        <<set _watchFoe to $NPCList.find(npc => npc.active is 'active' and npc.stance isnot 'defeated') ?? $NPCList[0]>>
        <<temple-watch-target _watchFoe>>
        <<if _watchTarget>>
          <<set _watchExpunge.push({target: _watchFoe, health: $enemyhealth})>>
        <</if>>
      <<elseif _watchMode is 'Struggle' or _watchMode is 'Tentacle'>>
        <<set $_watchList to _watchMode is 'Struggle' ? ($struggle?.enemy ?? []) : Object.values($tentacles ?? {})>>
        <<for _watchFoe range $_watchList>>
          <<temple-watch-target _watchFoe>>
          <<if _watchTarget>>
            <<set _watchHealth to _watchMode is 'Struggle' ? _watchFoe.health : _watchFoe.tentaclehealth>>
            <<set _watchExpunge.push({target: _watchFoe, health: _watchHealth})>>
          <</if>>
        <</for>>
      <</if>>
    <</if>>
  <</silently>>
<</widget>>

<<widget 'temple-watch-expunge-end'>>
  <<silently>>
    <<for _watchEntry range _watchExpunge>>
      <<set _watchHealth to _watchMode is 'Default' ? $enemyhealth : (_watchMode is 'Struggle' ? _watchEntry.target.health : _watchEntry.target.tentaclehealth)>>
      <<set $_watchDelta to _watchEntry.health - _watchHealth>>
      <<if $_watchDelta gt 0>>
        <<temple-watch-damage _watchEntry.target $_watchDelta>>
        <<set $_watchExtra to _watchDamage - $_watchDelta>>
        <<if _watchMode is 'Default'>>
          <<set $enemyhealth to Math.max(0, $enemyhealth - $_watchExtra)>>
        <<elseif _watchMode is 'Struggle'>>
          <<set _watchEntry.target.health to Math.max(0, _watchHealth - $_watchExtra)>>
        <<else>>
          <<set _watchEntry.target.tentaclehealth to Math.max(0, _watchHealth - $_watchExtra)>>
          <<tentacle_record 'banish' `_watchEntry.health - _watchEntry.target.tentaclehealth` _watchEntry.target 'settled'>>
        <</if>>
      <</if>>
    <</for>>
    <<unset _watchExpunge>>
  <</silently>>
<</widget>>
