:: Temple Duties Case Widgets [widget]
<<widget 'temple-case-take'>>
  <<temple-duty-check>>
  <<if _dutyOffice and $TempleDuties.enrolled and !$TempleDuties.case
      and ['echo', 'roots', 'crate', 'ritual'].includes(_args[0])
      and (_args[0] isnot 'crate' or _dutyTrained)
      and (_args[0] isnot 'ritual' or _dutyFieldwork)
      and (_args[0] is 'echo' or ['monk', 'priest'].includes($temple_rank))>>
    <<set $_oldReport to $TempleDuties.reports[_args[0]]>>
    <<if (!_args[1] and _dutyNext is _args[0])
        or (_args[1] and $_oldReport
        and (!($_oldReport.honest and $_oldReport.result is 'resolved')
        or (_args[0] isnot 'ritual' and $temple_rank is 'priest' and Time.days gte $_oldReport.day + 7)))>>
      <<run delete $TempleDuties.reports[_args[0]]>>
      <<set $TempleDuties.case to {
        id: _args[0], stage: 'field', clues: [],
        prepared: false, advised: false, result: ''
        }>>
      <<if _args[1] and _args[0] isnot 'ritual' and $temple_rank is 'priest'
          and $TempleDuties.rewards.includesAll('echo', 'roots', 'crate')>>
        <<if $TempleDuties.followups[_args[0]] is undefined>>
          <<set $TempleDuties.followups[_args[0]] to $_oldReport.day>>
        <</if>>
        <<run $TempleDuties.case.clues.push(['visit-quiet', 'visit-damp', 'visit-shifted'][random(0, 2)])>>
      <</if>>
    <</if>>
  <</if>>
<</widget>>

<<widget 'temple-case-return'>>
  <<getouticon>>
  <<if $TempleDuties.case?.id is 'ritual'>>
    <<lanLink ['Return along the path to the shore (0:10)', '沿小径返回湖岸 (0:10)'] 'Lake Shore'>>
      <<set _ritual_return_passage to $passage, _ritual_return_location to $location>>
      <<pass 10>>
      <!-- 战后衣物损坏等情况仍可撤离求援，保留实际战果；优先事件与回放不改变调查。 -->
      <<if $TempleDuties.case?.id is 'ritual' and $TempleDuties.case.stage is 'field'
          and $passage is _ritual_return_passage and $location is _ritual_return_location
          and !$combat and !$possessed and !$nextPassage and !$nextPassageCheck and !$eventforced
          and !$replayScene and !$statFreeze and !isPregnancyEnding()>>
        <<set $TempleDuties.case.stage to 'report', $TempleDuties.case.result to 'withdrawn'>>
      <</if>>
    <</lanLink>><br>
    <span class='lblue'><<lanSwitch 'Tell Jordan what happened when you return to the temple.' '回到神殿后，把经过告诉约旦。'>></span>
  <<elseif ['roots', 'crate'].includes($TempleDuties.case?.id)>>
    <<lanLink ['Return to the docks (0:02)', '返回码头 (0:02)'] 'Docks'>>
      <<pass 2>>
    <</lanLink>>
    <br>
    <span class='lblue'><<lanSwitch 'Return to the temple duties desk to tell Jordan what you found.' '回到神殿后，到职务桌向约旦汇报这次调查。'>></span>
  <<else>>
    <<lanLink ['Return to the duties desk', '返回职务桌'] 'Revelation Temple Office'>>
    <</lanLink>>
    <br>
  <</if>>
<</widget>>

<<widget 'temple-case-docks-link'>>
  <<temple-duty-check>>
  <<if _dutySafe and ['roots', 'crate'].includes($TempleDuties.case?.id) and $TempleDuties.case.stage is 'field'>>
    <<icon 'cargo-stack.png'>>
    <<lanLink `[$TempleDuties.case.id is 'roots' ? 'Meet the monk at the old storehouse (0:02)' : 'Go to the returned crate (0:02)', $TempleDuties.case.id is 'roots' ? '到旧仓房与修士会合 (0:02)' : '前往退回的货箱处 (0:02)']` 'Revelation Temple Field'>>
      <<if !$TempleDuties.case.clues.includes('departed')>>
        <<for _field_name range ['Robin', 'Sydney']>>
          <<temple-candidate-check _field_name 90>>
          <<if !_candidateFree>><<run $TempleDuties.case.clues.delete('party:' + _field_name)>><</if>>
        <</for>>
        <<run $TempleDuties.case.clues.pushUnique('departed', 'party-day:' + Math.floor(Time.days))>>
      <</if>>
      <<pass 2>>
    <</lanLink>>
    <br>
  <</if>>
<</widget>>

<<widget 'temple-case-gwylan-link'>>
  <<temple-duty-check>>
  <<if _dutySafe and $location is 'forest_shop' and _gwylanLocation is 'shop' and $TempleDuties.case?.stage is 'field' and !$TempleDuties.case.advised and C.npc.Gwylan.init is 1>>
    <<socialiseicon 'ask'>>
    <<lanLink ['Ask Gwylan to check marks on notes (0:10)', '向格威岚核对标记 (0:10)'] 'Revelation Temple Gwylan'>>
      <<pass 10>>
    <</lanLink>>
    <br>
  <</if>>
<</widget>>

:: Revelation Temple Case Brief
<<temple-duty-place>>
<<npc Jordan>>
<<person1>>
<<if !_dutyOffice or !$TempleDuties.enrolled>>
  <<temple-duty-back>>
  <<exit>>
<</if>>
<<set _briefId to $TempleDuties.case?.id ?? _dutyNext>>
<<if !_briefId>>
  <<temple-duty-back>>
  <<exit>>
<</if>>
<span class='gold bold'><<temple-case-title _briefId>></span><br><br>
<<language>>
  <<option 'EN'>>
    <<switch _briefId>>
      <<case 'echo'>>
        A night-shift attendant heard knocking behind the lower storeroom wall after lights-out. Jordan hands you the building plan. "Please check the drainpipe and the shutter fastening. They have both needed repairs before. Find out where the sound comes from, and tell me if there is anything you cannot explain."
      <<case 'roots'>>
        Jordan calls over a monk who is putting away a whip. "The old storehouse by the docks has roots growing through the wall. Please go together." The monk checks your grip on the lamp. "I'll show you where to stand. Watch what happens to the roots when the light reaches them." Jordan hands over the key. "The delivery books are still inside. Bring them back if you can. Both of you."
      <<case 'crate'>>
        Jordan sets a shipping note beside the books you recovered. "A porter heard someone calling beneath the warehouse floor. You know the place, child. Would you go and see?" <<He>> puts a hand on the note before you take it. "The porter is waiting outside. If you find the same creatures, don't go in alone. Come back and tell us." There are boards by the entrance, and the porter can help lay them. You may also ask a prepared companion to come.
      <<case 'ritual'>>
        The worker you brought out returns with a relative. A friend went to a prayer meeting in the woods by the lake, and has not come home. The relative has marked the path. Jordan reads the invitation twice. "I haven't arranged any prayers there." <<He>> looks troubled. "If you go to the lake, please ask whether anyone has seen them. Be careful, child. If there is danger, come and tell me. I'm not asking you to face it alone."
    <</switch>>
    Jordan asks you to write down what you find, even if you have to leave before the work is finished.
  <<option 'CN'>>
    <<switch _briefId>>
      <<case 'echo'>>
        夜班侍从熄灯后，听见下层储藏室的墙后传来敲击声。约旦把建筑图交给你。“请检查排水管和百叶窗扣件。以前都修过。先查清声音从哪里来，有什么拿不准的，就回来告诉我。”
      <<case 'roots'>>
        约旦叫住一名正收起长鞭的修士。“码头旁的旧仓房，墙里长出了会动的根。请你们一起去一趟。”修士看了看你握灯的手。“到了那里，我指给你看该站在哪里。留意灯照过去时，那些根会怎样动。”约旦递来钥匙。“交货簿还在里面。能带就带回来。你们两个也是。”
      <<case 'crate'>>
        约旦把运单放在你取回的账簿旁。“搬运工在仓库地板下面听见有人呼救。孩子，你认得那里，愿意去看看吗？”你伸手拿运单时，<<he>>按住了纸角。“搬运工会在外面等。要是又看见那些生物，别独自进去，回来告诉我们。”入口边备有木板，搬运工可以帮忙铺设。你也可以问问准备妥当的同伴是否愿意同行。
      <<case 'ritual'>>
        你接出的工人带着一名亲属回来求助。有个朋友去参加湖边林子里的祈祷聚会，之后一直没有回家。亲属在纸上画出了小径。约旦把请帖读了两遍。“我没有在那里安排祈祷。”<<His>>面露忧色。“要是你去湖边，请问问有没有人见过对方。务必小心，孩子。有危险就回来告诉我，我不是让你独自去冒险。”
    <</switch>>
    约旦让你记下发现。就算没能处理完，也要带回来。
<</language>>
<br><br>
<<if $TempleDuties.case?.clues.some(clue => clue.startsWith('visit-'))>>
  <<language>>
    <<option 'EN'>>
      Jordan has placed your earlier report under the new note. "The place has been used since you left. Tell me what has changed." The clerk has reserved a return-inspection payment from the shift purse.
    <<option 'CN'>>
      约旦把你先前的报告压在新便条下面。“你走后，这个地方仍有人使用。告诉我，哪些变了。”侍从从值班报酬里留出了一份回访费用。
  <</language>>
  <br><br>
<</if>>
<<if _briefId is 'ritual' and $TempleDuties.case?.clues.includes('help')>>
  <<lanSwitch 'The older monk is waiting by the lake with your sketch. Jordan asks you to rest before going back.' '资深修士会带着草图在湖岸等候。约旦让你歇过一会儿再去。'>><br><br>
<</if>>
<<capture _briefId>>
  <<if !$TempleDuties.case>>
    <<if (_briefId is 'echo' or ['monk', 'priest'].includes($temple_rank)) and (_briefId isnot 'crate' or _dutyTrained) and (_briefId isnot 'ritual' or _dutyFieldwork)>>
      <<icon 'temple/duties-book.png'>>
      <<temple-duty-action `['Accept the assignment (0:05)', '接下委托 (0:05)']` 5 'Revelation Temple Case Accepted'>>
        <<temple-case-take _briefId>>
      <</temple-duty-action>>
      <br>
    <<else>>
      <span class='lblue'><<lanSwitch 'Jordan reserves outside assignments for members who have completed the vigil.' '约旦将外勤留给已完成守夜试炼的成员。'>></span><br>
    <</if>>
  <<else>>
    <<if ['crate', 'ritual'].includes(_briefId) and !$TempleDuties.case.clues.includes('departed') and !$TempleDuties.case.clues.includes('visit-quiet')>><<temple-field-roster>><br><</if>>
    <<if !$TempleDuties.case.prepared>>
      <<icon 'temple/field-kit.png'>>
      <<temple-duty-action `['Borrow a lamp, rope and gloves (0:10)', '借用灯、绳索与手套 (0:10)']` 10 'Revelation Temple Case Note'>>
        <<set $TempleDuties.case.prepared to true>>
        <<set $TempleDuties.note to 'kit'>>
      <</temple-duty-action>>
      <br>
    <</if>>
    <<if ['roots', 'crate', 'ritual'].includes(_briefId)>>
      <<getouticon>>
      <<lanLink ['Return to hall', '先返回大厅'] 'Temple'>>
      <</lanLink>>
      <br>
    <<else>>
      <<templeicon 'quarters'>>
      <<lanLink ['Go to the storeroom', '前往储藏室'] 'Revelation Temple Field'>>
      <</lanLink>>
      <br>
    <</if>>
    <<socialiseicon 'ask'>>
    <<temple-duty-action `['Withdraw from investigation (0:05)', '向约旦说明退出 (0:05)']` 5 'Revelation Temple Report'>>
      <<set $TempleDuties.case.stage to 'report'>>
      <<set $TempleDuties.case.result to 'withdrawn'>>
    <</temple-duty-action>>
    <br>
  <</if>>
<</capture>>
<br>
<<if !$TempleDuties.case or !['crate', 'ritual'].includes(_briefId)>>
  <<temple-duty-back>>
<</if>>

:: Revelation Temple Field
<<if ['roots', 'crate'].includes($TempleDuties.case?.id)>>
  <<set $outside to 1>>
  <<set $location to 'docks'>>
  <<effects>>
  <<temple-duty-check>>
<<else>>
  <<temple-duty-place>>
<</if>>
<<if !_dutySafe or $TempleDuties.case?.stage isnot 'field'>>
  <<temple-case-return>>
  <<exit>>
<</if>>
<span class='gold bold'><<temple-case-title $TempleDuties.case.id>></span><br><br>
<<set _quietVisit to $TempleDuties.case.clues.includes('visit-quiet')>>
<<set _dampVisit to $TempleDuties.case.clues.includes('visit-damp')>>
<<set _shiftedVisit to $TempleDuties.case.clues.includes('visit-shifted')>>
<<language>>
  <<option 'EN'>>
    <<if _quietVisit>>
      <<if $TempleDuties.case.id is 'echo'>>
        The clerk has moved the bed away from the wall. A folded note records one knock, then none. The drain and shutter still need checking before you sign beneath it.
      <<elseif $TempleDuties.case.id is 'roots'>>
        The books are back on their shelf. Cut roots lie dry beneath the first stair. No movement follows the lamp, but someone has rubbed away half your chalk line.
      <<else>>
        The porter has laid the new delivery beside the old receipt. All the workers are outside now. One name appears twice on the list, and the seal has been copied onto the wrong side of the crate.
      <</if>>
    <<else>>
      <<switch $TempleDuties.case.id>>
      <<case 'echo'>>
        You reach the lower storeroom and hold your breath to listen. The knocking stops for a moment, then starts again with a gust of wind. Beside the cold wall, fresh scratches mark the shutter. A drain runs from below the window down through the floor.
      <<case 'roots'>>
        A porter waits outside and points the monk towards the steps. A delivery book lies half-open beneath the roots. They tighten when the lamp passes over them. The steps behind you are slick; a narrow route runs along the dry wall.
      <<case 'crate'>>
        At the docks warehouse, the returned crate stands beneath the awning by the entrance. An adult porter holds the warehouse door open for you. You look beyond the crate, towards the part of the warehouse the calls came from. The floorboards there sag into a patch of dark water. Something moves beneath it; you cannot see where the water has come from.
      <</switch>>
      <<if _dampVisit>>
        Water has reached the old marks. The lamp throws a wavering line across the wet floor. Someone has left boots beside the entrance, still full of water.
      <<elseif _shiftedVisit>>
        The shelves have been moved since your last visit. Your old exit mark now points behind a stack. Something taps where the lamp cannot reach.
      <</if>>
    <</if>>
  <<option 'CN'>>
    <<if _quietVisit>>
      <<if $TempleDuties.case.id is 'echo'>>
        侍从把床挪离了墙。折好的便条记着一声敲击，之后没有了。在下面签字前，排水管与百叶窗仍需检查。
      <<elseif $TempleDuties.case.id is 'roots'>>
        书已经放回架上，剪断的根须干在第一级台阶下。灯照过，没有东西跟着动，但你的粉笔线被擦去了半截。
      <<else>>
        搬运工把新交货单放在旧收据旁。工人现在都在外面。名单上有个名字出现了两次，封印却抄在货箱错误的一侧。
      <</if>>
    <<else>>
      <<switch $TempleDuties.case.id>>
      <<case 'echo'>>
        你来到下层储藏室，屏住呼吸仔细听。敲击声停了一会儿，一阵风吹过，又响了起来。墙面冰冷，旁边的百叶窗上有新的刮痕。一根排水管从窗下向下延伸，穿过地板。
      <<case 'roots'>>
        搬运工等在门外，见修士来了，便指向台阶下方。一本交货簿被根须压住，摊开了一半。灯照过去时，根须收紧。身后的台阶湿滑，干燥的墙边却留着一条窄路。
      <<case 'crate'>>
        你来到码头仓库。退回的货箱放在入口旁的雨棚下，一名成年搬运工替你撑着仓库的门。你望向刚才传来呼救声的地方，在货箱后方、仓库更深处。那里的地板向下塌陷，浸在一片黑水里。水下有什么东西动了一下，看不出水是从哪儿来的。
      <</switch>>
      <<if _dampVisit>>
        水已经淹到旧标记。灯在湿地板上映出摇晃的一道线。入口边放着一双靴子，里面仍盛着水。
      <<elseif _shiftedVisit>>
        上次离开后，货架被挪过。旧出口标记如今指向一摞箱子后面。灯照不到的地方，有什么东西轻叩了一下。
      <</if>>
    <</if>>
<</language>>
<<temple-field-company>>
<br><br>
<<temple-field-companion-actions>>
<<if $TempleDuties.case.id is 'echo'>>
  <<if !_quietVisit>>
  <<language>>
    <<option 'EN'>>
      <<if !$TempleDuties.case.clues.includes('pipe')>>
        The iron drainpipe below the window hums with every passing gust, vibrating against the stone and throwing distorted knocking sounds across the vaulted ceiling.
      <<else>>
        You have heard the knocking carry along the empty drainpipe. It grows quieter when the wind drops.
      <</if>>
      <<if !$TempleDuties.case.clues.includes('shutter')>>
        Across the cold wall, the storm shutter hangs slightly askew; a rusted hinge rattles against the stone masonry whenever the air pressure shifts outside.
      <<else>>
        You have found a loose shutter fastening. It strikes the stone beside the drainpipe when the wind rises.
      <</if>>
    <<option 'CN'>>
      <<if !$TempleDuties.case.clues.includes('pipe')>>
        窗下的铁质排水管随着穿堂风发出空洞的嗡鸣，管壁轻微震颤，将外界气压变动放大成断断续续的沉闷敲击声，在石拱顶下回荡。
      <<else>>
        你已经听出敲击声沿空排水管传来。风停时，声音也会减弱。
      <</if>>
      <<if !$TempleDuties.case.clues.includes('shutter')>>
        冰冷的墙面上，风暴百叶窗略微倾斜，锈蚀的铰链扣件在气流掀动下时不时磕碰石壁，留下浅浅的刮痕。
      <<else>>
        你已经找到松动的百叶窗扣件。风起时，它会撞上排水管旁的石壁。
      <</if>>
  <</language>>
  <</if>>
  <br>
  <<if !$TempleDuties.case.clues.includes('pipe')>>
    <<socialiseicon>>
    <<set _pipeMinutes to $TempleDuties.case.prepared or $TempleDuties.archive.topics.includes('buildings') ? 10 : 15>>
    <<temple-duty-action `['Listen along the drain', '沿排水管听声音']` `_pipeMinutes` 'Revelation Temple Case Note'>>
      <<run $TempleDuties.case.clues.pushUnique('pipe')>>
      <<scienceskill 1>>
      <<set $TempleDuties.note to 'pipe'>>
    <</temple-duty-action>>
    (<<print '0:' + _pipeMinutes>>)<br>
  <</if>>
  <<if !$TempleDuties.case.clues.includes('shutter')>>
    <<socialiseicon>>
    <<set _shutterMinutes to currentSkillValue('science') gte 300 or $TempleDuties.case.prepared ? 10 : 20>>
    <<temple-duty-action `['Check the shutter fastening', '检查百叶窗扣件']` `_shutterMinutes` 'Revelation Temple Case Note'>>
      <<run $TempleDuties.case.clues.pushUnique('shutter')>>
      <<scienceskill 1>>
      <<set $TempleDuties.note to 'shutter'>>
    <</temple-duty-action>>
    (<<print '0:' + _shutterMinutes>>)<br>
  <</if>>
  <<if $TempleDuties.case.clues.includesAll('pipe', 'shutter')>>
    <<socialiseicon>>
    <<temple-duty-action `['Fasten the shutter and test the drain (0:15)', '固定百叶窗，测试排水管 (0:15)']` 15 'Revelation Temple Report'>>
      <<set $TempleDuties.case.result to 'resolved'>>
      <<set $TempleDuties.case.stage to 'report'>>
    <</temple-duty-action>>
    <br>
  <</if>>
  <<templeicon 'altar'>>
  <<temple-duty-action `['Draw a seal on the wall (0:20)', '在墙上画下驱邪封印 (0:20)']` 20 'Revelation Temple Report'>>
    <<set $TempleDuties.case.result to 'mistaken'>>
    <<set $TempleDuties.case.stage to 'report'>>
    <<stress 4>>
  <</temple-duty-action>>
  <br>
<<else>>
  <<if !_quietVisit>>
  <<language>>
    <<option 'EN'>>
      <<if $TempleDuties.case.id is 'roots'>>
        <<if !$TempleDuties.case.clues.includes('route')>>
          The stone steps behind you are slick with foul-smelling subterranean mold. In the gloom, a sudden retreat looks treacherous.
        <<else>>
          A clear white chalk line marks a path across the dry flagstones, providing a safe, unobstructed route back up the stairs.
        <</if>>
        <<if !$TempleDuties.case.clues.includes('marks')>>
          The dark roots constricting the old delivery books pulse like slow veins, but their tangled nodes and growth patterns remain unsketched.
        <<else>>
          You have copied the marks beside the roots and noted how they differ from the seals in the old records.
        <</if>>
      <<else>>
        <<if !$TempleDuties.case.clues.includes('rescued')>>
          From the collapsed floorboards over the sunken bilge, a trapped dockhand's muffled, desperate cries echo weakly across the dark water.
        <<else>>
          The rescued dockhand rests safely on the dry timber gangway by the entrance, wrapped in a coarse wool blanket.
        <</if>>
        <<if !$TempleDuties.case.clues.includes('route')>>
          The wet floorboards sag dangerously over the bilge; no clear path has been staked to navigate the collapse.
        <<else>>
          You have laid sturdy planks across the sagging timbers, securing a clear passage to the entrance.
        <</if>>
        <<if !$TempleDuties.case.clues.includes('marks')>>
          The returned relief crate stands under the dripping awning, but its seals and cargo records have not yet been examined.
        <<else>>
          You have thoroughly examined the crate's seals and weighbills, confirming the strange discrepancies in its cargo.
        <</if>>
      <</if>>
    <<option 'CN'>>
      <<if $TempleDuties.case.id is 'roots'>>
        <<if !$TempleDuties.case.clues.includes('route')>>
          身后的石阶覆着一层滑腻发黑的冷苔，在昏暗中湿滑难辨，稍有不慎便会失足跌入泥泞。
        <<else>>
          沿着干燥石壁画出的白色粉笔线分明醒目，标出了一条通向石门台阶的安全退路。
        <</if>>
        <<if !$TempleDuties.case.clues.includes('marks')>>
          绞缠在账册上的暗色根须如血管般缓慢抽动，表皮复杂的异变节理尚未有人抄录记录。
        <<else>>
          你已抄下根须旁的标记，并记下了它们与旧记录中封印的差别。
        <</if>>
      <<else>>
        <<if !$TempleDuties.case.clues.includes('rescued')>>
          仓库深处坍塌浸水的底板下方，受困搬运工微弱而绝望的求救声断断续续传来，黑水泛着冰冷的气泡。
        <<else>>
          获救的搬运工已经转移到入口干燥的木质货台上，裹着粗毛毯惊魂未定地喘息。
        <</if>>
        <<if !$TempleDuties.case.clues.includes('route')>>
          浸湿的板条在积水上方危险地摇晃下沉，尚未架设出一条通往大门的稳妥通道。
        <<else>>
          你已用木板与绳索稳妥加固了一条通往入口大门的畅通通道。
        <</if>>
        <<if !$TempleDuties.case.clues.includes('marks')>>
          退回的神殿货箱静置在滴水的雨棚下，封蜡与货单的异状尚未仔细核验比对。
        <<else>>
          你已仔细勘验了货箱四周的封蜡印章与运单批号，确认了箱体异常增重的诡异差额。
        <</if>>
      <</if>>
  <</language>>
  <</if>>
  <br>
  <<if !$TempleDuties.case.clues.includes('route')>>
    <<socialiseicon>>
    <<set _routeMinutes to $TempleDuties.case.prepared or $TempleDuties.archive.topics.includes('buildings') or currentSkillValue('skulduggery') gte 400 ? 10 : 20>>
    <<temple-duty-action `['Map a way out', '标出撤离路线']` `_routeMinutes` 'Revelation Temple Case Note'>>
      <<run $TempleDuties.case.clues.pushUnique('route')>>
      <<set $TempleDuties.note to 'route'>>
    <</temple-duty-action>>
    (<<print '0:' + _routeMinutes>>)<br>
  <</if>>
  <<if !$TempleDuties.case.clues.includes('marks')>>
    <<socialiseicon>>
    <<set _markMinutes to currentSkillValue('history') gte 300 or $TempleDuties.case.advised
      or $TempleDuties.archive.topics.includes('ward-notes')
      or $TempleDuties.case.id is 'crate' and $TempleDuties.archive.topics.includes('deliveries') ? 10 : 20>>
    <<temple-duty-action `['Copy and compare marks', '抄录标记并比对']` `_markMinutes` 'Revelation Temple Case Note'>>
      <<if $TempleDuties.case.id is 'roots' and !$TempleDuties.case.clues.includes('marks') and !$TempleDuties.case.clues.includes('visit-quiet')>>
        <<run maplebirch.get('Psyche')?.change(-15, 120)>>
      <</if>>
      <<run $TempleDuties.case.clues.pushUnique('marks')>>
      <<historyskill 1>>
      <<set $TempleDuties.note to 'marks'>>
    <</temple-duty-action>>
    (<<print '0:' + _markMinutes>>)<br>
  <</if>>
  <<if $TempleDuties.case.id is 'crate' and !$TempleDuties.case.clues.includes('rescued')>>
    <<socialiseicon>>
    <<set _rescueMinutes to _quietVisit or currentSkillValue('physique') gte 5000 or $TempleDuties.case.prepared ? 10 : 25>>
    <<temple-duty-action `[_quietVisit ? 'Check the workers against the list' : 'Bring the trapped worker back to the door', _quietVisit ? '对照名单，清点工人' : '把受困工人带回门边']` `_rescueMinutes` 'Revelation Temple Case Note'>>
      <<run $TempleDuties.case.clues.pushUnique('rescued')>>
      <<if !$TempleDuties.case.clues.includes('visit-quiet')>>
        <<tiredness `$TempleDuties.case.prepared ? 1 : 3`>>
      <</if>>
      <<set $TempleDuties.note to 'rescued'>>
    <</temple-duty-action>>
    (<<print '0:' + _rescueMinutes>>)
    <<if !_quietVisit>><<gtiredness>><</if>><br>
  <</if>>
  <<if _quietVisit and $TempleDuties.case.clues.includesAll('route', 'marks')
      and ($TempleDuties.case.id isnot 'crate' or $TempleDuties.case.clues.includes('rescued'))>>
    <<socialiseicon>>
    <<temple-duty-action `['Complete inspection (0:10)', '完成核对带回记录 (0:10)']` 10 `$TempleDuties.case.id is 'crate' ? 'Revelation Temple Inspection End' : 'Revelation Temple Report'`>>
      <<set $TempleDuties.case.result to 'resolved'>>
      <<set $TempleDuties.case.stage to 'report'>>
    <</temple-duty-action>>
    <br>
  <<elseif !_quietVisit>>
    <<set _fieldReady to $TempleDuties.case.clues.includesAll('route', 'marks') and ($TempleDuties.case.id isnot 'crate' or $TempleDuties.case.clues.includes('rescued'))>>
    <<if !_fieldReady>>
      <span class='blue'>
      <<if $TempleDuties.case.id is 'roots'>>
        <<lanSwitch 'The roots reach across the doorway. You have not finished marking a way back or checking the marks beside them.' '根须已经伸过门口。退路和根旁的标记，你还没有核对完。'>>
      <<else>>
        <<lanSwitch 'Something moves beneath the boards. There is still work to do before you can keep the doorway clear.' '木板下面有什么东西在动。想守住门口，还有事情需要先处理。'>>
      <</if>>
      </span><br>
    <<else>>
      <span class='teal'>
      <<if $TempleDuties.case.id is 'roots'>>
        <<lanSwitch 'The chalk line leads back to the door. You put your notes away and turn towards the roots.' '粉笔线一直通向门口。你收好笔记，转身面对那些根须。'>>
      <<else>>
        <<lanSwitch 'The worker is clear and the boards are secure. Purple tentacles slide out of the water towards you.' '工人已经离开积水，木板也撑稳了。紫色的触手从水里滑出来，探向你。'>>
      <</if>>
      </span><br>
    <</if>>
    <<if !$settings.tentaclesEnabled>>
      <<if _fieldReady>>
        <<temple-duty-action `['Secure the entrance and carry the records out (0:05)', '封好入口，将记录带出去 (0:05)']` 5 'Revelation Temple Inspection End'>>
          <<set $TempleDuties.case.stage to 'report', $TempleDuties.case.result to 'resolved'>>
        <</temple-duty-action>><br>
      <</if>>
    <<else>>
      <<templeicon 'altar'>>
      <<temple-duty-action `[_fieldReady ? ($TempleDuties.case.id is 'roots' ? 'Hold doorway and sever roots (0:01)' : 'Hold gangway and fight tendrils (0:01)') : ($TempleDuties.case.id is 'roots' ? 'Risk ambush and hack roots (0:01)' : 'Risk wading in to fight (0:01)'), _fieldReady ? ($TempleDuties.case.id is 'roots' ? '扼守石门斩断根须 (0:01)' : '立足栈道击退触手 (0:01)') : ($TempleDuties.case.id is 'roots' ? '冒险强行斩除暗根 (0:01)' : '冒险涉水正面迎战 (0:01)')]` 1 'Revelation Temple Combat'>>
        <<if $settings.tentaclesEnabled>>
          <<set $TempleDuties.case.stage to 'combat'>>
          <<set $combat to 1>>
          <<set $enemytype to 'tentacles'>>
          <<molested>>
          <<controlloss>>
          <<set _fieldCount to ($TempleDuties.case.prepared and $TempleDuties.case.clues.includes('route') ? 4 : 8)
            + ($TempleDuties.case.clues.includes('visit-shifted') ? 2 : 0)
            - ($TempleDuties.archive.topics.includes('ward-notes') ? 1 : 0)
            - ($TempleDuties.case.id is 'roots' and !$TempleDuties.rewards.includes('roots') ? 1 : 0)>>
          <<if $TempleDuties.case.id is 'roots'>>
            <<tentaclestart _fieldCount 12 'root' 'vine' true>>
          <<else>>
            <<tentaclestart _fieldCount 15>>
          <</if>>
        <</if>>
      <</temple-duty-action>>
      <br>
    <</if>>
  <</if>>
<</if>>
<<socialiseicon>>
<<set _withdrawMinutes to $TempleDuties.case.prepared or $TempleDuties.archive.topics.includes('fieldwork') ? 3 : 5>>
<<temple-duty-action `['Withdraw with your notes', '携带笔记撤离']` `_withdrawMinutes` 'Revelation Temple Withdrawal'>>
  <<set $TempleDuties.case.stage to 'report'>>
  <<set $TempleDuties.case.result to 'withdrawn'>>
  <<if $TempleDuties.case.clues.includes('visit-damp') and !$TempleDuties.case.prepared>>
    <<tiredness 2>>
  <</if>>
<</temple-duty-action>>
(<<print '0:0' + _withdrawMinutes>>)
<<if _dampVisit and !$TempleDuties.case.prepared>><<gtiredness>><</if>><br>
<br>
<<getouticon>>
<<lanLink ['Leave for now', '先离开这里'] `$TempleDuties.case.id is 'echo' ? 'Revelation Temple Case Brief' : 'Docks'`>>
<</lanLink>>
<br>

:: Revelation Temple Case Note
<<if ['roots', 'crate'].includes($TempleDuties.case?.id) and $TempleDuties.note isnot 'kit'>>
  <<set $outside to 1>>
  <<set $location to 'docks'>>
  <<effects>>
  <<temple-duty-check>>
<<else>>
  <<temple-duty-place>>
<</if>>
<<if !$TempleDuties.case or !_dutySafe>>
  <<temple-case-return>>
  <<exit>>
<</if>>
<<language>>
  <<option 'EN'>>
    <<switch $TempleDuties.note>>
      <<case 'kit'>>
        Jordan counts the rope and gloves with you. The lamp is filled. You test the knot and turn its light over the notes. It will be easier to work a fastening, keep your way back visible and bring someone across a broken floor. All three are to be returned with your report.
      <<case 'pipe'>>
        The knocking carries along the empty drain. It grows quieter when the wind drops. You note how the pipe carries the sound into the room. Hearing it behind the wall does not mean that its source is inside the wall.
      <<case 'shutter'>>
        The shutter fastening is loose. It strikes the stone beside the window, exactly where the scratches are. A light push reproduces the knock. Fastening it will let you check whether the wind was causing the sound.
      <<case 'route'>>
        You find a dry way back to the door, wedge it open and mark the route in chalk. You can now find the exit even if you have to leave in a hurry.
      <<case 'marks'>>
        The marks at the site differ from the seal copied in the old records. You sketch both and mark the differences. The old seal cannot explain these marks on its own, and neither tells you who left them.
      <<case 'rescued'>>
        <<if $TempleDuties.case.clues.includes('visit-quiet')>>
          The repeated name belongs to one worker who helped with two loads. You read the list back and let the porter correct it. Everyone answers from this side of the door.
        <<else>>
          Using a rope or the porters' boards to cross the damaged floor, you bring the trapped adult worker back onto sound flooring. The porter at the door leads them outside. The calls stop, but the dark water remains.
        <</if>>
    <</switch>>
  <<option 'CN'>>
    <<switch $TempleDuties.note>>
      <<case 'kit'>>
        约旦和你一起数清绳索与手套，灯已经加满。你试过绳结，让灯光落在笔记上。有了它们，检查扣件、留好归路，以及把人带过破损地板都会容易些。交报告时，三样都要归还。
      <<case 'pipe'>>
        敲击声沿着空的排水管传下来，风停时，声音也小了。你记下这一点：声音会沿管道传进房间，听起来在墙后，源头却不一定在墙里。
      <<case 'shutter'>>
        百叶窗的扣件松了，晃动时正好敲在窗边有刮痕的石头上。你轻推窗扇，又听见同样的敲击声。把窗固定住，就能再试试风吹过时还会不会响。
      <<case 'route'>>
        你沿干燥的一侧找到返回门口的路，把门楔住，再用粉笔标出路线。真要匆忙撤离时，也能沿着标记找到出口。
      <<case 'marks'>>
        现场标记的线条，与旧记录里抄下的封印不同。你把两种图样画在一起，标出差别。旧封印不能直接解释眼前的痕迹，你也还不知道是谁留下了这些标记。
      <<case 'rescued'>>
        <<if $TempleDuties.case.clues.includes('visit-quiet')>>
          名字重复的工人帮忙搬了两批货。你读回名单，让搬运工更正。所有人都在门的这一侧应答。
        <<else>>
          你用绳索接应，或借搬运工的木板搭过破损处，把受困的成年工人带回完好的地板上。门边的搬运工接过人，领到仓库外。呼救声停了，里面的黑水却还在。
        <</if>>
    <</switch>>
<</language>>
<br><br>
<<if ['roots', 'crate', 'ritual'].includes($TempleDuties.case?.id) and $TempleDuties.note is 'kit'>>
  <<getouticon>>
  <<lanLink ['Return to the hall', '返回大厅'] 'Temple'>>
  <</lanLink>>
  <br>
<<else>>
  <<getouticon>>
  <<lanLink ['Continue the investigation', '继续调查'] 'Revelation Temple Field'>>
  <</lanLink>>
  <br>
<</if>>

:: Revelation Temple Combat
<<if $TempleDuties.case?.stage is 'field'>>
  <<if $TempleDuties.case.id is 'ritual'>><<include 'Revelation Temple Ritual Site'>><<else>><<include 'Revelation Temple Field'>><</if>>
  <<exit>>
<</if>>
<<if $TempleDuties.case?.stage is 'combat' and $combat is 1 and $enemytype is 'tentacles'>>
  <<temple-tentacle-turn 'Revelation Temple Combat' 'Revelation Temple Combat End'>>
<<else>>
  <<getouticon>>
  <<lanLink ['Return to report', '返回汇报'] 'Revelation Temple Report'>>
  <</lanLink>>
  <br>
<</if>>

:: Temple Tentacle Turn Widgets [widget]
<<widget 'temple-tentacle-turn'>>
  <<statetentacles>>
  <<effects>>
  <<effectstentacles>>
  <<tentacles>>
  <<actionstentacles>>
  <!-- 临时战败标记不跨 passage，沿用委托结果把撤离带到收尾页。 -->
  <<if _combatend>><<set $TempleDuties.case.result to 'withdrawn'>><</if>>
  <<if $tentacles.active lte $tentacles.max / 2 or _combatend>>
    <span id='next'>
    <<lanLink ['Next', '继续'] `_args[1]`>>
    <</lanLink>>
    </span><<nexttext>>
  <<else>>
    <span id='next'>
    <<lanLink ['Next', '继续'] `_args[0]`>>
    <</lanLink>>
    </span><<nexttext>>
  <</if>>
<</widget>>

:: Revelation Temple Combat End
<<if $TempleDuties.case?.id is 'ritual'>><<include 'Revelation Temple Ritual Combat End'>><<exit>><</if>>
<<if $TempleDuties.case?.stage is 'combat' and $combat is 1 and $enemytype is 'tentacles' and ($tentacles.active lte $tentacles.max / 2 or $TempleDuties.case.result is 'withdrawn')>>
  <<set _caseWon to $TempleDuties.case.result isnot 'withdrawn' and $tentacles.active lte $tentacles.max / 2 and $stress lt $stressmax and !$possessed>>
  <<if _caseWon>>
    <<run $TempleDuties.case.clues.pushUnique('route', 'marks')>>
    <<if $TempleDuties.case.id is 'crate'>>
      <<run $TempleDuties.case.clues.pushUnique('rescued')>>
    <</if>>
    <<set $TempleDuties.case.result to 'resolved'>>
  <<else>>
    <<set $TempleDuties.case.result to 'withdrawn'>>
  <</if>>
  <<set $TempleDuties.case.stage to 'report'>>
  <<clotheson>>
  <<endcombat>>
<</if>>
<<if $combat>>
  <<lanLink ['Continue fighting', '继续战斗'] 'Revelation Temple Combat'>>
  <</lanLink>>
  <<exit>>
<</if>>
<<language>>
  <<option 'EN'>>
    <<if $TempleDuties.case?.result is 'resolved'>>
      <<if $TempleDuties.case.id is 'roots'>>
        The roots shrink into the cracks. You reach for a twitching end, but the monk catches your sleeve. "Leave it. We have what we came for." You free the damp books while the monk keeps the lamp on the wall, then back through the doorway together.
      <<else>>
        The last purple coil slips beneath the boards. You wait, watching the dark water. The porter calls from the doorway. Everyone is outside. You take the papers and follow, pulling the door shut behind you.
      <</if>>
      <br><br>
      You can take your account back to Jordan.
    <<else>>
      <<if $TempleDuties.case?.id is 'roots'>>The monk pulls you back over the step and forces the door shut. "That's enough. We'll tell Jordan."<<else>>You crawl back across the boards. The porter catches your arm at the doorway and pulls you clear before shutting the door.<</if>>
      You wait for your breathing to settle, then mark the entrance as unsafe. You can tell Jordan what happened and try again when you are ready.
    <</if>>
  <<option 'CN'>>
    <<if $TempleDuties.case?.result is 'resolved'>>
      <<if $TempleDuties.case.id is 'roots'>>
        根须缩回石缝。你伸手去抓仍在抽动的一截，修士却拉住了你的袖子。“别管了。要拿的已经拿到了。”修士用灯照住墙面，你抽出湿漉漉的账簿，两人一起退过门槛。
      <<else>>
        最后一截紫色的触手滑进木板下面。你盯着黑水，等了一会儿。搬运工从门口叫你，其他人都出去了。你带上纸张跟过去，从外面拉上了门。
      <</if>>
      <br><br>
      可以回去向约旦说明经过了。
    <<else>>
      <<if $TempleDuties.case?.id is 'roots'>>修士拽着你退过台阶，用力关上门。“够了。回去告诉约旦。”<<else>>你沿木板爬回去。门口的搬运工抓住你的胳膊，将你拉出来，随即关上了门。<</if>>
      你等呼吸稍稍平复，在入口留下危险的记号。先向约旦说明经过，准备好了再来。
    <</if>>
<</language>>
<br><br>
<<temple-case-return>>

:: Revelation Temple Report
<<temple-duty-place>>
<<npc Jordan>>
<<person1>>
<<if !_dutyReport>>
  <<lanSwitch 'Jordan will hear the report when the desk opens again.' '职务桌再次开放时，约旦会听你的报告。'>><br><br>
  <<temple-duty-back>>
  <<exit>>
<</if>>
<<language>>
  <<option 'EN'>>
    Jordan puts your report beside the original assignment. "Tell me what you found. If something went wrong, I need to know that too."
    <<if $TempleDuties.case.result is 'mistaken'>>
      A clerk has already recorded that the knocking continued after the seal was painted.
    <</if>>
  <<option 'CN'>>
    约旦把报告放在委托单旁。“告诉我你发现了什么。如果出了差错，我也得知道。”
    <<if $TempleDuties.case.result is 'mistaken'>>
      侍从已经记下：封印画好后，敲击仍在继续。
    <</if>>
<</language>>
<br><br>
<<set _paidVisit to $TempleDuties.case.clues.some(clue => clue.startsWith('visit-'))
  and $TempleDuties.case.result is 'resolved' and $temple_rank is 'priest'
  and Time.days gte ($TempleDuties.followups[$TempleDuties.case.id] ?? -7) + 7>>
<<if _paidVisit>>
  <<set _visitPay to $TempleDuties.case.id is 'echo' ? 3500 : $TempleDuties.case.id is 'roots' ? 6000 : 8000>>
  <<lanSwitch 'Return inspection: ' '回访劳务费：'>><span class='gold'><<printmoney _visitPay>></span><br>
<</if>>
<<if _paidVisit and $TempleDuties.duty_day is Math.floor(Time.days)>>
  <span class='lblue'><<lanSwitch 'Your paid shift is already entered for today. Bring the report tomorrow; the clerk keeps the inspection open.' '今天的有薪职务已经登记。明天再带报告来，侍从会保留这次检查。'>></span><br><br>
  <<temple-duty-back>>
  <<exit>>
<</if>>
<<socialiseicon>>
<<temple-duty-action `['Give a factual report, including the gaps (0:10)', '如实汇报，也说清尚未查明的事 (0:10)']` 10 'Revelation Temple Report Done'>>
  <<if $TempleDuties.case?.stage is 'combat' and !$combat>>
    <<set $TempleDuties.case.stage to 'report'>>
    <<set $TempleDuties.case.result to 'withdrawn'>>
  <</if>>
  <<temple-case-file true>>
<</temple-duty-action>>
<br>
<<socialiseicon>>
<<temple-duty-action `['Present everything as a successful exorcism (0:10)', '把一切都说成成功驱魔 (0:10)']` 10 'Revelation Temple Report Done'>>
  <<if $TempleDuties.case?.stage is 'combat' and !$combat>>
    <<set $TempleDuties.case.stage to 'report'>>
    <<set $TempleDuties.case.result to 'withdrawn'>>
  <</if>>
  <<temple-case-file false>>
<</temple-duty-action>>
<br>
<br>
<<temple-duty-back>>

:: Temple Duties Report Widgets [widget]
<<widget 'temple-case-file'>>
  <<temple-duty-check>>
  <<if _dutySafe and $TempleDuties.enrolled and $TempleDuties.case?.stage is 'report'>>
    <<set _file to $TempleDuties.case>>
    <<set _paidVisit to _args[0] and _file.result is 'resolved'
      and _file.clues.some(clue => clue.startsWith('visit-'))
      and $temple_rank is 'priest' and $TempleDuties.rewards.includesAll('echo', 'roots', 'crate')
      and Time.days gte ($TempleDuties.followups[_file.id] ?? -7) + 7>>
    <<if _paidVisit and $TempleDuties.duty_day is Math.floor(Time.days)>>
      <<exit>>
    <</if>>
    <<set $TempleDuties.note to _args[0] ? _file.result : 'inflated'>>
    <<set $TempleDuties.reports[_file.id] to { result: _file.result || 'withdrawn', honest: _args[0], day: Math.floor(Time.days) }>>
    <<if _args[0] and _file.result is 'resolved' and !$TempleDuties.rewards.includes(_file.id)>>
      <<run $TempleDuties.rewards.push(_file.id)>>
      <<set $TempleDuties.followups[_file.id] to Math.floor(Time.days)>>
      <<grace 3>>
      <<famegood 10 null true>>
      <<money `_file.id is 'echo' ? 6000 : _file.id is 'roots' ? 15000 : 20000` 'templeDuty'>>
    <<elseif _paidVisit>>
      <<set $TempleDuties.followups[_file.id] to Math.floor(Time.days)>>
      <<set $TempleDuties.duty_day to Math.floor(Time.days)>>
      <<set $TempleDuties.duties += 1>>
      <<set $TempleDuties.note to 'revisited-' + _file.id>>
      <<grace 1>>
      <<money `_file.id is 'echo' ? 3500 : _file.id is 'roots' ? 6000 : 8000` 'templeDuty'>>
    <<elseif !_args[0]>>
      <<npcincr Jordan love -2>>
    <</if>>
    <<temple-field-file _args[0]>>
    <<if _file.id is 'ritual' and _file.result isnot 'resolved'
        and (_file.clues.includes('interrupt') or _args[0] and (_file.clues.includes('marks') or _file.clues.includes('confronted')))>>
      <<set _file.clues to _file.clues.filter(clue => clue isnot 'departed' and !clue.startsWith('party-day:'))>>
      <<if _file.clues.includes('rescued')>><<run _file.clues.pushUnique('evacuated')>><</if>>
      <<run _file.clues.pushUnique('help')>>
      <<set _file.stage to 'field', _file.result to ''>>
      <<set $TempleDuties.note to _file.clues.includes('evacuated') ? 'ritual-withdrawn' : 'ritual-help'>>
    <<elseif !(_file.id is 'ritual' and !_args[0] and _file.result is 'resolved')>>
      <!-- 已完成的救援若谎报，只需重新提交报告，不重演受困者被绑。 -->
      <<set $TempleDuties.case to null>>
    <</if>>
  <</if>>
<</widget>>

:: Revelation Temple Report Done
<<temple-duty-place>>
<<npc Jordan>>
<<person1>>
<<if $TempleDuties.note.startsWith('field-ritual')>>
  <<temple-ritual-debrief>>
<<elseif $TempleDuties.note.startsWith('field-')>>
  <<temple-field-debrief>>
<<else>>
<<language>>
  <<option 'EN'>>
    <<switch $TempleDuties.note>>
      <<case 'revisited-echo'>>
        Jordan compares the two visits before signing the new entry. "You returned. You checked again." The clerk sets your inspection pay beside the shift book. Your notes on the fastening and drain remain beside the old report. Neither explains the knock after the door is shut.
      <<case 'revisited-roots'>>
        Jordan traces the cleared route on your sketch. "Keep this with the next shift's instructions." The clerk sets your inspection pay beside it. The new growth and the places you could safely reach are recorded separately.
      <<case 'revisited-crate'>>
        Jordan compares the cargo list with your new account. "And the workers are clear of it now?" <<He>> records your answer before signing. The clerk files the handover and sets your inspection pay on the desk.
      <<case 'resolved'>>
        Jordan reads the evidence before signing. "You checked, and you brought back what mattered." <<He>> enters the work in the duties book.
      <<case 'ritual-withdrawn'>>
        Jordan calls a monk to look after the rescued visitor, then takes your hands. "Are you hurt, child?" <<He>> listens to your answer before turning to the others. "We must keep people away from that path." An older monk takes the sketch. If you return to show the way, you will have company.
      <<case 'ritual-help'>>
        Jordan rises as you describe the stone and the bound person. "Thank you for coming back. We must hurry." <<He>> calls over two members and gives them your sketch. One takes a whip from beneath their habit. "Meet me at the shore," the monk tells you. "I'll go with you."
      <<case 'withdrawn'>>
        "Coming back for help is a decision too," Jordan says. <<He>> marks the place as unsafe and files what you found. If you decide to return, ask at the duties desk to take the assignment again.
      <<case 'mistaken'>>
        "Then the seal has not stopped it. The fastening and the pipe still need checking," Jordan says. <<He>> asks the clerk to record the unsuccessful attempt. You can take the assignment again if you want to investigate further.
      <<case 'inflated'>>
        Jordan compares your account with the clerk's notes. "These don't say the same thing. I can't sign a report I can't trust."
    <</switch>>
  <<option 'CN'>>
    <<switch $TempleDuties.note>>
      <<case 'revisited-echo'>>
        约旦比对过两次记录，才签下新的那一行。“你回去了。又核实了一遍。”侍从把检查报酬放在值班簿旁。扣件和排水管的检查记录附在旧报告边，两份都没解释关门后传来的敲击。
      <<case 'revisited-roots'>>
        约旦沿着草图上清出的路线看了一遍。“把这个留给下一班。”侍从把检查报酬放在图旁。新长出的根须，与能安全走到的位置，分别记在两处。
      <<case 'revisited-crate'>>
        约旦拿货单比对你这次的记录。“工人已经离开危险位置了？”<<He>>记下你的回答，随后签字。侍从收好交接单，把检查报酬放在桌上。
      <<case 'resolved'>>
        约旦先看证据，才签字。“你核对过，也把重要的东西带回来了。”<<He>>将这次工作记进职务簿。
      <<case 'ritual-withdrawn'>>
        约旦叫来修士照看获救的访客，又握住你的双手。“孩子，你受伤了吗？”<<He>>听你回答，才转向其他人。“不能再让人走上那条小径。”一名资深修士接过草图。等你回去指路时，会有人陪同。
      <<case 'ritual-help'>>
        你说起石台上被绑住的人，约旦立刻站了起来。“谢谢你回来告诉我。我们得快些。”<<He>>叫来两名成员，把草图交给他们。其中一人从袍下取出长鞭。“到湖岸找我，”修士对你说，“我和你一起去。”
      <<case 'withdrawn'>>
        “回来求援，也是一种判断。”约旦说。<<He>>标明危险位置，收好你已经查到的记录。等你准备再次调查时，可以在职务桌重新接下委托。
      <<case 'mistaken'>>
        “这么说，封印没能止住声音。扣件和排水管，两样都还得查。”约旦让侍从记下这次未成的尝试。如果想再调查，你可以重新接下委托。
      <<case 'inflated'>>
        约旦把你的说法与侍从便条比对。“这两份讲的不是同一回事。我不能签一份无法信任的报告。”
    <</switch>>
<</language>>
<br><br>
<</if>>
<<temple-duty-rest-link>>
<<temple-duty-back>>

:: Revelation Temple Gwylan
<<set $outside to 0>>
<<set $location to 'forest_shop'>>
<<effects>>
<<temple-duty-check>>
<<set _gwylanLocation to gwylanSchedule()>>
<<if _dutySafe and _gwylanLocation is 'shop' and C.npc.Gwylan.init is 1
    and C.npc.Gwylan.state is 'active'
    and $TempleDuties.case?.stage is 'field' and !$TempleDuties.case.advised>>
  <<npc Gwylan>>
  <<person1>>
  <<set $TempleDuties.case.advised to true>>
  <<language>>
    <<option 'EN'>>
      Gwylan turns the page towards the light. "A copied mark won't tell you who made the original," <<he>> says. "Keep the difference in your notes." <<He>> taps the exit you have marked. "And keep that. You need somewhere to return to."
      <<if $temple_confessor_intro>>
        "The people you met may ask for more than a report. Decide what you'll promise before they ask."
      <</if>>
    <<option 'CN'>>
      格威岚把纸转向光。“抄下的标记，不会告诉你原件是谁留下的，”<<he>>说，“把区别记好。”<<He>>轻点你画的出口。“这个也要留好。你需要能回去的地方。”
      <<if $temple_confessor_intro>>
        “你见过的那些人，可能不只要报告。他们开口之前，想好自己会答应什么。”
      <</if>>
  <</language>>
<<elseif _gwylanLocation isnot 'shop'>>
  <<lanSwitch 'Gwylan has stepped away from the counter. You put your notes away for another visit.' '格威岚不在柜台边。你收好笔记，留待下次交谈。'>>
<</if>>
<br><br>
<<getouticon>>
<<lanLink ['Return to the shop', '返回店内'] 'Forest Shop Entrance'>>
<</lanLink>>
<br>

:: Revelation Temple Case Accepted
<<temple-duty-place>>
<<if $TempleDuties.case>>
  <span class='gold bold'><<temple-case-title $TempleDuties.case.id>></span><br><br>
  <<lanSwitch 'Jordan has entered the assignment under your name. You can borrow equipment or read the old records before going to the site. If you leave to prepare, the investigation stays open; tell Jordan if you decide to withdraw.' '约旦已把委托记在你名下。出发前，可以借用器具，也可以先去旧资料室查阅记录。暂时离开不会结束调查，如果决定退出，再向约旦说明。'>><br><br>
  <<icon 'temple/field-kit.png'>>
  <<lanLink ['Review the instructions and prepare', '核对说明，做好准备'] 'Revelation Temple Case Brief'>>
  <</lanLink>>
  <br>
<<else>>
  <<lanSwitch 'The assignment could not be entered. Return when Jordan is available.' '这次没有登记成功。约旦能接待时，可以再来。'>><br>
<</if>>
<br>
<<temple-duty-back>>

:: Revelation Temple Withdrawal
<<lanSwitch 'You leave the unsafe area with your notes and end this attempt. Take what you found to Jordan before arranging another visit.' '你带着笔记撤出危险区域，这次调查到此为止。先把已经查到的事告诉约旦，再安排回访。'>><br><br>
<<temple-case-return>>

:: Revelation Temple Inspection End
<<set $outside to 1>><<set $location to 'docks'>><<effects>>
<<lanSwitch 'You finish the inspection and put the checked records with your notes.' '你完成检查，把核对过的记录收进笔记。'>><br><br>
<<temple-case-return>>
