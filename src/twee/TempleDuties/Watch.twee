:: Temple Watch Widgets [widget]
<<widget 'temple-watch-skills'>>
  <<silently>>
    <<set _watchRouteSkill to currentSkillValue('history') gte 400 or currentSkillValue('science') gte 400
      or currentSkillValue('skulduggery') gte 500>>
    <<set _watchNotes to $TempleDuties.archive.topics.includes('ward-notes')>>
    <<set _watchPrayer to (maplebirch.get('TempleChoir')?.singing ?? 0) gte 600 or currentSkillValue('english') gte 600>>
    <<set _watchWill to _watchPrayer ? 550 : 650>>
    <<set _watchControl to $awareness gte 600 ? 350 : 400>>
  <</silently>>
<</widget>>

<<widget 'temple-watch-check'>>
  <<set _watch to $TempleDuties.watch>>
  <<set _watchActive to Boolean(_watch) and !['passed', 'failed'].includes(_watch.phase)>>
  <<set _watchSafe to _dutySafe and _dutyCredentials and _watchActive and Time.date.timeStamp lt _watch.until>>
  <<if _watchActive>>
    <<for _watchName range _watch.party>>
      <<temple-candidate-check _watchName 0>>
      <<if !_candidateFree or !_candidate.agreed>>
        <<set _watchSafe to false>>
      <</if>>
    <</for>>
  <</if>>
<</widget>>

<<widget 'temple-watch-roster'>>
  <<if $TempleDuties.party.length>>
    <<socialiseicon>>
    <<lanLink ['Cancel all invitations', '取消所有邀请']>>
      <<set $TempleDuties.party to []>>
      <<replace '#temple-watch-roster'>>
        <<temple-watch-roster>>
      <</replace>>
    <</lanLink>>
    <br>
  <</if>>
  <<for _watchName range ['Robin', 'Sydney']>>
    <<temple-candidate-check _watchName 0>>
    <<if _candidateFree and _candidate.agreed and _candidate.lessons.includesAll('care', 'wards')>>
      <<capture _watchName>>
        <<socialiseicon>>
        <<lanLink `[$TempleDuties.party.includes(_watchName) ? 'Cancel invitation: ' + maplebirch.auto(_watchName) : 'Invite ' + maplebirch.auto(_watchName) + ' to join the watch', $TempleDuties.party.includes(_watchName) ? '取消对' + maplebirch.auto(_watchName) + '的邀请' : '邀请' + maplebirch.auto(_watchName) + '一起参加守望']`>>
          <<if $TempleDuties.party.includes(_watchName)>>
            <<run $TempleDuties.party.delete(_watchName)>>
          <<else>>
            <<run $TempleDuties.party.pushUnique(_watchName)>>
          <</if>>
          <<replace '#temple-watch-roster'>>
            <<temple-watch-roster>>
          <</replace>>
        <</lanLink>>
        <<if $TempleDuties.party.includes(_watchName)>>
          <span class='teal'><<lanSwitch ' · Invited' ' · 已邀请'>></span>
        <</if>>
        <br>
      <</capture>>
    <</if>>
  <</for>>
  <<set _watchStart to _dutyCredentials and Time.hour lt 14
    and !(Time.weekDay is 1 and Time.hour lt 13)
    and !_watchActive and $TempleDuties.watch?.day isnot Math.floor(Time.days)
    and !$TempleDuties.case>>
  <<set _watchUnavailable to []>>
  <<for _watchName range $TempleDuties.party>>
    <<temple-candidate-check _watchName 185>>
    <<if !_candidateFree or !_candidate.agreed or !_candidate.lessons.includesAll('care', 'wards')>>
      <<set _watchStart to false>>
      <<run _watchUnavailable.push(_watchName)>>
    <</if>>
  <</for>>
  <<if _watchStart>>
    <br>
    <<icon 'temple/watch-door.png'>>
    <<temple-duty-action `['Enter the lower passage and begin the watch (0:05)', '进入下层通道，开始守望 (0:05)']` 5 'Revelation Temple Watch' `$TempleDuties.party`>>
      <<if _dutyCredentials and !$TempleDuties.case and $TempleDuties.watch?.day isnot Math.floor(Time.days)>>
        <<set $TempleDuties.watch to { day: Math.floor(Time.days), until: Time.date.timeStamp + 10800,
          party: clone($TempleDuties.party), phase: 'threshold', aids: [], route: false }>>
        <<set $TempleDuties.party to []>>
      <</if>>
    <</temple-duty-action>>
    <br>
  <<else>>
    <<if !_dutyCredentials>>
      <<temple-duty-requirements 'watch'>>
    <<elseif $TempleDuties.case>>
      <span class='lblue'><<lanSwitch 'Finish the current investigation and report to Jordan before taking the watch.' '先完成手头的调查并向约旦汇报，再接下守望。'>></span><br>
    <<elseif $TempleDuties.watch?.day is Math.floor(Time.days)>>
      <span class='lblue'><<lanSwitch 'You have already attempted the watch today. You may return tomorrow.' '今天已经尝试过守望，可以明天再来。'>></span><br>
    <<elseif Time.weekDay is 1 and Time.hour lt 13>>
      <span class='lblue'><<lanSwitch 'Wait until Sunday mass ends at 13:00 before beginning the watch.' '等周日弥撒结束，13:00 后再开始守望。'>></span><br>
    <<elseif Time.hour gte 14>>
      <span class='lblue'><<lanSwitch 'It is too late to begin today. Return before 14:00, with three hours free after entering the passage.' '今天已经来不及开始。请在 14:00 前再来，并为进入通道后的守望留出三小时。'>></span><br>
    <<elseif _watchUnavailable.length>>
      <span class='lblue'><<print _watchUnavailable.map(name => maplebirch.auto(name)).join(lanSwitch(', ', '、'))>><<lanSwitch ': not ready for this watch, or unable to stay for the entry and three-hour watch. Check the preparation book or cancel the invitation.' '：尚未准备好，或无法为入场和三小时守望留出空闲。请核对候任名册，也可以取消邀请。'>></span><br>
    <</if>>
  <</if>>
<</widget>>

<<widget 'temple-watch-support'>>
  <<for _watchName range _watch.party>>
    <<set _watchAid to _watchName + ':' + _args[0]>>
    <<if !_watch.aids.includes(_watchAid)>>
      <<capture _watchName _watchAid>>
        <<socialiseicon>>
        <<if _args[0] is 'lamp'>>
          <<temple-duty-action `['Help ' + maplebirch.auto(_watchName) + ' steady the lamp against the cold draft (0:05)', '在第一道门前帮' + maplebirch.auto(_watchName) + '扶稳提灯，抵御阴风 (0:05)']` 5 'Revelation Temple Watch Support' `_watchName`>>
            <<temple-watch-check>>
            <<if _watchSafe and !_watch.aids.includes(_watchAid)>>
              <<run _watch.aids.push(_watchAid)>>
              <<set $TempleDuties.speaker to _watchName>>
            <</if>>
          <</temple-duty-action>>
        <<else>>
          <<temple-duty-action `['Guide ' + maplebirch.auto(_watchName) + ' through the prayer response against the calling (0:05)', '在第二道门前引领' + maplebirch.auto(_watchName) + '应和答词，抵御呼唤 (0:05)']` 5 'Revelation Temple Watch Support' `_watchName`>>
            <<temple-watch-check>>
            <<if _watchSafe and !_watch.aids.includes(_watchAid)>>
              <<run _watch.aids.push(_watchAid)>>
              <<set $TempleDuties.speaker to _watchName>>
            <</if>>
          <</temple-duty-action>>
        <</if>>
        <br>
      <</capture>>
    <</if>>
  <</for>>
<</widget>>


:: Revelation Temple Watch Brief
<<temple-duty-place>>
<<temple-watch-check>>
<<if !_dutyOffice or !$TempleDuties.enrolled or !['monk', 'priest'].includes($temple_rank)>>
  <<temple-duty-back>>
  <<exit>>
<</if>>
<<npc Jordan>>
<<person1>>
<<language>>
  <<option 'EN'>>
    Jordan lifts three keys from the ring. Two are polished. The third leaves a dark stain on <<his>> palm. "An older priest will lead you through the lower passage. Check all three doors, and bring everyone back. The first keeps the wind out. The second keeps the flock safe from what calls beyond it. At the last, listen carefully to who is asking."
    <<He>> covers the third key with <<his>> fingers. "Take the prayer sheet and the ward pattern. Each person needs a lamp. Help your companions hold theirs at the first door, and recite with them at the second. I shall wait by the outer door for your return."
  <<option 'CN'>>
    约旦从钥匙圈上取下三把钥匙。两把已经磨亮，第三把却在<<his>>掌心留下了深色的痕迹。“资深司祭会领你进入下层通道。检查完三扇门，再把所有人带回来。第一扇门挡风，第二扇门把教徒与门后的呼唤隔开。到了最后一扇，听清楚是谁在请求。”
    <<He>>合拢手指，遮住第三把钥匙。“带上祷文和护符图样，每人拿一盏灯。若有同伴参加，记得在第一扇门前帮他们持稳灯，在第二扇门前陪他们念祷文。我会在外门这里，等你们回来。”
<</language>>
<br><br>
<<if _watchActive>>
  <<icon 'temple/watch-door.png'>>
  <<lanLink ['Return to the unfinished watch', '继续尚未结束的守望'] 'Revelation Temple Watch'>>
  <</lanLink>>
  <br>
<<else>>
  <div id='temple-watch-roster'>
    <<temple-watch-roster>>
  </div>
<</if>>
<br>
<<temple-duty-back>>

:: Revelation Temple Watch
<<temple-duty-place>>
<<temple-watch-check>>
<<temple-watch-skills>>
<<if !_watchActive>>
  <<temple-duty-back>>
  <<exit>>
<</if>>
<<if $combat>>
  <<lanLink ['Continue fighting', '继续战斗'] 'Revelation Temple Watch Combat'>>
  <</lanLink>>
  <<exit>>
<</if>>
<<if !_watchSafe>>
  <<lanSwitch 'The flame has burned below the mark Jordan showed you. The older priest knocks on the outer door, signalling that it is time for everyone to leave the passage.' '火苗已经低过约旦指给你看的刻痕。资深司祭叩响外门，示意大家该退出通道了。'>>
  <br><br>
  <<temple-watch-leave>>
  <<exit>>
<</if>>
<<switch _watch.phase>>
  <<case 'threshold'>>
    <<language>>
      <<option 'EN'>>
        The passage runs beside the garden wall. You can hear water beyond the wall, though it has not rained here. The older priest leads you to the first door and points to the roots caught beneath it. "The forest has found this way again. Clear those roots so we can pass. Keep the lamps facing the outer door, where we came in."
        <<if _watch.party.includes('Robin')>>
          <<if _watch.aids.includes('Robin:lamp')>>
            <br><br>Robin stays close beside you, holding the lamp with both hands. The flame burns steady and clear, casting a warm amber ring across the flagstones.
          <<else>>
            <br><br>The icy draft whistling beneath the door flutters Robin's habit. Robin shivers slightly, knuckles pale around the lantern handle as the flame gutters violently in the wind.
          <</if>>
        <</if>>
        <<if _watch.party.includes('Sydney')>>
          <<if _watch.aids.includes('Sydney:lamp')>>
            <br><br>Sydney holds the lantern upright and still; its level glow illuminates every scratch and mortar seam in the ancient stonework.
          <<else>>
            <br><br>Sydney is squinting into the gloom along the stone vault, lantern swaying in the sudden draft, casting jittery shadows against the wall.
          <</if>>
        <</if>>
      <<option 'CN'>>
        通道沿着花园围墙延伸。墙后传来水声，可这里并没有下雨。资深司祭领你来到第一扇门前，指着卡在门下的根须。“森林又找到这里了。先清开这些根须，我们才能过去。让灯照着进来时的外门，别忘了退路。”
        <<if _watch.party.includes('Robin')>>
          <<if _watch.aids.includes('Robin:lamp')>>
            <br><br>罗宾紧挨在你身旁，双手稳稳端着提灯。灯火明亮而安定，在石板地上晕开一圈温暖的橙光。
          <<else>>
            <br><br>门缝里灌入的刺骨阴风吹乱了罗宾的衣袍。罗宾单薄的身子微微发抖，手指发白地攥着提灯把手，火苗在气流中狂乱晃荡，几欲熄灭。
          <</if>>
        <</if>>
        <<if _watch.party.includes('Sydney')>>
          <<if _watch.aids.includes('Sydney:lamp')>>
            <br><br>悉尼手中的提灯平稳端正，明亮稳定的火光将石壁上的每一道刻痕与灰缝照得分毫毕现。
          <<else>>
            <br><br>悉尼正凝神观察石拱深处的黑暗，冷风灌来，手中的提灯摇晃不定，石壁上的阴影也跟着混乱地摆动。
          <</if>>
        <</if>>
    <</language>>
    <br><br>
    <<temple-watch-support 'lamp'>>
    <<icon 'temple/ward-stone.png'>>
    <<temple-duty-action `['Mark the way back and check the copied ward pattern first (0:20)', '先标好退路，核对抄录的护符图样 (0:20)']` 20 'Revelation Temple Watch Note' `_watch.party`>>
      <<temple-watch-check>>
      <<if _watchSafe and _watch.phase is 'threshold'>>
        <<temple-watch-skills>>
        <<set _watch.route to _watchRouteSkill>>
        <<set $TempleDuties.note to 'watch-route'>>
      <</if>>
    <</temple-duty-action>>
    <br>
    <<templeicon 'trialcontinue'>>
    <<temple-duty-action `['Fight back the roots blocking the doorway (0:01)', '清除堵住门口的根须 (0:01)']` 1 'Revelation Temple Watch Combat' `_watch.party`>>
      <<temple-watch-check>>
      <<if _watchSafe and _watch.phase is 'threshold'>>
        <<set _watch.phase to 'roots'>>
        <<set $combat to 1>>
        <<set $enemytype to 'tentacles'>>
        <<molested>>
        <<controlloss>>
        <<temple-watch-skills>>
        <<tentaclestart `(_watch.route ? 8 : 12) - (_watchNotes ? 2 : 0)` 18 'root' 'vine' true>>
      <</if>>
    <</temple-duty-action>>
    <br>
  <<case 'voices'>>
    <<language>>
      <<option 'EN'>>
        At the second door, a voice calls your name from the other side and asks you to come closer. Behind you, a lamp gutters as someone draws breath to answer. You look down at the prayer sheet. One instruction has been underlined: "Keep those beside you on this side of the door."
        <<if _watch.party.includes('Robin')>>
          <<if _watch.aids.includes('Robin:answer')>>
            <br><br>Robin's voice rises clear beside yours, chanting the ancient cadence. The steady prayer drowns out the insidious whispers from the door.
          <<else>>
            <br><br>As the gentle whisper seeps through the door, Robin's chest heaves. Robin's lips part slightly in confusion, struggling against the eerie impulse to answer.
          <</if>>
        <</if>>
        <<if _watch.party.includes('Sydney')>>
          <<if _watch.aids.includes('Sydney:answer')>>
            <br><br>Sydney's palms are clasped tightly against the prayer sheet, reciting the holy words with firm resolve, barring the murmurs from your midst.
          <<else>>
            <br><br>Sydney freezes, eyes widening as the distorted voice calls from the latch. Sydney's knuckles strain against the prayer paper, momentarily lost in the whisper.
          <</if>>
        <</if>>
      <<option 'CN'>>
        到了第二扇门前，门后的声音叫出了你的名字，请你再走近些。身后一盏灯晃了晃，有人吸气，像是准备回答那道声音。你低头看向祷文，其中一句被划了线：“让同行的人留在门的这一边。”
        <<if _watch.party.includes('Robin')>>
          <<if _watch.aids.includes('Robin:answer')>>
            <br><br>罗宾的声音与你清晰地重合在一起，神圣祷文的韵律在石廊中回响，彻底压过了门后诡异诱人的低语。
          <<else>>
            <br><br>门后的呢喃声丝丝缕缕地飘来，罗宾胸口剧烈起伏，嘴唇微微张开，眼中带着惶惑，正艰难地抵御着应声的冲动。
          <</if>>
        <</if>>
        <<if _watch.party.includes('Sydney')>>
          <<if _watch.aids.includes('Sydney:answer')>>
            <br><br>悉尼双手合拢紧扣着祷文纸，字字沉稳地诵念着答词，将门后传来的惑人幻音彻底隔绝。
          <<else>>
            <br><br>门后扭曲的声音让悉尼浑身一僵，手中的祷文纸被捏出深深的皱褶，目光在门缝前显出片刻的迷惘与挣扎。
          <</if>>
        <</if>>
    <</language>>
    <br><br>
    <<temple-watch-support 'answer'>>
    <<templeicon 'pray'>>
    <<if _watchPrayer>>
      <<lanSwitch 'You recognise the prayer response in the older text. Its familiar rhythm helps you keep reciting while the voice calls from behind the door.' '你在旧祷文里认出了应和的句子。门后的声音仍在呼唤，但熟悉的韵律能帮你继续念下去。'>>
      <br><br>
    <</if>>
    <<temple-duty-action `['Recite the prayer with those beside you (0:20)', '带身旁的人一起念祷文 (0:20)']` 20 'Revelation Temple Watch Note' `_watch.party`>>
      <<temple-watch-check>>
      <<if _watchSafe and _watch.phase is 'voices'>>
        <<temple-watch-skills>>
        <<set _watch.phase to currentSkillValue('willpower') gte _watchWill and $control gte _watchControl ? 'shadow' : 'failed'>>
        <<set $TempleDuties.note to _watch.phase is 'failed' ? 'watch-voices' : 'watch-answer'>>
        <<if _watch.phase is 'shadow'>>
          <<for _wName range _watch.party>>
            <<if !_watch.aids.includes(_wName + ':answer')>>
              <<run _watch.aids.push(_wName + ':answer')>>
            <</if>>
          <</for>>
        <</if>>
        <<stress 12>>
        <<tiredness `_watchPrayer ? 5 : 8`>>
      <</if>>
    <</temple-duty-action>>
    <span class='lblue'><<lanSwitch ' | Willpower and control' ' | 意志与自控'>></span><br>
    <<socialiseicon>>
    <<lanLink ['Answer the voice calling your name beyond the door', '回答门后叫你名字的声音'] 'Revelation Temple Watch Failed'>>
      <<set _watch.phase to 'failed'>>
    <</lanLink>>
    <br>
  <<case 'shadow'>>
    <<language>>
      <<option 'EN'>>
        The voice stops. The second door is still closed, but something pale is already moving across the floor at your feet. You never saw it pass through the doorway. The lamps cast your shadows towards it. Behind you, the priest takes hold of the bolt. "Keep it away from the lamps, child. We need their light to get everyone out."
      <<option 'CN'>>
        声音停了。第二扇门还关着，苍白的东西却已经贴着你们脚边的地面爬来。你没有看见它经过门口。灯火把你们的影子投向它。身后的司祭握住门闩。“别让它碰到灯，孩子。我们还得借着灯光，把所有人带出去。”
    <</language>>
    <br><br>
    <<templeicon 'trialcontinue'>>
    <<temple-duty-action `['Fight off the pale shapes and protect the lamps (0:01)', '击退苍白的东西，护住灯火 (0:01)']` 1 'Revelation Temple Watch Combat' `_watch.party`>>
      <<temple-watch-check>>
      <<if _watchSafe and _watch.phase is 'shadow'>>
        <<set $combat to 1>>
        <<set $enemytype to 'tentacles'>>
        <<molested>>
        <<controlloss>>
        <<tentaclestart 10 20 'tentacle' 'pale'>>
      <</if>>
    <</temple-duty-action>>
    <br>
  <<case 'seal'>>
    <<language>>
      <<option 'EN'>>
        The last door has a small mirror beside its handle. Your copied ward pattern has a gap, but the reflected pattern is complete. As you lift the paper, the line filling that gap in the mirror moves towards your fingers. Everyone waits behind you while you decide which pattern to use to seal the door.
        <<if currentSkillValue('skulduggery') gte 500 or $awareness gte 600>>
          A scratch on the door runs outwards from the edge of the mirror. In the reflection, the same scratch runs towards the glass.
        <</if>>
      <<option 'CN'>>
        最后一扇门的把手旁嵌着一面小镜子。你抄下的护符图样留着一道缺口，镜中的图样却是完整的。你抬起纸张，镜中补齐缺口的那条线便向你的手指移来。同行的人都在身后，等你选定图样，封好这扇门。
        <<if currentSkillValue('skulduggery') gte 500 or $awareness gte 600>>
          门上的一道刮痕从镜边向外延伸。镜中同一处的刮痕，却朝着镜面伸去。
        <</if>>
    <</language>>
    <br><br>
    <<icon 'temple/ward-stone.png'>>
    <<temple-duty-action `['Use your copied pattern; count everyone before sealing the door (0:20)', '按纸上的图样封门，先确认所有人都在身后 (0:20)']` 20 'Revelation Temple Watch Passed' `_watch.party`>>
      <<temple-watch-check>>
      <<if _watchSafe and _watch.phase is 'seal'>>
        <<set $TempleDuties.trial_day to Math.floor(Time.days)>>
        <<for _watchName range _watch.party>>
          <<if _watch.aids.includesAll(_watchName + ':lamp', _watchName + ':answer')>>
            <<set $TempleDuties.candidates[_watchName].trial_day to Math.floor(Time.days)>>
            <<if _watchName is 'Robin'>>
              <<npcincr Robin trauma 2>>
            <</if>>
          <</if>>
        <</for>>
        <<set _watch.phase to 'passed'>>
      <</if>>
    <</temple-duty-action>>
    <br>
    <<mirroricon>>
    <<lanLink ['Fill the gap on your paper to match the reflection', '照镜中的样子，补齐纸上图样的缺口'] 'Revelation Temple Watch Failed'>>
      <<set _watch.phase to 'failed'>>
    <</lanLink>>
    <br>
<</switch>>
<br>
<<temple-watch-leave>>

:: Revelation Temple Watch Support
<<temple-duty-place>>
<<temple-watch-check>>
<<npc `$TempleDuties.speaker`>>
<<person1>>
<<language>>
  <<option 'EN'>>
    <<if $TempleDuties.speaker is 'Robin'>>
      <<if $TempleDuties.watch.phase is 'voices'>>
        A broken edge of the lamp has cut Robin's fingers. You wrap the cuts in a strip of cloth and help <<him>> hold the lamp steady. <<He>> looks up. "Still here," <<he>> says quietly. You recite the next line of the prayer together.
      <<else>>
        Robin is gripping the lamp tightly. You stand beside <<him>> and help <<him>> steady it. <<He>> looks up. "Still here," <<he>> says quietly. You recite the next line of the prayer together.
      <</if>>
    <<else>>
      <<if $TempleDuties.watch.phase is 'voices'>>
        Sydney's sleeve has torn at the wrist. Blood marks the prayer sheet, and <<his>> voice is hoarse. You help <<him>> steady the lamp and hold the page where <<he>> can read it. When you begin the next line, <<he>> joins in.
      <<else>>
        Sydney has reached the end of a familiar prayer. You help <<him>> steady the lamp and point to the next response on the sheet. <<He>> takes a slow breath. When you begin the next line, <<he>> joins in.
      <</if>>
    <</if>>
  <<option 'CN'>>
    <<if $TempleDuties.speaker is 'Robin'>>
      <<if $TempleDuties.watch.phase is 'voices'>>
        灯罩破裂的边缘划伤了罗宾的手指。你用布条包好伤口，帮<<him>>拿稳灯。<<He>>抬起头，轻声说：“我还在这里。”你们一起念出下一句祷文。
      <<else>>
        罗宾紧紧攥着灯。你站到<<him>>身旁，帮<<him>>稳住灯身。<<He>>抬起头，轻声说：“我还在这里。”你们一起念出下一句祷文。
      <</if>>
    <<else>>
      <<if $TempleDuties.watch.phase is 'voices'>>
        悉尼腕边的袖口已经撕裂，祷文纸上沾着血，<<his>>声音也哑了。你帮<<him>>扶稳灯，把纸举到<<he>>看得清的地方。你念出下一句，<<he>>便跟着念下去。
      <<else>>
        悉尼已经念完了熟悉的那段祷文。你帮<<him>>扶稳灯，指着纸上接下来要应和的句子。<<He>>慢慢吸了口气。你开口念，<<he>>便跟着念下去。
      <</if>>
    <</if>>
<</language>>
<br><br>
<<temple-watch-back>>

:: Revelation Temple Watch Note
<<temple-duty-place>>
<<language>>
  <<option 'EN'>>
    <<switch $TempleDuties.note>>
      <<case 'watch-route'>>
        <<if $TempleDuties.watch.route>>
          You compare the copied ward pattern with the marks along a seam in the wall. Beside them, you find a dry strip of floor leading back to the outer door.
        <<else>>
          Damp has blurred the marks on the wall. You can still see the outer door, but you cannot find a clear path back: roots cover more of the floor than you first thought.
        <</if>>
      <<case 'watch-answer'>>
        You nearly answer the voice calling from behind the door. You catch yourself and finish the prayer with those beside you. The voice falls silent.
      <<case 'watch-voices'>>
        Before you finish the prayer, you hear yourself answering the voice behind the door. The older priest steadies the lamp behind you, knocks twice on the outer door, and leads everyone towards the exit.
    <</switch>>
  <<option 'CN'>>
    <<switch $TempleDuties.note>>
      <<case 'watch-route'>>
        <<if $TempleDuties.watch.route>>
          你沿着墙缝，把墙上的痕迹与抄下的护符图样逐一核对，在旁边找到一条干燥的窄路，可以一直退到进来时的外门。
        <<else>>
          墙上的痕迹已经被潮气洇花。你仍看得见进来时的外门，却找不出一条畅通的退路：地上的根须比你起初以为的更多。
        <</if>>
      <<case 'watch-answer'>>
        你差点开口回答门后的呼唤，及时停住，又和身旁的人一起念完祷文。门后的声音终于安静下来。
      <<case 'watch-voices'>>
        祷文还没念完，你已经听见自己在回答门后的声音。资深司祭扶住你身后的灯，叩了两下外门，领着所有人往出口退去。
    <</switch>>
<</language>>
<br><br>
<<if $TempleDuties.watch.phase is 'failed'>>
  <<getouticon>><<lanLink ['Leave with the priest', '随司祭退出'] 'Revelation Temple Watch Failed'>>
  <</lanLink>>
  <br>
<<else>>
  <<temple-watch-back>>
<</if>>

:: Revelation Temple Watch Combat
<<if ['roots', 'shadow'].includes($TempleDuties.watch?.phase) and $combat is 1 and $enemytype is 'tentacles'>>
  <<temple-tentacle-turn 'Revelation Temple Watch Combat' 'Revelation Temple Watch Combat End'>>
<<else>>
  <<temple-watch-back>>
<</if>>

:: Revelation Temple Watch Combat End
<<if ['roots', 'shadow'].includes($TempleDuties.watch?.phase) and $combat is 1 and $enemytype is 'tentacles'
    and ($tentacles.active lte $tentacles.max / 2 or _combatend)>>
  <<set _watchWon to $tentacles.active lte $tentacles.max / 2 and $stress lt $stressmax and !$possessed>>
  <<if _watchWon>>
    <<if $TempleDuties.watch.phase is 'roots'>>
      <<for _wName range $TempleDuties.watch.party>>
        <<if !$TempleDuties.watch.aids.includes(_wName + ':lamp')>>
          <<run $TempleDuties.watch.aids.push(_wName + ':lamp')>>
        <</if>>
      <</for>>
    <</if>>
  <</if>>
  <<clotheson>>
  <<endcombat>>
  <<set $TempleDuties.watch.phase to _watchWon ? ($TempleDuties.watch.phase is 'roots' ? 'voices' : 'seal') : 'failed'>>
<</if>>
<<if $combat>>
  <<lanLink ['Continue fighting', '继续战斗'] 'Revelation Temple Watch Combat'>>
  <</lanLink>>
  <<exit>>
<</if>>
<<language>>
  <<option 'EN'>>
    <<if $TempleDuties.watch?.phase is 'voices'>>
      The severed roots wither back into the damp mortar of the stone wall, twitching feebly before stilling completely. Loose dust and stone chips have scraped your arms, but the clear path to the threshold remains open. You help your companions steady their lamps and check that everyone's flame burns clear. From the dark passage ahead, a soft draft brings the smell of cold, subterranean water.
    <<elseif $TempleDuties.watch?.phase is 'seal'>>
      The thrashing pale shapes recoil from the burning lamps, dissolving into oily moisture along the stone floor. Your breath comes ragged in the close air, but the lanterns held firmly by your companions kept the darkness from closing in. The older priest slides the iron bolt home behind you with a heavy clang. "All accounted for," the older priest whispers, hands steadying. Ahead, the final door stands waiting.
    <<else>>
      Loose stone has scraped your arms during the struggle. You stand beside the lamps and count the people still with you. Beyond the wall, something taps once.
    <</if>>
  <<option 'CN'>>
    <<if $TempleDuties.watch?.phase is 'voices'>>
      被斩断的根须在湿冷的石灰缝中抽搐了几下，终于软垂萎缩。激战中飞溅的碎石刮破了你的手臂，但通往外门的退路依然畅通。你帮身旁的同伴扶稳提灯，逐一确认所有人的火苗都依然明亮。前方的幽暗通道里，拂来一阵夹杂着潮气的冷风。
    <<elseif $TempleDuties.watch?.phase is 'seal'>>
      狂乱抽打的苍白触须被灯火逼退，化作石板上的一滩油腻水渍。逼仄的空气中，呼吸声沉重而急促，但同行伙伴高举的提灯护住了彼此，未让黑暗将任何人吞噬。身后的资深司祭推上沉重的铁栓，发出笃定的钝响。“人都在，”资深司祭低声说，手也稳了下来。前方，最后一道门静静伫立在灯光下。
    <<else>>
      混乱中，碎石刮破了你的手臂。你站到灯旁，清点仍在身边的人。墙的另一侧，有什么东西轻叩了一下。
    <</if>>
<</language>>
<br><br>
<<temple-watch-back>>

:: Revelation Temple Watch Passed
<<temple-duty-place>>
<<if $TempleDuties.watch?.phase isnot 'passed'>>
  <<temple-watch-back>>
  <<exit>>
<</if>>
<<npc Jordan>>
<<person1>>
<<language>>
  <<option 'EN'>>
    The older priest leads everyone back through the outer door to the room with the fire. Your hands shake too much to undo the lamp strap. Jordan loosens it, then washes the grit from your cuts. <<He>> counts the lamps once, and the people twice. "You brought everyone back and sealed the doors. The watch is complete." <<He>> draws a blanket over the nearest shoulders. "Rest first, child. We can speak when you feel ready."
  <<option 'CN'>>
    资深司祭带着大家穿过外门，回到生着炉火的房间。你的手抖得解不开灯带。约旦替你松开带子，又洗去伤口里的碎屑。<<He>>数了一遍灯，又数了两遍人。“所有人都回来了，门也封好了。这次守望结束了。”<<He>>给离得最近的人披上毯子。“先休息，孩子。等你缓过来，我们再谈。”
<</language>>
<<if $TempleDuties.trial_day gte 0>>
  <br><br>
  <<lanSwitch 'You have gained the trait ' '你获得了特质'>>
  <span class='gold'><<lanSwitch 'Watchkeeper' '守望者'>></span><<lanSwitch '.' '。'>>
<</if>>
<<for _watchName range $TempleDuties.watch.party>>
  <br><br>
  <<if $TempleDuties.candidates[_watchName].trial_day gte 0>>
    <span class='teal'><<print maplebirch.auto(_watchName)>><<lanSwitch ' has completed the watch required for appointment and can now attend the interview.' '已完成任职所需的守望，现在可以参加面谈。'>></span>
  <<else>>
    <span class='lblue'><<print maplebirch.auto(_watchName)>><<lanSwitch ' still needs to complete the watch required for appointment. Jordan asks you to try together another day, helping with both the lamp and the prayer response.' '还未完成任职所需的守望。约旦请你改天再陪同一次，在持灯和应和祷文时都加以照应。'>></span>
  <</if>>
<</for>>
<br><br>
<<temple-duty-rest-link>>
<<temple-duty-back>>

:: Revelation Temple Watch Failed
<<temple-duty-place>>
<<if $combat>>
  <<lanLink ['Continue fighting', '继续战斗'] 'Revelation Temple Watch Combat'>>
  <</lanLink>>
  <<exit>>
<</if>>
<<npc Jordan>>
<<person1>>
<<language>>
  <<option 'EN'>>
    The older priest brings you and the lamps back through the outer door. One lamp has gone cold. Jordan places it beside the others. "We will stop here today. Rest, and come back another day when you are ready." <<He>> keeps a hand over the key ring. You cannot see which key <<he>> has covered.
  <<option 'CN'>>
    资深司祭带着你和灯退出外门。其中一盏灯已经冷了。约旦把它放在其他灯旁。“今天先到这里。休息吧，准备好了，改天再来。”<<He>>用手压住钥匙圈，你看不见<<he>>遮住的是哪一把。
<</language>>
<br><br>
<<temple-duty-rest-link>>
<<temple-duty-back>>

:: Temple Watch Return Widgets [widget]
<<widget 'temple-watch-back'>>
  <<templeicon 'trialcontinue'>>
  <<lanLink ['Continue checking the lower passage', '继续检查下层通道'] 'Revelation Temple Watch'>>
  <</lanLink>>
  <br>
<</widget>>

<<widget 'temple-watch-leave'>>
  <<getouticon>>
  <<lanLink ['End this watch and ask the priest to lead everyone out', '结束这次守望，请司祭带所有人退出'] 'Revelation Temple Watch Failed'>>
    <<if !$combat and $TempleDuties.watch and !['passed', 'failed'].includes($TempleDuties.watch.phase)>>
      <<set $TempleDuties.watch.phase to 'failed'>>
    <</if>>
  <</lanLink>>
  <br>
<</widget>>
